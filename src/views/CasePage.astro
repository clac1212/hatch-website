---
import { getEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import AgentCards from '../components/pages/AgentCards.astro';
import { avatars } from '../components/pages/agent-visuels';
import { casVisuels } from '../components/sections/cas-visuels';
import { fill, longDate } from '../components/pages/format';
import type { CaseId } from '../content/schemas/cas';
import {
  BRAND,
  breadcrumbList,
  founders,
  languageTag,
  organizationId,
  person,
} from '../seo/jsonld';
import { entryRoutes, routes, useTranslations, type Locale } from '../i18n/ui';

/**
 * A customer case page (/clients/<id>, /en/clients/<id>): the most citable page of the site (SEO
 * brief, Notion "04 · Le contenu"). Hero on the customer's brand colour, like its slice on the home
 * shelf (logo, storefront, "Avec <agent>"), with the dates and the author; then the before/after
 * figures, each with its source; the customer's quote; the story; the agents involved; the single
 * call to action. Copy: src/content/cases/<locale>/<id>.yaml; labels: src/content/pages/case.
 */
interface Props {
  locale: Locale;
  id: CaseId;
}

const { locale, id } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry('cases', `${locale}/${id}`);
if (!entry) throw new Error(`Missing src/content/cases/${locale}/${id}.yaml`);
const c = entry.data;
const uiEntry = await getEntry('casePage', locale);
if (!uiEntry) throw new Error(`Missing src/content/pages/case/${locale}.yaml`);
const ui = uiEntry.data;
const visuel = casVisuels[id];
if (!visuel) throw new Error(`"${id}" is not a case id of src/content/schemas/cas.ts`);
const paths = entryRoutes.clients(id);

const badge = await getEntry('agents', `${locale}/${c.agents[0]}`);
if (!badge) throw new Error(`Missing src/content/agents/${locale}/${c.agents[0]}.md`);
const auteur = c.author && ui.authors[c.author];
const vars = { client: c.client };
const wrap = 'mx-auto w-full max-w-site px-6 md:px-12';

// Article signed by its author (full name when they are a founder), dated by the content.
const site = Astro.site!;
const url = new URL(paths[locale], site).href;
const jsonLd = [
  breadcrumbList(site, [
    { name: BRAND, path: routes.home[locale] },
    { name: c.client, path: paths[locale] },
  ]),
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    mainEntityOfPage: url,
    headline: c.title,
    description: c.seo.description,
    inLanguage: languageTag[locale],
    datePublished: c.published,
    dateModified: c.updated,
    ...(auteur && {
      author: person(founders.find((f) => f.givenName === auteur.name)?.name ?? auteur.name),
    }),
    publisher: { '@id': organizationId(site) },
    about: { '@type': 'Organization', name: c.client },
  },
];
---

<Base
  locale={locale}
  paths={paths}
  title={c.seo.title}
  description={c.seo.description}
  ogType="article"
  jsonLd={jsonLd}
  noindex={c.brouillon}
>
  <header class="marque pt-28 pb-14 text-white md:pt-36 md:pb-0" style={`--marque:${visuel.color}`}>
    <div
      class:list={[wrap, 'grid items-end gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]']}
    >
      <div class="flex flex-col items-start gap-6 md:pb-20" data-rv-groupe>
        <nav aria-label={ui.breadcrumb.label} data-rv>
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-caption text-white/75">
            <li><a href={routes.home[locale]} class="fil">{ui.breadcrumb.home}</a></li>
            <li aria-hidden="true">›</li>
            <li>
              <a href={`${routes.home[locale]}#cas-clients`} class="fil">{ui.breadcrumb.cases}</a>
            </li>
            <li aria-hidden="true">›</li>
            <li><a href={paths[locale]} aria-current="page" class="text-white">{c.client}</a></li>
          </ol>
        </nav>
        <Picture
          src={visuel.logo}
          alt={c.client}
          formats={['avif', 'webp']}
          height={visuel.logoH * 1.4}
          densities={[1, 2]}
          class="w-auto object-contain"
          style={`height:${visuel.logoH * 1.4}px`}
          data-rv
        />
        <p class="font-mono text-kicker text-white/60 uppercase" data-rv>{ui.kicker}</p>
        <h1 class="titre font-display font-bold" data-rv>{c.title}</h1>
        <p
          class="max-w-[38rem] text-punch text-white/80 md:text-[1.3125rem] md:leading-[1.5]"
          data-rv
        >
          {c.lead}
        </p>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-caption text-white/75" data-rv>
          <span class="badge">
            <Image
              src={avatars[c.agents[0]]}
              alt=""
              width={28}
              densities={[1, 2]}
              class="size-7 object-contain"
            />
            {ui.with}
            {badge.data.name}
          </span>
          <time datetime={c.published}>
            {fill(ui.published, { date: longDate(c.published, locale) })}
          </time>
          {
            c.updated !== c.published && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={c.updated}>
                  {fill(ui.updated, { date: longDate(c.updated, locale) })}
                </time>
              </>
            )
          }
          {
            auteur && (
              <>
                <span aria-hidden="true">·</span>
                <span>{fill(ui.by, { author: `${auteur.name}, ${auteur.role}` })}</span>
              </>
            )
          }
        </p>
        <div data-rv>
          <Button href={routes.demo[locale]} variant="cream">{t('cta.demo')}</Button>
        </div>
      </div>
      <div class="mx-auto w-full max-w-[420px] md:mr-0">
        <Picture
          src={visuel.front}
          alt={c.visualAlt}
          formats={['avif', 'webp']}
          widths={[320, 480, 640]}
          sizes="(min-width: 768px) 420px, 80vw"
          loading="eager"
          class="h-auto w-full object-contain object-bottom"
        />
      </div>
    </div>
  </header>

  <section aria-labelledby="cas-chiffres" class="py-20 md:py-28">
    <div class:list={[wrap, 'flex flex-col gap-10']} data-rv-groupe>
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>{ui.figures.kicker}</p>
        <h2 id="cas-chiffres" class="font-display text-section font-bold text-ink" data-rv>
          {ui.figures.title}
        </h2>
      </div>
      <ul class="grid gap-4 md:grid-cols-3" data-rv>
        {
          c.figures.map((f) => (
            <li class="chiffre">
              <div class="flex items-end gap-6">
                {f.before && (
                  <p class="flex flex-col gap-1">
                    <span class="font-mono text-source text-soft uppercase">
                      {ui.figures.before}
                    </span>
                    <span class="font-display text-stat text-soft">{f.before}</span>
                  </p>
                )}
                <p class="flex flex-col gap-1">
                  {f.before && (
                    <span class="font-mono text-source text-orange-txt uppercase">
                      {ui.figures.after}
                    </span>
                  )}
                  <span class="font-display text-stat font-bold text-ink">{f.after}</span>
                </p>
              </div>
              <p class="text-body text-ink">{f.label}</p>
              <p class="mt-auto font-mono text-source text-soft uppercase">{f.source}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="marque py-16 text-white md:py-24" style={`--marque:${visuel.color}`}>
    <div class={wrap}>
      <figure class="flex max-w-[64rem] flex-col gap-6" data-rv-groupe>
        <blockquote
          class="font-display text-[clamp(1.75rem,1.3rem+1.8vw,2.75rem)] leading-[1.2]"
          data-rv
        >
          <p>{c.quote.text}</p>
        </blockquote>
        <figcaption class="text-body text-white/80" data-rv>{c.quote.author}</figcaption>
      </figure>
    </div>
  </section>

  <section aria-labelledby="cas-histoire" class="py-20 md:py-28">
    <div class:list={[wrap, 'grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16']} data-rv-groupe>
      <p class="font-mono text-kicker text-orange-txt uppercase" id="cas-histoire" data-rv>
        {ui.story.kicker}
      </p>
      <div class="flex max-w-prose flex-col gap-10">
        {
          c.sections.map((s) => (
            <div class="flex flex-col gap-3" data-rv>
              <h2 class="font-display text-card font-bold text-ink md:text-[1.75rem]">{s.title}</h2>
              <p class="text-body text-soft">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="cas-agents" class="bg-surface py-20 md:py-28">
    <div class:list={[wrap, 'flex flex-col gap-10']} data-rv-groupe>
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>{ui.agents.kicker}</p>
        <h2 id="cas-agents" class="font-display text-section font-bold text-ink" data-rv>
          {fill(ui.agents.title, vars)}
        </h2>
      </div>
      <div data-rv>
        <AgentCards slugs={c.agents} locale={locale} />
      </div>
    </div>
  </section>

  <section aria-labelledby="cas-cta" class="py-20 md:py-28" data-rv-groupe>
    <div class:list={[wrap, 'flex flex-col items-start gap-5 md:items-center md:text-center']}>
      <h2 id="cas-cta" class="font-display text-section font-bold text-ink" data-rv>
        {ui.cta.title}
      </h2>
      <p class="max-w-[36rem] text-body text-soft" data-rv>{ui.cta.text}</p>
      <div data-rv>
        <Button href={routes.demo[locale]} size="lg">{t('cta.demo')}</Button>
      </div>
      <p class="mt-8 font-mono text-source text-soft uppercase">
        <time datetime={c.updated}>{fill(ui.updated, { date: longDate(c.updated, locale) })}</time>
      </p>
    </div>
  </section>
</Base>

<style>
  .marque {
    background-color: var(--marque);
  }
  .titre {
    max-width: 22ch;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .fil {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-white) 35%, transparent);
    text-underline-offset: 3px;
  }
  .fil:hover {
    color: var(--color-white);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    background: var(--color-white);
    font-weight: 600;
    color: var(--color-ink);
  }
  .chiffre {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
</style>
