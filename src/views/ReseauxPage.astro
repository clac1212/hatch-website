---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Clients from '../components/sections/Clients.astro';
import Probleme from '../components/sections/Probleme.astro';
import Demo from '../components/sections/Demo.astro';
import Equipe from '../components/sections/Equipe.astro';
import Cas from '../components/sections/Cas.astro';
import MiseEnPlace from '../components/sections/MiseEnPlace.astro';
import Tarifs from '../components/sections/Tarifs.astro';
import { section } from '../content/section';
import siege from '../assets/footer/siege.jpg';
import { routes, type Locale } from '../i18n/ui';
import { BRAND, languageTag, organizationId } from '../seo/jsonld';

/**
 * The franchise-network space (/reseaux, /en/networks): the former one-page home, with the Europe map
 * hero and the agents' open space in the footer. The Security block now lives on the home page.
 * Shared by src/pages/reseaux.astro (FR) and src/pages/en/networks.astro (EN).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = await getEntry('home', locale);
if (!home) throw new Error(`Missing src/content/home/${locale}.yaml`);
const { seo } = home.data.reseaux;
const pied = { image: siege, ...(await section('piedDePage', locale)).scenes.reseaux };

// Structured data: the site, and the product with the real prices of the Tarifs section
// (euros excl. VAT, per location and per month, monthly and annual billing).
const site = Astro.site!;
const tarifs = await section('tarifs', locale);
const homeUrl = new URL(routes.reseaux[locale], site).href;
const price = (name: string, amount: number) => ({
  '@type': 'UnitPriceSpecification',
  name,
  price: amount,
  priceCurrency: 'EUR',
  valueAddedTaxIncluded: false,
  unitText: tarifs.unite.replace(/^\/\s*/, ''),
});
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${homeUrl}#software`,
    name: BRAND,
    description: seo.description,
    url: homeUrl,
    inLanguage: languageTag[locale],
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    publisher: { '@id': organizationId(site) },
    offers: tarifs.offres.map((o) => ({
      '@type': 'Offer',
      name: o.nom.replace(/\s*\n\s*/g, ' '),
      description: o.type,
      price: o.prix.mensuel,
      priceCurrency: 'EUR',
      priceSpecification: [
        price(tarifs.formule.mensuel, o.prix.mensuel),
        price(tarifs.formule.annuel, o.prix.annuel),
      ],
    })),
  },
];
---

<Base
  locale={locale}
  paths={routes.reseaux}
  title={seo.title}
  description={seo.description}
  jsonLd={jsonLd}
  pied={pied}
  espace
>
  <Hero locale={locale} europe />
  <Clients locale={locale} />
  <Probleme locale={locale} />
  <Demo locale={locale} />
  <Equipe locale={locale} />
  <Cas locale={locale} />
  <MiseEnPlace locale={locale} />
  <Tarifs locale={locale} />
</Base>
