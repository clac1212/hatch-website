---
import { getEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Mur from '../components/agents/Mur.astro';
import Exemple from '../components/agents/Exemple.astro';
import Probleme from '../components/agents/probleme/Probleme.astro';
import Relais, { type Lien } from '../components/agents/Relais.astro';
import Icone from '../components/agents/Icone.astro';
import { centres } from '../components/agents/visuels';
import { agentPhoto, avatars } from '../components/pages/agent-visuels';
import { fill } from '../components/pages/format';
import { section } from '../content/section';
import { agentSlugs, type AgentSlug } from '../content/schemas/agents';
import { BRAND, breadcrumbList, languageTag, organizationId } from '../seo/jsonld';
import { entryRoutes, routes, useTranslations, type Locale } from '../i18n/ui';

/**
 * An agent's page (/agents/<slug>, /en/agents/<slug>), after the Pencil mock-ups "Page agent —
 * <agent>" (César 10/10), Patrick's copy word for word:
 * 1. hero: the job as H1 (Fraunces, like the home hero), the first sentence, the demo button, the agent's render;
 * 2. the problem: a title naming the pain, a sentence, its objects (probleme/Probleme.astro);
 * 3. what it does, as a feature wall (Mur.astro);
 * 4. what it does alone vs what you decide;
 * 5. a usage example, played on the devices of whoever acts (Exemple.astro, scenes/);
 * 6. what it works with, as a relay diagram (Relais.astro); 7. its FAQ, visible and as FAQPage; 8. the agents to read next and the
 *    demo. No update date or author line on any page (César 12/10).
 * The copy is the `page` block of src/content/agents/<locale>/<slug>.md; the wall's copy is in
 * src/content/agents-bento/; the section headings in src/content/pages/agent/<locale>.yaml.
 */
interface Props {
  locale: Locale;
  slug: AgentSlug;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry('agents', `${locale}/${slug}`);
if (!entry?.data.page) throw new Error(`No page block in src/content/agents/${locale}/${slug}.md`);
const { name } = entry.data;
const p = entry.data.page;
const uiEntry = await getEntry('agentPage', locale);
/** The example's scene, for the agents that have one (src/content/agents-scenes/). */
const scene = await getEntry('agentsScenes', `${locale}/${slug}`);
/** The objects of the problem, for the agents that have them (src/content/agents-probleme/). */
const probleme = await getEntry('agentsProbleme', `${locale}/${slug}`);
if (!uiEntry) throw new Error(`Missing src/content/pages/agent/${locale}.yaml`);
const ui = uiEntry.data;
const paths = entryRoutes.agents(slug);
const vars = { name };
const photo = agentPhoto(slug);
const teinte = centres[slug].fond;

/** Every agent, for the cards that name them: name, job, and its page once published. */
const agents = Object.fromEntries(
  await Promise.all(
    agentSlugs.map(async (a) => {
      const e = await getEntry('agents', `${locale}/${a}`);
      if (!e) throw new Error(`Missing src/content/agents/${locale}/${a}.md`);
      const publiee = !!e.data.page && !e.data.page.brouillon;
      return [a, { ...e.data, href: publiee ? entryRoutes.agents(a)[locale] : undefined }];
    }),
  ),
) as Record<AgentSlug, { name: string; job: string; href?: string }>;

/** "Il travaille avec": Patrick's cards, or, for Lark, every agent it gathers (name and job). */
const liens: Lien[] =
  'cartes' in p.with
    ? p.with.cartes.map((c) => {
        const v = c.visuel;
        if ('agents' in v) {
          const seul = v.agents.length === 1 ? agents[v.agents[0]].href : undefined;
          return { titre: c.titre, texte: c.texte, agents: v.agents, href: seul };
        }
        return { titre: c.titre, texte: c.texte, icone: v.icone, ton: v.ton };
      })
    : p.with.agents.map((a) => ({
        titre: agents[a].name,
        texte: agents[a].job,
        agents: [a],
        href: agents[a].href,
      }));

// Structured data: the breadcrumb, the agent as part of Hatch OS with the prices of the Tarifs
// section (euros excl. VAT, per location and per month), and the visible FAQ word for word.
const site = Astro.site!;
const homeUrl = new URL(routes.home[locale], site).href;
const pageUrl = new URL(paths[locale], site).href;
const tarifs = await section('tarifs', locale);
const prix = tarifs.offres.flatMap((o) => [o.prix.annuel, o.prix.mensuel]);
const jsonLd = [
  breadcrumbList(site, [
    { name: ui.breadcrumb.home, path: routes.home[locale] },
    { name: ui.breadcrumb.agents, path: `${routes.home[locale]}#agents` },
    { name, path: paths[locale] },
  ]),
  {
    '@type': 'SoftwareApplication',
    '@id': `${pageUrl}#software`,
    name: `${name} · ${BRAND}`,
    description: p.seo.description,
    url: pageUrl,
    inLanguage: languageTag[locale],
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    dateModified: p.updated,
    isPartOf: { '@id': `${homeUrl}#software` },
    publisher: { '@id': organizationId(site) },
    offers: {
      '@type': 'AggregateOffer',
      lowPrice: Math.min(...prix),
      highPrice: Math.max(...prix),
      priceCurrency: 'EUR',
      offerCount: tarifs.offres.length,
      url: `${homeUrl}#tarifs`,
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  locale={locale}
  paths={paths}
  title={p.seo.title}
  description={p.seo.description}
  jsonLd={jsonLd}
  noindex={p.brouillon}
>
  <div class="bg-white">
    <header class="pt-32 pb-16 md:pt-44 md:pb-20">
      <div class="wrap-agent grid items-center gap-12 lg:grid-cols-[1fr_500px] lg:gap-20">
        <div class="flex flex-col items-start gap-8" data-rv-groupe>
          <h1 class="titre font-display font-semibold text-ink" data-rv>{p.title}</h1>
          <p class="max-w-[36rem] text-body text-soft" data-rv>{p.lead}</p>
          <div data-rv>
            <Button href={routes.demo[locale]} size="lg">{t('cta.demo')}</Button>
          </div>
        </div>
        <div
          class="mx-auto aspect-[500/620] w-full max-w-[500px] overflow-hidden rounded-[24px]"
          style={`background-color:${photo.fond}`}
        >
          <Picture
            src={photo.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[500, 760, 1000]}
            sizes="(min-width: 1024px) 500px, 92vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover"
            style={`object-position:${photo.position}`}
          />
        </div>
      </div>
    </header>

    <Probleme titre={p.problem.titre} texte={p.problem.texte} objets={probleme?.data} />

    <section aria-labelledby="agent-actions" class="bg-mur py-24 md:py-28">
      <div class="wrap-agent flex flex-col gap-12" data-rv-groupe>
        <h2 id="agent-actions" class="font-display text-section font-bold text-ink" data-rv>
          {fill(ui.actions, vars)}
        </h2>
        <Mur slug={slug} name={name} locale={locale} actions={p.actions} />
      </div>
    </section>

    <section aria-labelledby="agent-main" class="py-24 md:py-28">
      <div class="wrap-agent flex flex-col gap-12" data-rv-groupe>
        <h2 id="agent-main" class="font-display text-section font-bold text-ink" data-rv>
          {ui.control.title}
        </h2>
        <div class="grid gap-5 md:grid-cols-2" data-rv>
          <div class="main" style={`background-color:${teinte}`}>
            <p class="main-tete">
              <Image src={avatars[slug]} alt="" width={44} densities={[1, 2]} class="size-11" />
              <b>{fill(ui.control.agent, vars)}</b>
            </p>
            <ul>
              {
                p.control.agent.map((item) => (
                  <li>
                    <Icone nom="check" taille={15} class="text-orange-txt" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="main bg-mur">
            <p class="main-tete">
              <span class="main-vous">
                <Icone nom="user" taille={18} />
              </span>
              <b>{ui.control.you}</b>
            </p>
            <ul>
              {
                p.control.you.map((item) => (
                  <li>
                    <Icone nom="user-check" taille={15} class="text-soft" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <Exemple
      titre={ui.example}
      intro={p.exemple.intro}
      agent={name}
      contexte={p.exemple.contexte}
      avatar={avatars[slug]}
      etapes={p.exemple.etapes}
      scene={scene?.data}
    />

    <Relais
      titre={ui.with}
      intro={'texte' in p.with ? p.with.texte : undefined}
      centre={{ slug, name }}
      liens={liens}
    />

    <section aria-labelledby="agent-faq" class="bg-faq py-24 md:py-28">
      <div class="wrap-agent grid gap-10 lg:grid-cols-[460px_1fr]" data-rv-groupe>
        <h2 id="agent-faq" class="font-display text-section font-bold text-ink" data-rv>
          {ui.faq}
        </h2>
        <div class="faq" data-rv>
          {
            p.faq.map((f) => (
              <details>
                <summary>
                  <h3>{f.q}</h3>
                  <Icone nom="x" taille={18} class="signe" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section aria-labelledby="agent-suite" class="pt-24 pb-14 md:pt-28 md:pb-16">
      <div class="wrap-agent flex flex-col gap-12" data-rv-groupe>
        <h2 id="agent-suite" class="font-display text-section font-bold text-ink" data-rv>
          {ui.related.title}
        </h2>
        <div class="grid gap-5 lg:grid-cols-[520px_1fr]" data-rv>
          <ul class="flex flex-col gap-3">
            {
              p.related.map((r) => {
                const a = agents[r.agent];
                const Tag = a.href ? 'a' : 'div';
                return (
                  <li>
                    <Tag href={a.href} class="suite">
                      <span class="suite-av" style={`background-color:${centres[r.agent].fond}`}>
                        <Image
                          src={avatars[r.agent]}
                          alt=""
                          width={64}
                          densities={[1, 2]}
                          class="size-16 object-contain"
                        />
                      </span>
                      <span class="flex flex-1 flex-col gap-1">
                        <b class="suite-nom">{a.name}</b>
                        <span class="suite-texte">{r.texte}</span>
                      </span>
                      {a.href && (
                        <span class="suite-fleche" aria-hidden="true">
                          <Icone nom="arrow-right" taille={18} />
                        </span>
                      )}
                    </Tag>
                  </li>
                );
              })
            }
          </ul>
          <div class="demo">
            <Image
              src={avatars[slug]}
              alt=""
              width={100}
              densities={[1, 2]}
              class="size-[100px] object-contain"
            />
            <p class="demo-titre">{ui.related.demo}</p>
            <div class="mt-auto pt-6">
              <Button href={routes.demo[locale]} size="lg">{t('cta.demo')}</Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* H1 in the site's title face, like the home hero (César 12/10). */
  .titre {
    max-width: 16em;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.25rem);
    line-height: 1.06;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }
  /* Vous gardez la main: the agent's card (its tint, its avatar), and yours. */
  .main {
    padding: 32px 36px 28px;
    border-radius: 24px;
  }
  .main-tete {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .main-tete b {
    font: 700 22px/1.2 var(--font-display);
    color: var(--color-ink);
  }
  .main-vous {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-white);
  }
  .main li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    font-size: 16px;
    color: var(--color-ink);
  }
  .main li + li {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
  }

  /* Il travaille avec: a visual (an agent's render or a tool's app icon) over Patrick's line. */

  /* FAQ: questions folded (native <details>); a click opens the answer, the plus turns into a cross. */
  .faq details {
    border-top: 1px solid var(--color-ligne-claire);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0 10px;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .faq h3 {
    font: 600 17px/1.4 var(--font-sans);
    color: var(--color-ink);
  }
  .faq :global(.signe) {
    flex: none;
    color: var(--color-copper);
    transition: rotate 0.3s var(--ease-doux);
  }
  .faq details:not([open]) :global(.signe) {
    rotate: 45deg;
  }
  .faq details:not([open]) summary {
    padding-bottom: 22px;
  }
  .faq details p {
    max-width: 46rem;
    padding: 0 48px 22px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-soft);
  }

  /* Pour aller plus loin: the agents to read next, then the demo. */
  .suite {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 24px 20px 20px;
    border-radius: 24px;
    background: var(--color-galet);
    transition: box-shadow 0.3s var(--ease-doux);
  }
  a.suite:hover,
  a.suite:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-orange);
    outline: none;
  }
  .suite-av {
    display: grid;
    flex: none;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 20px;
  }
  .suite-nom {
    font: 700 24px/1.15 var(--font-display);
    color: var(--color-ink);
  }
  .suite-texte {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-soft);
  }
  .suite-fleche {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-white);
    transition: background-color 0.3s var(--ease-doux);
  }
  a.suite:hover .suite-fleche {
    background: var(--color-orange-txt);
  }
  .demo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    min-height: 420px;
    padding: 48px 56px;
    border-radius: 32px;
    background:
      radial-gradient(55% 60% at 80% 100%, rgb(248 122 1 / 0.42), transparent 70%),
      var(--color-night);
  }
  .demo-titre {
    max-width: 8em;
    font: 700 clamp(40px, 4vw, 56px) / 1.02 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-white);
  }
  @media (max-width: 39.99rem) {
    .demo {
      padding: 36px 28px;
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq :global(.signe),
    .suite,
    .suite-fleche {
      transition: none;
    }
  }
</style>
