---
import { getEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import DemoEcran from '../components/sections/DemoEcran.astro';
import AgentCards from '../components/pages/AgentCards.astro';
import { agentPhoto, avatars } from '../components/pages/agent-visuels';
import { fill, longDate } from '../components/pages/format';
import { section } from '../content/section';
import type { AgentSlug, toolLogos } from '../content/schemas/agents';
import { BRAND, breadcrumbList } from '../seo/jsonld';
import { entryRoutes, routes, useTranslations, type Locale } from '../i18n/ui';
import logoWhatsapp from '../assets/sans-filtre/whatsapp.svg';
import logoDrive from '../assets/miseEnPlace/src-google-drive.png';
import logoNotion from '../assets/miseEnPlace/src-notion.png';
import logoWord from '../assets/miseEnPlace/src-word.png';
import logoPdf from '../assets/miseEnPlace/src-pdf.jpg';
import logoExcel from '../assets/miseEnPlace/src-excel.png';

/**
 * An agent's page (/agents/<slug>, /en/agents/<slug>), the template of the SEO content brief
 * (Notion "04 · Le contenu"), in the order it sets:
 * 1. hero: the job in the customer's words as H1, the first sentence (who, problem, result), and the
 *    bird in the visual (its mosaic render) with its line in the first person;
 * 2. the problem as lived, beside the agent's request in the home's Problème section (BunBun);
 * 3. what it does (3–4 actions) beside its diorama demo screen, static in its final state (no GSAP);
 * 4. a customer scenario, only when the content has one (linked to the case page);
 * 5. the tools it plugs into; 6. its FAQ, visible (<details>); 7. the agents it works with;
 * 8. the single call to action, then the date of the last update.
 * The page's copy is the `page` block of src/content/agents/<locale>/<slug>.md; the shared labels
 * are in src/content/pages/agent/<locale>.yaml.
 */
interface Props {
  locale: Locale;
  slug: AgentSlug;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry('agents', `${locale}/${slug}`);
if (!entry?.data.page) throw new Error(`No page block in src/content/agents/${locale}/${slug}.md`);
const { name, job, pitch } = entry.data;
const p = entry.data.page;
const uiEntry = await getEntry('agentPage', locale);
if (!uiEntry) throw new Error(`Missing src/content/pages/agent/${locale}.yaml`);
const ui = uiEntry.data;
const paths = entryRoutes.agents(slug);

// The request this agent answers in the home's Problème section (one per agent there).
const probleme = await section('probleme', locale);
const demande = probleme.notifications.find((n) => n.agent === slug);
if (!demande) throw new Error(`No Problème notification answered by "${slug}" (${locale})`);

// The agent's demo screen in the diorama.
const demo = (await section('demo', locale)).lieux
  .flatMap((l) => l.agents)
  .find((a) => a.cle === p.demo);
if (!demo) throw new Error(`No diorama demo "${p.demo}" (${locale})`);
const telephone = demo.ecran.appareil === 'telephone' || demo.ecran.appareil === 'formation';

const LOGOS: Record<(typeof toolLogos)[number], ImageMetadata> = {
  whatsapp: logoWhatsapp,
  'google-drive': logoDrive,
  notion: logoNotion,
  word: logoWord,
  pdf: logoPdf,
  excel: logoExcel,
};

const photo = agentPhoto(slug);
const vars = { name };
const wrap = 'mx-auto w-full max-w-site px-6 md:px-12';
// Section numbers follow the blocks actually shown (the scenario is optional).
const blocs = [
  'problem',
  'actions',
  ...(p.scenario ? ['scenario'] : []),
  'tools',
  'faq',
  'related',
];
const num = (bloc: string) => String(blocs.indexOf(bloc) + 1).padStart(2, '0');
const rang = (i: number) => String(i + 1).padStart(2, '0');

const site = Astro.site!;
const jsonLd = [
  breadcrumbList(site, [
    { name: BRAND, path: routes.home[locale] },
    { name: `${name} · ${job}`, path: paths[locale] },
  ]),
];
---

<Base
  locale={locale}
  paths={paths}
  title={p.seo.title}
  description={p.seo.description}
  jsonLd={jsonLd}
  noindex={p.brouillon}
>
  <header class="pt-28 pb-16 md:pt-36 md:pb-24">
    <div class:list={[wrap, 'grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16']}>
      <div class="flex flex-col items-start gap-6" data-rv-groupe>
        <nav aria-label={ui.breadcrumb.label} data-rv>
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-caption text-soft">
            <li><a href={routes.home[locale]} class="fil">{ui.breadcrumb.home}</a></li>
            <li aria-hidden="true">›</li>
            <li>
              <a href={`${routes.home[locale]}#agents`} class="fil">{ui.breadcrumb.agents}</a>
            </li>
            <li aria-hidden="true">›</li>
            <li><a href={paths[locale]} aria-current="page" class="text-ink">{name}</a></li>
          </ol>
        </nav>
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>{name} · {job}</p>
        <h1 class="titre font-display font-bold text-ink" data-rv>{p.title}</h1>
        <p class="max-w-[38rem] text-punch text-soft md:text-[1.3125rem] md:leading-[1.5]" data-rv>
          {p.lead}
        </p>
        <div data-rv>
          <Button href={routes.demo[locale]} size="lg">{t('cta.demo')}</Button>
        </div>
      </div>

      <figure
        class="relative mx-auto aspect-square w-full max-w-[520px] overflow-hidden rounded-[28px] lg:mx-0 lg:justify-self-end"
        style={`background-color:${photo.fond}`}
      >
        <Picture
          src={photo.src}
          alt=""
          formats={['avif', 'webp']}
          widths={[400, 600, 800, 1040]}
          sizes="(min-width: 1024px) 520px, 92vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
          style={`object-position:${photo.position}`}
        />
        <figcaption
          class="absolute inset-x-3 bottom-3 flex flex-col gap-1 rounded-[14px] bg-white/70 px-4 py-3 shadow-1 outline outline-1 -outline-offset-[0.5px] outline-white/80 backdrop-blur-[7px] md:inset-x-4 md:bottom-4"
        >
          <span class="font-display text-[19px] leading-tight font-bold text-ink">{name}</span>
          <span class="text-caption text-ink">{pitch}</span>
        </figcaption>
      </figure>
    </div>
  </header>

  <section aria-labelledby="agent-probleme" class="bg-cream-2 py-20 md:py-28">
    <div
      class:list={[wrap, 'grid items-center gap-12 lg:grid-cols-[1fr_0.9fr] lg:gap-20']}
      data-rv-groupe
    >
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>
          {num('problem')} · {ui.problem.kicker}
        </p>
        <h2 id="agent-probleme" class="font-display text-section font-bold text-ink" data-rv>
          {p.problem.title}
        </h2>
        <p class="max-w-[36rem] text-body text-soft" data-rv>{p.problem.text}</p>
      </div>
      <div class="demande" data-rv>
        <p class="font-mono text-source text-soft uppercase">
          {probleme.telephone.apps[demande.app]} · {demande.de}
        </p>
        <p class="text-body font-medium text-ink">{demande.message}</p>
        <div class="reponse">
          <Image
            src={avatars[slug]}
            alt=""
            width={36}
            densities={[1, 2]}
            class="size-9 shrink-0 object-contain"
          />
          <div class="flex flex-col gap-1">
            <p class="font-mono text-source text-orange-txt uppercase">
              {fill(ui.problem.answer, vars)} → {demande.a}
            </p>
            <p class="text-body text-ink">{demande.reponse}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="agent-actions"
    class="overflow-x-clip bg-night py-20 text-white md:py-28"
  >
    <div
      class:list={[wrap, 'grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16']}
      data-rv-groupe
    >
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-white/60 uppercase" data-rv>
          {num('actions')} · {ui.actions.kicker}
        </p>
        <h2 id="agent-actions" class="font-display text-section font-bold" data-rv>
          {p.actions.title}
        </h2>
        <ol class="points flex w-full flex-col" data-rv>
          {
            p.actions.items.map((it, i) => (
              <li>
                <span class="rang">{rang(i)}</span>
                <span>
                  <b>{it.title}</b>
                  {it.text}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class:list={['vitrine', telephone && 'vitrine-tel']} data-rv>
        <DemoEcran ecran={demo.ecran} avatar={avatars[slug]} />
      </div>
    </div>
  </section>

  {
    p.scenario && (
      <section aria-labelledby="agent-scenario" class="py-20 md:py-28">
        <div class={wrap} data-rv-groupe>
          <div
            class="grid overflow-hidden rounded-card bg-surface shadow-[inset_0_0_0_1px_var(--color-line)] "
            data-rv
          >
            <div class="flex flex-col items-start gap-4 p-8 md:p-12">
              <p class="font-mono text-kicker text-orange-txt uppercase">
                {num('scenario')} · {ui.scenario.kicker}
              </p>
              <h2 id="agent-scenario" class="font-display text-section font-bold text-ink">
                {p.scenario.title}
              </h2>
              <p class="max-w-[36rem] text-body text-soft">{p.scenario.text}</p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section
    aria-labelledby="agent-outils"
    class:list={['pb-20 md:pb-28', p.scenario ? 'pt-0' : 'pt-20 md:pt-28']}
  >
    <div class:list={[wrap, 'grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16']} data-rv-groupe>
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>
          {num('tools')} · {ui.tools.kicker}
        </p>
        <h2 id="agent-outils" class="font-display text-section font-bold text-ink" data-rv>
          {ui.tools.title}
        </h2>
        <p class="max-w-[34rem] text-body text-soft" data-rv>{p.tools.text}</p>
      </div>
      <ul class="flex flex-wrap content-start gap-3 lg:pt-10" data-rv>
        {
          p.tools.items.map((tool) => (
            <li class="outil">
              {tool.logo && (
                <Image
                  src={LOGOS[tool.logo]}
                  alt=""
                  width={22}
                  height={22}
                  densities={[1, 2]}
                  class="size-[22px] object-contain"
                />
              )}
              {tool.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="agent-faq" class="bg-surface py-20 md:py-28">
    <div class:list={[wrap, 'grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16']} data-rv-groupe>
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>
          {num('faq')} · {ui.faq.kicker}
        </p>
        <h2 id="agent-faq" class="font-display text-section font-bold text-ink" data-rv>
          {fill(ui.faq.title, vars)}
        </h2>
      </div>
      <div class="faq" data-rv>
        {
          p.faq.map((f) => (
            <details>
              <summary>
                <h3>{f.q}</h3>
                <span class="signe" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="agent-equipe" class="py-20 md:py-28">
    <div class:list={[wrap, 'flex flex-col gap-10']} data-rv-groupe>
      <div class="flex flex-col items-start gap-5">
        <p class="font-mono text-kicker text-orange-txt uppercase" data-rv>
          {num('related')} · {ui.related.kicker}
        </p>
        <h2 id="agent-equipe" class="font-display text-section font-bold text-ink" data-rv>
          {ui.related.title}
        </h2>
      </div>
      <div data-rv>
        <AgentCards slugs={p.related} locale={locale} />
      </div>
      <p data-rv>
        <a href={`${routes.home[locale]}#cas-clients`} class="lien">{ui.allCases} →</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="agent-cta" class="bg-cream-2 py-20 md:py-28" data-rv-groupe>
    <div class:list={[wrap, 'flex flex-col items-start gap-5 md:items-center md:text-center']}>
      <h2 id="agent-cta" class="font-display text-section font-bold text-ink" data-rv>
        {fill(ui.cta.title, vars)}
      </h2>
      <p class="max-w-[36rem] text-body text-soft" data-rv>{fill(ui.cta.text, vars)}</p>
      <div data-rv>
        <Button href={routes.demo[locale]} size="lg">{t('cta.demo')}</Button>
      </div>
      <p class="mt-8 font-mono text-source text-soft uppercase">
        <time datetime={p.updated}>{fill(ui.updated, { date: longDate(p.updated, locale) })}</time>
      </p>
    </div>
  </section>
</Base>

<style>
  /* H1 a notch under text-h1: the job, in the customer's words, runs longer than a slogan. */
  .titre {
    max-width: 20ch;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .fil {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 3px;
    transition: color 0.3s var(--ease-doux);
  }
  .fil:hover {
    color: var(--color-ink);
  }
  .lien {
    font-weight: 600;
    color: var(--color-orange-txt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lien:hover {
    color: var(--color-orange-hover);
  }

  /* The request from the field, then the agent's answer under it. */
  .demande {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-glass);
    background: var(--color-surface);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      var(--shadow-2);
  }
  .reponse {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 10px;
    padding: 16px;
    border-radius: var(--radius-card);
    background: var(--color-orange-tint);
  }

  /* Actions: index in the pixel font, a bold title then its line, rows separated by rules. */
  .points li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    padding: 16px 0;
    border-top: 1px solid var(--color-line-night);
    font: 400 16px/1.5 var(--font-sans);
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
  }
  .points li b {
    display: block;
    margin-bottom: 2px;
    font: 700 17px/1.3 var(--font-sans);
    color: var(--color-white);
  }
  .rang {
    padding-top: 2px;
    font: 400 13px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-white) 60%, transparent);
  }

  /* The demo screen: an iPad fills the column; a phone sits right, its head-office notification
     (DemoSuivi) beside it on the left (over its bottom edge on phones). */
  .vitrine {
    width: 100%;
    max-width: 680px;
    justify-self: center;
  }
  .vitrine-tel {
    width: 300px;
    justify-self: end;
    margin-right: clamp(0px, 4vw, 48px);
  }
  @media (max-width: 47.99rem) {
    .vitrine-tel {
      width: min(260px, 66vw);
      justify-self: center;
      margin-right: 0;
    }
  }

  .outil {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font: 600 15px/1.2 var(--font-sans);
    color: var(--color-ink);
  }

  /* FAQ: each question a ruled row; the answer opens under it (native <details>, no JS). */
  .faq details {
    border-top: 1px solid var(--color-line);
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .faq h3 {
    font: 700 19px/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .faq details p {
    max-width: 40rem;
    padding: 0 48px 22px 0;
    font: 400 17px/1.55 var(--font-sans);
    color: var(--color-soft);
  }
  /* Plus sign that turns into a minus once open. */
  .signe {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-cream-2);
  }
  .signe::before,
  .signe::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    top: 13px;
    height: 2px;
    background: var(--color-ink);
    transition: rotate 0.3s var(--ease-doux);
  }
  .signe::after {
    rotate: 90deg;
  }
  details[open] .signe::after {
    rotate: 0deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .fil,
    .signe::after {
      transition: none;
    }
  }
</style>
