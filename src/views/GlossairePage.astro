---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import Badge from '../components/ressources/Badge.astro';
import Sorties from '../components/ressources/Sorties.astro';
import { piedRessources } from '../components/ressources/pied';
import { BRAND, breadcrumbList, languageTag } from '../seo/jsonld';
import { routes, type Locale } from '../i18n/ui';

/**
 * The glossary (/ressources/glossaire, /en/resources/glossary): every term in alphabetical order,
 * each with its stable anchor (linked from the /ressources preview) and its audience badge.
 * Content: src/content/pages/glossaire/<locale>.yaml.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pied = await piedRessources(locale);
const g = (await getEntry('glossairePage', locale))?.data;
if (!g) throw new Error(`Missing src/content/pages/glossaire/${locale}.yaml`);
const ui = (await getEntry('ressourcesPage', locale))?.data;
if (!ui) throw new Error(`Missing src/content/pages/ressources/${locale}.yaml`);
const termes = [...g.termes].sort((a, b) =>
  a.mot.localeCompare(b.mot, locale, { sensitivity: 'base' }),
);
/** First letter without its accent (É goes under E), so the groups follow the sort. */
const lettreDe = (mot: string) => mot.normalize('NFD').charAt(0).toUpperCase();
const groupes = termes.reduce<{ lettre: string; termes: typeof termes }[]>((acc, x) => {
  const l = lettreDe(x.mot);
  const dernier = acc.at(-1);
  if (dernier?.lettre === l) dernier.termes.push(x);
  else acc.push({ lettre: l, termes: [x] });
  return acc;
}, []);
/** The whole alphabet: letters with no term show, greyed out, so the bar keeps its shape. */
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const presentes = new Set(groupes.map((x) => x.lettre));

const site = Astro.site!;
const url = new URL(routes.glossaire[locale], site).href;
const jsonLd = [
  breadcrumbList(site, [
    { name: BRAND, path: routes.home[locale] },
    { name: ui.guide.retour, path: routes.ressources[locale] },
    { name: g.kicker, path: routes.glossaire[locale] },
  ]),
  {
    '@type': 'DefinedTermSet',
    '@id': `${url}#glossaire`,
    name: g.titre,
    inLanguage: languageTag[locale],
    hasDefinedTerm: termes.map((x) => ({
      '@type': 'DefinedTerm',
      '@id': `${url}#${x.ancre}`,
      name: x.mot,
      description: x.definition,
    })),
  },
];
---

<Base
  locale={locale}
  paths={routes.glossaire}
  title={g.seo.title}
  description={g.seo.description}
  nav="accueil"
  piedEpure
  pied={pied}
  jsonLd={jsonLd}
>
  <!-- The same reading layout as a guide: the text column centred, the A-Z index on its left from
       1024 px, staying in view; above it on smaller screens, as a strip under the nav. -->
  <Section rythme="bas" class="pt-32 lg:pt-40">
    <div class="lecture">
      <header class="col-texte flex flex-col items-start gap-5">
        <a href={routes.ressources[locale]} class="retour text-caption font-semibold text-soft">
          <span aria-hidden="true">←</span>
          {ui.guide.retour}
        </a>
        <h1 class="font-display text-h1 font-semibold text-balance">{g.titre}</h1>
        <p class="text-punch text-soft">{g.chapeau}</p>
      </header>

      <nav aria-label={g.lettres} class="lettres">
        <ul>
          {
            alphabet.map((l) => (
              <li>
                {presentes.has(l) ? (
                  <a href={`#lettre-${l}`} class="lettre">
                    {l}
                  </a>
                ) : (
                  <span class="lettre vide" aria-hidden="true">
                    {l}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="col-texte">
        {
          groupes.map((gr) => (
            <section id={`lettre-${gr.lettre}`} class="groupe" aria-labelledby={`t-${gr.lettre}`}>
              <h2
                id={`t-${gr.lettre}`}
                class="font-display text-section font-semibold text-orange-txt"
              >
                {gr.lettre}
              </h2>
              <dl class="mt-2">
                {gr.termes.map((x) => (
                  <div id={x.ancre} class="terme">
                    <dt class="flex flex-wrap items-center gap-3">
                      <a href={`#${x.ancre}`} class="font-display text-card font-semibold">
                        {x.mot}
                      </a>
                      <Badge locale={locale} public={x.public} />
                    </dt>
                    <dd class="mt-2 text-soft">{x.definition}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
      </div>
    </div>
  </Section>

  <Section rythme="bas">
    <Sorties locale={locale} public="tous" />
  </Section>
</Base>

<style>
  .lecture {
    display: grid;
    grid-template-columns: minmax(0, var(--container-prose));
    justify-content: center;
  }
  .col-texte {
    grid-column: 1;
  }
  /* The index: a strip under the nav on small screens, a column of its own from 1024 px. */
  .lettres {
    position: sticky;
    /* exception: just under the floating nav */
    top: 5rem;
    z-index: 10;
    margin-top: 2.5rem;
    padding: 0.5rem 0;
    background: var(--color-cream);
  }
  .lettres ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  @media (width >= 64rem) {
    .lecture {
      /* exception: the index column, the same as a guide's contents */
      grid-template-columns: 14rem minmax(0, var(--container-prose)) 14rem;
      column-gap: 3rem;
    }
    .col-texte {
      grid-column: 2;
    }
    .lettres {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      top: 7rem;
      margin-top: 2rem;
      padding: 0;
      background: none;
    }
    .lettres ul {
      display: grid;
      grid-template-columns: repeat(6, 2rem);
    }
  }
  .lettre {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-ink);
    transition:
      background-color 0.2s var(--ease-hatch),
      color 0.2s var(--ease-hatch);
  }
  a.lettre:hover {
    background: var(--color-orange-tint);
    color: var(--color-orange-txt);
  }
  a.lettre:focus-visible,
  .terme a:focus-visible,
  .retour:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .lettre.vide {
    color: var(--color-line);
  }
  .groupe {
    padding-top: 2.5rem;
    scroll-margin-top: 8.5rem;
  }
  .terme {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 8.5rem;
  }
  /* The term reached by a link: a soft tint the width of the column. */
  .terme:target {
    background: var(--color-orange-tint);
    box-shadow:
      -1rem 0 0 var(--color-orange-tint),
      1rem 0 0 var(--color-orange-tint);
  }
  .terme a:hover,
  .retour:hover {
    color: var(--color-orange-txt);
  }
  @media (prefers-reduced-motion: reduce) {
    .lettre {
      transition: none;
    }
  }
</style>
