---
/**
 * The home page (/, /en): the crossroads of the site. A banner saying what Hatch OS does (a
 * sentence whose ending rotates, with the agent doing that job), then two doors side by side:
 * independent restaurant (Robin) and network (the agents), then the Security block.
 * Shared by src/pages/index.astro (FR) and src/pages/en/index.astro (EN).
 */
import { getEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import SecuriteLivre from '../components/sections/SecuriteLivre.astro';
import { section } from '../content/section';
import { routes, type Locale } from '../i18n/ui';
import { webSite } from '../seo/jsonld';
import oeuf from '../assets/robin/independant.jpg';
import reseau from '../assets/tarifs/reseau-flotte.jpg';
import peep from '../assets/portraits/peep.jpg';
import pecker from '../assets/portraits/pecker.jpg';
import finch from '../assets/portraits/finch.jpg';
import jay from '../assets/portraits/jay.jpg';
import sparrow from '../assets/portraits/sparrow.jpg';
import owl from '../assets/portraits/owl.jpg';
import lark from '../assets/portraits/lark.jpg';
import robin from '../assets/portraits/robin.jpg';
// 3D icon at the end of the sentence, like muse.ai: Microsoft Fluent Emoji 3D (MIT licence).
import emPeep from '../assets/emojis/peep.png';
import emOwl from '../assets/emojis/owl.png';
import emJay from '../assets/emojis/jay.png';
import emLark from '../assets/emojis/lark.png';
import emFinch from '../assets/emojis/finch.png';
import emPecker from '../assets/emojis/pecker.png';
import emSparrow from '../assets/emojis/sparrow.png';
import emRobin from '../assets/emojis/robin.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = await getEntry('home', locale);
if (!home) throw new Error(`Missing src/content/home/${locale}.yaml`);
const { seo } = home.data;
const { titre, mots: taches, lead, espaces } = await section('accueil', locale);

type Agent = (typeof taches)[number]['agent'];
const AGENTS: Record<Agent, { portrait: ImageMetadata; emoji: ImageMetadata }> = {
  peep: { portrait: peep, emoji: emPeep },
  owl: { portrait: owl, emoji: emOwl },
  jay: { portrait: jay, emoji: emJay },
  lark: { portrait: lark, emoji: emLark },
  finch: { portrait: finch, emoji: emFinch },
  pecker: { portrait: pecker, emoji: emPecker },
  sparrow: { portrait: sparrow, emoji: emSparrow },
  robin: { portrait: robin, emoji: emRobin },
};
// Each agent's avatar is its video loop (public/anim), the portrait as poster.
const mots = taches.map((m) => ({
  texte: m.texte,
  agent: m.agent.charAt(0).toUpperCase() + m.agent.slice(1),
  img: AGENTS[m.agent].portrait,
  emoji: AGENTS[m.agent].emoji,
  video: `/anim/${m.agent}.mp4`,
}));
// Start of the sentence, before the rotating ending (also the screen-reader text).
const prefixe = `${titre.debut} ${titre.liaison} `;

const site = Astro.site!;
// Anchors of the former one-page home, now on the networks page.
const anciennesAncres = [
  'agents',
  'cas-clients',
  'tarifs',
  'demo',
  'equipe',
  'mise-en-place',
  'probleme',
  'clients',
];
const reseauxUrl = routes.reseaux[locale];
---

<Base
  locale={locale}
  paths={routes.home}
  title={seo.title}
  description={seo.description}
  nav="accueil"
  navTone="night"
  jsonLd={[webSite(site, locale, routes.home[locale], seo.description)]}
>
  <!-- 1 · The banner: what Hatch OS does -->
  <!-- Just the text, muse.ai style: no frame, no image, one big centred sentence. -->
  <section
    class="hero-noir flex flex-col items-center gap-4 bg-night px-4 pt-36 pb-20 text-center sm:px-6 lg:pt-44 lg:pb-28"
    aria-labelledby="accueil-titre"
  >
    <!-- muse.ai's "rebus" title: line 1 with the avatar in a circle, line 2 the sentence ending
         that changes word by word. The avatar changes with it: it is the agent doing that job. -->
    <h1
      id="accueil-titre"
      class="rebus w-full font-display text-[30px] leading-[1.08] font-medium tracking-[-0.015em] sm:text-[38px] lg:text-[clamp(38px,3.2vw,46px)] text-cream"
      data-rebus
      data-prefixe={prefixe}
    >
      <span class="sr-only">{prefixe}{mots[0].texte}</span>
      <span class="ligne" aria-hidden="true">
        {titre.debut}<span class="avatars" data-avatars>
          {
            mots.map((m, i) => (
              <span class:list={['av', i === 0 && 'on']} title={m.agent}>
                <video
                  class="av-img portrait"
                  src={m.video}
                  poster={m.img.src}
                  autoplay
                  muted
                  loop
                  playsinline
                />
              </span>
            ))
          }
        </span>{titre.liaison}
      </span>
      <span class="ligne phrases" aria-hidden="true">
        {
          mots.map((m, i) => (
            <span class:list={['ph', i === 0 && 'on']}>
              {m.texte.split(' ').map((w, j) => (
                <>
                  <span class="w" style={`--i:${j}`}>
                    {w}
                  </span>{' '}
                </>
              ))}
              <span class="w icone" style={`--i:${m.texte.split(' ').length}`}>
                <Image src={m.emoji} alt="" width={128} densities={[1, 2]} class="icone-img" />
              </span>
            </span>
          ))
        }
      </span>
    </h1>
    <p class="max-w-[440px] text-[12px] leading-5 text-white lg:text-[13px] lg:leading-5">
      {lead}
    </p>
  </section>

  <main class="mx-auto flex max-w-[1360px] flex-col gap-4 px-4 pt-6 pb-16 sm:px-6 lg:gap-5 lg:pt-8">
    <!-- 2 · The two doors -->
    <div class="grid gap-4 md:grid-cols-2 lg:gap-5">
      <!-- Independent → Robin -->
      <a
        href={routes.robin[locale]}
        class="group flex flex-col overflow-hidden rounded-[28px] bg-surface shadow-1 ring-1 ring-line transition hover:-translate-y-1 hover:shadow-2 lg:rounded-[36px]"
      >
        <div class="relative aspect-[16/10] overflow-hidden">
          <Picture
            src={oeuf}
            alt={espaces.independant.alt}
            widths={[600, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={['avif', 'webp']}
            class="size-full object-cover transition duration-700 group-hover:scale-[1.03]"
          />
        </div>
        <div class="flex flex-1 flex-col gap-3 px-6 pt-6 pb-7 lg:px-9 lg:pt-8 lg:pb-9">
          <span class="font-mono text-[12px] tracking-[0.16em] text-orange-txt uppercase">
            {espaces.independant.kicker}
          </span>
          <h2 class="font-display text-[28px] leading-[1.1] font-semibold text-ink lg:text-[36px]">
            {espaces.independant.titre}
          </h2>
          <p class="text-[15px] leading-6 text-soft">
            {espaces.independant.texte}
          </p>
          <span class="mt-auto pt-3">
            <span
              class="btn-vif inline-flex items-center gap-2 rounded-full bg-orange px-5 py-3 text-[0.875rem] font-bold text-ink shadow-[0_6px_16px_rgb(248_122_1/0.35)]"
            >
              {espaces.independant.cta}
              <span aria-hidden="true">→</span>
            </span>
          </span>
        </div>
      </a>

      <!-- Network → the networks space -->
      <a
        href={routes.reseaux[locale]}
        class="group flex flex-col overflow-hidden rounded-[28px] bg-night shadow-1 transition hover:-translate-y-1 hover:shadow-2 lg:rounded-[36px]"
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-scene">
          <Picture
            src={reseau}
            alt={espaces.reseau.alt}
            widths={[600, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={['avif', 'webp']}
            class="size-full object-cover transition duration-700 group-hover:scale-[1.03]"
          />
        </div>
        <div class="flex flex-1 flex-col gap-3 px-6 pt-6 pb-7 lg:px-9 lg:pt-8 lg:pb-9">
          <span class="font-mono text-[12px] tracking-[0.16em] text-peach uppercase">
            {espaces.reseau.kicker}
          </span>
          <h2
            class="font-display text-[28px] leading-[1.1] font-semibold text-cream lg:text-[36px]"
          >
            {espaces.reseau.titre}
          </h2>
          <p class="text-[15px] leading-6 text-cream/75">
            {espaces.reseau.texte}
          </p>
          <span class="mt-auto pt-3">
            <span
              class="btn-vif inline-flex items-center gap-2 rounded-full bg-cream px-5 py-3 text-[0.875rem] font-bold text-ink"
            >
              {espaces.reseau.cta}
              <span aria-hidden="true">→</span>
            </span>
          </span>
        </div>
      </a>
    </div>

    <script is:inline data-keep>
      // muse.ai-style "rebus" title. Every 2.8 s: the ending's words exit upwards one after another,
      // the next ending's words come in from below; the agent in the circle changes with it (it
      // hops in). Reduced motion: the first sentence stays, no animation.
      (function () {
        var root = document.querySelector('[data-rebus]');
        if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var ph = [].slice.call(root.querySelectorAll('.ph'));
        var av = [].slice.call(root.querySelectorAll('.av'));
        var sr = root.querySelector('.sr-only');
        var prefixe = root.dataset.prefixe;
        var i = 0;
        setInterval(function () {
          var a = ph[i],
            b = av[i];
          a.classList.remove('on');
          a.classList.add('out');
          b.classList.remove('on');
          b.classList.add('out');
          i = (i + 1) % ph.length;
          ph[i].classList.remove('out');
          ph[i].classList.add('on');
          av[i].classList.remove('out');
          av[i].classList.add('on');
          if (sr) sr.textContent = prefixe + ph[i].textContent.replace(/\s+/g, ' ').trim();
          setTimeout(function () {
            a.classList.remove('out');
            b.classList.remove('out');
          }, 900);
        }, 2800);
      })();
    </script>
  </main>

  <!-- 3 · Security, full width: the orange banner from the Security page, its four themes -->
  <SecuriteLivre locale={locale} />

  <!-- Links to the former one-page home (/#tarifs…): its sections now live on the networks page. -->
  <script is:inline define:vars={{ anciennesAncres, reseauxUrl }}>
    function versReseaux() {
      var ancre = location.hash.slice(1);
      if (anciennesAncres.indexOf(ancre) !== -1 && !document.getElementById(ancre)) {
        location.replace(reseauxUrl + location.hash);
      }
    }
    versReseaux();
    addEventListener('hashchange', versReseaux);
  </script>
</Base>

<style>
  .rebus .ligne {
    display: block;
  }

  /* The avatar, like Muse's: a circle a bit taller than the capitals, thin outline, set in
     the line. All agents stacked in the same cell, only one visible. */
  .avatars {
    position: relative;
    display: inline-grid;
    width: 1.3em;
    height: 1.3em;
    margin: -0.12em 0.19em;
    vertical-align: middle;
    translate: 0 -0.05em;
    border-radius: 999px;
    background: var(--color-cream-2);
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-white) 20%, transparent);
    overflow: hidden;
    cursor: default;
  }
  .av {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    translate: 0 60%;
    scale: 0.7;
    transition:
      opacity 0.3s ease,
      translate 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .av.on {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .av.out {
    opacity: 0;
    translate: 0 -40%;
    scale: 0.85;
    transition-timing-function: ease-in;
    transition-duration: 0.3s;
  }
  .av :global(.av-img) {
    width: 80%;
    height: auto;
    margin-bottom: 6%;
    transform-origin: 50% 100%;
  }
  /* it breathes while shown, it waddles on hover (Muse's "working") */
  /* Muse-style portrait (cream background, agent facing forward filling the circle): full cell. */
  .av :global(.av-img.portrait) {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    /* the agent a bit smaller in its circle, anchored at the bottom */
    scale: 0.9;
    transform-origin: 50% 100%;
  }
  .av.on :global(.av-img) {
    animation: respire 2.2s 0.6s ease-in-out infinite;
  }
  .avatars:hover .av.on :global(.av-img) {
    animation: dandine 0.7s ease-in-out infinite;
  }
  @keyframes respire {
    0%,
    100% {
      transform: scale(1, 1);
    }
    50% {
      transform: scale(1.04, 0.96);
    }
  }
  @keyframes dandine {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-8deg) translateY(-3%);
    }
    75% {
      transform: rotate(8deg) translateY(-3%);
    }
  }

  /* The sentence endings: all stacked in the same cell (its height is the longest one's),
     word by word. Exit upwards, enter from below, staggered 45 ms per word.
     The changing ending: bold, italic (Fraunces' true italic) and brand orange. */
  .rebus .phrases {
    display: grid;
    justify-items: center;
    font-weight: 700;
    font-style: italic;
    /* on night, the bright brand orange is legible (6.6:1) */
    color: var(--color-orange);
  }
  .ph {
    grid-area: 1 / 1;
    place-self: start center;
    max-width: 100%;
  }
  .w {
    display: inline-block;
    opacity: 0;
    translate: 0 0.3em;
    transition:
      opacity 0.35s ease,
      translate 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 45ms);
  }
  .ph.on .w {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(180ms + var(--i) * 45ms);
  }
  /* The 3D icon at the end of the sentence (muse.ai: 1em, set slightly below the baseline). */
  .icone {
    /* aligned like muse.ai: a 1em box centred on the x-height */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1em;
    vertical-align: -0.14em;
    padding-inline: 0.08em;
  }
  .icone :global(.icone-img) {
    display: block;
    width: 1.05em;
    height: 1.05em;
    object-fit: contain;
  }
  .ph.out .w {
    opacity: 0;
    translate: 0 -0.3em;
    transition-timing-function: ease-in;
  }

  @media (prefers-reduced-motion: reduce) {
    .av,
    .w {
      transition: none;
    }
    .av.on :global(.av-img),
    .avatars:hover .av.on :global(.av-img) {
      animation: none;
    }
  }
</style>
