---
/**
 * The home page (/, /en): the crossroads of the site. A banner saying what Hatch OS does (a
 * sentence whose ending rotates, with the agent doing that job), then two doors side by side:
 * independent restaurant (Robin) and network (the agents), then the Security block.
 * Shared by src/pages/index.astro (FR) and src/pages/en/index.astro (EN).
 */
import { getEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import SecuriteBandeau from '../components/sections/SecuriteBandeau.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import { section } from '../content/section';
import { routes, type Locale } from '../i18n/ui';
import { webSite } from '../seo/jsonld';
import Conteneur from '../components/layout/Conteneur.astro';
import LisierePixel from '../components/ui/LisierePixel.astro';
import grain from '../assets/hero/grain.png';
import oeuf from '../assets/robin/independant.jpg';
import reseau from '../assets/tarifs/reseau-flotte.jpg';
import peep from '../assets/portraits/peep.jpg';
import pecker from '../assets/portraits/pecker.jpg';
import finch from '../assets/portraits/finch.jpg';
import jay from '../assets/portraits/jay.jpg';
import sparrow from '../assets/portraits/sparrow.jpg';
import owl from '../assets/portraits/owl.jpg';
import lark from '../assets/portraits/lark.jpg';
import robin from '../assets/portraits/robin.jpg';
// 3D icon at the end of the sentence, like muse.ai: Microsoft Fluent Emoji 3D (MIT licence).
import emPeep from '../assets/emojis/peep.png';
import emOwl from '../assets/emojis/owl.png';
import emJay from '../assets/emojis/jay.png';
import emLark from '../assets/emojis/lark.png';
import emFinch from '../assets/emojis/finch.png';
import emPecker from '../assets/emojis/pecker.png';
import emSparrow from '../assets/emojis/sparrow.png';
import emRobin from '../assets/emojis/robin.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = await getEntry('home', locale);
if (!home) throw new Error(`Missing src/content/home/${locale}.yaml`);
const { seo } = home.data;
const { titre, mots: taches, lead, espaces, activite, equipe } = await section('accueil', locale);

type Agent = (typeof taches)[number]['agent'];
const AGENTS: Record<Agent, { portrait: ImageMetadata; emoji: ImageMetadata }> = {
  peep: { portrait: peep, emoji: emPeep },
  owl: { portrait: owl, emoji: emOwl },
  jay: { portrait: jay, emoji: emJay },
  lark: { portrait: lark, emoji: emLark },
  finch: { portrait: finch, emoji: emFinch },
  pecker: { portrait: pecker, emoji: emPecker },
  sparrow: { portrait: sparrow, emoji: emSparrow },
  robin: { portrait: robin, emoji: emRobin },
};
// Each agent's avatar is its video loop (public/anim), the portrait as poster.
const mots = taches.map((m) => ({
  texte: m.texte,
  agent: m.agent.charAt(0).toUpperCase() + m.agent.slice(1),
  img: AGENTS[m.agent].portrait,
  emoji: AGENTS[m.agent].emoji,
  video: `/anim/${m.agent}.mp4`,
}));
// Start of the sentence, before the rotating ending (also the screen-reader text).
const prefixe = `${titre.debut} ${titre.liaison} `;

const site = Astro.site!;
// Anchors of the former one-page home, now on the networks page.
const anciennesAncres = [
  'agents',
  'cas-clients',
  'tarifs',
  'demo',
  'equipe',
  'mise-en-place',
  'probleme',
  'clients',
];
const reseauxUrl = routes.reseaux[locale];
---

<Base
  locale={locale}
  paths={routes.home}
  title={seo.title}
  description={seo.description}
  nav="accueil"
  navTone="night"
  jsonLd={[webSite(site, locale, routes.home[locale], seo.description)]}
>
  <!-- 1 · The banner: what Hatch OS does -->
  <!-- Just the text, muse.ai style: no frame, no image, one big centred sentence. -->
  <!-- Signature section: grain on the night, a pixel edge into the doors, the agents' row and a live
       activity line. exception: 82svh tall, top padding clears the floating nav. -->
  <Section
    ton="night"
    rythme="aucun"
    pleine
    class="hero-noir relative flex min-h-[82svh] flex-col overflow-hidden"
    aria-labelledby="accueil-titre"
    data-nav-fond="sombre"
  >
    <div class="hero-grain" aria-hidden="true" style={`background-image:url(${grain.src})`}></div>
    <Conteneur
      class="relative z-1 flex flex-1 flex-col items-center justify-center gap-6 pt-32 pb-24 text-center lg:pt-40 lg:pb-28"
    >
      <!-- muse.ai's "rebus" title: line 1 with the avatar in a circle, line 2 the sentence ending
         that changes word by word. The avatar changes with it: it is the agent doing that job. -->
      <h1
        id="accueil-titre"
        class="entree rebus w-full font-display text-h1 font-semibold text-cream"
        style="--d:1"
        data-rebus
        data-prefixe={prefixe}
      >
        <span class="sr-only">{prefixe}{mots[0].texte}</span>
        <span class="ligne" aria-hidden="true">
          {titre.debut}<span class="avatars" data-avatars>
            {
              mots.map((m, i) => (
                <span class:list={['av', i === 0 && 'on']} title={m.agent}>
                  <video
                    class="av-img portrait"
                    src={m.video}
                    poster={m.img.src}
                    autoplay
                    muted
                    loop
                    playsinline
                  />
                </span>
              ))
            }
          </span>{titre.liaison}
        </span>
        <span class="ligne phrases" aria-hidden="true">
          {
            mots.map((m, i) => (
              <span class:list={['ph', i === 0 && 'on']}>
                {m.texte.split(' ').map((w, j) => (
                  <>
                    <span class="w" style={`--i:${j}`}>
                      {w}
                    </span>{' '}
                  </>
                ))}
                <span class="w icone" style={`--i:${m.texte.split(' ').length}`}>
                  <Image src={m.emoji} alt="" width={128} densities={[1, 2]} class="icone-img" />
                </span>
              </span>
            ))
          }
        </span>
      </h1>
      <p class="entree max-w-lead text-punch text-(--doux)" style="--d:2">
        {lead}
      </p>

      <!-- The team: the agent named in the title lights up -->
      <ul class="entree equipe mt-4" style="--d:3" aria-label={equipe} data-equipe>
        {
          mots.map((m, i) => (
            <li class:list={['eq', i === 0 && 'on']} data-j={i}>
              <Image src={m.img} alt="" width={48} densities={[1, 2]} class="eq-img" />
              <span class="eq-nom">{m.agent}</span>
            </li>
          ))
        }
      </ul>

      <!-- Live activity, one event at a time (BunBun, the fictive network) -->
      <ol class="entree activite" style="--d:4" aria-label={activite.label} data-activite>
        {
          activite.lignes.map((l, i) => (
            <li class:list={['act', i === 0 && 'on']}>
              <span class="act-point" aria-hidden="true" />
              <span>
                <span class="act-nom">{l.agent.charAt(0).toUpperCase() + l.agent.slice(1)}</span>{' '}
                {l.texte}
              </span>
            </li>
          ))
        }
      </ol>
    </Conteneur>

    <div class="absolute inset-x-0 bottom-0 z-1">
      <LisierePixel color="var(--color-cream)" />
    </div>
  </Section>

  <!-- 2 · The two doors -->
  <Section ton="cream">
    <div class="grid gap-5 md:grid-cols-2">
      <!-- Independent → Robin -->
      <a
        href={routes.robin[locale]}
        class="group flex flex-col overflow-hidden rounded-card bg-surface shadow-1 ring-1 ring-line transition hover:-translate-y-1 hover:shadow-2"
      >
        <div class="relative aspect-[16/10] overflow-hidden">
          <Picture
            src={oeuf}
            alt={espaces.independant.alt}
            widths={[600, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={['avif', 'webp']}
            class="size-full object-cover transition duration-700 group-hover:scale-[1.03]"
          />
        </div>
        <div class="flex flex-1 flex-col gap-4 p-6 lg:p-9">
          <span class="font-mono text-kicker text-orange-txt uppercase">
            {espaces.independant.kicker}
          </span>
          <h2 class="font-display text-section font-semibold text-ink">
            {espaces.independant.titre}
          </h2>
          <p class="text-body text-soft">
            {espaces.independant.texte}
          </p>
          <span class="mt-auto pt-3">
            <Button variant="orange">{espaces.independant.cta}</Button>
          </span>
        </div>
      </a>

      <!-- Network → the networks space -->
      <a
        href={routes.reseaux[locale]}
        class="group flex flex-col overflow-hidden rounded-card bg-night shadow-1 transition hover:-translate-y-1 hover:shadow-2"
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-scene">
          <Picture
            src={reseau}
            alt={espaces.reseau.alt}
            widths={[600, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={['avif', 'webp']}
            class="size-full object-cover transition duration-700 group-hover:scale-[1.03]"
          />
        </div>
        <div class="flex flex-1 flex-col gap-4 p-6 lg:p-9">
          <span class="font-mono text-kicker text-peach uppercase">
            {espaces.reseau.kicker}
          </span>
          <h2 class="font-display text-section font-semibold text-cream">
            {espaces.reseau.titre}
          </h2>
          <p class="text-body text-cream/75">
            {espaces.reseau.texte}
          </p>
          <span class="mt-auto pt-3">
            <Button variant="cream">{espaces.reseau.cta}</Button>
          </span>
        </div>
      </a>
    </div>
  </Section>

  <script is:inline data-keep>
    // muse.ai-style "rebus" title. Every 2.8 s: the ending's words exit upwards one after another,
    // the next ending's words come in from below; the agent in the circle changes with it (it
    // hops in). Reduced motion: the first sentence stays, no animation.
    (function () {
      var root = document.querySelector('[data-rebus]');
      if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var ph = [].slice.call(root.querySelectorAll('.ph'));
      var av = [].slice.call(root.querySelectorAll('.av'));
      var sr = root.querySelector('.sr-only');
      var prefixe = root.dataset.prefixe;
      var eq = [].slice.call(document.querySelectorAll('[data-equipe] .eq'));
      var i = 0;
      setInterval(function () {
        var a = ph[i],
          b = av[i];
        a.classList.remove('on');
        a.classList.add('out');
        b.classList.remove('on');
        b.classList.add('out');
        i = (i + 1) % ph.length;
        ph[i].classList.remove('out');
        ph[i].classList.add('on');
        av[i].classList.remove('out');
        av[i].classList.add('on');
        if (sr) sr.textContent = prefixe + ph[i].textContent.replace(/\s+/g, ' ').trim();
        eq.forEach(function (e, k) {
          e.classList.toggle('on', k === i);
        });
        setTimeout(function () {
          a.classList.remove('out');
          b.classList.remove('out');
        }, 900);
      }, 2800);
    })();
  </script>

  <script is:inline data-keep>
    // The activity line: one event every 3.6 s, the previous one slides up and out.
    // Reduced motion: the first event stays.
    (function () {
      var li = [].slice.call(document.querySelectorAll('[data-activite] .act'));
      if (li.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var k = 0;
      setInterval(function () {
        li[k].classList.remove('on');
        k = (k + 1) % li.length;
        li[k].classList.add('on');
      }, 3600);
    })();
  </script>

  <!-- 3 · Security: a compact band, the four promises and a link to the full page -->
  <SecuriteBandeau locale={locale} />

  <!-- Links to the former one-page home (/#tarifs…): its sections now live on the networks page. -->
  <script is:inline define:vars={{ anciennesAncres, reseauxUrl }}>
    function versReseaux() {
      var ancre = location.hash.slice(1);
      if (anciennesAncres.indexOf(ancre) !== -1 && !document.getElementById(ancre)) {
        location.replace(reseauxUrl + location.hash);
      }
    }
    versReseaux();
    addEventListener('hashchange', versReseaux);
  </script>
</Base>

<style>
  /* Film grain over the night: a material, not a gradient. */
  .hero-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-size: 128px 128px;
    mix-blend-mode: screen;
    opacity: 0.06;
  }

  /* Entrance, once: title, lead, team, activity fade up in turn. */
  .entree {
    animation: entree 0.7s var(--ease-hatch) both;
    animation-delay: calc(var(--d, 0) * 110ms);
  }
  @keyframes entree {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  /* The team row: 8 small portraits, the one named in the title lit, the others dimmed. */
  .equipe {
    display: flex;
    gap: 10px;
  }
  .eq {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .eq :global(.eq-img) {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-cream-2);
    opacity: 0.55;
    filter: saturate(0.85);
    transition:
      opacity 0.4s var(--ease-hatch),
      filter 0.4s var(--ease-hatch),
      translate 0.4s var(--ease-hatch);
  }
  .eq.on :global(.eq-img),
  .eq:hover :global(.eq-img) {
    opacity: 1;
    filter: none;
    translate: 0 -3px;
  }
  .eq-nom {
    position: absolute;
    top: calc(100% + 8px);
    font: 400 var(--text-source) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-cream) 60%, transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .eq.on .eq-nom,
  .eq:hover .eq-nom {
    opacity: 1;
  }

  /* The activity line: Departure Mono, one event shown, a breathing orange dot. */
  .activite {
    display: grid;
    margin-top: 28px;
    font: 400 var(--text-kicker) / 1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-cream) 70%, transparent);
  }
  .act {
    grid-area: 1 / 1;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    text-wrap: balance;
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.5s var(--ease-hatch),
      translate 0.5s var(--ease-hatch);
  }
  .act.on {
    opacity: 1;
    translate: 0 0;
  }
  .act-nom {
    color: var(--color-cream);
  }
  .act-point {
    position: relative;
    flex: none;
    translate: 0 -1px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .act-point::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-orange);
    animation: point 2.4s ease-out infinite;
  }
  @keyframes point {
    70%,
    100% {
      scale: 2.6;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entree,
    .act-point::after {
      animation: none;
    }
    .act,
    .eq :global(.eq-img) {
      transition: none;
    }
  }

  .rebus .ligne {
    display: block;
  }

  /* The avatar, like Muse's: a circle a bit taller than the capitals, thin outline, set in
     the line. All agents stacked in the same cell, only one visible. */
  .avatars {
    position: relative;
    display: inline-grid;
    width: 1.3em;
    height: 1.3em;
    margin: -0.12em 0.19em;
    vertical-align: middle;
    translate: 0 -0.05em;
    border-radius: 999px;
    background: var(--color-cream-2);
    box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--color-white) 20%, transparent);
    overflow: hidden;
    cursor: default;
  }
  .av {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    translate: 0 60%;
    scale: 0.7;
    transition:
      opacity 0.3s ease,
      translate 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .av.on {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .av.out {
    opacity: 0;
    translate: 0 -40%;
    scale: 0.85;
    transition-timing-function: ease-in;
    transition-duration: 0.3s;
  }
  .av :global(.av-img) {
    width: 80%;
    height: auto;
    margin-bottom: 6%;
    transform-origin: 50% 100%;
  }
  /* it breathes while shown, it waddles on hover (Muse's "working") */
  /* Muse-style portrait (cream background, agent facing forward filling the circle): full cell. */
  .av :global(.av-img.portrait) {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    /* the agent a bit smaller in its circle, anchored at the bottom */
    scale: 0.9;
    transform-origin: 50% 100%;
  }
  .av.on :global(.av-img) {
    animation: respire 2.2s 0.6s ease-in-out infinite;
  }
  .avatars:hover .av.on :global(.av-img) {
    animation: dandine 0.7s ease-in-out infinite;
  }
  @keyframes respire {
    0%,
    100% {
      transform: scale(1, 1);
    }
    50% {
      transform: scale(1.04, 0.96);
    }
  }
  @keyframes dandine {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-8deg) translateY(-3%);
    }
    75% {
      transform: rotate(8deg) translateY(-3%);
    }
  }

  /* The sentence endings: all stacked in the same cell (its height is the longest one's),
     word by word. Exit upwards, enter from below, staggered 45 ms per word.
     The changing ending: bold, italic (Fraunces' true italic) and brand orange. */
  .rebus .phrases {
    display: grid;
    justify-items: center;
    font-weight: 700;
    font-style: italic;
    /* on night, the bright brand orange is legible (6.6:1) */
    color: var(--color-orange);
  }
  .ph {
    grid-area: 1 / 1;
    place-self: start center;
    max-width: 100%;
  }
  .w {
    display: inline-block;
    opacity: 0;
    translate: 0 0.3em;
    transition:
      opacity 0.35s ease,
      translate 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 45ms);
  }
  .ph.on .w {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(180ms + var(--i) * 45ms);
  }
  /* The 3D icon at the end of the sentence (muse.ai: 1em, set slightly below the baseline). */
  .icone {
    /* aligned like muse.ai: a 1em box centred on the x-height */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1em;
    vertical-align: -0.14em;
    padding-inline: 0.08em;
  }
  .icone :global(.icone-img) {
    display: block;
    width: 1.05em;
    height: 1.05em;
    object-fit: contain;
  }
  .ph.out .w {
    opacity: 0;
    translate: 0 -0.3em;
    transition-timing-function: ease-in;
  }

  @media (prefers-reduced-motion: reduce) {
    .av,
    .w {
      transition: none;
    }
    .av.on :global(.av-img),
    .avatars:hover .av.on :global(.av-img) {
      animation: none;
    }
  }
</style>
