---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { routes, useTranslations, type Locale } from '../i18n/ui';

/** The home page, shared by src/pages/index.astro (FR) and src/pages/en/index.astro (EN). */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = await getEntry('home', locale);
if (!home) throw new Error(`Missing src/content/home/${locale}.yaml`);
const { seo, hero } = home.data;
---

<Base locale={locale} route="home" title={seo.title} description={seo.description}>
  <section
    class="mx-auto flex min-h-dvh max-w-site flex-col justify-center gap-6 px-6 pt-32 pb-20 md:px-8"
  >
    <h1 class="max-w-4xl font-mono text-h1">{hero.h1}</h1>
    <p class="max-w-prose text-body text-soft">{hero.lead}</p>
    <div>
      <Button href={routes.demo[locale]}>{t('cta.demo')}</Button>
    </div>
  </section>
</Base>
