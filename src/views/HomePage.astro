---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Clients from '../components/sections/Clients.astro';
import Probleme from '../components/sections/Probleme.astro';
import Demo from '../components/sections/Demo.astro';
import Equipe from '../components/sections/Equipe.astro';
import Cas from '../components/sections/Cas.astro';
import MiseEnPlace from '../components/sections/MiseEnPlace.astro';
import Securite from '../components/sections/Securite.astro';
import Tarifs from '../components/sections/Tarifs.astro';
import { routes, type Locale } from '../i18n/ui';

/** The home page, shared by src/pages/index.astro (FR) and src/pages/en/index.astro (EN). Order = v4 prototype. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = await getEntry('home', locale);
if (!home) throw new Error(`Missing src/content/home/${locale}.yaml`);
const { seo } = home.data;
---

<Base locale={locale} paths={routes.home} title={seo.title} description={seo.description}>
  <Hero locale={locale} />
  <Clients locale={locale} />
  <Probleme locale={locale} />
  <Demo locale={locale} />
  <Equipe locale={locale} />
  <Cas locale={locale} />
  <MiseEnPlace locale={locale} />
  <Securite locale={locale} />
  <Tarifs locale={locale} />
</Base>
