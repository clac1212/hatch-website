---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import Carte from '../components/ui/Carte.astro';
import Badge from '../components/ressources/Badge.astro';
import Sorties from '../components/ressources/Sorties.astro';
import { piedRessources } from '../components/ressources/pied';
import { avatars } from '../components/pages/agent-visuels';
import { centres } from '../components/agents/visuels';
import { fill, longDate } from '../components/pages/format';
import { BRAND, breadcrumbList, languageTag, organizationId } from '../seo/jsonld';
import { entryRoutes, routes, type Locale } from '../i18n/ui';
import { guideSlug, publishedGuides } from '../content/pages/guides';

/**
 * A guide of /ressources (/ressources/<slug>, /en/resources/<slug>): kicker, H1 in Departure Mono
 * (the general rule, no exception here), chapeau, the cover, « L'essentiel » and the table of
 * contents (its ## headings), the Markdown body (a blockquote opening on a bold line is the agent's
 * box), its FAQ as <details>, its
 * sources, a card per agent it names, three related guides, then the way out matching its audience (the demo for
 * networks, the Robin waitlist for independents, both for everyone).
 * Content: src/content/ressources/<locale>/<slug>.md; shared labels: `guide` of
 * src/content/pages/ressources/<locale>.yaml.
 */
interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const pied = await piedRessources(locale);
const entry = await getEntry('ressources', `${locale}/${slug}`);
if (!entry) throw new Error(`Missing src/content/ressources/${locale}/${slug}.md`);
const ui = (await getEntry('ressourcesPage', locale))?.data;
if (!ui) throw new Error(`Missing src/content/pages/ressources/${locale}.yaml`);
const { Content, headings } = await render(entry);
/** Table of contents: the body's ## headings. */
const sommaire = headings.filter((h) => h.depth === 2);
const g = entry.data;
const l = ui.guide;
const paths = entryRoutes.guides(slug);

/** The agents it names, with their page once published. */
const agents = await Promise.all(
  (g.agents ?? []).map(async (a) => {
    const e = await getEntry('agents', `${locale}/${a}`);
    if (!e) throw new Error(`Missing src/content/agents/${locale}/${a}.md`);
    const publiee = !!e.data.page && !e.data.page.brouillon;
    return {
      slug: a,
      name: e.data.name,
      job: e.data.job,
      pitch: e.data.pitch,
      href: publiee ? entryRoutes.agents(a)[locale] : undefined,
    };
  }),
);

/** Three guides to read next: same audience (or everyone) first, then the most recent. */
const lies = (await publishedGuides(locale))
  .filter((x) => guideSlug(x.id) !== slug)
  .sort((a, b) => {
    const proche = (x: typeof a) =>
      x.data.public === g.public || x.data.public === 'tous' ? 0 : 1;
    return proche(a) - proche(b);
  })
  .slice(0, 3)
  .map((x) => ({ ...x.data, href: entryRoutes.guides(guideSlug(x.id))[locale] }));

const site = Astro.site!;
const url = new URL(paths[locale], site).href;
const jsonLd = [
  breadcrumbList(site, [
    { name: BRAND, path: routes.home[locale] },
    { name: l.retour, path: routes.ressources[locale] },
    { name: g.title, path: paths[locale] },
  ]),
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    mainEntityOfPage: url,
    headline: g.title,
    description: g.description,
    inLanguage: languageTag[locale],
    dateModified: g.updatedAt,
    image: new URL(g.image.src, site).href,
    author: { '@id': organizationId(site) },
    publisher: { '@id': organizationId(site) },
  },
  ...(g.faq.length > 0
    ? [
        {
          '@type': 'FAQPage',
          '@id': `${url}#faq`,
          mainEntity: g.faq.map((q) => ({
            '@type': 'Question',
            name: q.question,
            acceptedAnswer: { '@type': 'Answer', text: q.reponse },
          })),
        },
      ]
    : []),
];
---

<Base
  locale={locale}
  paths={paths}
  title={`${g.seoTitle} | ${BRAND}`}
  image={{ src: g.image, alt: g.imageAlt }}
  description={g.description}
  ogType="article"
  nav="accueil"
  piedEpure
  pied={pied}
  jsonLd={jsonLd}
  noindex={g.brouillon}
>
  <!-- A reading page: one column at the width of running text; on a wide screen the contents sit in
       a column of their own on its left, and stay in view, marking the part being read. -->
  <Section rythme="bas" class="pt-32 lg:pt-40">
    <article class="lecture">
      <header class="col-texte flex flex-col items-start gap-5">
        <a href={routes.ressources[locale]} class="retour text-caption font-semibold text-soft">
          <span aria-hidden="true">←</span>
          {l.retour}
        </a>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <Badge locale={locale} public={g.public} />
          <span class="font-mono text-source text-soft uppercase">{g.metier}</span>
        </div>
        <h1 class="font-display text-h1 font-semibold text-balance">{g.title}</h1>
        <p class="text-punch text-soft">{g.chapeau}</p>
        <p class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-source text-soft uppercase">
          <span>{fill(l.lecture, { n: String(g.readingMinutes) })}</span>
          <span>
            {l.majLe}
            <time datetime={g.updatedAt}>{longDate(g.updatedAt, locale)}</time>
          </span>
        </p>
      </header>

      <Carte variante="image" class="col-texte mt-10 aspect-3/2">
        <Image
          src={g.image}
          alt={g.imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 800px) 760px, 100vw"
          loading="eager"
          class="size-full object-cover"
        />
      </Carte>

      {
        sommaire.length > 2 && (
          <nav class="sommaire" aria-labelledby="guide-sommaire" data-sommaire>
            <details open>
              <summary id="guide-sommaire" class="font-mono text-kicker text-soft uppercase">
                {l.sommaire}
              </summary>
              <ol>
                {sommaire.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }

      <div class="col-texte mt-10 flex flex-col gap-12">
        <Carte as="aside" class="essentiel p-6 sm:p-8" aria-labelledby="guide-essentiel">
          <h2 id="guide-essentiel" class="font-mono text-kicker text-orange-txt uppercase">
            {l.essentiel}
          </h2>
          <ul>
            {g.essentiel.map((e) => <li>{e}</li>)}
          </ul>
        </Carte>

        <div class="corps">
          <Content />
        </div>

        {
          g.faq.length > 0 && (
            <section aria-labelledby="guide-faq">
              <h2 id="guide-faq" class="font-display text-card font-semibold">
                {l.faq}
              </h2>
              <div class="mt-4 border-t border-line">
                {g.faq.map((q) => (
                  <details class="question">
                    <summary>
                      <span>{q.question}</span>
                      <span class="plus" aria-hidden="true" />
                    </summary>
                    <p class="pb-5 text-soft">{q.reponse}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        {
          agents.length > 0 && (
            <section aria-labelledby="guide-agents">
              <h2 id="guide-agents" class="font-display text-card font-semibold">
                {l.agents}
              </h2>
              <ul class="mt-5 flex flex-col gap-3">
                {agents.map((a) => (
                  <li>
                    <Carte
                      href={a.href}
                      taille="sm"
                      class="flex items-center gap-4 p-3 pr-5 [--r:var(--radius-card-sm)]"
                    >
                      <span
                        class="grid size-18 shrink-0 place-items-center rounded-interieur"
                        style={`background-color:${centres[a.slug].fond}`}
                      >
                        <Image
                          src={avatars[a.slug]}
                          alt=""
                          width={56}
                          densities={[1, 2]}
                          class="size-14 object-contain"
                        />
                      </span>
                      <span class="flex flex-1 flex-col gap-1">
                        <span class="flex flex-wrap items-baseline gap-x-3">
                          <b class="font-display text-card font-semibold">{a.name}</b>
                          <span class="font-mono text-source text-soft uppercase">{a.job}</span>
                        </span>
                        <span class="text-caption text-soft">{a.pitch}</span>
                        {a.href && (
                          <span class="sr-only">{fill(l.agentLien, { name: a.name })}</span>
                        )}
                      </span>
                    </Carte>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          g.sources.length > 0 && (
            <section aria-labelledby="guide-sources" class="border-t border-line pt-8">
              <h2 id="guide-sources" class="font-mono text-kicker text-soft uppercase">
                {l.sources}
              </h2>
              <ol class="mt-4 flex list-decimal flex-col gap-2 pl-5 font-mono text-source text-soft">
                {g.sources.map((s) => (
                  <li>
                    {s.affirmation} · {l.luLe}{' '}
                    <time datetime={s.luLe}>{longDate(s.luLe, locale)}</time> ·{' '}
                    <a href={s.url} rel="noopener" class="break-all underline underline-offset-2">
                      {new URL(s.url).hostname.replace(/^www\./, '')}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </div>
    </article>
  </Section>

  {
    lies.length > 0 && (
      <Section rythme="bas" aria-labelledby="guide-lies">
        <h2 id="guide-lies" class="font-display text-section font-semibold text-balance">
          {l.lies}
        </h2>
        <ul class="mt-8 grid gap-5 md:grid-cols-3">
          {lies.map((x) => (
            <li>
              <Carte href={x.href} class="flex h-full flex-col">
                <span class="block aspect-3/2 overflow-clip bg-scene">
                  <Image
                    src={x.image}
                    alt={x.imageAlt}
                    widths={[400, 640]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    class="carte-zoom size-full object-cover"
                  />
                </span>
                <span class="flex flex-col gap-3 p-6">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <Badge locale={locale} public={x.public} />
                    <span class="font-mono text-source text-soft uppercase">{x.metier}</span>
                  </span>
                  <b class="font-display text-card font-semibold text-balance">{x.title}</b>
                </span>
              </Carte>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section rythme="bas">
    <Sorties locale={locale} public={g.public} />
  </Section>
</Base>

<script>
  // The contents mark the part being read: the last heading that has passed under the nav.
  const sommaire = document.querySelector<HTMLElement>('[data-sommaire]');
  if (sommaire) {
    const liens = [...sommaire.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const titres = liens
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((h): h is HTMLElement => !!h);
    let actif = -1;
    const marquer = () => {
      const seuil = innerHeight * 0.3;
      let i = -1;
      titres.forEach((h, k) => {
        if (h.getBoundingClientRect().top <= seuil) i = k;
      });
      if (i === actif) return;
      actif = i;
      liens.forEach((a, k) =>
        k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'),
      );
    };
    let prevu = false;
    addEventListener(
      'scroll',
      () => {
        if (prevu) return;
        prevu = true;
        requestAnimationFrame(() => {
          prevu = false;
          marquer();
        });
      },
      { passive: true },
    );
    marquer();
    // On a wide screen the contents are a column of their own, always open.
    const large = matchMedia('(min-width: 64rem)');
    const details = sommaire.querySelector('details')!;
    const ouvrir = () => {
      if (large.matches) details.open = true;
    };
    large.addEventListener('change', ouvrir);
    if (!large.matches) details.open = false;
  }
</script>

<style>
  /* One column at the width of running text, centred; from 1024 px the contents take a column on
     its left, the text column staying where it was. */
  .lecture {
    display: grid;
    grid-template-columns: minmax(0, var(--container-prose));
    justify-content: center;
  }
  .col-texte {
    grid-column: 1;
  }
  .sommaire {
    grid-column: 1;
    margin-top: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  @media (width >= 64rem) {
    .lecture {
      /* exception: the contents column, the width of its longest lines */
      grid-template-columns: 14rem minmax(0, var(--container-prose)) 14rem;
      column-gap: 3rem;
    }
    .col-texte {
      grid-column: 2;
    }
    .sommaire {
      grid-column: 1;
      grid-row: 3 / span 2;
      align-self: start;
      position: sticky;
      top: 7rem;
      margin-top: 2.5rem;
      padding-bottom: 0;
      border-bottom: 0;
    }
    .sommaire summary {
      pointer-events: none;
    }
    .sommaire summary::after {
      display: none;
    }
  }
  .sommaire summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  .sommaire summary::-webkit-details-marker {
    display: none;
  }
  .sommaire summary::after {
    content: '+';
    font-size: 1rem;
  }
  .sommaire details[open] summary::after {
    content: '−';
  }
  .sommaire ol {
    display: flex;
    flex-direction: column;
    margin-top: 0.875rem;
    border-left: 1px solid var(--color-line);
  }
  .sommaire a {
    display: block;
    margin-left: -1px;
    padding: 0.375rem 0 0.375rem 1rem;
    border-left: 2px solid transparent;
    font-size: var(--text-caption);
    line-height: 1.4;
    color: var(--color-soft);
    transition:
      color 0.2s var(--ease-hatch),
      border-color 0.2s var(--ease-hatch);
  }
  .sommaire a:hover {
    color: var(--color-ink);
  }
  .sommaire a[aria-current] {
    border-left-color: var(--color-orange);
    color: var(--color-ink);
    font-weight: 600;
  }

  .retour:hover {
    color: var(--color-ink);
  }
  .retour:focus-visible,
  .sommaire a:focus-visible,
  .question summary:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .essentiel {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .essentiel ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .essentiel li::marker {
    color: var(--color-orange-txt);
  }

  /* The guide's text, from Markdown. */
  .corps {
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-soft);
  }
  .corps :global(h2) {
    margin: 3rem 0 0.875rem;
    font-family: var(--font-display);
    font-size: var(--text-card);
    font-weight: 600;
    line-height: var(--text-card--line-height);
    letter-spacing: var(--text-card--letter-spacing);
    color: var(--color-ink);
    text-wrap: balance;
    scroll-margin-top: 7rem;
  }
  .corps :global(h3) {
    margin: 2rem 0 0.5rem;
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-ink);
  }
  .corps :global(:is(h2, h3):first-child) {
    margin-top: 0;
  }
  .corps :global(:is(p, ul, ol, blockquote)) {
    margin: 0 0 1rem;
  }
  .corps :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .corps :global(ol) {
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .corps :global(li) {
    margin-bottom: 0.4rem;
    padding-left: 0.25rem;
  }
  .corps :global(li::marker) {
    color: var(--color-orange-txt);
  }
  .corps :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .corps :global(a) {
    color: var(--color-orange-txt);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .corps :global(a:hover) {
    color: var(--color-orange-hover);
  }
  /* A callout in the text: a quiet card of its own. */
  .corps :global(blockquote) {
    margin: 2rem 0;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-card-sm);
    corner-shape: squircle;
    background: var(--color-cream-2);
    color: var(--color-ink);
  }
  .corps :global(blockquote > p:first-child strong) {
    font-family: var(--font-mono);
    font-size: var(--text-kicker);
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  .corps :global(blockquote > :last-child) {
    margin-bottom: 0;
  }
  /* Tables: rules between rows only, figures aligned, a scroll of their own on a phone. */
  .corps :global(table) {
    display: block;
    max-width: 100%;
    margin: 1.75rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-caption);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .corps :global(th) {
    padding: 0 1.25rem 0.75rem 0;
    border-bottom: 1px solid var(--color-ink);
    text-align: left;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-source);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-soft);
  }
  .corps :global(td) {
    min-width: 7rem;
    padding: 0.75rem 1.25rem 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    color: var(--color-ink);
  }

  .question {
    border-bottom: 1px solid var(--color-line);
  }
  .question summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--color-ink);
  }
  .question summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 6px 0 auto;
    height: 2px;
    border-radius: 2px;
    background: var(--color-orange-txt);
    transition: transform 0.25s var(--ease-hatch);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .question[open] .plus::after {
    transform: rotate(0deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .plus::before,
    .plus::after,
    .sommaire a {
      transition: none;
    }
  }
</style>
