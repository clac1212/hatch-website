---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { routes, type Locale } from '../i18n/ui';

/** Legal pages (terms, privacy, legal notice), shared by FR and EN: `src/content/legal/<locale>/<page>.md`. */
interface Props {
  locale: Locale;
  page: 'terms' | 'privacy' | 'mentions';
}

const { locale, page } = Astro.props;
const entry = await getEntry('legal', `${locale}/${page}`);
if (!entry) throw new Error(`Missing src/content/legal/${locale}/${page}.md`);
const { Content } = await render(entry);
const { seo, title, meta } = entry.data;
---

<Base locale={locale} paths={routes[page]} title={seo.title} description={seo.description}>
  <article class="mx-auto max-w-prose px-6 pt-32 pb-24 md:pt-40">
    <h1
      class="font-display text-[clamp(2.25rem,1.6rem+2.4vw,3.25rem)] leading-[1.08] font-bold tracking-[-0.02em] text-ink"
    >
      {title}
    </h1>
    <p class="mt-4 border-b border-line pb-6 font-mono text-caption text-muted uppercase">
      {meta}
    </p>
    <div class="legal mt-10">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* Markdown body: element selectors are unavoidable here, the HTML comes from the renderer. */
  .legal {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-soft);
  }
  .legal :global(h2) {
    margin: 3rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(h3) {
    margin: 1.75rem 0 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .legal :global(p),
  .legal :global(ul),
  .legal :global(table) {
    margin: 0 0 0.875rem;
  }
  .legal :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li) {
    margin-bottom: 0.4rem;
    padding-left: 0.25rem;
  }
  .legal :global(li::marker) {
    color: var(--color-orange);
  }
  .legal :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal :global(a) {
    color: var(--color-orange-txt);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .legal :global(a:hover) {
    color: var(--color-orange-hover);
  }
  .legal :global(code) {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-surface-2);
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink);
  }
  .legal :global(table) {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-btn);
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    background: var(--color-surface);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .legal :global(th) {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface-2);
    padding: 0.7rem 1.1rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-soft);
  }
  .legal :global(td) {
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 1.1rem;
    vertical-align: top;
  }
  .legal :global(td code) {
    overflow-wrap: anywhere;
  }
  .legal :global(tr:last-child td) {
    border-bottom: 0;
  }
</style>
