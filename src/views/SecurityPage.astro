---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Check from '../components/pages/Check.astro';
import Icon from '../components/pages/Icon.astro';
import { routes, type Locale } from '../i18n/ui';

/** Security page (pencil-new.pen → "Page Sécurité — Hatch"), shared by /securite and /en/security. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('securityPage', locale);
if (!entry) throw new Error(`Missing src/content/pages/security/${locale}.yaml`);
const { seo, hero, training, sharing, access, foundation, cta } = entry.data;

const wrap = 'mx-auto max-w-[1440px] px-6 md:px-12 xl:px-24';
const kicker = 'font-mono text-[13px] tracking-[1px] uppercase md:text-[14px]';
const h2 = 'font-display text-[30px] leading-[1.1] font-bold md:text-[38px] md:leading-[41px]';
const lightCard =
  'flex flex-col items-start gap-3 rounded-glass bg-surface p-6 outline outline-1 -outline-offset-1 outline-line md:p-7';
---

<Base locale={locale} paths={routes.security} title={seo.title} description={seo.description}>
  <header class:list={[wrap, 'flex flex-col items-start gap-5 pt-32 pb-10 md:pt-[140px] md:pb-14']}>
    <p class="font-mono text-[14px] tracking-[1px] text-orange-txt uppercase md:text-[15px]">
      {hero.kicker}
    </p>
    <h1
      class="font-display text-[40px] leading-[1.05] font-bold tracking-[-1px] text-ink md:text-[56px] md:leading-[57px]"
    >
      {hero.title}
    </h1>
    <p class="text-[17px] leading-[27px] text-soft md:text-[19px] md:leading-[29px]">{hero.lead}</p>
    <ul class="flex flex-wrap gap-3">
      {
        hero.badges.map((badge) => (
          <li class="flex items-center gap-2 rounded-full bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink outline outline-1 -outline-offset-1 outline-line">
            <Check class="size-4 text-orange" />
            {badge}
          </li>
        ))
      }
    </ul>
  </header>

  <section
    aria-labelledby="secu-ia"
    class:list={[wrap, 'flex flex-col gap-6 py-10 md:py-12']}
    data-rv-groupe
  >
    <p class:list={[kicker, 'text-orange-txt']} data-rv>{training.kicker}</p>
    <h2 id="secu-ia" class:list={[h2, 'text-ink']} data-rv>{training.title}</h2>
    <div class="grid items-start gap-5 md:grid-cols-2">
      {
        training.cards.map((c) => (
          <article class={lightCard} data-rv>
            <Icon name={c.icon} class="size-7 text-orange" />
            <h3 class="text-[18px] font-bold text-ink">{c.title}</h3>
            <p class="text-[15px] leading-[23px] text-soft">{c.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    aria-labelledby="secu-partage"
    class:list={[wrap, 'grid gap-8 pt-6 pb-10 md:grid-cols-2 md:gap-6 md:pb-12']}
    data-rv-groupe
  >
    <div class="flex flex-col items-start gap-4">
      <p class:list={[kicker, 'text-orange-txt']} data-rv>{sharing.kicker}</p>
      <h2
        id="secu-partage"
        class="font-display text-[28px] leading-[1.1] font-bold text-ink md:text-[34px] md:leading-[37px]"
        data-rv
      >
        {sharing.title}
      </h2>
      <p class="text-[16px] leading-[25px] text-soft" data-rv>{sharing.text}</p>
      <ul class="flex flex-col gap-3.5" data-rv>
        {
          sharing.items.map((item) => (
            <li class="flex items-center gap-2.5 text-[14px] font-semibold text-ink">
              <Check class="size-[18px] text-orange" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <figure
      class="flex flex-col gap-3 self-start rounded-glass bg-surface p-5 outline outline-1 -outline-offset-1 outline-line md:p-6"
      data-rv
    >
      <figcaption class="font-mono text-[12px] tracking-[1px] text-orange-txt uppercase">
        {sharing.example.title}
      </figcaption>
      <ul class="flex flex-col gap-3">
        {
          sharing.example.rows.map((row) => (
            <li class="flex items-center justify-between gap-3 rounded-xl bg-cream p-3.5">
              <span class="text-[14px] font-semibold text-ink">{row.source}</span>
              <span
                class:list={[
                  'text-[13px] font-bold whitespace-nowrap',
                  row.shared ? 'partage' : 'text-soft',
                ]}
              >
                {row.status}
              </span>
            </li>
          ))
        }
      </ul>
    </figure>
  </section>

  <section aria-labelledby="secu-acces" class="bg-night text-cream" data-rv-groupe>
    <div class:list={[wrap, 'flex flex-col gap-6 py-12 md:py-12']}>
      <p class:list={[kicker, 'text-orange']} data-rv>{access.kicker}</p>
      <h2 id="secu-acces" class:list={[h2, 'text-cream md:leading-[1.2]']} data-rv>
        {access.title}
      </h2>
      <p class="text-[16px] leading-[25px] text-stone/80" data-rv>{access.text}</p>
      <div class="grid items-start gap-5 md:grid-cols-3">
        {
          access.cards.map((c) => (
            <article
              class="flex flex-col items-start gap-3 rounded-glass bg-night-2 p-6 outline outline-1 -outline-offset-1 outline-line-night md:p-7"
              data-rv
            >
              <Icon name={c.icon} class="size-7 text-orange" />
              <h3 class="text-[18px] font-bold text-cream">{c.title}</h3>
              <p class="text-[14.5px] leading-[22px] text-stone/80">{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    aria-labelledby="secu-socle"
    class:list={[wrap, 'flex flex-col gap-5 py-10 md:py-12']}
    data-rv-groupe
  >
    <h2 id="secu-socle" class:list={[kicker, 'text-orange-txt']} data-rv>{foundation.kicker}</h2>
    <div class="grid items-start gap-5 md:grid-cols-2">
      {
        foundation.cards.map((c) => (
          <article class={lightCard.replace('gap-3', 'gap-2.5')} data-rv>
            <h3 class="text-[17px] font-bold text-ink">{c.title}</h3>
            <p class="text-[14.5px] leading-[22px] text-soft">{c.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    aria-labelledby="secu-cta"
    class:list={[wrap, 'flex flex-col items-center gap-4 pt-8 pb-18 text-center']}
  >
    <h2
      id="secu-cta"
      class="font-display text-[24px] leading-tight font-bold text-ink md:text-[28px]"
    >
      {cta.title}
    </h2>
    <Button href={cta.href} size="lg" class="max-w-full whitespace-normal">{cta.label}</Button>
  </section>
</Base>

<style>
  /* "Shared" status: success green readable as text on cream (AA). */
  .partage {
    color: var(--color-success-txt);
  }
</style>
