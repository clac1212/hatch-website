---
/**
 * The Robin page (/robin, /en/robin): the AI partner of independent restaurant owners, on WhatsApp,
 * with the sign-up form for the beta waitlist. Shared by src/pages/robin.astro (FR) and
 * src/pages/en/robin.astro (EN); copy in src/content/sections/robin/{fr,en}.yaml.
 * Inspiration: muse.ai (restraint, night background, one big sentence) and ChatGPT's "dots" page:
 * the character floating above the title, the sticky nav pill, the WhatsApp situations, "a week with
 * Robin" as a timeline, the WhatsApp phone, three trust cards.
 * The form posts JSON to /api/liste-attente (200 {ok:true}, 400 {ok:false,error:'invalid'}, 500 {ok:false}).
 */
import { Image } from 'astro:assets';
import rungis from '../assets/footer/rungis.jpg';
import Base from '../layouts/Base.astro';
import Carte from '../components/ui/Carte.astro';
import Button from '../components/ui/Button.astro';
import EnTete from '../components/ui/EnTete.astro';
import Section from '../components/layout/Section.astro';
import Iphone from '../components/ui/Iphone.astro';
import Ipad from '../components/ui/Ipad.astro';
import Situations from '../components/robin/Situations.astro';
import { section } from '../content/section';
import { routes, type Locale } from '../i18n/ui';
import portrait from '../assets/portraits/robin.jpg';
import soir from '../assets/robin/soir.jpg';
import poseLun from '../assets/robin/semaine/lun.jpg';
import poseMar from '../assets/robin/semaine/mar.jpg';
import poseMer from '../assets/robin/semaine/mer.jpg';
import poseJeu from '../assets/robin/semaine/jeu.jpg';
import poseVen from '../assets/robin/semaine/ven.jpg';
import poseDim from '../assets/robin/semaine/dim.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const {
  seo,
  hero,
  pied: piedRobin,
  soiree,
  fait,
  semaine,
  canaux,
  confiance,
  beta,
} = await section('robin', locale);

/** Robin's own footer: the Rungis market and what Robin keeps track of, hall by hall. */
const pied = { image: rungis, ...(await section('piedDePage', locale)).scenes.robin };

/** Robin, one outfit per day of the timeline (same order as `semaine.jours`). */
const poses = [poseLun, poseMar, poseMer, poseJeu, poseVen, poseDim];

/** The waitlist fields, in display order; the website is the only optional one. */
const champs = [
  { id: 'prenom', type: 'text', auto: 'given-name', requis: true },
  { id: 'nom', type: 'text', auto: 'family-name', requis: true },
  { id: 'restaurant', type: 'text', auto: 'organization', requis: true },
  { id: 'site', type: 'url', auto: 'url', requis: false },
  { id: 'whatsapp', type: 'tel', auto: 'tel', requis: true },
  { id: 'email', type: 'email', auto: 'email', requis: true },
] as const;
---

<Base
  espace
  locale={locale}
  paths={routes.robin}
  nav="robin"
  navTone="night"
  pied={pied}
  piedEpure
  piedAppel={{ href: '#beta', label: hero.cta, signature: piedRobin.signature }}
  title={seo.title}
  description={seo.description}
>
  <!-- --debord: how far the evening iPad hangs over the next section (half of it, roughly). -->
  <div class="nuit bg-night text-cream [--debord:clamp(120px,19vw,300px)]">
    <!-- 1 · Hero: Robin floats above the title (dots), one big centred sentence (muse.ai).
         exception: the top padding clears the floating nav. -->
    <Section id="robin" ton="night" rythme="aucun" class="pt-36 lg:pt-44" data-nav-fond="sombre">
      <div class="flex flex-col items-center text-center">
        <!-- Robin flies into his circle, waves, takes notes, checks a receipt, gives a thumbs up,
           then flies off (15 s loop; reduced motion: the portrait stays still). -->
        <div class="mb-8 flex flex-col items-center gap-2" data-vol>
          <div class="size-[132px] overflow-hidden rounded-full bg-cream-2 lg:size-[156px]">
            <video
              class="size-full object-cover"
              src="/anim/robin-vol.mp4"
              poster={portrait.src}
              muted
              loop
              playsinline
              preload="auto"
              aria-label={hero.video}></video>
          </div>
        </div>
        <h1 class="font-display text-h1 font-semibold">
          {hero.titre}
        </h1>
        <p class="mt-5 max-w-lead text-punch text-(--doux)">
          {hero.intro}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="#beta" variant="orange" size="lg">{hero.cta}</Button>
        </div>

        <!-- The scene below the hero, in an iPad hanging half over the next section: the bistro at
           closing time, Robin talks to the owner (looping video), his messages pop out one after
           another. exception: its width and overhang are the scene's own. -->
        <div class="soiree relative z-10 mt-14 w-full max-w-[900px] lg:mt-16" data-soiree>
          <Ipad class="soiree-ipad">
            <video
              class="soiree-video"
              src="/anim/robin-soir.mp4"
              poster={soir.src}
              muted
              loop
              playsinline
              preload="auto"
              aria-label={soiree.video}></video>
            <ol class="bulles-soir" aria-label={soiree.label}>
              {
                soiree.messages.map((m, i) => (
                  <li class="bs" style={`--i:${i}`}>
                    <span class="bs-bulle">
                      {m.txt}
                      {m.lien && (
                        <span class="bs-lien">
                          {m.lien} <span aria-hidden="true">→</span>
                        </span>
                      )}
                    </span>
                  </li>
                ))
              }
            </ol>
          </Ipad>
        </div>
      </div>
    </Section>

    <!-- 3 · What Robin does: alternating rows, a WhatsApp situation in a tinted card -->
    <Section id="fait" ton="cream" class="pt-[calc(var(--debord)+clamp(4rem,2.6rem+4.4vw,7rem))]">
      <div class="flex flex-col gap-12 lg:gap-16">
        <EnTete titre={fait.titre} />
        <Situations locale={locale} />
      </div>
    </Section>

    <!-- 4 · A week with Robin: the day timeline (the dots "day") -->
    <Section id="semaine" ton="night" data-semaine>
      <div class="flex flex-col items-center text-center">
        <EnTete titre={semaine.titre} align="centre" />

        <!-- Robin and his bubble, which change with the day -->
        <div class="scene mt-12">
          <!-- Robin changes outfit with the day: coffee on Monday, crate on Tuesday, calendar on
               Wednesday, chef's hat on Thursday, bell on Friday, nightcap on Sunday. -->
          <div class="flotte jour-av">
            {
              poses.map((src, i) => (
                <Image
                  src={src}
                  alt=""
                  widths={[120, 240]}
                  sizes="120px"
                  class:list={['pose', i === 0 && 'on']}
                  data-j={i}
                />
              ))
            }
          </div>
          <div class="bulles">
            {
              semaine.jours.map((j, i) => (
                <p class:list={['bulle', i === 0 && 'on']} data-j={i}>
                  {j.bulle}
                </p>
              ))
            }
          </div>
        </div>

        <!-- The timeline -->
        <div class="frise mt-10 w-full" role="tablist" aria-label={semaine.frise}>
          {
            semaine.jours.map((j, i) => (
              <button
                type="button"
                role="tab"
                class="jour"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="semaine-detail"
                data-j={i}
              >
                <span class="jour-point" aria-hidden="true" />
                <span class="jour-nom">{j.jour}</span>
                <span class="jour-heure">{j.heure}</span>
              </button>
            ))
          }
        </div>

        <div id="semaine-detail" class="details mt-10" aria-live="polite">
          {
            semaine.jours.map((j, i) => (
              <div class:list={['detail', i === 0 && 'on']} data-j={i}>
                <h3 class="font-display text-card font-semibold">{j.titre}</h3>
                <p class="mx-auto mt-3 max-w-lead text-body text-(--doux)">{j.texte}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Section>

    <!-- 5 · Where to find him: the WhatsApp phone (no app yet) -->
    <Section id="canaux" ton="cream-2" data-canaux>
      <div class="flex flex-col items-center text-center">
        <EnTete titre={canaux.titre} intro={canaux.texte} align="centre" />

        <div class="telephone mt-10 w-full max-w-[320px]">
          <Iphone>
            <!-- WhatsApp -->
            <div class="ecran wa on" data-c="0">
              <div class="wa-statut" aria-hidden="true"><span>8:31</span><span>●●● ▮</span></div>
              <header class="wa-barre">
                <span class="wa-retour" aria-hidden="true">‹</span>
                <Image src={portrait} alt="" width={40} densities={[1, 2]} class="wa-av" />
                <span class="wa-contact"><b>Robin</b><span>{canaux.telephone.statut}</span></span>
              </header>
              <div class="wa-fil">
                <p class="wa-jour">{canaux.telephone.jour}</p>
                {
                  canaux.telephone.messages.map((m) => (
                    <div class:list={['wa-msg', m.qui, m.doc && 'wa-doc']}>
                      {m.doc && (
                        <span class="wa-fichier">
                          <b>{m.doc}</b>
                          <span>{m.meta}</span>
                        </span>
                      )}
                      {m.txt}
                    </div>
                  ))
                }
              </div>
            </div>
          </Iphone>
        </div>
      </div>
    </Section>

    <!-- 6 · Trust: on the dark background, three cards outlined in the blue of Robin's feathers. -->
    <Section id="confiance" ton="cream">
      <div class="flex flex-col items-center">
        <EnTete titre={confiance.titre} align="centre" />
        <div class="mt-12 grid w-full gap-4 md:grid-cols-3">
          {
            confiance.cartes.map((c, i) => (
              <Carte
                as="article"
                variante="nuit"
                class="flex flex-col items-start gap-3 p-7 lg:p-8"
              >
                <span class="font-mono text-kicker text-(--doux)">0{i + 1}</span>
                <h3 class="font-display text-card font-semibold">{c.titre}</h3>
                <p class="text-body text-(--doux)">{c.texte}</p>
              </Carte>
            ))
          }
        </div>
      </div>
    </Section>

    <!-- 7 · The beta: the waitlist -->
    <Section id="beta" ton="night">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_0.95fr] lg:gap-16">
        <EnTete kicker={beta.kicker} titre={beta.titre} intro={beta.texte} />
        <!-- Without JS the form still posts (POST, so nothing lands in the URL); with JS the inline
             script validates, then sends JSON and swaps the form for the confirmation. -->
        <form
          class="flex flex-col gap-4 rounded-panneau bg-cream p-6 text-ink sm:p-8 lg:p-10"
          action="/api/liste-attente"
          method="post"
          novalidate
          data-liste
          data-locale={locale}
          data-envoi={beta.messages.envoi}
          data-succes={beta.messages.succes}
          data-erreur={beta.messages.erreur}
          data-invalide={beta.messages.invalide}
        >
          <div class="grid gap-3 sm:grid-cols-2" data-masquer>
            {
              champs.map((c) => (
                <label class="champ" for={`r-${c.id}`}>
                  <span>{beta.champs[c.id].label}</span>
                  <input
                    id={`r-${c.id}`}
                    name={c.id}
                    type={c.type}
                    placeholder={beta.champs[c.id].placeholder}
                    autocomplete={c.auto}
                    required={c.requis}
                  />
                </label>
              ))
            }
          </div>
          <!-- Honeypot: invisible to people and assistive tech, bots fill it and get dropped server-side. -->
          <div class="sr-only" aria-hidden="true">
            <input type="text" name="hatch_hp" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="locale" value={locale} />

          <Button
            type="submit"
            size="lg"
            block
            class="mt-2 disabled:cursor-wait disabled:opacity-60"
            data-masquer
          >
            {beta.bouton}
          </Button>
          <p class="statut" role="status" aria-live="polite" tabindex="-1" data-statut></p>
          <p class="text-center text-caption text-soft" data-masquer>{beta.mention}</p>
        </form>
      </div>
    </Section>
  </div>

  <script is:inline data-keep>
    // Robin flying in the hero and the evening scene: both loops start on their own, except with
    // reduced motion (the posters stay still).
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('[data-vol] video, [data-soiree] video').forEach(function (v) {
        v.play().catch(function () {});
      });
    })();
    // A week with Robin: clicking a day changes the bubble and the detail. Without JS, Monday stays
    // visible.
    (function () {
      function onglets(root, attr) {
        if (!root) return;
        var tabs = [].slice.call(root.querySelectorAll('[role="tab"]'));
        var panneaux = [].slice.call(root.querySelectorAll('[' + attr + ']:not([role="tab"])'));
        tabs.forEach(function (t) {
          t.addEventListener('click', function () {
            var v = t.getAttribute(attr);
            tabs.forEach(function (u) {
              u.setAttribute('aria-selected', u === t ? 'true' : 'false');
            });
            panneaux.forEach(function (p) {
              var on = p.getAttribute(attr) === v;
              p.classList.toggle('on', on);
              p.setAttribute('aria-hidden', on ? 'false' : 'true');
            });
          });
        });
      }
      onglets(document.querySelector('[data-semaine]'), 'data-j');
    })();
    // The beta waitlist: checks the required fields and the email, posts JSON to /api/liste-attente,
    // and on success swaps the fields for the confirmation. Every message comes from the form's
    // data attributes and lands in the aria-live status line.
    (function () {
      var form = document.querySelector('[data-liste]');
      if (!form) return;
      var statut = form.querySelector('[data-statut]');
      var bouton = form.querySelector('button[type="submit"]');
      var requis = [].slice.call(form.querySelectorAll('input[required]'));
      var courriel = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      var enCours = false;
      function valeur(nom) {
        return form.elements.namedItem(nom).value.trim();
      }
      function dire(cle) {
        statut.textContent = form.getAttribute('data-' + cle);
      }
      // Back from a plain form post (the script had not loaded): the endpoint adds ?inscription=.
      var retour = new URLSearchParams(location.search).get('inscription');
      if (retour === 'ok') {
        [].forEach.call(form.querySelectorAll('[data-masquer]'), function (el) {
          el.hidden = true;
        });
        statut.classList.add('ok');
        dire('succes');
      } else if (retour === 'erreur') {
        dire('erreur');
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (enCours) return;
        var fautifs = requis.filter(function (c) {
          return !c.value.trim() || (c.name === 'email' && !courriel.test(c.value.trim()));
        });
        requis.forEach(function (c) {
          c.setAttribute('aria-invalid', fautifs.indexOf(c) >= 0 ? 'true' : 'false');
        });
        if (fautifs.length) {
          dire('invalide');
          fautifs[0].focus();
          return;
        }
        enCours = true;
        bouton.disabled = true;
        dire('envoi');
        fetch('/api/liste-attente', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prenom: valeur('prenom'),
            nom: valeur('nom'),
            restaurant: valeur('restaurant'),
            site: valeur('site'),
            whatsapp: valeur('whatsapp'),
            email: valeur('email'),
            locale: form.getAttribute('data-locale'),
            hatch_hp: form.elements.namedItem('hatch_hp').value,
          }),
        })
          .then(function (r) {
            return r
              .json()
              .catch(function () {
                return {};
              })
              .then(function (d) {
                if (r.ok) {
                  [].forEach.call(form.querySelectorAll('[data-masquer]'), function (el) {
                    el.hidden = true;
                  });
                  statut.classList.add('ok');
                  dire('succes');
                  statut.focus();
                  return;
                }
                dire(d && d.error === 'invalid' ? 'invalide' : 'erreur');
                enCours = false;
                bouton.disabled = false;
              });
          })
          .catch(function () {
            dire('erreur');
            enCours = false;
            bouton.disabled = false;
          });
      });
    })();
  </script>
</Base>

<style>
  /* Robin floats gently, like the dot above the title. */
  .flotte {
    filter: drop-shadow(0 18px 24px color-mix(in srgb, var(--color-black) 45%, transparent));
    animation: flotte 5s ease-in-out infinite;
  }
  @keyframes flotte {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  /* The evening scene: the video fills the iPad's screen, which hangs over the next section. */
  .soiree {
    margin-bottom: calc(-1 * var(--debord));
  }
  .soiree-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The bubbles come from Robin on the counter: opening to the left, the tail pointing down just to his left.
     One at a time, in the same cell, each in turn (9 s, time to read), then the evening restarts.
     Robin sits at ~55% of the video's width and ~42% of its height. */
  .bulles-soir {
    position: absolute;
    right: 46%;
    bottom: 66%;
    display: grid;
    align-items: end;
    width: min(330px, 40%);
    text-align: left;
    container-type: inline-size;
  }
  .bs {
    grid-area: 1 / 1;
    opacity: 0;
    transform-origin: 88% 100%;
    animation: bulle-soir 19.5s var(--ease-doux) infinite;
    animation-delay: calc(0.6s + var(--i) * 6.5s);
  }
  .bs-bulle {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 15px 13px;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
    font: 400 13px/1.45 var(--font-sans);
    color: var(--color-ink);
  }
  /* The bubble opens to the left; its tail, bottom right, points down just left of Robin. */
  .bs-bulle::after {
    content: '';
    position: absolute;
    right: 26px;
    bottom: -13px;
    width: 22px;
    height: 16px;
    background: var(--color-surface);
    clip-path: polygon(0 0, 100% 0, 82% 100%);
  }
  .bs-lien {
    align-self: flex-start;
    padding: 6px 10px;
    border-radius: 10px;
    background: var(--color-orange-tint);
    font: 600 12px/1.2 var(--font-sans);
    color: var(--color-orange-txt);
  }
  /* The bubble pops from Robin, stays long enough to read, then makes way for the next. */
  @keyframes bulle-soir {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }
    3%,
    29% {
      opacity: 1;
      transform: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  /* On small screens, the bubble keeps its place above Robin, smaller. */
  @media (max-width: 47.99rem) {
    .bulles-soir {
      right: 45%;
      width: 52%;
    }
    .bs-bulle {
      padding: 8px 10px 9px;
      border-radius: 14px;
      font-size: 10.5px;
      gap: 5px;
    }
    .bs-lien {
      padding: 4px 7px;
      font-size: 10px;
    }
  }

  /* A week: the scene (Robin + bubble), the timeline, the detail. */
  .scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .jour-av {
    display: grid;
    width: 120px;
    height: 120px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-cream-2);
  }
  .jour-av :global(.pose) {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    scale: 0.92;
    transition:
      opacity 0.3s var(--ease-doux),
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .jour-av :global(.pose.on) {
    opacity: 1;
    scale: 1;
  }
  .bulles {
    display: grid;
    min-height: 74px;
  }
  .bulle {
    grid-area: 1 / 1;
    max-width: 380px;
    padding: 14px 18px;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
    color: var(--color-ink);
    font: 500 15px/1.45 var(--font-sans);
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.3s var(--ease-doux),
      translate 0.4s var(--ease-doux);
  }
  .bulle.on {
    opacity: 1;
    translate: 0 0;
  }
  .frise {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .frise::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: var(--filet);
  }
  .jour {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-bottom: 6px;
    cursor: pointer;
  }
  .jour-point {
    width: 15px;
    height: 15px;
    border-radius: 999px;
    background: var(--fond);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, currentColor 45%, transparent);
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .jour-nom {
    font: 600 14px/1 var(--font-sans);
    color: color-mix(in srgb, currentColor 70%, transparent);
  }
  .jour-heure {
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }
  .jour[aria-selected='true'] .jour-point {
    background: var(--color-orange);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-orange) 25%, transparent);
  }
  .jour[aria-selected='true'] .jour-nom {
    color: currentColor;
  }
  .jour:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 8px;
  }
  .details {
    display: grid;
  }
  .detail {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.3s var(--ease-doux);
  }
  .detail.on {
    opacity: 1;
  }

  /* The phone screen. */
  .ecran {
    --pt: calc(100cqw / 370);
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.35s var(--ease-doux);
    text-align: left;
  }
  .ecran.on {
    opacity: 1;
  }

  /* WhatsApp in the iPhone, same proportions as the demo mock-ups. */
  .wa {
    container-type: inline-size;
    background: var(--color-whatsapp-wall);
