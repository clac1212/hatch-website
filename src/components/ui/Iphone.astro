---
/**
 * iPhone 17 Pro frame for product mock-ups: the screen is the default slot, an HTML box placed
 * exactly on the frame's screen area, under the Dynamic Island.
 * Frame artwork: the SVG traced by Eldora UI (MIT, github.com/karthikmudunuri/eldoraui,
 * registry/eldoraui/iphone-17-pro.tsx), recoloured with the design tokens.
 * The screen box is a size container: its content can size itself in cqw.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['iphone', className]}>
  <div class="ecran">
    <slot />
    <span class="reflet" aria-hidden="true"></span>
  </div>
  <svg class="cadre" viewBox="0 0 200 400" aria-hidden="true">
    <path
      class="metal"
      d="M196.11,128.09c0-.25-.2-.45-.45-.45-.11.04-.37.03-.69,0V36.69c0-17.84-14.46-32.31-32.31-32.31H37.48C19.63,4.39,5.17,18.85,5.17,36.69v48.99c-.3.02-.55.03-.66-.02-.25,0-.45.2-.45.45,0,0,0,17.29,0,17.29-.03.41.5.49,1.11.48v13.63c-.61,0-1.14.08-1.11.48,0,0,0,28.54,0,28.54-.03.42.5.49,1.11.48v7.95c-.61,0-1.14.08-1.11.48,0,0,0,28.54,0,28.54-.03.42.5.49,1.11.48v178.86c0,17.84,14.46,32.31,32.31,32.31h125.2c17.84,0,32.31-14.46,32.31-32.31v-188.87c.32-.02.58-.03.69.04,1.26.1.03-45.94.45-46.38ZM186.07,362.63c0,13.56-10.99,24.56-24.56,24.56H38.64c-13.56,0-24.56-10.99-24.56-24.56V37.37c0-13.56,10.99-24.56,24.56-24.56h122.87c13.56,0,24.56,10.99,24.56,24.56v325.26Z"
    ></path>
    <path
      class="verre"
      d="M161.38,7.29H38.78c-16.54,0-29.95,13.41-29.95,29.95v325.52c0,16.54,13.41,29.95,29.95,29.95h122.6c16.54,0,29.95-13.41,29.95-29.95V37.24c0-16.54-13.41-29.95-29.95-29.95ZM186.07,362.57c0,13.6-11.02,24.62-24.62,24.62H38.7c-13.6,0-24.62-11.02-24.62-24.62V37.43c0-13.6,11.02-24.62,24.62-24.62h122.75c13.6,0,24.62,11.02,24.62,24.62v325.14Z"
    ></path>
    <path
      class="ile"
      d="M119.61,33.86h-38.93c-10.48-.18-10.5-15.78,0-15.96,0,0,38.93,0,38.93,0,4.41,0,7.98,3.57,7.98,7.98,0,4.41-3.57,7.98-7.98,7.98Z"
    ></path>
    <path class="objectif" d="M118.78,29.21c-4.32.06-4.32-6.73,0-6.66,4.32-.06,4.32,6.73,0,6.66Z"
    ></path>
  </svg>
</div>

<style>
  /* viewBox 200 × 400; the screen is the rect (14.08, 12.81, 171.98 × 374.37, r 24.62). */
  .iphone {
    position: relative;
    aspect-ratio: 1 / 2;
    filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--color-shadow) 25%, transparent))
      drop-shadow(0 26px 34px color-mix(in srgb, var(--color-shadow) 38%, transparent));
  }
  .ecran {
    position: absolute;
    left: 7.04%;
    top: 3.2025%;
    width: 85.99%;
    height: 93.5925%;
    container-type: size;
    overflow: hidden;
    border-radius: 14.32% / 6.58%;
  }
  .cadre {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .metal {
    fill: var(--color-metal);
    stroke: var(--color-metal-dark);
    stroke-width: 0.35;
  }
  .verre,
  .ile {
    fill: var(--color-glass);
  }
  .objectif {
    fill: var(--color-night-2);
  }
  /* A soft glare across the glass; the demo timeline sweeps it once when the device lands. */
  .reflet {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 30%,
      color-mix(in srgb, var(--color-white) 22%, transparent) 45%,
      transparent 60%
    );
    opacity: 0;
    pointer-events: none;
  }
</style>
