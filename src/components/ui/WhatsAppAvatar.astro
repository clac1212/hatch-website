---
/**
 * A WhatsApp avatar (ui/WhatsApp, robin/Telephone): the contact's picture, or WhatsApp's default one
 * (a white silhouette on grey) for a person, a group or a business. A circle 1em wide: the parent
 * sets its size with `font-size`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  genre?: 'personne' | 'groupe' | 'entreprise';
  nom: string;
  class?: string;
}
const { image, genre = 'personne', class: className } = Astro.props;
---

{
  image ? (
    <Image src={image} alt="" width={64} densities={[1, 2]} class:list={['wav', className]} />
  ) : (
    <span class:list={['wav', 'wav-defaut', className]} aria-hidden="true">
      <svg viewBox="0 0 40 40">
        {genre === 'personne' && (
          <path d="M20 21a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm-13 13c1.5-6.3 6.8-10 13-10s11.5 3.7 13 10a19.8 19.8 0 0 1-26 0Z" />
        )}
        {genre === 'groupe' && (
          <path d="M15 20a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm11 1a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM5 33c1.2-5.5 5.2-9 10-9s8.8 3.5 10 9a19.8 19.8 0 0 1-20 0Zm21.5-9.8c3.9.3 7 3.3 8 7.6a19.9 19.9 0 0 1-6.6 3.7c-.4-4.4-2.2-8.4-5.4-10.9 1.2-.3 2.6-.5 4-.4Z" />
        )}
        {genre === 'entreprise' && (
          <path d="M10 12h20l2.5 6.5a3.4 3.4 0 0 1-6.3 1.3 3.4 3.4 0 0 1-6.2 0 3.4 3.4 0 0 1-6.2 0 3.4 3.4 0 0 1-6.3-1.3Zm1.5 10.3a5.2 5.2 0 0 0 2.6.6V29h11.8v-6.1c.9 0 1.8-.2 2.6-.6V31h-17Z" />
        )}
      </svg>
    </span>
  )
}

<style>
  .wav {
    display: block;
    flex: none;
    width: 1em;
    height: 1em;
    border-radius: 999px;
    object-fit: cover;
    background: var(--color-robin-studio);
  }
  .wav-defaut {
    background: var(--color-whatsapp-avatar);
  }
  .wav-defaut svg {
    width: 100%;
    height: 100%;
    fill: var(--color-white);
  }
</style>
