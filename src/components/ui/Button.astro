---
import type { HTMLAttributes } from 'astro/types';

/**
 * "Bouton principal" from the DS: ink on light backgrounds, cream on night.
 * The site has a single call to action (book a demo), so this is the only button style.
 */
interface Props extends HTMLAttributes<'a'> {
  href: string;
  tone?: 'day' | 'night';
}

const { href, tone = 'day', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2.5 rounded-btn px-5.5 py-3.5 text-[0.9375rem] font-semibold transition-colors duration-200',
    tone === 'day'
      ? 'bg-ink text-white hover:bg-orange-hover'
      : 'bg-cream text-ink hover:bg-orange-tint',
    className,
  ]}
  {...rest}
>
  <slot />
  <svg
    viewBox="0 0 24 24"
    class:list={[
      'size-4 transition-transform duration-200 ease-hatch group-hover:translate-x-0.5',
      tone === 'day' ? 'text-orange' : 'text-ink',
    ]}
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14M13 6l6 6-6 6"></path>
  </svg>
</a>
