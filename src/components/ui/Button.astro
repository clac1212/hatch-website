---
import type { HTMLAttributes } from 'astro/types';

/**
 * The site's only button (DS decision 1, César 09/11): every variant is a pill, same sizes (`sm` | `lg`).
 * Two calls to action: book a demo (primary, everywhere) and, in the hero, try Hatch OS (the app's
 * signup, secondary). Looks:
 * - `orange`: the primary pill of the nav and the hero (`size` sm | lg);
 * - `secondary`: the same pill in translucent white with ink text, next to an orange one; it reads over
 *   the hero map (frosted, white rim) as well as on cream (hairline ring);
 * - `ink`: dark block button of the pricing cards, turns orange on hover;
 * - `cream`: its counterpart on night backgrounds (footer, dark pricing card).
 * Text on orange is always ink (6.8:1), never white (2.7:1, fails AA; César 06/10).
 * All are "vif": they lift on hover, the arrow slides and a light sweep crosses them.
 */
interface Props extends HTMLAttributes<'a'> {
  /** No href: the button is drawn inside a link that is already clickable (a card), as a <span>. */
  href?: string;
  variant?: 'orange' | 'secondary' | 'ink' | 'cream';
  size?: 'sm' | 'lg';
  block?: boolean;
}

const {
  href,
  variant = 'orange',
  size = 'sm',
  block = false,
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'btn-vif inline-flex items-center rounded-full font-bold whitespace-nowrap',
    size === 'sm' ? 'gap-2 px-5 py-3 text-caption' : 'gap-2.5 px-6 py-4 text-base',
    block && 'w-full justify-center',
    variant === 'orange' && [
      'bg-orange text-ink',
      size === 'sm' ? 'shadow-orange' : 'shadow-orange-lg',
    ],
    variant === 'secondary' &&
      'bg-white/80 text-ink shadow-1 ring-1 ring-ink/12 backdrop-blur-md ring-inset hover:bg-white hover:shadow-2',
    variant === 'ink' && 'bg-ink text-white hover:bg-orange hover:text-ink',
    variant === 'cream' && 'bg-cream text-ink',
    className,
  ]}
  {...rest}
>
  <slot />
  <svg
    viewBox="0 0 24 24"
    class:list={[size === 'lg' ? 'size-[18px]' : 'size-4']}
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14M12 5l7 7-7 7"></path>
  </svg>
</Tag>
