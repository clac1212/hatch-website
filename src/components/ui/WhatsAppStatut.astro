---
/**
 * The iOS status bar of the WhatsApp mock-ups (ui/WhatsApp, robin/Telephone): the clock, then signal,
 * Wi-Fi and battery either side of the Dynamic Island. Sized in `em` from its parent's font size; no
 * background of its own, the screen it sits on gives it.
 */
interface Props {
  heure?: string;
}
const { heure = '9:41' } = Astro.props;
---

<div class="wai-statut" aria-hidden="true">
  <span class="wai-horloge">{heure}</span>
  <span class="wai-capteurs">
    <svg viewBox="0 0 18 12">
      <rect x="0" y="8" width="3" height="4" rx="1"></rect>
      <rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect>
      <rect x="10" y="3" width="3" height="9" rx="1"></rect>
      <rect x="15" y="0" width="3" height="12" rx="1"></rect>
    </svg>
    <svg viewBox="0 0 16 12">
      <path
        d="M8 2.6c2.3 0 4.4.9 6 2.4l1.1-1.2A10.2 10.2 0 0 0 8 1 10.2 10.2 0 0 0 .9 3.8L2 5c1.6-1.5 3.7-2.4 6-2.4Zm0 3.3c1.4 0 2.6.5 3.6 1.4l1.1-1.2A6.9 6.9 0 0 0 8 4.3a6.9 6.9 0 0 0-4.7 1.8l1.1 1.2c1-.9 2.2-1.4 3.6-1.4Zm0 3.2c.5 0 1 .2 1.3.5L8 11 6.7 9.6c.3-.3.8-.5 1.3-.5Z"
      ></path>
    </svg>
    <svg viewBox="0 0 27 12" class="wai-batterie">
      <rect
        x=".5"
        y=".5"
        width="23"
        height="11"
        rx="3.5"
        fill="none"
        stroke="currentColor"
        opacity=".4"></rect>
      <rect x="2" y="2" width="17" height="8" rx="2"></rect>
      <path d="M25 4v4c.8-.3 1.3-1.1 1.3-2S25.8 4.3 25 4Z" opacity=".45"></path>
    </svg>
  </span>
</div>

<style>
  .wai-statut {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: 3.15em;
    padding: 0.55em 1.75em 0 2.05em;
  }
  .wai-horloge {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .wai-capteurs {
    display: flex;
    align-items: center;
    gap: 0.32em;
  }
  .wai-capteurs svg {
    height: 0.68em;
    width: auto;
    fill: currentColor;
  }
  .wai-capteurs .wai-batterie {
    height: 0.75em;
  }
</style>
