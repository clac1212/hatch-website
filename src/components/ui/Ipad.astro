---
/**
 * iPad frame (landscape) for product mock-ups: the screen is the default slot, an HTML box placed
 * exactly on the frame's screen area.
 * Frame artwork: the SVG traced by Eldora UI (MIT, github.com/karthikmudunuri/eldoraui,
 * registry/eldoraui/ipad.tsx), recoloured with the design tokens.
 * The screen box is a size container: its content can size itself in cqw.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['ipad', className]}>
  <svg class="cadre" viewBox="0 0 520 400" aria-hidden="true">
    <path
      class="metal"
      d="M479.04,14.14H88.14v-.59c0-.16-.13-.3-.3-.3h-16.7c-.16,0-.3.13-.3.3v.59h-3.46v-.59c0-.16-.13-.3-.3-.3h-16.7c-.16,0-.3.13-.3.3v.59h-9.13c-13.4,0-24.27,10.78-24.45,24.14h-.48c-.16,0-.3.13-.3.3v20.07c0,.16.13.3.3.3h.47v303.38c0,13.51,10.95,24.45,24.45,24.45h438.08c13.51,0,24.45-10.95,24.45-24.45V38.6c0-13.51-10.95-24.45-24.45-24.45Z"
    ></path>
    <rect class="verre" x="18.58" y="15.94" width="482.84" height="368.91" rx="23.29" ry="23.29"
    ></rect>
    <circle class="objectif" cx="245.1" cy="22.23" r="2.44"></circle>
    <circle class="capteur" cx="274.98" cy="22.23" r=".88"></circle>
  </svg>
  <div class="ecran">
    <slot />
    <span class="reflet" aria-hidden="true"></span>
  </div>
</div>

<style>
  /* viewBox 520 × 400; the screen is the rect (31.37, 28.47, 457.25 × 342.87, r 9.61). */
  .ipad {
    position: relative;
    aspect-ratio: 520 / 400;
    filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--color-shadow) 25%, transparent))
      drop-shadow(0 26px 34px color-mix(in srgb, var(--color-shadow) 38%, transparent));
  }
  .cadre {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ecran {
    position: absolute;
    left: 6.0327%;
    top: 7.1175%;
    width: 87.933%;
    height: 85.7175%;
    container-type: size;
    overflow: hidden;
    border-radius: 2.1017% / 2.8028%;
  }
  .metal {
    fill: var(--color-metal);
    stroke: var(--color-metal-dark);
    stroke-width: 0.5;
  }
  .verre {
    fill: var(--color-glass);
  }
  .objectif {
    fill: var(--color-night-2);
  }
  .capteur {
    fill: var(--color-line-night);
  }
  /* A soft glare across the glass; the demo timeline sweeps it once when the device lands. */
  .reflet {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 30%,
      color-mix(in srgb, var(--color-white) 22%, transparent) 45%,
      transparent 60%
    );
    opacity: 0;
    pointer-events: none;
  }
</style>
