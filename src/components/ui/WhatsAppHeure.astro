---
/**
 * The time at the end of a WhatsApp bubble (ui/WhatsApp.astro), with the blue double tick of a
 * read message when `lu` (the owner's own messages).
 */
interface Props {
  heure: string;
  lu?: boolean;
}
const { heure, lu = false } = Astro.props;
---

<span class="wa-h"
  >{heure}{
    lu && (
      <svg viewBox="0 0 16 11" aria-hidden="true">
        <path
          d="M1.2 6.1 4.3 9.2 10.6 1.9M7.4 8.4l.8.8 6.3-7.3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }</span
>
