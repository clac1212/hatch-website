---
import type { Locale } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';
import {
  JayAvatar,
  PeepAvatar,
  SparrowAvatar,
  FinchAvatar,
  PeckerAvatar,
} from './birds/AvatarBirds.tsx';

interface Props {
  locale: Locale;
  data: CollectionEntry<'landing'>['data']['hub'];
}

const { data } = Astro.props;

// 7 sources distributed evenly along the left column.
// Icons are real brand PNG/JPG/WebP files in /public/logos (extracted from
// the reference HTML so we ship the same artwork as the original landing).
const sources = [
  { i: 0, top: '7%', label: 'PDF', src: '/logos/src-pdf.jpg' },
  { i: 1, top: '21.3%', label: 'Notion', src: '/logos/src-notion.png', imgSize: '34px' },
  { i: 2, top: '35.65%', label: 'Google Drive', src: '/logos/src-google-drive.png' },
  { i: 3, top: '50%', label: 'OneDrive', src: '/logos/src-onedrive.png' },
  { i: 4, top: '64.35%', label: 'Word', src: '/logos/src-word.webp' },
  { i: 5, top: '78.7%', label: 'Excel', src: '/logos/src-excel.png' },
  { i: 6, top: '93%', label: 'Airtable', src: '/logos/src-airtable.png' },
];

// 5 live agents evenly spaced in a quincunx pattern (alternating columns).
const agents = [
  { key: 'jay', name: 'Jay', top: '9%', left: '88%' },
  { key: 'peep', name: 'Peep', top: '30%', left: '95%' },
  { key: 'sparrow', name: 'Sparrow', top: '51%', left: '88%' },
  { key: 'finch', name: 'Finch', top: '72%', left: '95%' },
  { key: 'pecker', name: 'Pecker', top: '93%', left: '88%' },
];
---

<section class="hub-sec border-t-0 bg-white pb-14 pt-12" id="hub">
  <div class="container-site">
    <div class="hub-header mb-14 text-center">
      <div
        class="hub-pill mb-5 inline-flex items-center gap-[7px] rounded-full border border-hatch-pill-bg-strong bg-hatch-pill-bg px-3.5 py-[5px] text-xs font-semibold tracking-[0.03em] text-hatch-primary"
      >
        <span
          class="hub-pill-dot pulse-dot h-1.5 w-1.5 rounded-full bg-hatch-primary-bright shadow-[0_0_8px_rgba(90,173,110,0.7)]"
        ></span>
        <span>{data.pill}</span>
      </div>
      <h2
        class="mb-4 mt-2 font-display font-bold text-slate-900"
        style="font-size: clamp(26px, 3.6vw, 40px); line-height: 1.08; letter-spacing: -0.02em;"
        set:html={data.h2}
      />
      <p class="mx-auto max-w-[560px] text-base text-slate-500">{data.sub}</p>
    </div>

    <div
      class="hub-diagram relative mx-auto h-[480px] w-full max-w-[1280px] overflow-hidden rounded-[32px] hidden md:block"
      style="background: var(--hub-gradient);"
      aria-hidden="true"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(40% 60% at 20% 30%, rgba(254,215,170,0.45), transparent 60%), radial-gradient(40% 60% at 80% 70%, rgba(253,186,116,0.25), transparent 60%);"
      >
      </div>

      <!-- SVG: connections + animated dots -->
      <svg
        viewBox="0 0 1080 920"
        preserveAspectRatio="none"
        style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:0;"
        aria-hidden="true"
      >
        <defs>
          <filter id="hub-glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="2.4" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
        </defs>
        <g fill="none" stroke="#e2c9a8" stroke-width="1.5">
          <path id="p-s0" d="M 162 64.4  C 300 64.4,  370 460, 446 460"></path>
          <path id="p-s1" d="M 162 196   C 300 196,   370 460, 446 460"></path>
          <path id="p-s2" d="M 162 328   C 300 328,   370 460, 446 460"></path>
          <path id="p-s3" d="M 162 460   C 300 460,   370 460, 446 460"></path>
          <path id="p-s4" d="M 162 592   C 300 592,   370 460, 446 460"></path>
          <path id="p-s5" d="M 162 724   C 300 724,   370 460, 446 460"></path>
          <path id="p-s6" d="M 162 855.6 C 300 855.6, 370 460, 446 460"></path>
          <path id="p-a0" d="M 634 460 C 750 460, 830 82.8,  950 82.8"></path>
          <path id="p-a1" d="M 634 460 C 750 460, 860 276,   1026 276"></path>
          <path id="p-a2" d="M 634 460 C 750 460, 830 469.2, 950 469.2"></path>
          <path id="p-a3" d="M 634 460 C 750 460, 860 662.4, 1026 662.4"></path>
          <path id="p-a4" d="M 634 460 C 750 460, 830 855.6, 950 855.6"></path>
        </g>
        <g filter="url(#hub-glow)">
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.4s" begin="0.4s" repeatCount="indefinite"
              ><mpath href="#p-s0"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.5s" begin="0.7s" repeatCount="indefinite"
              ><mpath href="#p-s1"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.2s" begin="1.0s" repeatCount="indefinite"
              ><mpath href="#p-s2"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.6s" begin="0.2s" repeatCount="indefinite"
              ><mpath href="#p-s3"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.7s" begin="0.9s" repeatCount="indefinite"
              ><mpath href="#p-s4"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.3s" begin="1.4s" repeatCount="indefinite"
              ><mpath href="#p-s5"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#ea580c"
            ><animateMotion dur="2.6s" begin="0.6s" repeatCount="indefinite"
              ><mpath href="#p-s6"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#fbbf24"
            ><animateMotion dur="1.9s" begin="1.6s" repeatCount="indefinite"
              ><mpath href="#p-a0"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#fbbf24"
            ><animateMotion dur="1.8s" begin="2.0s" repeatCount="indefinite"
              ><mpath href="#p-a1"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#fbbf24"
            ><animateMotion dur="2.0s" begin="2.4s" repeatCount="indefinite"
              ><mpath href="#p-a2"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#fbbf24"
            ><animateMotion dur="1.9s" begin="2.8s" repeatCount="indefinite"
              ><mpath href="#p-a3"></mpath></animateMotion
            ></circle
          >
          <circle r="3.5" fill="#fbbf24"
            ><animateMotion dur="2.1s" begin="3.2s" repeatCount="indefinite"
              ><mpath href="#p-a4"></mpath></animateMotion
            ></circle
          >
        </g>
      </svg>

      <div class="absolute inset-0 pointer-events-none">
        <!-- SOURCES -->
        {
          sources.map(({ i, top, label, src, imgSize }) => (
            <div
              class="hub-src-card absolute flex h-[50px] w-[50px] items-center justify-center overflow-hidden rounded-xl bg-white"
              data-i={i}
              style={`left:10%; top:${top}; transform: translate(-50%,-50%); box-shadow: var(--shadow-hub-src);`}
              title={label}
            >
              <img
                src={src}
                alt={label}
                class="object-contain"
                style={imgSize ? `width:${imgSize};height:${imgSize};` : 'width:100%;height:100%;'}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }

        <!-- CENTER -->
        <div
          class="hub-ring-el r1 absolute rounded-[42px] border-[1.5px] border-hatch-accent/[0.22]"
          style="left:50%; top:50%; transform: translate(-50%,-50%); width:100px; height:100px; animation: hubRingPulse 3s ease-out infinite;"
        >
        </div>
        <div
          class="hub-ring-el r2 absolute rounded-[42px] border-[1.5px] border-hatch-accent/[0.22]"
          style="left:50%; top:50%; transform: translate(-50%,-50%); width:100px; height:100px; animation: hubRingPulse 3s ease-out 1.5s infinite;"
        >
        </div>
        <div
          class="hub-center-card absolute flex h-[100px] w-[100px] items-center justify-center rounded-[22px] bg-white p-2"
          style="left:50%; top:50%; transform: translate(-50%,-50%); z-index:5; box-shadow: var(--shadow-hub-center);"
        >
          <div class="hub-center-inner h-full w-full overflow-hidden rounded-2xl">
            <img src="/logos/src-hatch.png" alt="Hatch" class="h-full w-full object-cover" />
          </div>
          <div
            class="hub-center-name absolute left-1/2 top-[calc(100%+18px)] -translate-x-1/2 whitespace-nowrap text-center"
          >
            <strong class="block text-[15px] font-bold tracking-[-0.02em] text-slate-900"
              >Hatch</strong
            >
            <span
              class="mt-[3px] block font-mono text-[8px] uppercase tracking-[0.14em] text-hatch-accent-deep"
              >{data.centerLabel}</span
            >
          </div>
        </div>

        <!-- AGENTS -->
        {
          agents.map(({ key, name, top, left }) => (
            <div
              class="hub-agent-card absolute flex flex-col items-center"
              data-i={key}
              style={`left:${left}; top:${top}; transform: translate(-50%,-50%); width:64px; pointer-events: auto;`}
            >
              {key === 'jay' && <JayAvatar size={46} />}
              {key === 'peep' && <PeepAvatar size={46} />}
              {key === 'sparrow' && <SparrowAvatar size={46} />}
              {key === 'finch' && <FinchAvatar size={46} />}
              {key === 'pecker' && <PeckerAvatar size={46} />}
              <span class="hub-agent-name mt-[4px] block whitespace-nowrap text-center font-display text-[10px] font-bold tracking-[-0.01em] text-slate-900">
                {name}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ── Mobile hub (visible only on small screens) ──
         Strategy: fixed-height container, all elements absolutely positioned.
         SVG viewBox="0 0 100 100" with preserveAspectRatio="none" so that
         SVG coordinate X = CSS left X%, SVG coordinate Y = CSS top Y%.
         This guarantees lines connect exactly to icon/bird centers.
         ─── Coordinates ───────────────────────────────────────────
         Source icon centers  : x=10,  y=13 / 37 / 62 / 87
         Hub card center      : x=50,  y=50
         Agent bird centers   : x=90,  y=22 / 50 / 78
         ─────────────────────────────────────────────────────────── -->
    <div
      class="hub-mobile relative mx-auto block overflow-hidden rounded-2xl md:hidden"
      style="background: var(--hub-gradient); max-width: 380px; height: 228px;"
    >
      <!-- radial gradient overlays -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(50% 60% at 18% 30%, rgba(254,215,170,0.55), transparent 60%), radial-gradient(40% 50% at 82% 72%, rgba(253,186,116,0.3), transparent 55%);"
        aria-hidden="true"
      >
      </div>

      <!-- SVG: lines + animated dots — covers the FULL container -->
      <svg
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        class="absolute inset-0 h-full w-full"
        style="z-index:1;"
        aria-hidden="true"
      >
        <!-- connection lines: sources → hub, hub → agents -->
        <g fill="none" stroke="#e2c9a8" stroke-width="0.55">
          <path d="M 10 13 Q 30 13 50 50"></path>
          <path d="M 10 37 Q 30 37 50 50"></path>
          <path d="M 10 62 Q 30 62 50 50"></path>
          <path d="M 10 87 Q 30 87 50 50"></path>
          <path d="M 50 50 Q 70 22 90 22"></path>
          <path d="M 50 50 Q 70 50 90 50"></path>
          <path d="M 50 50 Q 70 78 90 78"></path>
        </g>
        <!-- orange dots: sources → hub -->
        <circle r="1.6" fill="#ea580c" opacity="0.9">
          <animateMotion dur="1.8s" begin="0s" repeatCount="indefinite" path="M 10 13 Q 30 13 50 50"
          ></animateMotion>
        </circle>
        <circle r="1.6" fill="#ea580c" opacity="0.9">
          <animateMotion
            dur="2.0s"
            begin="0.6s"
            repeatCount="indefinite"
            path="M 10 37 Q 30 37 50 50"></animateMotion>
        </circle>
        <circle r="1.6" fill="#ea580c" opacity="0.9">
          <animateMotion
            dur="1.9s"
            begin="1.2s"
            repeatCount="indefinite"
            path="M 10 62 Q 30 62 50 50"></animateMotion>
        </circle>
        <circle r="1.6" fill="#ea580c" opacity="0.9">
          <animateMotion
            dur="2.1s"
            begin="1.8s"
            repeatCount="indefinite"
            path="M 10 87 Q 30 87 50 50"></animateMotion>
        </circle>
        <!-- yellow dots: hub → agents -->
        <circle r="1.6" fill="#fbbf24" opacity="0.95">
          <animateMotion
            dur="1.6s"
            begin="0.3s"
            repeatCount="indefinite"
            path="M 50 50 Q 70 22 90 22"></animateMotion>
        </circle>
        <circle r="1.6" fill="#fbbf24" opacity="0.95">
          <animateMotion
            dur="1.7s"
            begin="1.0s"
            repeatCount="indefinite"
            path="M 50 50 Q 70 50 90 50"></animateMotion>
        </circle>
        <circle r="1.6" fill="#fbbf24" opacity="0.95">
          <animateMotion
            dur="1.8s"
            begin="1.6s"
            repeatCount="indefinite"
            path="M 50 50 Q 70 78 90 78"></animateMotion>
        </circle>
      </svg>

      <!-- SOURCE icons: absolutely placed so their centers match SVG coordinates
           Icon size 38×38 → offset = 19px from center point -->
      {
        sources.slice(0, 4).map(({ label, src, imgSize }, idx) => {
          const yPct = [13, 37, 62, 87][idx];
          return (
            <div
              class="absolute flex h-[38px] w-[38px] items-center justify-center overflow-hidden rounded-xl bg-white"
              style={`left: calc(10% - 19px); top: calc(${yPct}% - 19px); z-index:2; box-shadow: var(--shadow-hub-src);`}
              title={label}
            >
              <img
                src={src}
                alt={label}
                class="object-contain"
                style={imgSize ? `width:${imgSize};height:${imgSize};` : 'width:88%;height:88%;'}
                loading="lazy"
                decoding="async"
              />
            </div>
          );
        })
      }

      <!-- HUB pulse rings: centered exactly at (50%, 50%) of the container -->
      <div
        class="absolute"
        style="width:64px;height:64px;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:18px;border:1.5px solid rgba(234,88,12,0.22);animation:hubRingPulse 3s ease-out infinite;z-index:2;"
      >
      </div>
      <div
        class="absolute"
        style="width:64px;height:64px;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:18px;border:1.5px solid rgba(234,88,12,0.22);animation:hubRingPulse 3s ease-out 1.5s infinite;z-index:2;"
      >
      </div>

      <!-- HUB card: its center sits at exactly (50%, 50%) — matches SVG hub coordinates -->
      <div
        class="absolute flex h-[64px] w-[64px] items-center justify-center overflow-hidden rounded-[18px] bg-white"
        style="left:50%;top:50%;transform:translate(-50%,-50%);z-index:3;box-shadow:var(--shadow-hub-center);"
      >
        <img
          src="/logos/src-hatch.png"
          alt="Hatch"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- HUB label: sits below the card (card bottom = 50%+32px) -->
      <div
        class="absolute text-center"
        style="left:50%;top:calc(50% + 38px);transform:translateX(-50%);z-index:3;white-space:nowrap;"
      >
        <strong class="block text-[10px] font-bold tracking-[-0.01em] text-slate-900">Hatch</strong>
        <span class="block font-mono text-[7px] uppercase tracking-[0.1em] text-hatch-accent-deep"
          >{data.centerLabel}</span
        >
      </div>

      <!-- AGENT birds: centered at x=90%, y=22/50/78%
           Bird component renders ~42×42px → offset = 21px -->
      <div class="absolute" style="left:calc(90% - 21px); top:calc(22% - 21px); z-index:2;">
        <JayAvatar size={42} />
      </div>
      <div class="absolute" style="left:calc(90% - 21px); top:calc(50% - 21px); z-index:2;">
        <PeepAvatar size={42} />
      </div>
      <div class="absolute" style="left:calc(90% - 21px); top:calc(78% - 21px); z-index:2;">
        <SparrowAvatar size={42} />
      </div>
    </div>
  </div>
</section>

<style>
  .hub-src-card {
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.3s;
  }
  .hub-src-card:hover {
    transform: translate(-50%, -50%) scale(1.06) !important;
  }
  .hub-agent-card {
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hub-agent-card:hover {
    transform: translate(-50%, -50%) scale(1.1) !important;
  }
</style>
