---
/**
 * MAQUETTE — la section Tarifs de l'espace réseau en formulaire (agents, réseau, coordonnées),
 * partagée par la page /maquettes/tarifs et la page réseau complète /maquettes/reseau.
 */
import { Image } from 'astro:assets';
import peep from '../../assets/portraits/peep.jpg';
import owl from '../../assets/portraits/owl.jpg';
import jay from '../../assets/portraits/jay.jpg';
import lark from '../../assets/portraits/lark.jpg';
import finch from '../../assets/portraits/finch.jpg';
import pecker from '../../assets/portraits/pecker.jpg';
import sparrow from '../../assets/portraits/sparrow.jpg';

/** Chaque agent face à nous, dans son cercle ; quand on le coche, il fait le geste de son métier (une fois). */
const a = (nom: string, role: string, img: ImageMetadata, miroir = false) => ({
  nom,
  role,
  img,
  miroir,
  video: `/maquettes/anim/${nom.toLowerCase()}-geste.mp4`,
});

const offres = [
  {
    id: 'socle',
    nom: 'Le socle',
    tag: 'Base de chaque équipe',
    texte:
      'Peep répond à vos équipes sur WhatsApp, Owl en cuisine sur tablette, Jay tient vos documents à jour, Lark pilote le réseau.',
    agents: [
      a('Peep', 'Vos équipes', peep),
      a('Owl', 'La cuisine', owl),
      a('Jay', 'Vos documents', jay),
      a('Lark', 'Le pilotage', lark),
    ],
    coche: true,
  },
  {
    id: 'finch',
    nom: 'Finch',
    tag: 'Qualité et audits',
    texte: "Prépare les grilles d'audit, suit chaque plan d'action jusqu'à la preuve.",
    agents: [a('Finch', 'Qualité', finch)],
  },
  {
    id: 'pecker',
    nom: 'Pecker',
    tag: 'Formation',
    texte: 'Transforme vos procédures en parcours courts et relance ceux qui ne les ont pas faits.',
    agents: [a('Pecker', 'Formation', pecker)],
  },
  {
    id: 'sparrow',
    nom: 'Sparrow',
    tag: 'Développement et ouvertures',
    texte: 'Pré-qualifie vos candidats à la franchise et suit chaque ouverture jusqu\'au jour J.',
    agents: [a('Sparrow', 'Développement', sparrow)],
  },
];

const ouvertures = ['1 à 3', '4 à 10', '11 à 25', 'Plus de 25'];
const etapes = [
  ['Vous choisissez vos agents', 'Et vous nous dites combien d\'établissements compte votre réseau.'],
  ['Vous réservez un créneau', 'Vos réponses sont jointes à la réservation, pas besoin de tout répéter.'],
  ['On vous présente votre tarif', 'Calé sur vos agents et la taille de votre réseau, pendant la démo.'],
];
---

<section id="tarifs" class="bg-cream pt-28 pb-20 lg:pt-36 lg:pb-28">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
    <div class="mx-auto mb-10 flex max-w-[760px] flex-col items-center gap-4 text-center lg:mb-14">
      <span class="font-mono text-[12px] tracking-[0.16em] text-orange-txt uppercase">Tarifs</span>
      <h1 class="font-display text-[36px] leading-[1.06] font-semibold tracking-[-0.02em] text-ink lg:text-[54px]">
        Composez votre équipe d'agents.
      </h1>
      <p class="text-[16px] leading-7 text-soft lg:text-[17px]">
        Chaque réseau est différent. Dites-nous ce qui vous intéresse : on vous présente un tarif
        adapté à vos agents et à la taille de votre réseau, pendant la démo.
      </p>
    </div>

    <div class="grid items-start gap-5 lg:grid-cols-[1fr_340px]">
      <form
        class="flex flex-col gap-9 rounded-[28px] bg-surface p-6 shadow-1 ring-1 ring-line sm:p-8 lg:rounded-[36px] lg:p-10"
        onsubmit="event.preventDefault()"
      >
        <!-- 1 · Agents -->
        <fieldset class="flex flex-col gap-4">
          <legend class="etape"><span>1</span>Quels agents vous intéressent ?</legend>
          <div class="grid gap-3 sm:grid-cols-3" data-equipe>
            {
              offres.map((o) => (
                <label class:list={['agent', o.id === 'socle' && 'socle sm:col-span-3']}>
                  <input type="checkbox" id={`a-${o.id}`} name="agents" value={o.id} checked={o.coche} class="sr-only" />
                  <span class="troupe" aria-hidden="true">
                    {o.agents.map((ag, k) => (
                      <span class="membre" style={`--k:${k}`}>
                        <span class:list={['rond', ag.miroir && 'miroir']}>
                          <video src={ag.video} poster={ag.img.src} muted playsinline preload="none" />
                        </span>
                        {o.id === 'socle' && (
                          <span class="membre-nom">
                            <b>{ag.nom}</b> {ag.role}
                          </span>
                        )}
                      </span>
                    ))}
                  </span>
                  <span class="flex flex-col gap-1">
                    <span class="flex flex-wrap items-baseline gap-x-3">
                      <b class="font-display text-[20px] text-ink">{o.nom}</b>
                      <span class="font-mono text-[11px] tracking-[0.14em] text-orange-txt uppercase">{o.tag}</span>
                    </span>
                    <span class="text-[14px] leading-5 text-soft">{o.texte}</span>
                    {(o.id === 'finch' || o.id === 'pecker') && (
                      <span class="avec-socle">S'ajoute au socle</span>
                    )}
                    {o.id === 'socle' && (
                      <span class="requis" data-requis>
                        Inclus d'office avec Finch ou Pecker
                      </span>
                    )}
                  </span>
                  <span class="coche" aria-hidden="true">✓</span>
                </label>
              ))
            }
          </div>
          <!-- N'apparaît que si Sparrow est coché : c'est ce qui fixe son prix. -->
          <div class="ouvertures flex-col gap-3 rounded-2xl bg-surface-2 p-5 ring-1 ring-line">
            <span class="text-[14px] font-semibold text-ink">Combien d'ouvertures prévoyez-vous par an ?</span>
            <div class="flex flex-wrap gap-2">
              {
                ouvertures.map((v, i) => (
                  <label class="choix">
                    <input type="radio" name="ouvertures" value={v} checked={i === 1} class="sr-only" />
                    <span>{v}</span>
                  </label>
                ))
              }
            </div>
          </div>
        </fieldset>

        <!-- 2 · Réseau -->
        <fieldset class="flex flex-col gap-4">
          <legend class="etape"><span>2</span>Votre réseau</legend>
          <div class="grid gap-3 sm:grid-cols-[1fr_220px]">
            <label class="champ"><span>Nom de l'enseigne</span><input placeholder="BunBun" autocomplete="organization" /></label>
            <label class="champ"><span>Nombre d'établissements</span><input type="number" min="1" placeholder="24" /></label>
          </div>
        </fieldset>

        <!-- 3 · Contact -->
        <fieldset class="flex flex-col gap-4">
          <legend class="etape"><span>3</span>Vos coordonnées</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="champ"><span>Prénom et nom</span><input placeholder="Camille Martin" autocomplete="name" /></label>
            <label class="champ"><span>Votre rôle</span><input placeholder="Directrice des opérations" autocomplete="organization-title" /></label>
            <label class="champ"><span>Email professionnel</span><input type="email" placeholder="camille@bunbun.fr" autocomplete="email" /></label>
            <label class="champ"><span>Téléphone</span><input type="tel" placeholder="06 12 34 56 78" autocomplete="tel" /></label>
          </div>
          <label class="decide">
            <input type="checkbox" name="decisionnaire" class="sr-only" />
            <span class="decide-case" aria-hidden="true">✓</span>
            <span>Je suis décisionnaire pour ce projet</span>
          </label>
        </fieldset>

        <div class="flex flex-col items-start gap-3 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-[380px] text-[13.5px] leading-5 text-soft">
            Étape suivante : vous choisissez un créneau, vos réponses sont jointes à la réservation.
          </p>
          <button
            type="submit"
            class="btn-vif inline-flex items-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink shadow-[0_10px_24px_rgb(248_122_1/0.4)]"
          >
            Choisir un créneau de démo <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>

      <!-- Comment ça se passe -->
      <aside class="flex flex-col gap-6 rounded-[28px] bg-night p-7 text-cream lg:sticky lg:top-28 lg:rounded-[36px] lg:p-8">
        <span class="font-mono text-[12px] tracking-[0.16em] text-peach uppercase">Comment ça se passe</span>
        <ol class="flex flex-col gap-5">
          {
            etapes.map(([t, d], i) => (
              <li class="flex gap-4">
                <span class="flex size-8 flex-none items-center justify-center rounded-full bg-orange font-mono text-[13px] text-ink">{i + 1}</span>
                <span class="flex flex-col gap-1">
                  <b class="text-[15px]">{t}</b>
                  <span class="text-[13.5px] leading-5 text-cream/70">{d}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="border-t border-line-night pt-5 text-[13px] leading-5 text-cream/70">
          Sans engagement. Vos données servent uniquement à préparer la démo.
        </p>
      </aside>
    </div>
  </div>
</section>
<script is:inline data-keep>
  // Le socle est obligatoire pour prendre Finch ou Pecker : dès que l'un des deux est coché, le socle
  // se coche et se verrouille (on ne peut plus le décocher) ; il se libère quand aucun des deux ne l'est.
  (function () {
    var socle = document.getElementById('a-socle');
    if (!socle) return;
    var lies = ['a-finch', 'a-pecker']
      .map(function (id) {
        return document.getElementById(id);
      })
      .filter(Boolean);
    var carte = socle.closest('.agent');
    function regler() {
      var verrou = lies.some(function (i) {
        return i.checked;
      });
      if (verrou && !socle.checked) {
        socle.checked = true;
        socle.dispatchEvent(new Event('change'));
      }
      carte.classList.toggle('verrou', verrou);
      socle.setAttribute('aria-disabled', verrou ? 'true' : 'false');
    }
    socle.addEventListener('click', function (e) {
      if (carte.classList.contains('verrou')) e.preventDefault();
    });
    lies.forEach(function (i) {
      i.addEventListener('change', regler);
    });
    regler();
  })();
</script>
<script is:inline data-keep>
  // Cocher un agent le fait sortir de son cercle et dire coucou : la vidéo se joue une fois, puis
  // s'arrête (pas de boucle, donc pas de pause nécessaire). Survol : même coucou. Mouvement réduit : rien.
  (function () {
    var root = document.querySelector('[data-equipe]');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    function coucou(label) {
      [].slice.call(label.querySelectorAll('video')).forEach(function (v, k) {
        setTimeout(function () {
          v.currentTime = 0;
          v.play().catch(function () {});
        }, k * 220);
      });
    }
    [].slice.call(root.querySelectorAll('.agent')).forEach(function (label) {
      var input = label.querySelector('input');
      input.addEventListener('change', function () {
        if (input.checked) coucou(label);
      });
      label.addEventListener('mouseenter', function () {
        coucou(label);
      });
    });
    // À l'arrivée sur la page, le socle (coché d'office) salue une fois.
    var socle = root.querySelector('.socle');
    if (socle && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) {
        if (e[0].isIntersecting) {
          io.disconnect();
          coucou(socle);
        }
      }, { threshold: 0.6 });
      io.observe(socle);
    }
  })();
</script>

<style>
  .etape {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .etape span {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-cream);
    font: 400 13px var(--font-mono);
  }

  /* Carte d'agent sélectionnable : un vrai checkbox caché, l'état se lit sur la carte. Les agents
     sont face à nous, chacun dans son cercle ; cochés, ils se lèvent un peu et font coucou. */
  .agent {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 18px 18px;
    border-radius: 20px;
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
    cursor: pointer;
    transition:
      box-shadow 0.2s,
      background 0.2s;
  }
  .agent:hover {
    box-shadow: inset 0 0 0 1px var(--color-stone);
  }
  .agent:has(input:checked) {
    background: var(--color-peach-2);
    box-shadow: inset 0 0 0 2px var(--color-orange);
  }
  .agent:has(input:focus-visible) {
    outline: 3px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .troupe {
    display: flex;
    gap: 18px;
  }
  .membre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .rond {
    display: block;
    width: 84px;
    height: 84px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-cream-2);
    box-shadow: 0 0 0 3px var(--color-surface);
    transition: translate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--k) * 60ms);
  }
  .rond video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Un agent sur deux est vu en miroir : il salue de l'autre aile, les coucous ne se ressemblent pas tous. */
  .rond.miroir video {
    scale: -1 1;
  }
  .agent:has(input:checked) .rond {
    translate: 0 -4px;
  }
  .membre-nom {
    font-size: 12.5px;
    line-height: 1.25;
    text-align: center;
    color: var(--color-soft);
  }
  .membre-nom b {
    display: block;
    font-size: 14px;
    color: var(--color-ink);
  }
  /* Le socle : les quatre en rang, le texte à côté sur très grand écran, dessous sinon. */
  .socle {
    gap: 18px;
  }
  @media (min-width: 80rem) {
    .socle {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      padding: 22px 56px 22px 24px;
    }
    .socle .troupe {
      flex: none;
    }
  }
  @media (max-width: 30rem) {
    .socle .troupe {
      gap: 10px;
    }
    .socle .rond {
      width: 64px;
      height: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rond {
      transition: none;
    }
  }
  /* Finch et Pecker s'ajoutent au socle ; le socle verrouillé le dit. */
  .avec-socle,
  .requis {
    margin-top: 4px;
    font: 400 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-soft);
  }
  .requis {
    display: none;
    color: var(--color-orange-txt);
  }
  .agent.verrou .requis {
    display: block;
  }
  .agent.verrou {
    cursor: default;
  }
  .coche {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    box-shadow: inset 0 0 0 1.5px var(--color-stone);
    color: transparent;
    font-size: 14px;
    font-weight: 700;
  }
  .agent:has(input:checked) .coche {
    background: var(--color-orange);
    box-shadow: none;
    color: var(--color-ink);
  }

  /* La question des ouvertures n'existe que si Sparrow est coché. */
  .ouvertures {
    display: none;
  }
  form:has(#a-sparrow:checked) .ouvertures {
    display: flex;
  }
  .choix span {
    display: inline-flex;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }
  .choix input:checked + span {
    background: var(--color-ink);
    color: var(--color-cream);
    box-shadow: none;
  }

  /* La coche « décisionnaire » : même case que les cartes d'agents. */
  .decide {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }
  .decide-case {
    display: flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px var(--color-stone);
    color: transparent;
    font-size: 13px;
    font-weight: 700;
  }
  .decide input:checked + .decide-case {
    background: var(--color-orange);
    box-shadow: none;
    color: var(--color-ink);
  }
  .decide input:focus-visible + .decide-case {
    outline: 3px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .champ {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .champ input {
    height: 48px;
    padding: 0 16px;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-surface-2);
    font: 400 15px var(--font-sans);
    color: var(--color-ink);
    outline: none;
  }
  .champ input::placeholder {
    color: var(--color-muted);
  }
  .champ input:focus {
    border-color: var(--color-orange-txt);
    box-shadow: 0 0 0 4px var(--color-orange-tint);
  }
</style>
