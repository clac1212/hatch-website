---
/**
 * MOCKUP (EN): the network area's Pricing section as a form (agents, network, contact details),
 * English version of ../TarifsFormulaire.astro.
 */
import { Image } from 'astro:assets';
import peep from '../../../assets/portraits/peep.jpg';
import owl from '../../../assets/portraits/owl.jpg';
import jay from '../../../assets/portraits/jay.jpg';
import lark from '../../../assets/portraits/lark.jpg';
import finch from '../../../assets/portraits/finch.jpg';
import pecker from '../../../assets/portraits/pecker.jpg';
import sparrow from '../../../assets/portraits/sparrow.jpg';

/** Each agent faces us in a circle; when checked, it does its job's gesture (once). */
const a = (nom: string, role: string, img: ImageMetadata, miroir = false) => ({
  nom,
  role,
  img,
  miroir,
  video: `/maquettes/anim/${nom.toLowerCase()}-geste.mp4`,
});

const offres = [
  {
    id: 'socle',
    nom: 'The Core',
    tag: 'Every team starts here',
    texte:
      'Peep answers your teams on WhatsApp, Owl works in the kitchen on a tablet, Jay keeps your documents up to date, Lark runs the network.',
    agents: [
      a('Peep', 'Your teams', peep),
      a('Owl', 'The kitchen', owl),
      a('Jay', 'Your documents', jay),
      a('Lark', 'Management', lark),
    ],
    coche: true,
  },
  {
    id: 'finch',
    nom: 'Finch',
    tag: 'Quality and audits',
    texte: 'Prepares audit checklists and follows every action plan through to proof.',
    agents: [a('Finch', 'Quality', finch)],
  },
  {
    id: 'pecker',
    nom: 'Pecker',
    tag: 'Training',
    texte: "Turns your procedures into short courses and follows up with those who haven't taken them.",
    agents: [a('Pecker', 'Training', pecker)],
  },
  {
    id: 'sparrow',
    nom: 'Sparrow',
    tag: 'Development and openings',
    texte: 'Pre-qualifies your franchise candidates and tracks every opening through to launch day.',
    agents: [a('Sparrow', 'Development', sparrow)],
  },
];

const ouvertures = ['1 to 3', '4 to 10', '11 to 25', 'More than 25'];
const etapes = [
  ['You pick your agents', 'And tell us how many locations your network has.'],
  ['You book a slot', 'Your answers are attached to the booking, no need to repeat anything.'],
  ['We present your pricing', 'Based on your agents and the size of your network, during the demo.'],
];
---

<section id="tarifs" class="bg-cream pt-16 pb-20 lg:pt-20 lg:pb-28">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
    <div class="mx-auto mb-10 flex max-w-[760px] flex-col items-center gap-4 text-center lg:mb-14">
      <h2 class="font-display text-[36px] leading-[1.06] font-semibold tracking-[-0.02em] text-ink lg:text-[54px]">
        Build your team of agents.
      </h2>
      <p class="text-[16px] leading-7 text-soft lg:text-[17px]">
        Every network is different. Tell us what you are interested in: we present pricing
        tailored to your agents and the size of your network, during the demo.
      </p>
    </div>

    <div class="grid items-start gap-5 lg:grid-cols-[1fr_340px]">
      <form
      data-tarifs
      novalidate
        class="flex flex-col gap-9 rounded-[28px] bg-surface p-6 shadow-1 ring-1 ring-line sm:p-8 lg:rounded-[36px] lg:p-10"
        onsubmit="event.preventDefault()"
      >
        <!-- 1 · Agents -->
        <fieldset class="flex flex-col gap-4">
          <legend class="etape" data-etape="1"><span>1</span>Which agents are you interested in?</legend>
          <button type="button" class="anim-pause" data-anim-pause aria-pressed="false" hidden>
            <span class="ap-ico" aria-hidden="true"></span>
            <span data-anim-label>Pause animations</span>
          </button>
          <div class="grid gap-3 sm:grid-cols-3" data-equipe>
            {
              offres.map((o) => (
                <label class:list={['agent', o.id === 'socle' && 'socle sm:col-span-3']}>
                  <input type="checkbox" id={`a-${o.id}`} name="agents" value={o.id} checked={o.coche} class="sr-only" />
                  <span class="troupe" aria-hidden="true">
                    {o.agents.map((ag, k) => (
                      <span class="membre" style={`--k:${k}`}>
                        <span class:list={['rond', ag.miroir && 'miroir']}>
                          <video src={ag.video} poster={ag.img.src} muted playsinline preload="none" />
                        </span>
                        {o.id === 'socle' && (
                          <span class="membre-nom">
                            <b>{ag.nom}</b> {ag.role}
                          </span>
                        )}
                      </span>
                    ))}
                  </span>
                  <span class="flex flex-col gap-1">
                    {(o.id === 'finch' || o.id === 'pecker') && (
                      <span class="avec-socle">
                        <span aria-hidden="true">+</span> Adds to the Core
                      </span>
                    )}
                    <span class="flex flex-wrap items-baseline gap-x-3">
                      <b class="font-display text-[20px] text-ink">{o.nom}</b>
                      <span class="font-mono text-[11px] tracking-[0.14em] text-orange-txt uppercase">{o.tag}</span>
                    </span>
                    <span class="text-[14px] leading-5 text-soft">{o.texte}</span>
                    {o.id === 'socle' && (
                      <span class="requis" data-requis>
                        Always included with Finch or Pecker
                      </span>
                    )}
                  </span>
                  <span class="coche" aria-hidden="true">✓</span>
                </label>
              ))
            }
          </div>
          <!-- Only shown when Sparrow is checked: this is what sets its price. -->
          <div class="ouvertures flex-col gap-3 rounded-2xl bg-surface-2 p-5 ring-1 ring-line">
            <span class="text-[14px] font-semibold text-ink">How many openings do you plan per year?</span>
            <div class="flex flex-wrap gap-2">
              {
                ouvertures.map((v, i) => (
                  <label class="choix">
                    <input type="radio" name="ouvertures" value={v} checked={i === 1} class="sr-only" />
                    <span>{v}</span>
                  </label>
                ))
              }
            </div>
          </div>
        </fieldset>

        <!-- 2 · Network -->
        <fieldset class="flex flex-col gap-4">
          <legend class="etape" data-etape="2"><span>2</span>Your network</legend>
          <div class="grid gap-3 sm:grid-cols-[1fr_220px]">
            <label class="champ"><span>Brand name</span><input id="t-enseigne" name="enseigne" required data-e="2" placeholder="BunBun" autocomplete="organization" /></label>
            <label class="champ"><span>Number of locations</span><input id="t-etablissements" name="etablissements" type="number" min="1" required data-e="2" placeholder="24" /></label>
          </div>
        </fieldset>

        <!-- 3 · Contact -->
        <fieldset class="flex flex-col gap-4">
          <legend class="etape" data-etape="3"><span>3</span>Your contact details</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="champ"><span>Full name</span><input id="t-nom" name="nom" required data-e="3" placeholder="Camille Martin" autocomplete="name" /></label>
            <label class="champ"><span>Your role</span><input id="t-role" name="role" required data-e="3" placeholder="Head of Operations" autocomplete="organization-title" /></label>
            <label class="champ"><span>Work email</span><input id="t-email" name="email" type="email" required data-e="3" placeholder="camille@bunbun.com" autocomplete="email" /></label>
            <label class="champ"><span>Phone</span><input id="t-tel" name="telephone" type="tel" required data-e="3" placeholder="+33 6 12 34 56 78" autocomplete="tel" /></label>
          </div>
          <label class="decide">
            <input type="checkbox" name="decisionnaire" class="sr-only" />
            <span class="decide-case" aria-hidden="true">✓</span>
            <span>I am a decision maker for this project</span>
          </label>
        </fieldset>

        <div class="flex flex-col items-start gap-3 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-[380px] text-[13.5px] leading-5 text-soft" data-reste aria-live="polite">
            Next step: you pick a slot, and your answers are attached to the booking.
          </p>
          <button
            type="submit"
            data-envoi
            class="envoi btn-vif inline-flex items-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink shadow-[0_10px_24px_rgb(248_122_1/0.4)]"
          >
            Pick a demo slot <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>

      <!-- How it works -->
      <aside class="flex flex-col gap-6 rounded-[28px] bg-night p-7 text-cream lg:sticky lg:top-28 lg:rounded-[36px] lg:p-8">
        <span class="font-mono text-[12px] tracking-[0.16em] text-peach uppercase">How it works</span>
        <ol class="flex flex-col gap-5">
          {
            etapes.map(([t, d], i) => (
              <li class="flex gap-4">
                <span class="flex size-8 flex-none items-center justify-center rounded-full bg-orange font-mono text-[13px] text-ink">{i + 1}</span>
                <span class="flex flex-col gap-1">
                  <b class="text-[15px]">{t}</b>
                  <span class="text-[13.5px] leading-5 text-cream/70">{d}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="border-t border-line-night pt-5 text-[13px] leading-5 text-cream/70">
          No commitment. Your data is only used to prepare the demo.
        </p>
      </aside>
    </div>
  </div>
</section>
<script is:inline data-keep>
  // All three steps are required: at least one agent, the brand and its size, contact details
  // (the decision-maker box is optional). While something is missing, the button is inactive and the
  // line next to it says what's left; each completed step turns its badge into a check.
  (function () {
    var form = document.querySelector('[data-tarifs]');
    if (!form) return;
    var bouton = form.querySelector('[data-envoi]');
    var reste = form.querySelector('[data-reste]');
    var noms = { 1: 'pick at least one agent', 2: 'your network', 3: 'your contact details' };
    function ok(e) {
      if (e === 1) return !!form.querySelector('input[name="agents"]:checked');
      return [].slice.call(form.querySelectorAll('[data-e="' + e + '"]')).every(function (i) {
        return i.value.trim() !== '' && i.checkValidity();
      });
    }
    function regler() {
      var manque = [];
      [1, 2, 3].forEach(function (e) {
        var bon = ok(e);
        form.querySelector('[data-etape="' + e + '"]').classList.toggle('faite', bon);
        if (!bon) manque.push(e);
      });
      var pret = manque.length === 0;
      bouton.setAttribute('aria-disabled', pret ? 'false' : 'true');
      reste.textContent = pret
        ? 'All set: you pick a slot, and your answers are attached to the booking.'
        : 'Still to complete: ' +
          manque
            .map(function (e) {
              return noms[e] + ' (step ' + e + ')';
            })
            .join(', ') +
          '.';
    }
    form.addEventListener('input', regler);
    form.addEventListener('change', regler);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (bouton.getAttribute('aria-disabled') === 'true') {
        [].slice.call(form.querySelectorAll('[data-e]')).some(function (i) {
          if (i.value.trim() === '' || !i.checkValidity()) {
            i.focus();
            return true;
          }
          return false;
        });
      }
    });
    regler();
  })();
</script>
<script is:inline data-keep>
  // The Core is required for Finch or Pecker: as soon as either is checked, the Core gets checked
  // and locked (it can't be unchecked); it unlocks when neither is checked.
  (function () {
    var socle = document.getElementById('a-socle');
    if (!socle) return;
    var lies = ['a-finch', 'a-pecker']
      .map(function (id) {
        return document.getElementById(id);
      })
      .filter(Boolean);
    var carte = socle.closest('.agent');
    function regler() {
      var verrou = lies.some(function (i) {
        return i.checked;
      });
      if (verrou && !socle.checked) {
        socle.checked = true;
        socle.dispatchEvent(new Event('change'));
      }
      carte.classList.toggle('verrou', verrou);
      socle.setAttribute('aria-disabled', verrou ? 'true' : 'false');
    }
    socle.addEventListener('click', function (e) {
      if (carte.classList.contains('verrou')) e.preventDefault();
    });
    lies.forEach(function (i) {
      i.addEventListener('change', regler);
    });
    regler();
  })();
</script>
<script is:inline data-keep>
  // The team feels alive: checking (or hovering) an agent plays its job gesture, then each checked
  // agent repeats it now and then at its own pace (6 to 10 s), so the chosen team moves and the others
  // stay still. Since it loops, a button pauses everything (WCAG 2.2.2). Reduced motion: no gesture, no button.
  (function () {
    var root = document.querySelector('[data-equipe]');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var bouton = document.querySelector('[data-anim-pause]');
    var label = document.querySelector('[data-anim-label]');
    var pause = false;
    var cartes = [].slice.call(root.querySelectorAll('.agent'));
    var n = 0;
    function jouer(v) {
      if (pause) return;
      clearTimeout(v._t);
      v.currentTime = 0;
      v.play().catch(function () {});
    }
    function geste(carte) {
      [].slice.call(carte.querySelectorAll('video')).forEach(function (v, k) {
        clearTimeout(v._t);
        v._t = setTimeout(function () {
          jouer(v);
        }, k * 220);
      });
    }
    cartes.forEach(function (carte) {
      var input = carte.querySelector('input');
      [].slice.call(carte.querySelectorAll('video')).forEach(function (v) {
        var rythme = 6000 + (n++ % 5) * 900;
        // Gesture ended: if checked, the agent will do it again a bit later.
        v.addEventListener('ended', function () {
          clearTimeout(v._t);
          if (!input.checked || pause) return;
          v._t = setTimeout(function () {
            if (input.checked) jouer(v);
          }, rythme + Math.random() * 1500);
        });
      });
      input.addEventListener('change', function () {
        if (input.checked) geste(carte);
      });
      carte.addEventListener('mouseenter', function () {
        geste(carte);
      });
    });
    if (bouton) {
      bouton.hidden = false;
      bouton.addEventListener('click', function () {
        pause = !pause;
        bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
        label.textContent = pause ? 'Resume animations' : 'Pause animations';
        cartes.forEach(function (carte) {
          [].slice.call(carte.querySelectorAll('video')).forEach(function (v) {
            clearTimeout(v._t);
            if (pause) v.pause();
          });
          if (!pause && carte.querySelector('input').checked) geste(carte);
        });
      });
    }
    // On arrival, the checked team waves once, then lives its life.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (e) {
          if (e[0].isIntersecting) {
            io.disconnect();
            cartes.forEach(function (c) {
              if (c.querySelector('input').checked) geste(c);
            });
          }
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    }
  })();
</script>

<style>
  .etape {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
  }
  /* Completed step: the badge turns orange with a check. */
  .etape.faite span {
    background: var(--color-orange);
    color: transparent;
    position: relative;
  }
  .etape.faite span::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-ink);
    font: 700 14px/1 var(--font-sans);
  }
  /* Button inactive until all three steps are complete. */
  .envoi[aria-disabled='true'] {
    background: var(--color-stone);
    box-shadow: none;
    color: var(--color-soft);
    cursor: not-allowed;
  }
  .etape span {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-cream);
    font: 400 13px var(--font-mono);
  }

  /* Selectable agent card: a real hidden checkbox, state shown on the card. Agents face us,
     each in a circle; when checked, they rise a little and wave. */
  .agent {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 18px 18px;
    border-radius: 20px;
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
    cursor: pointer;
    transition:
      box-shadow 0.2s,
      background 0.2s;
  }
  .agent:hover {
    box-shadow: inset 0 0 0 1px var(--color-stone);
  }
  .agent:has(input:checked) {
    background: var(--color-peach-2);
    box-shadow: inset 0 0 0 2px var(--color-orange);
  }
  .agent:has(input:focus-visible) {
    outline: 3px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .troupe {
    display: flex;
    gap: 18px;
  }
  .membre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .rond {
    display: block;
    width: 84px;
    height: 84px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-cream-2);
    box-shadow: 0 0 0 3px var(--color-surface);
    transition: translate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--k) * 60ms);
  }
  .rond video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Mirrored agents wave with the other wing, so the waves don't all look alike. */
  .rond.miroir video {
    scale: -1 1;
  }
  .agent:has(input:checked) .rond {
    translate: 0 -4px;
  }
  .membre-nom {
    font-size: 12.5px;
    line-height: 1.25;
    text-align: center;
    color: var(--color-soft);
  }
  .membre-nom b {
    display: block;
    font-size: 14px;
    color: var(--color-ink);
  }
  /* The Core: the four in a row, text beside them on very wide screens, below otherwise. */
  .socle {
    gap: 18px;
  }
  @media (min-width: 80rem) {
    .socle {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      padding: 22px 56px 22px 24px;
    }
    .socle .troupe {
      flex: none;
    }
  }
  @media (max-width: 30rem) {
    .socle .troupe {
      gap: 10px;
    }
    .socle .rond {
      width: 64px;
      height: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rond {
      transition: none;
    }
  }
  /* Discreet animation pause button, right-aligned above the grid. */
  .anim-pause {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-end;
    margin-top: -8px;
    padding: 6px 11px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    font: 600 12px/1 var(--font-sans);
    color: var(--color-soft);
    cursor: pointer;
  }
  .anim-pause[hidden] {
    display: none;
  }
  .anim-pause:hover,
  .anim-pause:focus-visible {
    color: var(--color-ink);
  }
  .anim-pause:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .ap-ico {
    width: 8px;
    height: 9px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .anim-pause[aria-pressed='true'] .ap-ico {
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-right: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }
  /* Finch and Pecker add to the Core; the locked Core says so. */
  .avec-socle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    align-self: flex-start;
    margin-bottom: 4px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--color-orange-tint);
    box-shadow: inset 0 0 0 1px var(--color-orange);
    font: 700 12px/1 var(--font-sans);
    color: var(--color-orange-txt);
    white-space: nowrap;
  }
  .requis {
    margin-top: 4px;
    font: 400 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .requis {
    display: none;
    color: var(--color-orange-txt);
  }
  .agent.verrou .requis {
    display: block;
  }
  .agent.verrou {
    cursor: default;
  }
  .coche {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    box-shadow: inset 0 0 0 1.5px var(--color-stone);
    color: transparent;
    font-size: 14px;
    font-weight: 700;
  }
  .agent:has(input:checked) .coche {
    background: var(--color-orange);
    box-shadow: none;
    color: var(--color-ink);
  }

  /* The openings question only exists when Sparrow is checked. */
  .ouvertures {
    display: none;
  }
  form:has(#a-sparrow:checked) .ouvertures {
    display: flex;
  }
  .choix span {
    display: inline-flex;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }
  .choix input:checked + span {
    background: var(--color-ink);
    color: var(--color-cream);
    box-shadow: none;
  }

  /* The decision-maker checkbox: same box as the agent cards. */
  .decide {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }
  .decide-case {
    display: flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px var(--color-stone);
    color: transparent;
    font-size: 13px;
    font-weight: 700;
  }
  .decide input:checked + .decide-case {
    background: var(--color-orange);
    box-shadow: none;
    color: var(--color-ink);
  }
  .decide input:focus-visible + .decide-case {
    outline: 3px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .champ {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .champ input {
    height: 48px;
