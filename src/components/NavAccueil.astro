---
import Logo from './ui/Logo.astro';
import { appUrls, routes, otherLocale, useTranslations, type Locale, type Paths } from '../i18n/ui';

/**
 * MAQUETTE — nav de la page d'accueil (le carrefour) et de l'espace indépendant.
 * Volontairement minimale, façon muse.ai : le logo, la langue, la connexion. Les liens de l'espace
 * réseau (agents, cas clients, tarifs, sécurité) et la démo restent dans Nav.astro.
 */
interface Props {
  locale: Locale;
  paths: Paths;
  /** `night` over a black hero (accueil), `day` on cream (Robin). */
  tone?: 'day' | 'night';
  /** A space of the site (Robin): the logo brings back to the top of this page, « Accueil » to the home. */
  espace?: boolean;
}

const { locale, paths, tone = 'day', espace = false } = Astro.props;
const nuit = tone === 'night';
const t = useTranslations(locale);
const other = otherLocale(locale);
---

<header class:list={['fixed inset-x-0 top-0 z-60 backdrop-blur-md', nuit ? 'bg-night/85' : 'bg-cream/85']}>
  <nav
    id="nav"
    aria-label={t('a11y.mainNav')}
    class="mx-auto flex max-w-[1360px] items-center justify-between gap-2 px-4 py-4 sm:px-6 lg:py-5"
  >
    <a href={espace ? '#' : routes.home[locale]} aria-label={t('a11y.home')} class="shrink-0">
      <Logo tone={nuit ? 'night' : 'day'} class="w-[76px] sm:w-[84px] md:w-[96px]" />
    </a>
    <div class="flex items-center gap-1">
      {
        espace && (
          <a
            href={routes.home[locale]}
            class:list={['inline-flex items-center gap-1 rounded-full px-2 py-2.5 text-[0.875rem] sm:px-3 font-semibold transition-colors', nuit ? 'text-cream/70 hover:text-orange' : 'text-soft hover:text-orange-hover']}
          >
            <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
            <span class="max-[359px]:sr-only">{t('nav.back')}</span>
          </a>
        )
      }
      <a
        href={paths[other]}
        hreflang={other}
        lang={other}
        class:list={['rounded-full px-2 py-2.5 text-[0.875rem] font-semibold uppercase sm:px-3 transition-colors', nuit ? 'text-cream/70 hover:text-orange' : 'text-soft hover:text-orange-hover']}
      >
        {other}<span class="sr-only"> · {t('lang.switch')}</span>
      </a>
      <a
        href={appUrls.login}
        class:list={['rounded-full px-4 py-2.5 text-[0.875rem] font-semibold whitespace-nowrap sm:px-5 transition-colors hover:bg-orange hover:text-ink', nuit ? 'bg-cream text-ink' : 'bg-ink text-cream']}
      >
        {t('nav.login')}
      </a>
    </div>
  </nav>
</header>
