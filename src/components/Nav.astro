---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import { routes, otherLocale, useTranslations, type Locale, type Route } from '../i18n/ui';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
const home = routes.home[locale];
const links = [
  { href: `${home}#agents`, label: t('nav.agents') },
  { href: `${home}#cas-clients`, label: t('nav.cases') },
  { href: `${home}#tarifs`, label: t('nav.pricing') },
  { href: routes.security[locale], label: t('nav.security') },
];
const other = otherLocale(locale);
---

<header class="fixed inset-x-0 top-4 z-50 px-4">
  <nav
    aria-label={t('a11y.mainNav')}
    class="mx-auto flex max-w-[78rem] items-center justify-between gap-6 rounded-full border border-white/80 bg-cream/85 py-2.5 pr-2.5 pl-6 shadow-2 backdrop-blur-[18px]"
  >
    <a href={home} aria-label={t('a11y.home')} class="shrink-0">
      <Logo class="w-[88px] md:w-[100px]" />
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[0.9375rem] font-medium transition-colors hover:text-orange-txt"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-5">
      <a
        href={routes[route][other]}
        hreflang={other}
        lang={other}
        class="hidden font-mono text-kicker uppercase transition-colors hover:text-orange-txt sm:block"
      >
        {other}<span class="sr-only"> · {t('lang.switch')}</span>
      </a>
      <Button href={routes.demo[locale]} class="hidden rounded-full sm:inline-flex">
        {t('cta.demo')}
      </Button>

      <details class="group relative lg:hidden">
        <summary
          class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full bg-ink text-white [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">{t('a11y.menu')}</span>
          <svg
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
            <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block"></path>
          </svg>
        </summary>
        <div
          class="absolute top-full right-0 mt-3 w-64 rounded-card border border-line bg-surface p-3 shadow-3"
        >
          <ul class="flex flex-col">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-btn px-3 py-2.5 font-medium hover:bg-cream-2"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={routes[route][other]}
                hreflang={other}
                lang={other}
                class="block rounded-btn px-3 py-2.5 font-medium hover:bg-cream-2"
              >
                {t('lang.switch')}
              </a>
            </li>
          </ul>
          <Button href={routes.demo[locale]} class="mt-2 w-full justify-center">
            {t('cta.demo')}
          </Button>
        </div>
      </details>
    </div>
  </nav>
</header>
