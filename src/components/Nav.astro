---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import { appUrls, routes, otherLocale, useTranslations, type Locale, type Paths } from '../i18n/ui';

/**
 * v4 nav: liquid-glass pill, centred and fixed at the top; a drop shadow appears once the page scrolls.
 * From lg it folds while the visitor scrolls down (César 05/10): only the logo, « Se connecter » and
 * the demo stay, the links, the language and « Essayer » slide shut; scrolling back up unfolds it.
 * A small dead zone (FOLD_DELTA) keeps it from flickering on tiny scroll jitters.
 */
interface Props {
  locale: Locale;
  paths: Paths;
}

const { locale, paths } = Astro.props;
const t = useTranslations(locale);
const home = routes.home[locale];
const links = [
  { href: `${home}#agents`, label: t('nav.agents') },
  { href: `${home}#cas-clients`, label: t('nav.cases') },
  { href: `${home}#tarifs`, label: t('nav.pricing') },
  { href: routes.security[locale], label: t('nav.security') },
];
const other = otherLocale(locale);
---

<header class="pointer-events-none fixed inset-x-0 top-3 z-60 flex justify-center px-3 md:top-5">
  <nav
    id="nav"
    aria-label={t('a11y.mainNav')}
    class="verre pointer-events-auto flex w-full max-w-max items-center gap-1.5 rounded-full py-2 pr-2 pl-5 transition-[filter] duration-500 max-sm:justify-between md:pl-6 [&.defile]:drop-shadow-[0_10px_24px_rgb(20_10_0/0.18)]"
  >
    <a href={home} aria-label={t('a11y.home')} class="shrink-0">
      <Logo class="w-[80px] md:w-[92px]" />
    </a>
    <div class="n-pli n-liens hidden items-center lg:flex" data-pli>
      <span class="mx-2 h-[22px] w-px shrink-0 bg-ink/15" aria-hidden="true"></span>

      <ul class="flex items-center gap-0.5">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-full px-3.5 py-2.5 text-[0.875rem] font-semibold whitespace-nowrap transition-colors duration-300 hover:bg-orange/14 hover:text-orange-hover"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={paths[other]}
            hreflang={other}
            lang={other}
            class="block rounded-full px-3 py-2.5 font-mono text-[0.75rem] uppercase transition-colors duration-300 hover:bg-orange/14 hover:text-orange-hover"
          >
            {other}<span class="sr-only"> · {t('lang.switch')}</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Sign-in for customers, then the two CTAs: the demo (secondary) and try it (primary).
         Below lg the menu carries sign-in and the demo, the pill keeps the primary only. -->
    <a
      href={appUrls.login}
      class="hidden rounded-full px-3.5 py-2.5 text-[0.875rem] font-semibold whitespace-nowrap transition-colors duration-300 hover:bg-orange/14 hover:text-orange-hover lg:block"
    >
      {t('nav.login')}
    </a>
    <!-- The demo pill: from xl always; between lg and xl only while folded, the unfolded bar would
         wrap there (César 05/10). -->
    <span class="n-pli n-demo hidden lg:flex">
      <Button href={routes.demo[locale]} variant="secondary">{t('cta.demo')}</Button>
    </span>
    <span class="n-pli n-essai flex" data-pli>
      <Button href={appUrls.signup} class="max-sm:px-4 max-sm:text-[0.8125rem]">
        {t('nav.try')}
      </Button>
    </span>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-ink hover:bg-orange/14 [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">{t('a11y.menu')}</span>
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
          <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block"></path>
        </svg>
      </summary>
      <div
        class="absolute top-full right-0 mt-3 w-64 rounded-card border border-line bg-surface p-2 shadow-3"
      >
        <ul class="flex flex-col">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-btn px-3 py-2.5 font-semibold hover:bg-orange-tint"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={paths[other]}
              hreflang={other}
              lang={other}
              class="block rounded-btn px-3 py-2.5 font-semibold hover:bg-orange-tint"
            >
              {t('lang.switch')}
            </a>
          </li>
          <li class="mt-1 border-t border-line pt-1">
            <a
              href={routes.demo[locale]}
              class="block rounded-btn px-3 py-2.5 font-semibold hover:bg-orange-tint"
            >
              {t('cta.demo')}
            </a>
          </li>
          <li>
            <a
              href={appUrls.login}
              class="block rounded-btn px-3 py-2.5 font-semibold hover:bg-orange-tint"
            >
              {t('nav.login')}
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>

<style>
  /* Folding parts: their width slides to 0 (the pill follows), they fade, and the gap they leave is
     taken back by a negative margin. Only from lg; below, the menu carries everything. */
  @media (width >= 64rem) {
    .n-pli {
      /* clip, with a margin so the orange pill's shadow and focus rings aren't cut while open */
      overflow: clip;
      overflow-clip-margin: 18px;
      white-space: nowrap;
      max-width: var(--max);
      transition:
        max-width 0.55s var(--ease-hatch),
        opacity 0.35s var(--ease-hatch),
        margin 0.55s var(--ease-hatch);
    }
    .n-liens {
      --max: 44rem;
    }
    .n-essai {
      --max: 12rem;
    }
    .n-demo {
      --max: 16rem;
    }
    :global(#nav.replie) .n-liens,
    :global(#nav.replie) .n-essai,
    :global(#nav:not(.replie)) .n-demo {
      max-width: 0;
      opacity: 0;
      margin-inline-start: -0.375rem;
    }
  }
  @media (width >= 80rem) {
    :global(#nav:not(.replie)) .n-demo {
      max-width: var(--max);
      opacity: 1;
      margin-inline-start: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .n-pli {
      transition: none;
    }
  }
</style>

<script>
  // Rendered by this component, so it always exists.
  const nav = document.getElementById('nav')!;
  const plis = [...nav.querySelectorAll<HTMLElement>('.n-pli')];
  const large = matchMedia('(min-width: 64rem)');
  const xl = matchMedia('(min-width: 80rem)');
  /** Scroll needed in one direction before the bar folds or unfolds, and the top zone kept open. */
  const FOLD_DELTA = 28;
  const HAUT = 120;
  let dernier = scrollY;
  let cumul = 0;

  function plier(replie: boolean) {
    nav.classList.toggle('replie', replie && large.matches);
    // Hidden parts leave the tab order; the demo is shown folded, or always from xl.
    const plie = nav.classList.contains('replie');
    for (const el of plis) {
      const cache = el.classList.contains('n-demo') ? !plie && !xl.matches : plie;
      el.inert = large.matches && cache;
    }
  }

  const maj = () => {
    const y = scrollY;
    nav.classList.toggle('defile', y > 20);
    const dy = y - dernier;
    dernier = y;
    if (y < HAUT) {
      cumul = 0;
      return plier(false);
    }
    // Accumulate in the current direction only: a reversal starts the count again.
    cumul = Math.sign(dy) === Math.sign(cumul) ? cumul + dy : dy;
    if (cumul > FOLD_DELTA) plier(true);
    else if (cumul < -FOLD_DELTA) plier(false);
  };
  addEventListener('scroll', maj, { passive: true });
  large.addEventListener('change', () => plier(nav.classList.contains('replie')));
  xl.addEventListener('change', () => plier(nav.classList.contains('replie')));
  // Keyboard: tabbing into the bar opens it.
  nav.addEventListener('focusin', () => plier(false));
  maj();
  // Close the mobile menu once a link is followed (same-page anchors don't reload the page).
  document
    .querySelectorAll<HTMLAnchorElement>('#nav details a')
    .forEach((a) =>
      a.addEventListener('click', () => a.closest('details')!.removeAttribute('open')),
    );
</script>
