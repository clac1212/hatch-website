---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import { appUrls, routes, otherLocale, useTranslations, type Locale, type Paths } from '../i18n/ui';

/**
 * The site's only nav (DS decision 3, César 09/11): a floating glass pill, the same on every page;
 * only its content changes with the space it serves.
 *   logo (always back to the home page, César 10/11: no « ← Home » link) · the space's sections ·
 *   language · the space's one call to action
 * - `accueil` (/): the two spaces (independents → Robin, networks), and « Se connecter ».
 * - `robin`: Robin's sections, and the beta waitlist (no sign-in: independents have no account yet).
 * - `reseau` (/reseaux and its inner pages: agents, demo, security…): agents, customers, pricing, demo.
 * - `legal`: the language only.
 * `surPlace`: the page carries the sections itself (anchors stay on the page).
 * Real glass, like Apple's Liquid Glass: nearly transparent, blurred and refracting, so the page's own
 * colors show through it; nothing is painted in. Only the content adapts: a script reads the background
 * under the logo as the page scrolls and switches text and logo to cream over a dark one (`data-ton`),
 * the logo to ink over a vivid one (`data-vif`). A section whose look is an image rather than its
 * background color declares it with `data-nav-fond="clair" | "sombre"`. `tone` sets the first paint.
 */
interface Props {
  locale: Locale;
  paths: Paths;
  espace?: 'accueil' | 'robin' | 'reseau' | 'legal';
  surPlace?: boolean;
  tone?: 'day' | 'night';
}

const { locale, paths, espace = 'reseau', surPlace = false, tone = 'day' } = Astro.props;
const t = useTranslations(locale);
const home = routes.home[locale];
const sombre = tone === 'night';
const other = otherLocale(locale);

const base = surPlace ? '' : routes.reseaux[locale];
const liens = {
  accueil: [
    { href: routes.robin[locale], label: t('nav.independants') },
    { href: routes.reseaux[locale], label: t('nav.reseaux') },
  ],
  robin: [
    { href: '#fait', label: t('nav.robin.features') },
    { href: '#semaine', label: t('nav.robin.daily') },
    { href: '#canaux', label: t('nav.robin.whatsapp') },
  ],
  reseau: [
    { href: `${base}#agents`, label: t('nav.agents') },
    { href: `${base}#cas-clients`, label: t('nav.cases') },
    { href: `${base}#tarifs`, label: t('nav.pricing') },
  ],
  legal: [],
}[espace];
const cta = {
  accueil: { href: appUrls.login, label: t('nav.login'), variant: 'ink' },
  robin: { href: '#beta', label: t('cta.waitlist'), variant: 'orange' },
  reseau: { href: routes.demo[locale], label: t('cta.demo'), variant: 'orange' },
  legal: null,
}[espace] as { href: string; label: string; variant: 'orange' | 'ink' | 'cream' } | null;

const lien =
  'rounded-full px-3.5 py-2.5 text-caption font-semibold whitespace-nowrap transition-colors duration-300';
const survol = 'hover:bg-current/10';
---

<header class="pointer-events-none fixed inset-x-0 top-3 z-60 flex justify-center px-3 md:top-5">
  <nav
    id="nav"
    aria-label={t('a11y.mainNav')}
    class:list={[
      'vitre pointer-events-auto flex w-full max-w-max items-center gap-1.5 rounded-full py-2 pr-2 pl-5 transition-[filter] duration-500 max-sm:justify-between md:pl-6 [&.defile]:drop-shadow-[0_10px_24px_rgb(20_10_0/0.18)]',
    ]}
    data-ton={sombre ? 'sombre' : 'clair'}
  >
    <a href={home} aria-label={t('a11y.home')} class="shrink-0">
      <Logo class="n-logo-jour w-[80px] md:w-[92px]" />
      <Logo tone="night" class="n-logo-nuit w-[80px] md:w-[92px]" />
    </a>
    <div class="n-pli n-liens ml-4 hidden items-center lg:flex" data-pli>
      <ul class="flex items-center gap-0.5">
        {
          liens.map((l) => (
            <li>
              <a href={l.href} class:list={['block', lien, survol]}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={paths[other]}
            hreflang={other}
            lang={other}
            class:list={['block uppercase', lien, survol, 'n-attenue']}
          >
            {other}<span class="sr-only"> · {t('lang.switch')}</span>
          </a>
        </li>
      </ul>
    </div>

    {/* exception: a smaller button below 640 px so the pill fits a 360 px screen */}
    {
      cta && (
        <Button
          href={cta.href}
          variant={cta.variant}
          class:list={[
            'max-sm:px-4 max-sm:text-[0.8125rem]',
            cta.variant === 'ink' && 'n-cta-inverse',
          ]}
        >
          {cta.label}
        </Button>
      )
    }

    <details class="group relative lg:hidden">
      <summary
        class:list={[
          'flex size-10 cursor-pointer list-none items-center justify-center rounded-full [&::-webkit-details-marker]:hidden',
          survol,
        ]}
      >
        <span class="sr-only">{t('a11y.menu')}</span>
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
          <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block"></path>
        </svg>
      </summary>
      <div
        class="absolute top-full right-0 mt-3 w-64 rounded-card-sm border border-line bg-surface p-2 text-ink shadow-3"
      >
        <ul class="flex flex-col">
          {
            liens.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="block rounded-sm px-3 py-2.5 font-semibold hover:bg-orange-tint"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={paths[other]}
              hreflang={other}
              lang={other}
              class="block rounded-sm px-3 py-2.5 font-semibold hover:bg-orange-tint"
            >
              {t('lang.switch')}
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>

<style>
  /* The glass lets the background through: a faint white veil only, the blur and refraction come
     from .vitre (global.css, src/scripts/vitre.ts). No hard rim: just a hairline catching the light. */
  #nav {
    background-color: color-mix(in srgb, var(--color-white) 12%, transparent);
    color: var(--color-ink);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 22%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 10%, transparent),
      0 10px 30px color-mix(in srgb, var(--color-shadow) 14%, transparent);
    transition:
      color 0.45s var(--ease-hatch),
      filter 0.5s;
  }
  #nav::before {
    display: none;
  }
  #nav[data-ton='sombre'] {
    color: var(--color-cream);
  }
  .n-attenue {
    color: color-mix(in srgb, currentColor 68%, transparent);
  }
  /* The logos are rendered by Logo.astro, out of this component's scope. */
  #nav :global(.n-logo-nuit),
  #nav[data-ton='sombre'] :global(.n-logo-jour) {
    display: none;
  }
  #nav[data-ton='sombre'] :global(.n-logo-nuit) {
    display: block;
  }
  #nav[data-vif] :global(.n-logo-jour) {
    filter: brightness(0);
  }
  /* The ink button (home's « Se connecter ») turns cream over a dark background. */
  #nav[data-ton='sombre'] :global(.n-cta-inverse) {
    background: var(--color-cream);
    color: var(--color-ink);
  }
  @media (width >= 64rem) {
    .n-pli {
      overflow: clip;
      overflow-clip-margin: 18px;
      white-space: nowrap;
      max-width: 44rem;
      transition:
        max-width 0.55s var(--ease-hatch),
        opacity 0.35s var(--ease-hatch),
        margin 0.55s var(--ease-hatch);
    }
    :global(#nav:not(.replie)) .n-pli {
      transition-duration: 0.7s, 0.45s, 0.7s;
      transition-delay: 0.08s;
    }
    :global(#nav.replie) .n-pli {
      max-width: 0;
      opacity: 0;
      margin-inline-start: -0.375rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .n-pli {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const plis = [...nav.querySelectorAll<HTMLElement>('.n-pli')];
  const large = matchMedia('(min-width: 64rem)');
  const FOLD_DELTA = 28;
  const UNFOLD_DELTA = 160;
  const HAUT = 120;
  let dernier = scrollY;
  let cumul = 0;

  function plier(replie: boolean) {
    nav.classList.toggle('replie', replie && large.matches);
    const plie = nav.classList.contains('replie');
    for (const el of plis) el.inert = plie;
  }

  const maj = () => {
    const y = scrollY;
    nav.classList.toggle('defile', y > 20);
    const dy = y - dernier;
    dernier = y;
    if (y < HAUT) {
      cumul = 0;
      return plier(false);
    }
    cumul = Math.sign(dy) === Math.sign(cumul) ? cumul + dy : dy;
    if (cumul > FOLD_DELTA) plier(true);
    else if (cumul < -UNFOLD_DELTA) plier(false);
  };
  addEventListener('scroll', maj, { passive: true });

  // Liquid-glass tint: the background color right under the pill, found by walking up from the element
  // there to the first one with an opaque enough background (images and videos are skipped: their box
  // carries the color). A 1×1 canvas turns any CSS color (rgb, oklab, color-mix…) into RGBA.
  const pinceau = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
  function rgba(css: string): [number, number, number, number] {
    pinceau.clearRect(0, 0, 1, 1);
    pinceau.fillStyle = '#0000';
    pinceau.fillStyle = css;
    pinceau.fillRect(0, 0, 1, 1);
    const [r, g, b, a] = pinceau.getImageData(0, 0, 1, 1).data;
    return [r, g, b, a / 255];
  }
  const logo = nav.querySelector<HTMLElement>('a[href]')!;
  const NUIT = 'rgb(11, 11, 13)';
  const BLANC = 'rgb(255, 255, 255)';
  function fondSous(): string {
    // Read under the logo: it is what must stay legible (the pill's middle may sit over a card).
    const b = logo.getBoundingClientRect();
    const pile = document.elementsFromPoint(b.left + b.width / 2, b.top + b.height / 2);
    // Skip the nav's own fixed bar only: a page's hero may itself be a <header> (/securite).
    const barre = nav.parentElement!;
    let el = pile.find((e) => !barre.contains(e)) ?? null;
    for (; el; el = el.parentElement) {
      // A section whose look is an image, not its background color (the networks map), says it.
      const declare = (el as HTMLElement).dataset?.navFond;
      if (declare) return declare === 'sombre' ? NUIT : BLANC;
      const fond = getComputedStyle(el).backgroundColor;
      if (rgba(fond)[3] > 0.5) return fond;
    }
    return getComputedStyle(document.body).backgroundColor;
  }
  let dernierFond = '';
  let prevu = false;
  function accorder() {
    prevu = false;
    const fond = fondSous();
    if (fond === dernierFond) return;
    dernierFond = fond;
    const [r, g, b] = rgba(fond).map((v) => v / 255);
    const lin = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
    const luminance = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
    nav.dataset.ton = luminance < 0.2 ? 'sombre' : 'clair';
    // A vivid background (the orange Security band): the orange logo would vanish, it turns ink.
    const max = Math.max(r, g, b);
    nav.toggleAttribute('data-vif', max > 0 && (max - Math.min(r, g, b)) / max > 0.6);
  }
  const planifier = () => {
    if (!prevu) {
      prevu = true;
      requestAnimationFrame(accorder);
    }
  };
  addEventListener('scroll', planifier, { passive: true });
  addEventListener('resize', planifier);
  accorder();
  large.addEventListener('change', () => plier(nav.classList.contains('replie')));
  nav.addEventListener('focusin', () => plier(false));
  maj();
  document
    .querySelectorAll<HTMLAnchorElement>('#nav details a')
    .forEach((a) =>
      a.addEventListener('click', () => a.closest('details')!.removeAttribute('open')),
    );
</script>
