---
import { Image, Picture } from 'astro:assets';
import type { SceneDe } from '../../../content/schemas/scenes';
import IphoneReel from '../IphoneReel.astro';
import Icone from '../Icone.astro';
import LogoWhatsapp from '../LogoWhatsapp.astro';
import { avatars } from '../../pages/agent-visuels';
import { centres } from '../visuels';
import burger from '../../../assets/agents/peep/burger.jpg';

/**
 * Peep's "Exemple d'usage" scene (César 11/10): each step shows the device of whoever acts, the
 * previous one steps back (Exemple.astro's engine, `data-etapes`: device, screen, seconds).
 * 1. Claire's Hatch OS window: her request types itself, Peep drafts the announcement (photo,
 *    sheet), the three quiz questions come one by one.
 * 2. A Lyon Part-Dieu crew member's iPhone, Monday 9:00: the WhatsApp notification lands on the
 *    lock screen, the chat opens on the announcement, a tap starts the quiz.
 * 3. Claire's window again, Tuesday: read tracking counts up, a click on "Unread" keeps the two
 *    restaurants that haven't opened it, a click on "Remind now" sends the reminder.
 * 4. The same iPhone: the crew member types his plating question, Peep "is typing", the answer
 *    comes with the sheet's excerpt.
 * Each screen's markup is its final state; `.joue` (set by the engine) replays its beats, each
 * timed by `--t` (seconds from the screen's start).
 */
interface Props {
  d: SceneDe<'peep'>;
}
const { d } = Astro.props;
const etapes = [
  { a: 'siege', e: 0, d: 6.8 },
  { a: 'tel', e: 0, d: 7.8 },
  { a: 'siege', e: 1, d: 6.6 },
  { a: 'tel', e: 1, d: 6.4 },
];
const mots = (texte: string) => texte.split(' ');
const nonLus = d.suivi.total - d.suivi.lus;
---

<div class="pile" data-etapes={JSON.stringify(etapes)}>
  <div class="appareil devant" data-appareil="siege">
    <div class="fenetre">
      <div class="fen-ecran on" data-ecran="0">
        <p class="fen-barre">
          <span class="feux"><span></span><span></span><span></span></span>
          <b>{d.redaction.app}</b>
          <span class="fen-contexte">{d.redaction.contexte}</span>
        </p>
        <div class="fen-corps">
          <div class="demande">
            <span class="demande-qui">{d.redaction.demande.qui}</span>
            <p>
              {
                mots(d.redaction.demande.texte).map((m, i) => (
                  <>
                    <span class="mot" style={`--t:${(0.4 + i * 0.1).toFixed(2)}s`}>
                      {m}
                    </span>{' '}
                  </>
                ))
              }
            </p>
          </div>
          <div class="peep">
            <Image src={avatars.peep} alt="" width={56} densities={[1]} class="peep-av" />
            <div class="peep-corps">
              <b class="peep-nom">{d.redaction.agent}</b>
              <div class="attente">
                <p class="redige">
                  <span class="points"><span></span><span></span><span></span></span>
                  {d.redaction.redige}
                </p>
                <div class="annonce b" style="--t:2.9s">
                  <div class="annonce-haut">
                    <Image src={burger} alt="" width={360} class="annonce-photo" loading="lazy" />
                    <div class="annonce-texte">
                      <b>{d.redaction.annonce.titre}</b>
                      <p>{d.redaction.annonce.texte}</p>
                      <span class="piece">
                        <span class="piece-icone"><Icone nom="file-text" taille={13} /></span>
                        <span class="flex flex-col">
                          <b>{d.redaction.annonce.fiche.titre}</b>
                          <span>{d.redaction.annonce.fiche.meta}</span>
                        </span>
                      </span>
                    </div>
                  </div>
                  <div class="quiz">
                    <p class="quiz-libelle">
                      <Icone nom="list-checks" taille={13} />
                      {d.redaction.quiz.libelle}
                    </p>
                    <ol>
                      {
                        d.redaction.quiz.questions.map((q, i) => (
                          <li class="b" style={`--t:${3.7 + i * 0.5}s`}>
                            <span class="quiz-n">{i + 1}</span>
                            {q}
                          </li>
                        ))
                      }
                    </ol>
                  </div>
                </div>
              </div>
              <p class="actions b" style="--t:5.4s">
                <span class="btn">{d.redaction.boutons[0]}</span>
                <span class="btn sombre">{d.redaction.boutons[1]}</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="fen-ecran suivi" data-ecran="1">
        <p class="fen-barre">
          <span class="feux"><span></span><span></span><span></span></span>
          <b>{d.suivi.app}</b>
          <span class="fen-contexte">{d.suivi.contexte}</span>
        </p>
        <div class="fen-corps">
          <div class="suivi-tete">
            <span class="kicker">{d.suivi.libelle}</span>
            <p class="chiffre">
              <b class="compteur" style={`--pp-n:${d.suivi.lus}`}></b>
              <span class="sur">/ {d.suivi.total}</span>
              <span class="legende">{d.suivi.legende}</span>
            </p>
            <span class="jauge"><span style={`--a:${d.suivi.lus / d.suivi.total}`}></span></span>
          </div>
          <p class="onglets">
            <span class="onglet tous">{d.suivi.onglets[0]} <i>{d.suivi.total}</i></span>
            <span class="onglet nonlus">
              {d.suivi.onglets[1]}
              <i>{nonLus}</i>
              <span class="curseur c1"><Icone nom="mouse-pointer-2" taille={20} /></span>
            </span>
          </p>
          <ul class="liste">
            {
              d.suivi.restaurants.map((r, i) => (
                <li class:list={{ lu: r.lu }}>
                  <span class="nom b" style={`--t:${0.5 + i * 0.18}s`}>
                    {r.nom}
                  </span>
                  {r.lu ? (
                    <span class="etat ok b" style={`--t:${0.6 + i * 0.18}s`}>
                      <Icone nom="check-check" taille={12} />
                      {r.etat}
                    </span>
                  ) : (
                    <span class="echange b" style={`--t:${0.6 + i * 0.18}s`}>
                      <span class="etat gris avant">
                        <Icone nom="eye-off" taille={12} />
                        {r.etat}
                      </span>
                      <span class="etat orange apres">
                        <Icone nom="refresh-cw" taille={12} />
                        {d.suivi.relance.etat}
                      </span>
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
          <div class="relance deplie" style="--t:3.35s">
            <span class="btn sombre relancer">
              <span class="echange">
                <span class="avant"><Icone nom="send" taille={13} />{d.suivi.relance.bouton}</span>
                <span class="apres"><Icone nom="check" taille={13} />{d.suivi.relance.fait}</span>
              </span>
              <span class="curseur c2"><Icone nom="mouse-pointer-2" taille={20} /></span>
            </span>
            <span class="auto">{d.suivi.relance.auto}</span>
          </div>
          <span class="ressort"></span>
          <p class="bilan deplie" style="--t:3.6s">
            <span class="bilan-icone"><Icone nom="list-checks" taille={14} /></span>
            <span class="flex flex-col">
              <b>{d.suivi.quiz.libelle}</b>
              <span>{d.suivi.quiz.texte}</span>
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="appareil" data-appareil="tel">
    <div class="tel">
      <IphoneReel>
        <div class="ecran-tel on" data-ecran="0">
          <div class="verrou">
            <Picture
              src={centres.peep.src}
              alt=""
              formats={['avif', 'webp']}
              widths={[400]}
              sizes="250px"
              class="verrou-fond"
            />
            <p class="verrou-heure">{d.telephone.heure}</p>
            <p class="verrou-date">{d.telephone.date}</p>
            <div class="notif">
              <p class="notif-tete">
                <span class="wa"><LogoWhatsapp taille={9} /></span>
                <span class="flex-1">{d.telephone.notif.app}</span>
                <span>{d.telephone.notif.quand}</span>
              </p>
              <b>{d.telephone.notif.titre}</b>
              <span>{d.telephone.notif.texte}</span>
            </div>
          </div>
          <div class="chat glisse">
            <p class="chat-tete">
              <Icone nom="chevron-left" taille={14} />
              <Image src={avatars.peep} alt="" width={48} densities={[1]} class="chat-av" />
              <span class="flex flex-col">
                <b>{d.telephone.contact}</b>
                <span>{d.telephone.statut}</span>
              </span>
            </p>
            <div class="chat-fil">
              <span class="jour">{d.telephone.jour}</span>
              <div class="bulle b" style="--t:3s">
                <Image src={burger} alt="" width={400} class="bulle-photo" loading="lazy" />
                <b class="bulle-titre">{d.telephone.annonce.titre}</b>
                <p>{d.telephone.annonce.texte}</p>
                <span class="pdf">
                  <span class="pdf-icone">PDF</span>
                  <span class="flex flex-col">
                    <b>{d.telephone.annonce.fiche.titre}</b>
                    <span>{d.telephone.annonce.fiche.meta}</span>
                  </span>
                </span>
                <span class="heure">{d.telephone.annonce.heure}</span>
              </div>
              <div class="bulle b" style="--t:3.7s">
                <p class="quiz-tel">
                  <Icone nom="list-checks" taille={12} />
                  <b>{d.telephone.quiz.titre}</b>
                  <span>· {d.telephone.quiz.meta}</span>
                </p>
                <span class="bouton-wa">
                  {d.telephone.quiz.bouton}
                  <span class="doigt"></span>
                </span>
              </div>
              <div class="bulle sortant b" style="--t:5.5s">
                <p>{d.telephone.reponse.texte}</p>
                <span class="heure">
                  {d.telephone.reponse.heure}
                  <Icone nom="check-check" taille={11} class="vu" />
                </span>
              </div>
              <div class="bulle b" style="--t:6.3s">
                <p>{d.telephone.question.texte}</p>
                <span class="heure">{d.telephone.question.heure}</span>
              </div>
            </div>
            <p class="saisie">
              <span class="saisie-champ"><span class="saisie-ph">{d.question.saisie}</span></span>
              <span class="saisie-rond"><Icone nom="mic" taille={13} /></span>
            </p>
          </div>
        </div>

        <div class="ecran-tel" data-ecran="1">
          <div class="chat">
            <p class="chat-tete">
              <Icone nom="chevron-left" taille={14} />
              <Image src={avatars.peep} alt="" width={48} densities={[1]} class="chat-av" />
              <span class="flex flex-col">
                <b>{d.telephone.contact}</b>
                <span class="echange">
                  <span class="avant-ecrit">{d.telephone.statut}</span>
                  <span class="ecrit">{d.question.ecrit}</span>
                </span>
              </span>
            </p>
            <div class="chat-fil">
              <div class="bulle">
                <Image src={burger} alt="" width={400} class="bulle-photo" loading="lazy" />
                <b class="bulle-titre">{d.telephone.annonce.titre}</b>
                <p>{d.telephone.annonce.texte}</p>
                <span class="heure">{d.telephone.annonce.heure}</span>
              </div>
              <div class="bulle sortant">
                <p>{d.telephone.reponse.texte}</p>
                <span class="heure">
                  {d.telephone.reponse.heure}
                  <Icone nom="check-check" taille={11} class="vu" />
                </span>
              </div>
              <div class="bulle">
                <p>{d.telephone.question.texte}</p>
                <span class="heure">{d.telephone.question.heure}</span>
              </div>
              <span class="jour">{d.telephone.jour}</span>
              <div class="bulle sortant envoi">
                <p>{d.question.texte}</p>
                <span class="heure">
                  {d.question.heure}
                  <Icone nom="check-check" taille={11} class="vu" />
                </span>
              </div>
              <span class="bulle points-tel">
                <span class="points"><span></span><span></span><span></span></span>
              </span>
              <div class="bulle b" style="--t:4.3s">
                <span class="extrait">
                  <Image src={burger} alt="" width={400} class="extrait-photo" loading="lazy" />
                  <span class="extrait-source">
                    <Icone nom="file-text" taille={11} />
                    <span class="flex flex-col">
                      <b>{d.question.reponse.source.titre}</b>
                      <span>{d.question.reponse.source.meta}</span>
                    </span>
                  </span>
                </span>
                <b class="bulle-titre">{d.question.reponse.titre}</b>
                <p>{d.question.reponse.texte}</p>
                <span class="signature">{d.question.reponse.signature}</span>
              </div>
            </div>
            <p class="saisie">
              <span class="saisie-champ">
                <span class="saisie-ph">{d.question.saisie}</span>
                <span class="saisie-texte">
                  {
                    mots(d.question.texte).map((m, i) => (
                      <>
                        <span class="mot" style={`--t:${(0.4 + i * 0.13).toFixed(2)}s`}>
                          {m}
                        </span>{' '}
                      </>
                    ))
                  }
                </span>
              </span>
              <span class="saisie-rond">
                <span class="micro"><Icone nom="mic" taille={13} /></span>
                <span class="envoyer"><Icone nom="send-horizontal" taille={13} /></span>
                <span class="doigt"></span>
              </span>
            </p>
          </div>
        </div>
      </IphoneReel>
    </div>
  </div>
</div>

<style>
  @property --pp-n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  /* Generic beat: arrives at `--t` when its screen plays. */
  .joue .b {
    animation: pp-arrive 0.55s var(--ease-entree) var(--t, 0s) both;
  }
  @keyframes pp-arrive {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  /* A typed word shows at `--t`. */
  .joue .mot {
    animation: pp-fondu 0.08s linear var(--t) both;
  }
  @keyframes pp-fondu {
    from {
      opacity: 0;
    }
  }
  /* Transient beats (fill none): `pp-montre` shows a hidden element while it runs, `pp-masque`
     hides a visible one. */
  @keyframes pp-montre {
    from,
    to {
      opacity: 1;
    }
  }
  @keyframes pp-masque {
    from,
    to {
      opacity: 0;
    }
  }
  /* Two states sharing one place: the final one (`.apres`) replaces the first (`.avant`). */
  .echange {
    display: inline-grid;
  }
  .echange > * {
    grid-area: 1 / 1;
  }
  .echange .avant,
  .echange .ecrit {
    opacity: 0;
  }
  /* "Typing" dots. */
  .points {
    display: inline-flex;
    gap: 3px;
  }
  .points span {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: currentColor;
  }
  /* They bounce only while their screen plays, a few times, then rest. */
  .joue .points span {
    animation: pp-point 0.6s var(--ease-doux) 2s 6;
  }
  .joue .points span:nth-child(2) {
    animation-delay: 2.15s;
  }
  .joue .points span:nth-child(3) {
    animation-delay: 2.3s;
  }
  @keyframes pp-point {
    50% {
      opacity: 0.3;
      translate: 0 -2px;
    }
  }

  /* 1 and 3. Claire's window: two screens stacked in one frame, so it keeps its height. */
  .fenetre {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: min(540px, 100%);
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-galet);
    box-shadow: var(--shadow-3);
    font-family: var(--font-sans);
    color: var(--color-ink);
    container-type: inline-size;
  }
  .fen-ecran {
    display: flex;
    flex-direction: column;
    grid-area: 1 / 1;
    min-width: 0;
  }
  .fen-barre {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-ligne-claire);
    background: var(--color-white);
    font-size: 12px;
    color: var(--color-gray-500);
    white-space: nowrap;
  }
  .fen-barre b {
    font: 700 14px/1 var(--font-display);
    color: var(--color-ink);
  }
  .fen-contexte {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feux {
    display: flex;
    flex: none;
    gap: 6px;
    margin-right: 4px;
  }
  .feux span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--color-statut-rouge);
  }
  .feux span:nth-child(2) {
    background: var(--color-amber-line);
  }
  .feux span:nth-child(3) {
    background: var(--color-success);
  }
  .fen-corps {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
  }
  .demande {
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-self: flex-end;
    max-width: 82%;
    padding: 10px 13px;
    border-radius: 12px 12px 4px 12px;
    background: var(--color-orange-tint);
    font-size: 12.5px;
    line-height: 1.45;
  }
  .demande-qui {
    font: 400 10px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  .peep {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .peep-av {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
  }
  .peep-corps {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .peep-nom {
    font-size: 12px;
  }
  .attente {
    position: relative;
  }
  .redige {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-ligne-claire);
    font-size: 11.5px;
    color: var(--color-gray-500);
    opacity: 0;
  }
  .joue .redige {
    animation: pp-montre 0.9s linear 2s;
  }
  .annonce {
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow:
      inset 0 0 0 1px var(--color-ligne-claire),
      var(--shadow-1);
  }
  .annonce-haut {
    display: flex;
    gap: 12px;
    padding: 12px;
  }
  .annonce-photo {
    flex: none;
    width: 112px;
    height: 104px;
    border-radius: 8px;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .annonce-texte {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--color-soft);
  }
  .annonce-texte > b {
    font: 700 16px/1.15 var(--font-display);
    color: var(--color-ink);
  }
  .piece {
    display: flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    max-width: 100%;
    margin-top: 2px;
    padding: 5px 9px 5px 5px;
    border-radius: 8px;
    background: var(--color-mur);
    font-size: 10px;
    line-height: 1.25;
    color: var(--color-gray-500);
  }
  .piece b {
    font-size: 10.5px;
    color: var(--color-ink);
  }
  .piece-icone {
    display: grid;
    flex: none;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--color-statut-rouge-tint);
    color: var(--color-statut-rouge);
  }
  .quiz {
    padding: 10px 12px 12px;
    border-top: 1px solid var(--color-ligne-claire);
  }
  .quiz-libelle {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 7px;
    font: 400 10px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  .quiz ol {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .quiz li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    line-height: 1.35;
  }
  .quiz-n {
    display: grid;
    flex: none;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-mur);
    font: 400 10px/1 var(--font-mono);
    color: var(--color-gray-700);
  }
  .actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-ligne-claire);
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .btn.sombre {
    background: var(--color-night);
    box-shadow: none;
    color: var(--color-white);
  }

  /* 3. Read tracking. */
  .suivi .fen-corps {
    gap: 12px;
  }
  .suivi-tete {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .kicker {
    font: 400 10px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  .chiffre {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 12px;
    color: var(--color-soft);
  }
  .compteur::before {
    content: counter(pp-n);
  }
  .compteur {
    counter-reset: pp-n var(--pp-n);
    font: 700 30px/1 var(--font-display);
    letter-spacing: -0.02em;
