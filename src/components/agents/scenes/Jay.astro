---
import { Image } from 'astro:assets';
import type { SceneDe } from '../../../content/schemas/scenes';
import IphoneReel from '../IphoneReel.astro';
import Icone from '../Icone.astro';
import { avatars } from '../../pages/agent-visuels';

/**
 * Jay's "Exemple d'usage" scene (César 11/10): each step shows the device of whoever acts, the
 * previous one steps back (Exemple.astro's engine, `data-etapes`: device, screen, seconds).
 * 1. Head office's Hatch OS window: the pointer clicks "Connecter" on Google Drive, picks the
 *    "Manuel opératoire" folder, Jay indexes it (the count climbs, the sheets come in), synced.
 * 2. The Lille Centre crew member's iPhone at 21:40, WhatsApp: he types his question and sends it,
 *    Peep is typing, the answer comes step by step with the source sheet attached.
 * 3. Claire's document window: she types the cold room line into the opening sheet, the night
 *    falls on the resync, the new line is marked and Jay's card says the answers follow v3.
 * Each screen's markup is its final state; `.joue` (set by the engine) replays its beats, each
 * timed by `--t` (seconds from the screen's start).
 */
interface Props {
  d: SceneDe<'jay'>;
}
const { d } = Astro.props;
const etapes = [
  { a: 'siege', e: 0, d: 7 },
  { a: 'tel', e: 0, d: 8.4 },
  { a: 'drive', e: 0, d: 8.2 },
];
const { siege, telephone: tel, drive } = d;
/** French spacing: no line break before « ? », « : »… */
const insecable = (s: string) => s.replace(/ ([?!:;])/g, ' $1');
/** Words typed one by one, spread over `duree` seconds from `debut`. */
const frappe = (s: string, debut: number, duree: number) => {
  const mots = insecable(s).split(' ');
  return mots.map((m, i) => ({
    m,
    t: +(debut + (i * duree) / mots.length).toFixed(2),
    fin: i === mots.length - 1,
  }));
};
const question = frappe(tel.question, 0.6, 1.6);
const ajout = frappe(drive.ajout, 1.1, 1.9);
const choisi = siege.choix.dossiers[siege.choix.choisi];
---

<div class="pile" data-etapes={JSON.stringify(etapes)}>
  <div class="appareil devant" data-appareil="siege">
    <div class="fenetre on" data-ecran="0">
      <p class="fen-barre">
        <span class="feux"><span></span><span></span><span></span></span>
        <b>{siege.app}</b>
        <span>{siege.contexte}</span>
      </p>
      <div class="fen-corps">
        <p class="kicker">{siege.titre}</p>
        <div class="sources-zone">
          <ul class="sources">
            {
              siege.connecteurs.map((c, i) => (
                <li class:list={['source', { premier: i === 0 }]}>
                  <span class={`app app-${c.ton}`}>
                    <Icone nom={c.icone} taille={14} />
                  </span>
                  <span class="source-nom">
                    <b>{c.nom}</b>
                    {i === 0 && (
                      <span class="source-dossier">
                        <Icone nom="folder" taille={11} />
                        {choisi.nom}
                      </span>
                    )}
                  </span>
                  {i === 0 ? (
                    <span class="bascule">
                      <span class="bouton avant">
                        {siege.connecter}
                        <svg class="curseur c1" viewBox="0 0 16 22" aria-hidden="true">
                          <path d="M1.5 1.5v16l4-3.6 2.9 6.9 2.7-1.2-2.9-6.7h5.4z" />
                        </svg>
                      </span>
                      <span class="bouton apres">
                        <Icone nom="check" taille={12} />
                        {siege.connecte}
                      </span>
                    </span>
                  ) : (
                    <span class="bouton">{siege.connecter}</span>
                  )}
                </li>
              ))
            }
          </ul>
          <div class="choix">
            <p class="choix-titre">{siege.choix.titre}</p>
            <ul>
              {
                siege.choix.dossiers.map((f, i) => (
                  <li class:list={{ choisi: i === siege.choix.choisi }}>
                    <Icone nom="folder" taille={14} />
                    <span class="flex-1">
                      <b>{f.nom}</b>
                      <span>{f.meta}</span>
                    </span>
                    {i === siege.choix.choisi && (
                      <svg class="curseur c2" viewBox="0 0 16 22" aria-hidden="true">
                        <path d="M1.5 1.5v16l4-3.6 2.9 6.9 2.7-1.2-2.9-6.7h5.4z" />
                      </svg>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="index b" style="--t:3.1s">
          <p class="index-tete">
            <Image src={avatars.jay} alt="" width={40} densities={[1]} class="index-av" />
            <span class="index-titre">
              <span class="index-libelle">
                {siege.index.libelle}
                <Icone nom="folder" taille={10} />
                {siege.index.dossier}
              </span>
              <b class="compte" style={`--total:${siege.index.total}`}>
                <span class="compte-n"></span>
                <span>{siege.index.unite}</span>
              </b>
            </span>
            <span class="fini">
              <Icone nom="check" taille={12} />
              {siege.index.fin}
            </span>
          </p>
          <span class="jauge"><span></span></span>
          <ul class="docs">
            {
              siege.index.lignes.map((l, i) => (
                <li class="b" style={`--t:${3.8 + i * 0.5}s`}>
                  <Icone nom="file-text" taille={13} />
                  <span class:list={['ligne-texte', { barre: l.ton === 'gris' }]}>{l.texte}</span>
                  <span class={`etat etat-${l.ton}`}>{l.etat}</span>
                </li>
              ))
            }
          </ul>
          <p class="nuit b" style="--t:5.9s">
            <Icone nom="moon" taille={11} />
            {siege.index.nuit}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="appareil" data-appareil="tel">
    <div class="tel">
      <IphoneReel>
        <div class="ecran-tel on" data-ecran="0">
          <p class="statut">
            <span>{tel.heure}</span>
            <span class="statut-icones">
              <Icone nom="signal" taille={10} />
              <Icone nom="wifi" taille={10} />
              <Icone nom="battery-full" taille={12} />
            </span>
          </p>
          <p class="chat-tete">
            <Icone nom="chevron-left" taille={14} />
            <Image src={avatars.peep} alt="" width={40} densities={[1]} class="chat-av" />
            <span class="flex flex-col">
              <b>{tel.contact}</b>
              <span class="presence">
                <span class="en-ligne">{tel.statut}</span>
                <span class="ecrit">{tel.ecrit}</span>
              </span>
            </span>
          </p>
          <div class="fil">
            <span class="jour">{tel.jour}</span>
            <div class="pousse moi-zone" style="--t:2.6s">
              <div>
                <p class="bulle moi">
                  {insecable(tel.question)}
                  <span class="heure">
                    {tel.heure}
                    <Icone nom="check-check" taille={11} />
                  </span>
                </p>
              </div>
            </div>
            <div class="pousse points-zone">
              <div>
                <p class="points"><span></span><span></span><span></span></p>
              </div>
            </div>
            <div class="pousse" style="--t:4.6s">
              <div>
                <div class="bulle agent">
                  <p>{insecable(tel.reponse.intro)}</p>
                  <ol>
                    {
                      tel.reponse.etapes.map((e, i) => (
                        <li class="b" style={`--t:${4.9 + i * 0.3}s`}>
                          {e}
                        </li>
                      ))
                    }
                  </ol>
                  <span class="doc b" style="--t:6.3s">
                    <span class="doc-icone"><Icone nom="file-text" taille={13} /></span>
                    <span class="doc-texte">
                      <span class="doc-libelle">{tel.reponse.source.libelle}</span>
                      <b>{tel.reponse.source.titre}</b>
                      <span>{tel.reponse.source.meta}</span>
                    </span>
                    <Icone nom="external-link" taille={12} />
                  </span>
                  <span class="heure">{tel.reponse.signature}</span>
                </div>
              </div>
            </div>
          </div>
          <div class="compose">
            <Icone nom="plus" taille={16} />
            <span class="champ">
              <span class="placeholder">{tel.placeholder}</span>
              <span class="saisie">
                {
                  question.map((q) => (
                    <span class:list={['mot', { fin: q.fin }]} style={`--t:${q.t}s`}>
                      {q.m}
                    </span>
                  ))
                }
              </span>
            </span>
            <span class="envoi">
              <span class="micro"><Icone nom="mic" taille={14} /></span>
              <span class="envoyer">
                <Icone nom="send-horizontal" taille={13} />
              </span>
              <span class="doigt"></span>
            </span>
          </div>
        </div>
      </IphoneReel>
    </div>
  </div>

  <div class="appareil" data-appareil="drive">
    <div class="fenetre on" data-ecran="0">
      <div class="fen-barre doc-barre">
        <span class="feux"><span></span><span></span><span></span></span>
        <span class="doc-logo"><Icone nom="file-text" taille={15} /></span>
        <span class="doc-nom">
          <b>{drive.fichier}</b>
          <span>{drive.chemin}</span>
        </span>
        <span class="enregistre b" style="--t:3.2s">
          <Icone nom="cloud-check" taille={13} />
          <span>{drive.enregistre}</span>
        </span>
        <span class="present">{drive.auteur.charAt(0)}</span>
      </div>
      <p class="outils" aria-hidden="true">
        <Icone nom="undo-2" taille={13} />
        <Icone nom="redo-2" taille={13} />
        <span class="sep"></span>
        <Icone nom="bold" taille={13} />
        <Icone nom="italic" taille={13} />
        <Icone nom="underline" taille={13} />
        <span class="sep"></span>
        <Icone nom="list-ordered" taille={13} />
        <Icone nom="highlighter" taille={13} />
      </p>
      <div class="doc-corps">
        <div class="feuille">
          <b class="feuille-titre">{drive.titre}</b>
          <ol>
            {
              drive.etapes.map((e, i) => (
                <li>
                  {e}
                  {i === drive.sous && (
                    <div class="pousse ajout-zone" style="--t:0.7s">
                      <div>
                        <ul>
                          <li>
                            <mark class="surligne">
                              {ajout.map((a) => (
                                <span class:list={['mot', { fin: a.fin }]} style={`--t:${a.t}s`}>
                                  {a.m}
                                </span>
                              ))}
                              <span class="caret">
                                <span class="drapeau">{drive.auteur}</span>
                              </span>
                            </mark>
                          </li>
                        </ul>
                      </div>
                    </div>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
        <p class="nuit-voile">
          <span class="nuit-puce">
            <Icone nom="moon" taille={13} />
            {drive.nuit}
            <span class="tourne"><Icone nom="refresh-cw" taille={12} /></span>
          </span>
        </p>
        <div class="synchro b" style="--t:5.4s">
          <p class="synchro-tete">
            <Image src={avatars.jay} alt="" width={40} densities={[1]} class="synchro-av" />
            <Icone nom="refresh-cw" taille={11} />
            {drive.synchro.libelle}
          </p>
          <b class="synchro-titre">{drive.synchro.titre}</b>
          <ul>
            {
              drive.synchro.lignes.map((l, i) => (
                <li class="b" style={`--t:${5.8 + i * 0.3}s`}>
                  {i === 2 && (
                    <span class="trio">
                      <Image src={avatars.peep} alt="" width={32} densities={[1]} />
                      <Image src={avatars.owl} alt="" width={32} densities={[1]} />
                      <Image src={avatars.pecker} alt="" width={32} densities={[1]} />
                    </span>
                  )}
                  <span class="flex-1">{l.texte}</span>
                  <span class={`etat etat-${l.ton}`}>{l.etat}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Generic beat: arrives at `--t` when its screen plays. */
  .joue .b {
    animation: jy-arrive 0.55s var(--ease-entree) var(--t, 0s) both;
  }
  @keyframes jy-arrive {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  /* Shown only while its screen plays, until it ends (final state: hidden). */
  @keyframes jy-visible {
    0%,
    99% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  /* Hidden while its screen plays, until it ends (final state: shown). */
  @keyframes jy-cache {
    0%,
    99% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes jy-pop {
    from {
      opacity: 0;
      scale: 0.5;
    }
  }
  /* A typed word: no room and no ink until its moment. */
  .mot {
    display: inline-block;
    overflow: hidden;
    max-width: 30em;
    padding-right: 0.28em;
    vertical-align: bottom;
    white-space: nowrap;
  }
  .mot.fin {
    padding-right: 0;
  }
  .joue .mot {
    animation: jy-tape var(--t) linear;
  }
  @keyframes jy-tape {
    from,
    to {
      max-width: 0;
      padding-right: 0;
      opacity: 0;
    }
  }
  /* A block that makes room for itself at `--t`, pushing its neighbours. */
  .pousse {
    display: grid;
    grid-template-rows: 1fr;
  }
  .pousse > div {
    min-height: 0;
    overflow: hidden;
  }
  .joue .pousse {
    animation: jy-ouvre 0.45s var(--ease-doux) var(--t) both;
  }
  @keyframes jy-ouvre {
    from {
      grid-template-rows: 0fr;
      opacity: 0;
    }
  }

  /* The Hatch OS and document windows. */
  .fenetre {
    container-type: inline-size;
    width: min(540px, 100%);
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-galet);
    box-shadow: var(--shadow-3);
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .fen-barre {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-ligne-claire);
    background: var(--color-white);
    font-size: 12px;
    color: var(--color-gray-500);
  }
  .fen-barre > b {
    font: 700 14px/1 var(--font-display);
    color: var(--color-ink);
  }
  .feux {
    display: flex;
    flex: none;
    gap: 6px;
    margin-right: 4px;
  }
  .feux span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--color-statut-rouge);
  }
  .feux span:nth-child(2) {
    background: var(--color-amber-line);
  }
  .feux span:nth-child(3) {
    background: var(--color-success);
  }
  /* The pointer: slides to its target, clicks, lifts off. */
  .curseur {
    position: absolute;
    top: 55%;
    left: 50%;
    z-index: 3;
    width: 15px;
    height: 21px;
    fill: var(--color-ink);
    stroke: var(--color-white);
    stroke-width: 1.3;
    stroke-linejoin: round;
    filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--color-shadow) 30%, transparent));
    opacity: 0;
    pointer-events: none;
  }
  @keyframes jy-pointe {
    0% {
      opacity: 0;
      translate: var(--dx) var(--dy);
    }
    15% {
      opacity: 1;
    }
    55% {
      translate: 0 0;
      scale: 1;
    }
    65% {
      scale: 0.82;
    }
    75% {
      scale: 1;
    }
    90% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
      translate: 0 0;
    }
  }

  /* 1. Head office connects Google Drive. */
  .fen-corps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 18px 18px;
  }
  .kicker {
    font: 400 10px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .sources-zone {
    position: relative;
  }
  .sources {
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-ligne-claire);
  }
  .source {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 12px;
    font-size: 12px;
  }
  .source + .source {
    border-top: 1px solid var(--color-ligne-claire);
  }
  .source-nom {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .source-nom b {
    overflow: hidden;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .source-dossier {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-height: 2em;
    font-size: 11px;
    color: var(--color-gray-500);
  }
  .joue .source-dossier {
    animation: jy-dossier 0.45s var(--ease-doux) 2.95s both;
  }
  @keyframes jy-dossier {
    from {
      max-height: 0;
      opacity: 0;
    }
  }
  .app {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    color: var(--color-white);
  }
  .app-vert {
    background: var(--color-success);
  }
  .app-noir {
    background: var(--color-gray-800);
  }
  .app-jaune {
    background: var(--color-amber-line);
    color: var(--color-ink);
  }
  .app-bleu {
    background: var(--color-statut-bleu);
  }
  .bouton {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border-radius: 7px;
    box-shadow: inset 0 0 0 1px var(--color-ligne-claire);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-gray-700);
  }
  .bascule {
    display: grid;
    justify-items: end;
  }
  .bascule > * {
    grid-area: 1 / 1;
  }
  .avant {
    background: var(--color-ink);
    box-shadow: none;
    color: var(--color-white);
    opacity: 0;
  }
  .apres {
    background: var(--color-success-tint);
    box-shadow: none;
    color: var(--color-success-txt);
  }
  .joue .avant {
    animation: jy-visible 2.9s linear forwards;
  }
  .joue .apres {
    animation: jy-pop 0.4s var(--ease-pop) 2.9s both;
  }
  .joue .c1 {
    --dx: 80px;
    --dy: 50px;
    animation: jy-pointe 1.3s var(--ease-doux) 0.3s both;
  }
  .choix {
    position: absolute;
    top: 38px;
    right: 8px;
    z-index: 2;
    width: min(260px, 86%);
    padding: 8px;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow:
      0 0 0 1px var(--color-ligne-claire),
      var(--shadow-3);
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
  }
  .joue .choix {
    animation: jy-menu 1.8s var(--ease-doux) 1.2s both;
  }
  @keyframes jy-menu {
    0% {
      opacity: 0;
      translate: 0 -6px;
      scale: 0.97;
    }
    12%,
    85% {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .choix-titre {
    padding: 2px 6px 6px;
    font: 400 10px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .choix li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border-radius: 8px;
    color: var(--color-gray-500);
  }
  .choix li b,
  .choix li span span {
    display: block;
  }
  .choix li b {
    font-weight: 600;
    color: var(--color-ink);
  }
  .choix li span span {
    font-size: 10.5px;
  }
  .choix .choisi {
    background: var(--color-statut-bleu-tint);
    color: var(--color-statut-bleu);
  }
  .joue .choix .choisi {
    animation: jy-choisi 0.2s linear 2.3s both;
  }
  @keyframes jy-choisi {
    from {
      background: transparent;
      color: var(--color-gray-500);
    }
  }
  .c2 {
    top: 50%;
    left: 70%;
  }
  .joue .c2 {
    --dx: -10px;
    --dy: -40px;
    animation: jy-pointe 1.1s var(--ease-doux) 1.6s both;
  }
  .index {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow:
      inset 0 0 0 1px var(--color-ligne-claire),
      var(--shadow-1);
  }
  .index-tete {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .index-av {
    flex: none;
    width: 30px;
    height: 30px;
  }
  .index-titre {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .index-libelle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 4px;
    font: 400 10px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .compte {
    display: flex;
    align-items: baseline;
    gap: 5px;
    font: 700 20px/1 var(--font-display);
  }
  .compte span:last-child {
    font: 500 12px/1 var(--font-sans);
