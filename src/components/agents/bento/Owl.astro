---
import { Picture } from 'astro:assets';
import type { BentoDe } from '../../../content/schemas/bento';
import Tuile from '../Tuile.astro';
import Icone from '../Icone.astro';
import Ipad from '../../ui/Ipad.astro';
import kiosque from '../../../assets/agents/owl-kiosque.jpg';
import planInox from '../../../assets/agents/owl/plan-inox.jpg';

/**
 * Owl's feature wall (Pencil "Page agent — Owl", frame "03 — Ce que Owl fait pour vous"), tile by
 * tile on the six-column grid; the centre tile (Owl's render) is at column 3, row 1. Mixed
 * registers (César 11/10, after Finch): a voxel render, a dark tile, printed sheets on a real
 * stainless counter, a real iPad.
 */
interface Props {
  d: BentoDe<'owl'>;
}
const { d } = Astro.props;
/** Waveform of the dictated question, a speech-like shape (percent of its height). */
const ONDE = [
  14, 26, 44, 30, 62, 48, 84, 58, 100, 72, 40, 66, 90, 54, 28, 46, 78, 96, 62, 34, 58, 86, 50, 30,
  64, 42, 24, 36, 20, 12,
];
---

<Tuile col={1} row={1} w={2} h={2} titre={d.kiosque.titre} plein class="t-owl-kiosque">
  <Picture
    src={kiosque}
    alt=""
    formats={['avif', 'webp']}
    widths={[420, 640, 840]}
    sizes="(min-width: 1024px) 416px, 92vw"
    loading="lazy"
    class="kiosque-photo"
  />
</Tuile>

<Tuile col={5} row={1} w={2} h={2} titre={d.voix.titre} class="t-owl-voix">
  <div class="voix">
    <span class="onde" aria-hidden="true" data-amb="onde">
      {ONDE.map((h, i) => <span style={`height:${h}%;--j:${i}`} />)}
    </span>
    <p class="question" data-c style="--i:1">{d.voix.question}</p>
    <span class="dictee" data-c style="--i:2">
      <span class="inline-flex" data-amb="pouls">
        <Icone nom="mic" taille={12} />
      </span>
      {d.voix.pastille}
    </span>
  </div>
</Tuile>

<Tuile
  col={1}
  row={3}
  w={3}
  h={1}
  titre={d.documents.titre}
  disposition="ligne"
  class="t-owl-documents"
>
  <Picture
    src={planInox}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 1000, 1400]}
    sizes="(min-width: 1024px) 616px, 92vw"
    loading="lazy"
    class="inox"
  />
  <ul class="feuilles">
    {
      d.documents.sources.map((s, i) => (
        <li class={`feuille feuille-${i}`} data-c style={`--i:${i === 0 ? 2 : i - 1}`}>
          <p class="feuille-source">
            <Icone nom={s.icone} taille={10} class="shrink-0" />
            {s.source}
          </p>
          <b class="feuille-nom">{s.texte}</b>
          {i === 0 && (
            <p class="extrait">
              <span class="inline-flex" data-amb="pouls">
                <Icone nom="sparkles" taille={10} />
              </span>
              {d.documents.extrait}
            </p>
          )}
          <span class="lignes" aria-hidden="true">
            <span />
            <span />
            <span />
            <span />
          </span>
        </li>
      ))
    }
  </ul>
</Tuile>

<Tuile
  col={4}
  row={3}
  w={3}
  h={1}
  titre={d.restaurant.titre}
  disposition="ligne"
  class="t-owl-restaurant"
>
  <div class="poste">
    <div class="tablette" data-c>
      <Ipad>
        <div class="profil">
          <p class="profil-tete">
            <span class="profil-icone"><Icone nom="tablet" taille={14} /></span>
            <span class="flex flex-col">
              <span class="profil-ecran">{d.restaurant.ecran}</span>
              <b>{d.restaurant.tablette}</b>
            </span>
          </p>
          <ul class="reglages">
            {
              d.restaurant.etiquettes.map((e, i) => (
                <li style={`--i:${i}`}>
                  <span>{e}</span>
                  <span class="interrupteur" aria-hidden="true" />
                </li>
              ))
            }
          </ul>
        </div>
      </Ipad>
    </div>
  </div>
</Tuile>

<style>
  /* Tourne en mode kiosque: the voxel render fills the tile, the title sits over it. */
  /* The tile is Tuile's element, outside this component's scope. */
  :global(.mur .t-owl-kiosque) {
    aspect-ratio: 1;
  }
  /* The render's backdrop, for the strip the render leaves above it (beats Tuile's white). */
  :global(article.tuile.t-owl-kiosque) {
    background: color-mix(in srgb, var(--color-gray-400) 52%, var(--color-statut-bleu-tint));
  }
  @media (min-width: 64rem) {
    :global(.mur .t-owl-kiosque) {
      aspect-ratio: auto;
    }
  }
  :global(.mur .t-owl-kiosque .tuile-tete) {
    position: relative;
    z-index: 1;
    padding-top: 28px;
  }
  /* Lowered a little, as in the mock-up, so the title clears the wall. */
  .kiosque-photo {
    position: absolute;
    top: 21px;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The render settles in once, when the tile shows. */
  :global(.mur.js) .kiosque-photo {
    scale: 1.05;
  }
  :global(.mur.js .vu) .kiosque-photo {
    scale: 1;
    transition: scale 1.4s var(--ease-entree);
  }

  /* Comprend la voix: a dark tile, a large orange waveform, then the question it carried. */
  :global(.mur .tuile.t-owl-voix) {
    background: var(--color-night);
  }
  :global(.mur .tuile.t-owl-voix .tuile-tete h3) {
    color: var(--color-white);
  }
  .voix {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 0 28px;
  }
  .onde {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 128px;
  }
  .onde span {
    width: 6px;
    border-radius: 3px;
    background: var(--color-orange);
    transform-origin: center;
  }
  .question {
    margin-top: 36px;
    padding: 0 12px;
    text-align: center;
    font: 600 28px/1.2 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-white);
  }
  .dictee {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 22px;
    padding: 5px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 10%, transparent);
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-white) 75%, transparent);
  }
  .dictee :global(svg) {
    color: var(--color-orange);
  }

  /* Répond à partir de vos documents: printed sheets on a stainless counter, off the bottom edge. */
  .inox {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }
  :global(.mur .t-owl-documents .tuile-tete) {
    position: relative;
    z-index: 1;
  }
  .feuilles {
    position: relative;
    width: 100%;
    max-width: 370px;
    height: 190px;
    margin: 0 auto -16px;
  }
  @media (min-width: 40rem) {
    .feuilles {
      height: 100%;
      margin: 0;
    }
  }
  .feuille {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 150px;
    height: 200px;
    padding: 12px 12px 0;
    border-radius: 3px;
    background: var(--color-white);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-shadow) 18%, transparent),
      0 12px 24px color-mix(in srgb, var(--color-shadow) 22%, transparent);
  }
  /* The sheets behind sit higher, so their names show above the front one. */
  .feuille-1 {
    top: 14px;
    left: 0;
    rotate: -6deg;
  }
  .feuille-2 {
    top: 10px;
    right: 0;
    rotate: 5deg;
  }
  .feuille-0 {
    z-index: 1;
    top: 64px;
    left: calc(50% - 86px);
    width: 172px;
    rotate: -1.5deg;
  }
  .feuille-source {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 9.5px;
    color: var(--color-gray-700);
  }
  .feuille-nom {
    font: 700 14px/1.15 var(--font-display);
    color: var(--color-ink);
  }
  .extrait {
    display: flex;
    align-items: center;
    gap: 4px;
    align-self: flex-start;
    margin: 4px -4px 0;
    padding: 3px 5px;
    border-radius: 2px;
    background: var(--color-orange-tint);
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-orange-txt);
  }
  .lignes {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 6px;
  }
  .lignes span {
    height: 4px;
    border-radius: 2px;
    background: var(--color-gray-100);
  }
  .lignes span:nth-child(2) {
    width: 82%;
  }
  .lignes span:nth-child(3) {
    width: 92%;
  }
  .lignes span:nth-child(4) {
    width: 64%;
  }

  /* S'adapte au restaurant: a real iPad, the tablet's profile on screen, cut by the tile's edges. */
  .poste {
    position: relative;
    width: 100%;
    height: 190px;
    margin-bottom: -16px;
  }
  @media (min-width: 40rem) {
    .poste {
      height: 100%;
      margin-bottom: 0;
    }
  }
  .tablette {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 400px;
    margin-left: -170px;
    rotate: -3deg;
  }
  @media (min-width: 40rem) {
    .tablette {
      top: 12px;
      left: 0;
      margin-left: 0;
    }
  }
  .profil {
    display: flex;
    flex-direction: column;
    gap: 1.5cqw;
    height: 100%;
    padding: 3.6cqw 6cqw;
    background: var(--color-white);
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .profil-tete {
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding-bottom: 2.6cqw;
    border-bottom: 1px solid var(--color-ligne-claire);
  }
  .profil-icone {
    display: grid;
    place-items: center;
    width: 8cqw;
    height: 8cqw;
    border-radius: 2cqw;
    background: var(--color-gray-100);
  }
  .profil-ecran {
    font: 400 2.6cqw/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-700);
  }
  .profil-tete b {
    font-size: 4.4cqw;
    font-weight: 600;
    line-height: 1.2;
  }
  .reglages li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.9cqw 0;
    border-bottom: 1px solid var(--color-ligne-claire);
    font-size: 3.8cqw;
  }
  /* A switch, on: its knob slides across once the tile shows, one after the other. */
  .interrupteur {
    position: relative;
    width: 8.4cqw;
    height: 5cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .interrupteur::after {
    position: absolute;
    top: 0.5cqw;
    left: 3.9cqw;
    width: 4cqw;
    height: 4cqw;
    border-radius: 50%;
    background: var(--color-white);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--color-shadow) 25%, transparent);
    content: '';
  }
  :global(.mur.js) .interrupteur {
    background: var(--color-gray-100);
  }
  :global(.mur.js) .interrupteur::after {
    left: 0.5cqw;
  }
  :global(.mur.js .vu) .interrupteur {
    background: var(--color-orange);
    transition: background-color 0.3s var(--ease-doux) calc(0.8s + var(--i) * 0.3s);
  }
  :global(.mur.js .vu) .interrupteur::after {
    left: 3.9cqw;
    transition: left 0.3s var(--ease-doux) calc(0.8s + var(--i) * 0.3s);
  }
</style>
