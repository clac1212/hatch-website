---
import { Image, Picture } from 'astro:assets';
import type { BentoDe } from '../../../content/schemas/bento';
import Tuile from '../Tuile.astro';
import Icone from '../Icone.astro';
import Ipad from '../../ui/Ipad.astro';
import { avatars } from '../../pages/agent-visuels';
import { centres } from '../visuels';
import documents from '../../../assets/agents/jay/documents.jpg';
import cadenas from '../../../assets/agents/jay/cadenas.jpg';

interface Props {
  d: BentoDe<'jay'>;
}
const { d } = Astro.props;
const teinte = centres.jay.fond;
---

<Tuile col={1} row={1} w={2} h={2} titre={d.outils.titre} class="t-jay-outils">
  <ul class="apps">
    {
      d.outils.apps.map((a, i) => (
        <li class={`app app-${i}`} data-c style={`--i:${i}`}>
          <span class={`app-icone app-${a.ton}`} data-amb="flotte">
            <Icone nom={a.icone} taille={44} />
          </span>
          <span class="app-nom">{a.nom}</span>
        </li>
      ))
    }
  </ul>
  <p class="synchro" data-c style="--i:4">
    <span class="inline-flex" data-amb="tourne">
      <Icone nom="refresh-cw" taille={11} />
    </span>
    {d.outils.synchro}
  </p>
</Tuile>

<Tuile
  col={3}
  row={1}
  w={1}
  h={1}
  titre={d.imports.titre}
  class="t-jay-imports"
  plein
  style={`background-color:${teinte}`}
>
  <Picture
    src={documents}
    alt=""
    formats={['avif', 'webp']}
    widths={[400, 600]}
    sizes="200px"
    class="imports-image"
  />
  <p class="formats" data-c>
    {d.imports.fichiers.map((f) => <span class={`format format-${f.ton}`}>{f.type}</span>)}
  </p>
</Tuile>

<Tuile col={4} row={1} w={1} h={1} titre={d.acces.titre} class="t-jay-acces" plein>
  <Picture
    src={cadenas}
    alt=""
    formats={['avif', 'webp']}
    widths={[300, 450]}
    sizes="150px"
    class="acces-image"
  />
  <ul class="profils">
    {
      d.acces.profils.map((p, i) => (
        <li class:list={['profil', { voit: p.voit }]} data-c style={`--i:${i + 1}`}>
          {p.texte}
          <Icone nom={p.voit ? 'check' : 'lock'} taille={11} />
        </li>
      ))
    }
  </ul>
</Tuile>

<Tuile col={5} row={1} w={2} h={2} titre={d.sources.titre} class="t-jay-sources">
  <div class="imprime">
    <div class="feuille" data-c>
      <p class="feuille-tete">{d.sources.document}</p>
      <ol>
        {d.sources.avant.map((l) => <li>{l}</li>)}
        <li>
          <mark class="surligne">{d.sources.passage}</mark>
        </li>
        {d.sources.apres.map((l) => <li>{l}</li>)}
      </ol>
    </div>
    <p class="etiquette" data-c style="--i:3">
      <span class="punaise" aria-hidden="true"></span>
      <Icone nom="link" taille={12} />
      {d.sources.source}
    </p>
  </div>
</Tuile>

<Tuile col={1} row={3} w={2} h={1} titre={d.exclure.titre} class="t-jay-exclure">
  <div class="exclu">
    <p class="exclu-doc" data-c><s>{d.exclure.document}</s></p>
    <p class="exclu-etat" data-c style="--i:1">
      <span class="interrupteur" aria-hidden="true"></span>
      {d.exclure.etat}
    </p>
  </div>
</Tuile>

<Tuile col={5} row={3} w={2} h={2} titre={d.nourrit.titre} class="t-jay-nourrit">
  <ul class="cartes">
    {
      d.nourrit.agents.map((a, i) => (
        <li class={`carte carte-${i}`} data-c style={`--i:${i}`}>
          <span class="carte-fond" style={`background-color:${centres[a.agent].fond}`} />
          <Image
            src={avatars[a.agent]}
            alt=""
            width={120}
            densities={[1, 2]}
            class="carte-avatar"
          />
          <b>{a.nom}</b>
          <span>{a.texte}</span>
        </li>
      ))
    }
  </ul>
</Tuile>

<Tuile
  col={1}
  row={4}
  w={4}
  h={1}
  titre={d.redaction.titre}
  disposition="ligne"
  class="t-jay-redaction"
  style={`background-color:${teinte}`}
>
  <div class="bureau">
    <div class="tablette" data-c>
      <Ipad>
        <div class="doc">
          <p class="doc-barre" aria-hidden="true">
            <span></span><span></span><span></span>
          </p>
          <b class="doc-titre">{d.redaction.fiche}</b>
          <p>
            <mark class="selection">{d.redaction.selection}</mark>
          </p>
          <p class="doc-suite">{d.redaction.suite}</p>
          <span class="doc-ligne" aria-hidden="true"></span>
          <span class="doc-ligne courte" aria-hidden="true"></span>
        </div>
      </Ipad>
    </div>
    <div class="menu" data-c style="--i:3">
      <p class="menu-tete">
        <span class="inline-flex" data-amb="pouls">
          <Icone nom="sparkles" taille={12} />
        </span>
        {d.redaction.menu}
      </p>
      <ul>
        {
          d.redaction.actions.map((a, i) => (
            <li class:list={{ actif: i === 0 }} data-c style={`--i:${i + 4}`}>
              {a}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Tuile>

<style>
  /* Se branche sur vos outils: four app icons as objects, glossy, lit from above, each on its own shadow. */
  :global(.mur .t-jay-outils .tuile-corps) {
    justify-content: center;
    gap: 26px;
  }
  .apps {
    display: grid;
    grid-template-columns: repeat(2, 104px);
    gap: 26px 34px;
  }
  /* Offsets on `top`: the reveal animates `translate` on every `data-c` element. */
  .app {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .app-0 {
    rotate: -6deg;
  }
  .app-1 {
    rotate: 5deg;
    top: 14px;
  }
  .app-2 {
    rotate: 4deg;
    top: -6px;
  }
  .app-3 {
    rotate: -4deg;
    top: 8px;
  }
  .app-icone {
    position: relative;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 24px;
    color: var(--color-white);
    background-image: linear-gradient(
      165deg,
      color-mix(in srgb, var(--color-white) 26%, transparent),
      transparent 48%,
      color-mix(in srgb, var(--color-shadow) 16%, transparent)
    );
    box-shadow:
      inset 0 1.5px 0 color-mix(in srgb, var(--color-white) 55%, transparent),
      inset 0 -3px 6px color-mix(in srgb, var(--color-shadow) 22%, transparent),
      0 1px 2px color-mix(in srgb, var(--color-shadow) 22%, transparent),
      0 12px 18px -6px color-mix(in srgb, var(--color-shadow) 30%, transparent),
      0 30px 40px -18px color-mix(in srgb, var(--color-shadow) 34%, transparent);
  }
  /* The glass reflection across the icon's upper half. */
  .app-icone::after {
    content: '';
    position: absolute;
    inset: 3px 3px 50%;
    border-radius: 21px 21px 40% 40% / 21px 21px 18px 18px;
    background: linear-gradient(
      color-mix(in srgb, var(--color-white) 34%, transparent),
      transparent
    );
    pointer-events: none;
  }
  .app-icone :global(svg) {
    filter: drop-shadow(0 2px 2px color-mix(in srgb, var(--color-shadow) 30%, transparent));
  }
  .app-vert {
    background-color: var(--color-success);
  }
  .app-noir {
    background-color: var(--color-gray-800);
  }
  .app-jaune {
    background-color: var(--color-amber-line);
    color: var(--color-ink);
  }
  .app-bleu {
    background-color: var(--color-statut-bleu);
  }
  .app-nom {
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-gray-700);
  }
  :global(.mur.js .anime) .app-1 [data-amb='flotte'] {
    animation-delay: -0.55s;
  }
  :global(.mur.js .anime) .app-2 [data-amb='flotte'] {
    animation-delay: -1.1s;
  }
  :global(.mur.js .anime) .app-3 [data-amb='flotte'] {
    animation-delay: -1.65s;
  }
  .synchro {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-mur);
    font-size: 11px;
    color: var(--color-gray-700);
  }

  /* Importe vos PDF: a generated voxel pile of binders and sheets, one sheet landing on it. */
  :global(.mur .t-jay-imports .tuile-tete),
  :global(.mur .t-jay-acces .tuile-tete) {
    position: relative;
    z-index: 1;
    padding: 22px 12px 0;
  }
  .imports-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }
  .formats {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    gap: 3px;
    padding: 3px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-white) 85%, transparent);
    box-shadow: var(--shadow-1);
  }
  .format {
    padding: 3px 5px;
    border-radius: 5px;
    font: 700 8.5px/1 var(--font-sans);
    letter-spacing: 0.04em;
    color: var(--color-white);
  }
  .format-rouge {
    background: var(--color-statut-rouge);
  }
  .format-vert {
    background: var(--color-success-txt);
  }
  .format-violet {
    background: var(--color-trad-violet);
  }

  /* Règle qui voit quoi: a dark tile, a generated voxel padlock, who sees and who doesn't. */
  :global(.mur .tuile.t-jay-acces) {
    background: var(--color-night);
  }
  :global(.mur .tuile.t-jay-acces .tuile-tete h3) {
    color: var(--color-white);
  }
  .acces-image {
    position: absolute;
    bottom: -14px;
    left: -18px;
    width: 156px;
    height: 156px;
    /* The render's backdrop is a hair lighter than night: fade its edges into the tile. */
    mask-image: radial-gradient(closest-side, black 72%, transparent);
  }
  .profils {
    position: absolute;
    right: 14px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
  }
  .profil {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-white) 60%, transparent);
  }
  .profil.voit {
    color: var(--color-white);
  }

  /* Cite ses sources: the printed procedure, the cited passage under a highlighter, the source pinned on. */
  :global(.mur .tuile.t-jay-sources) {
    background: var(--color-cream-2);
  }
  :global(.mur .t-jay-sources .tuile-corps) {
    align-items: stretch;
  }
  .imprime {
    position: relative;
    flex: 1;
    margin: 4px 14px -40px;
  }
  .feuille {
    height: 100%;
    padding: 22px 22px 110px;
    border-radius: 3px;
    background: var(--color-white);
    box-shadow:
      0 1px 1px color-mix(in srgb, var(--color-shadow) 10%, transparent),
      0 16px 34px color-mix(in srgb, var(--color-shadow) 16%, transparent);
    rotate: 2deg;
  }
  .feuille-tete {
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--color-ink);
    font: 400 10px/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .feuille ol {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
    padding-left: 18px;
    list-style: decimal;
    font: 400 13px/1.5 var(--font-sans);
    color: var(--color-gray-700);
  }
  .feuille li::marker {
    font: 400 11px var(--font-mono);
    color: var(--color-gray-500);
  }
  .surligne {
    padding: 1px 2px;
    background-color: transparent;
    background-image: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-amber-line) 60%, transparent),
      color-mix(in srgb, var(--color-amber-line) 85%, transparent)
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    box-decoration-break: clone;
    color: var(--color-ink);
  }
  :global(.mur.js) .surligne {
    background-size: 0% 100%;
  }
  :global(.mur.js .vu) .surligne {
    background-size: 100% 100%;
    transition: background-size 0.9s var(--ease-doux) 0.6s;
  }
  .etiquette {
    position: absolute;
    right: -16px;
    bottom: 64px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px 8px;
    border-radius: 4px;
    background: var(--color-white);
    box-shadow:
      0 0 0 1px var(--color-statut-bleu-tint),
      0 10px 22px color-mix(in srgb, var(--color-shadow) 18%, transparent);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-statut-bleu);
    rotate: -5deg;
  }
  .punaise {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: radial-gradient(
      circle at 35% 30%,
      color-mix(in srgb, var(--color-white) 70%, var(--color-statut-rouge)),
      var(--color-statut-rouge) 55%,
      color-mix(in srgb, var(--color-shadow) 50%, var(--color-statut-rouge))
    );
    box-shadow: 1px 3px 3px color-mix(in srgb, var(--color-shadow) 30%, transparent);
  }

  /* Vous laisse exclure un document: the document's name, large, struck out once the switch turns off. */
  :global(.mur .t-jay-exclure .tuile-corps) {
    justify-content: center;
  }
  .exclu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .exclu-doc {
    font: 600 32px/1.1 var(--font-display);
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--color-gray-500);
  }
  /* The strike drawn as a background, so it crosses every line when the name wraps. */
  .exclu-doc s {
    padding: 0 4px;
    text-decoration: none;
    background: linear-gradient(var(--color-statut-rouge), var(--color-statut-rouge)) no-repeat 0
      58% / 100% 2.5px;
    box-decoration-break: clone;
  }
  :global(.mur.js) .exclu-doc {
    color: var(--color-ink);
  }
  :global(.mur.js) .exclu-doc s {
    background-size: 0% 2.5px;
  }
  :global(.mur.js .vu) .exclu-doc {
    color: var(--color-gray-500);
    transition: color 0.4s var(--ease-doux) 1.5s;
  }
  :global(.mur.js .vu) .exclu-doc s {
    background-size: 100% 2.5px;
    transition: background-size 0.5s var(--ease-doux) 1.4s;
  }
  .exclu-etat {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-gray-700);
  }
  .interrupteur {
    position: relative;
    flex: none;
    width: 42px;
    height: 25px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-gray-400) 55%, var(--color-white));
    box-shadow: inset 0 1px 3px color-mix(in srgb, var(--color-shadow) 14%, transparent);
  }
  .interrupteur::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 21px;
    height: 21px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow:
      0 2px 4px color-mix(in srgb, var(--color-shadow) 22%, transparent),
      0 0 0 0.5px color-mix(in srgb, var(--color-shadow) 8%, transparent);
  }
  /* With motion: the switch starts on, then turns off once the tile is in view. */
  :global(.mur.js) .interrupteur {
    background: var(--color-success);
  }
  :global(.mur.js) .interrupteur::after {
    translate: 17px 0;
  }
  :global(.mur.js .vu) .interrupteur {
    background: color-mix(in srgb, var(--color-gray-400) 55%, var(--color-white));
    transition: background-color 0.3s var(--ease-doux) 1.1s;
  }
  :global(.mur.js .vu) .interrupteur::after {
    translate: 0 0;
    transition: translate 0.3s var(--ease-doux) 1.1s;
  }

  /* Nourrit les autres agents: three cards fanned out, each agent standing out of its card. */
  :global(.mur .t-jay-nourrit .tuile-corps) {
    justify-content: center;
  }
  .cartes {
    display: flex;
    justify-content: center;
    margin-top: -4px;
  }
  .carte {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 140px;
    height: 226px;
    padding: 0 8px 20px;
    justify-content: flex-end;
    font-size: 11.5px;
    color: var(--color-soft);
  }
  .carte + .carte {
    margin-left: -20px;
  }
  .carte-0 {
    rotate: -8deg;
    top: 14px;
  }
  .carte-1 {
    z-index: 1;
    top: -6px;
  }
  .carte-2 {
    rotate: 8deg;
    top: 14px;
  }
  .carte-fond {
    position: absolute;
    inset: 52px 0 0;
    border-radius: 18px;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 60%, transparent),
      0 1px 2px color-mix(in srgb, var(--color-shadow) 12%, transparent),
      0 18px 30px -10px color-mix(in srgb, var(--color-shadow) 30%, transparent);
  }
  .carte-avatar {
    position: absolute;
    top: 0;
    left: 50%;
    width: 128px;
    height: auto;
    translate: -50% 0;
    filter: drop-shadow(0 10px 10px color-mix(in srgb, var(--color-shadow) 26%, transparent));
  }
  .carte b {
    position: relative;
    font: 600 20px/1.1 var(--font-display);
    color: var(--color-ink);
  }
  .carte > span:last-child {
    position: relative;
    margin-top: 2px;
  }

  /* Vous aide à rédiger: the sheet on a real iPad cut by the tile's edge, the AI menu floating in front. */
  :global(.mur .t-jay-redaction .tuile-corps) {
    align-items: stretch;
    overflow: visible;
  }
  .bureau {
    position: relative;
    flex: 1;
  }
  .tablette {
    position: absolute;
    top: 22px;
    left: 0;
    width: 440px;
    rotate: -2deg;
  }
  .doc {
    display: flex;
    flex-direction: column;
    gap: 2.6cqw;
    height: 100%;
    padding: 4cqw 8cqw;
    background: var(--color-white);
    font: 400 3.4cqw/1.45 var(--font-sans);
    color: var(--color-ink);
  }
  .doc-barre {
    display: flex;
    gap: 1.4cqw;
    padding-bottom: 2cqw;
    border-bottom: 1px solid var(--color-ligne-claire);
  }
  .doc-barre span {
    width: 7cqw;
    height: 2cqw;
    border-radius: 1cqw;
    background: var(--color-gray-100);
  }
  .doc-titre {
    font: 600 5.4cqw/1.2 var(--font-display);
  }
  .selection {
    padding: 0.3cqw 0.8cqw;
    border-radius: 0.6cqw;
    background-color: transparent;
    background-image: linear-gradient(var(--color-statut-bleu-tint), var(--color-statut-bleu-tint));
    background-repeat: no-repeat;
    background-size: 100% 100%;
    box-decoration-break: clone;
    box-shadow: inset 0 -0.4cqw 0 var(--color-statut-bleu);
    color: var(--color-ink);
  }
  :global(.mur.js) .selection {
    background-size: 0% 100%;
  }
  :global(.mur.js .vu) .selection {
    background-size: 100% 100%;
    transition: background-size 0.6s var(--ease-doux) 0.5s;
  }
  .doc-suite {
    color: var(--color-gray-700);
  }
  .doc-ligne {
    height: 1.6cqw;
    border-radius: 1cqw;
    background: var(--color-gray-100);
  }
  .doc-ligne.courte {
    width: 60%;
  }
  /* At 1440 the menu overlaps the iPad's right edge (left 360 px); narrower, it stays inside the
     tile, its right edge on the tile's. */
  .menu {
    position: absolute;
    top: 24px;
    left: min(360px, calc(100% - 196px));
    width: 196px;
    padding: 12px 8px 8px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow:
      0 0 0 1px var(--color-ligne-claire),
      0 6px 12px color-mix(in srgb, var(--color-shadow) 10%, transparent),
      0 30px 50px -12px color-mix(in srgb, var(--color-shadow) 36%, transparent);
    font-size: 12.5px;
    color: var(--color-ink);
    rotate: 2deg;
  }
  .menu-tete {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 6px 8px;
    font-weight: 600;
    color: var(--color-statut-bleu);
  }
  .menu ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .menu li {
    padding: 6px;
    border-radius: 8px;
  }
  .menu li.actif {
    background: var(--color-statut-bleu-tint);
    color: var(--color-statut-bleu);
    font-weight: 500;
  }
  /* 1024–1280: a smaller iPad and menu, so the menu sits beside the sheet's title, not over it. */
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .tablette {
