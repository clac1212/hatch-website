---
import { Picture } from 'astro:assets';
import type { BentoDe } from '../../../content/schemas/bento';
import Tuile from '../Tuile.astro';
import Icone from '../Icone.astro';
import IphoneReel from '../IphoneReel.astro';
import LogoWhatsapp from '../LogoWhatsapp.astro';
import Ipad from '../../ui/Ipad.astro';
import { centres } from '../visuels';
import salon from '../../../assets/agents/sparrow/salon.jpg';
import chantier from '../../../assets/agents/sparrow/chantier.jpg';

/**
 * Sparrow's feature wall, tile by tile on the six-column grid; the centre tile (Sparrow's render) is
 * at column 3, row 2. Registers mixed as on Finch's: two generated photos (a trade-show stand, a
 * restaurant under works), two devices (the phone, the tablet), large type, one dark tile.
 */
interface Props {
  d: BentoDe<'sparrow'>;
}
const { d } = Astro.props;
const teinte = centres.sparrow.fond;
const derniere = d.pipeline.etapes.length - 1;
const cases = Array.from({ length: d.espace.total }, (_, i) => i < d.espace.faites);
---

<Tuile col={1} row={1} w={2} h={2} titre={d.numero.titre} class="t-sparrow-numero" plein>
  <div class="scene" aria-hidden="true">
    <Picture
      src={salon}
      alt=""
      formats={['avif', 'webp']}
      widths={[500, 900]}
      sizes="(min-width: 64rem) 430px, 100vw"
      class="scene-photo"
    />
    <!-- The QR code sits on the stand's blank panel (measured on the photo: x 27.5–45.6 %, y 26–50.6 %). -->
    <span class="panneau" data-c>
      <span class="qr-ligne" data-amb="balaye"></span>
      <svg viewBox="0 0 108 108" class="qr">
        <g fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round">
          <rect x="4.5" y="4.5" width="25" height="25" rx="6"></rect>
          <rect x="78.5" y="4.5" width="25" height="25" rx="6"></rect>
          <rect x="4.5" y="78.5" width="25" height="25" rx="6"></rect>
          <path d="M54 18 V36 a10 10 0 0 1 -10 10 H40"></path>
          <path d="M76 52 H84"></path>
          <path d="M74 104 V88 a10 10 0 0 1 10 -10 H90"></path>
        </g>
        <g fill="currentColor">
          <circle cx="54" cy="4.5" r="4.5"></circle>
          <circle cx="4.5" cy="56" r="4.5"></circle>
          <circle cx="30" cy="56" r="4.5"></circle>
          <circle cx="103.5" cy="52" r="4.5"></circle>
          <circle cx="54" cy="80" r="4.5"></circle>
          <circle cx="54" cy="103.5" r="4.5"></circle>
          <circle cx="103.5" cy="103.5" r="4.5"></circle>
        </g>
      </svg>
      <span class="panneau-wa"><LogoWhatsapp taille={11} /></span>
    </span>
  </div>
  <p class="entrees">
    {
      d.numero.entrees.map((e, i) => (
        <span class="entree" data-c style={`--i:${i + 1}`}>
          <Icone nom={e.icone} taille={12} />
          {e.texte}
        </span>
      ))
    }
  </p>
</Tuile>

<Tuile col={3} row={1} w={1} h={1} titre={d.relances.titre} class="t-sparrow-relances" plein>
  <div class="verrou" aria-hidden="true">
    <Picture
      src={centres.sparrow.src}
      alt=""
      formats={['avif', 'webp']}
      widths={[400]}
      sizes="200px"
      class="verrou-fond"
    />
  </div>
  <div class="verrou-corps">
    <p class="verrou-heure">{d.relances.heure}</p>
    <div class="pile">
      <span class="notif notif-dessous" aria-hidden="true"></span>
      <div class="notif" data-c>
        <p class="notif-tete">
          <span class="notif-app" data-amb="sonne"><LogoWhatsapp taille={10} /></span>
          <span class="notif-nom min-w-0 flex-1 truncate">{d.relances.app}</span>
          <span class="notif-quand">{d.relances.pastille}</span>
        </p>
        <b>{d.relances.expediteur}</b>
        <span class="notif-message">{d.relances.message}</span>
      </div>
    </div>
  </div>
</Tuile>

<Tuile col={4} row={1} w={1} h={1} titre={d.reprise.titre}>
  <div class="reprise-scene">
    <span class="reprise" data-c data-amb="pouls">
      <Icone nom="hand" taille={15} />
      {d.reprise.bouton}
    </span>
    <span class="curseur" data-c style="--i:2" aria-hidden="true">
      <Icone nom="mouse-pointer-2" taille={26} />
    </span>
  </div>
</Tuile>

<Tuile
  col={5}
  row={1}
  w={2}
  h={2}
  titre={d.prequalification.titre}
  class="t-sparrow-prequalif"
  style={`background-color:${teinte}`}
>
  <div class="conv">
    <div class="tel" data-c>
      <IphoneReel>
        <div class="wa">
          <div class="wa-haut">
            <p class="wa-statut">{d.prequalification.heure}</p>
            <p class="wa-tete">
              <Icone nom="chevron-left" taille={14} class="wa-retour" />
              <span class="wa-avatar"><Icone nom="store" taille={12} /></span>
              <b>{d.prequalification.contact}</b>
            </p>
          </div>
          <div class="wa-fil">
            <p class="bulle bulle-agent" data-c style="--i:1">{d.prequalification.question}</p>
            <p class="bulle bulle-candidat" data-c style="--i:2">
              {d.prequalification.reponse}
              <Icone nom="check-check" taille={12} class="wa-coche" />
            </p>
          </div>
        </div>
      </IphoneReel>
    </div>
    <ul class="criteres" data-c style="--i:3">
      {
        d.prequalification.criteres.map((c) => (
          <li class:list={{ ok: c.verifie }}>
            <Icone nom={c.verifie ? 'circle-check' : 'hourglass'} taille={14} />
            {c.texte}
          </li>
        ))
      }
    </ul>
  </div>
</Tuile>

<Tuile col={1} row={3} w={1} h={1} titre={d.chantier.titre} class="t-sparrow-chantier" plein>
  <Picture
    src={chantier}
    alt=""
    formats={['avif', 'webp']}
    widths={[400, 600]}
    sizes="(min-width: 64rem) 210px, 50vw"
    class="chantier-photo"
  />
  <ul class="pieces">
    {
      d.chantier.pieces.map((p, i) => (
        <li class:list={['piece', { recu: p.recu }]} data-c style={`--i:${i + 1}`}>
          <Icone nom={p.recu ? 'circle-check' : 'hourglass'} taille={12} />
          {p.texte}
          <span class="sr-only"> · {p.etat}</span>
        </li>
      ))
    }
  </ul>
</Tuile>

<Tuile col={2} row={3} w={1} h={1} titre={d.espace.titre}>
  <div class="espace">
    <ul class="cases" aria-hidden="true">
      {
        cases.map((faite, i) => (
          <li class:list={['case', { faite }]} data-c style={`--i:${i}`}>
            {faite && <Icone nom="check" taille={13} />}
          </li>
        ))
      }
    </ul>
    <p class="espace-chiffre">
      <span class="ratio"
        ><span data-compte={d.espace.faites}>{d.espace.faites}</span><small>/{d.espace.total}</small
        ></span
      >
      <span class="espace-legende">{d.espace.legende}</span>
    </p>
  </div>
</Tuile>

<Tuile col={5} row={3} w={2} h={2} titre={d.ouverture.titre} class="t-sparrow-ouverture">
  <div class="tablette" data-c>
    <Ipad>
      <div class="rp">
        <p class="rp-tete">
          <b>{d.ouverture.ecran}</b>
          <span class="recalcul">
            <span class="inline-flex" data-amb="tourne">
              <Icone nom="refresh-cw" taille={11} />
            </span>
            {d.ouverture.pastille}
          </span>
        </p>
        <ul class="planning">
          {
            d.ouverture.taches.map((t, i) => (
              <li>
                <span class="tache">{t.texte}</span>
                <span class="piste">
                  <span
                    class={`barre barre-${t.etat}`}
                    style={`left:${t.debut}%;width:${t.fin - t.debut}%;--i:${i}`}
                  />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </Ipad>
  </div>
</Tuile>

<Tuile col={1} row={4} w={3} h={1} titre={d.pipeline.titre} disposition="ligne" empile>
  <ol class="entonnoir">
    {
      d.pipeline.etapes.map((e, i) => (
        <li class:list={['palier', { fin: i === derniere }]} data-c style={`--i:${i}`}>
          <span class={`palier-valeur palier-${i}`} data-compte={e.valeur}>
            {e.valeur}
          </span>
          <span class="palier-libelle">{e.libelle}</span>
        </li>
      ))
    }
  </ol>
</Tuile>

<Tuile col={4} row={4} w={1} h={1} titre={d.tableau.titre} class="t-sparrow-tableau" seule>
  <div class="tableau">
    <p class="tableau-chiffre" data-compte={d.tableau.valeur}>{d.tableau.valeur}</p>
    <p class="tableau-legende">{d.tableau.legende}</p>
  </div>
</Tuile>

<style>
  /* Un numéro WhatsApp dédié: the brand's stand at a franchise show, the QR code on its totem. */
  /* The tile is a size container so the square photo always covers it (cover, by hand: the QR code
     must stay on the totem's panel, so the photo and the code scale together). */
  :global(.mur .tuile.t-sparrow-numero) {
    container-type: size;
    aspect-ratio: 1;
  }
  @media (min-width: 64rem) {
    :global(.mur .tuile.t-sparrow-numero) {
      aspect-ratio: auto;
    }
  }
  :global(.mur .t-sparrow-numero .tuile-tete) {
    position: relative;
    z-index: 1;
    padding: 24px 22px 0;
  }
  .scene {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 100cqh);
    aspect-ratio: 1;
    translate: -50% -50%;
  }
  .scene-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .panneau {
    position: absolute;
    top: 26%;
    left: 27.5%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6%;
    width: 18.1%;
    height: 24.6%;
    overflow: hidden;
    color: var(--color-ink);
  }
  .qr {
    flex: none;
    width: 72%;
    height: auto;
    aspect-ratio: 1;
  }
  .panneau-wa {
    display: grid;
    place-items: center;
    width: 18%;
    aspect-ratio: 1;
    border-radius: 25%;
    background: var(--color-whatsapp-brand);
    color: var(--color-white);
  }
  .panneau-wa :global(svg) {
    width: 70%;
    height: 70%;
  }
  /* A scan line sweeps down the code while the tile is on screen (Mur.astro, `balaye`). */
  .qr-ligne {
    /* The code's height, in the scene's width (the panel is 24.6 % of it, the code ~55 % of that). */
    --course: 13cqw;
    position: absolute;
    top: 14%;
    left: 10%;
    right: 10%;
    height: 2px;
    border-radius: 2px;
    background: var(--color-orange);
    box-shadow: 0 0 10px var(--color-orange);
    opacity: 0;
  }
  .entrees {
    position: absolute;
    right: 0;
    bottom: 16px;
    left: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    padding: 0 12px;
  }
  .entree {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 88%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-1);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Des automatisations et des relances: the reminder lands on the candidate's lock screen. */
  :global(.mur .tuile.t-sparrow-relances) {
    color: var(--color-white);
  }
  :global(.mur .t-sparrow-relances .tuile-tete) {
    position: relative;
    z-index: 1;
    padding: 22px 14px 0;
  }
  :global(.mur .tuile.t-sparrow-relances .tuile-tete h3) {
    color: var(--color-white);
    text-shadow: 0 1px 8px color-mix(in srgb, var(--color-shadow) 40%, transparent);
  }
  .verrou {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .verrou-fond {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(14px) saturate(1.2) brightness(0.62);
    scale: 1.25;
  }
  .verrou-corps {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 0 10px 12px;
  }
  .verrou-heure {
    margin-bottom: 6px;
    font: 300 24px/1 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--color-white);
  }
  .pile {
    position: relative;
    width: 100%;
    padding-bottom: 6px;
  }
  .notif {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    padding: 8px 10px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-white) 80%, transparent);
    backdrop-filter: blur(12px);
    font-size: 10px;
    line-height: 1.3;
    color: var(--color-ink);
  }
  /* An earlier reminder, tucked under the new one. */
  .notif-dessous {
    position: absolute;
    right: 8px;
    bottom: 0;
    left: 8px;
    width: auto;
    height: 24px;
    background: color-mix(in srgb, var(--color-white) 45%, transparent);
  }
  .notif-tete {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 9px;
    color: var(--color-gray-700);
  }
  .notif-app {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 4px;
    background: var(--color-whatsapp-brand);
    color: var(--color-white);
  }
  .notif-quand {
    white-space: nowrap;
    font-weight: 600;
    color: var(--color-amber-txt);
  }
  .notif b {
    font-size: 10.5px;
  }
  .notif-message {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--color-gray-700);
  }

  /* La reprise par le siège: the button head office presses, the pointer on it. */
  .reprise-scene {
    position: relative;
    display: grid;
    flex: 1;
    place-items: center;
    padding-bottom: 10px;
  }
  /* Wraps on two lines rather than overflow when the tile is narrow (1024–1280). */
  .reprise {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 12px 18px;
    border-radius: 22px;
    background: var(--color-ink);
    box-shadow:
      0 10px 24px color-mix(in srgb, var(--color-shadow) 28%, transparent),
      0 2px 4px color-mix(in srgb, var(--color-shadow) 18%, transparent);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-white);
    rotate: -3deg;
  }
  .reprise :global(svg) {
    flex: none;
  }
  .curseur {
    position: absolute;
    right: 18%;
    bottom: 4px;
    color: var(--color-ink);
    filter: drop-shadow(0 3px 4px color-mix(in srgb, var(--color-shadow) 30%, transparent));
  }
  .curseur :global(svg) {
    fill: var(--color-white);
  }

  /* La préqualification: the WhatsApp exchange on a real phone, run off the tile's bottom edge, and
     the criteria Sparrow checks on a card laid over it. */
  :global(.mur .t-sparrow-prequalif .tuile-corps) {
    align-items: stretch;
    overflow: visible;
  }
  .conv {
    position: relative;
    flex: 1;
    min-height: 300px;
    margin-bottom: -16px;
  }
  .tel {
    position: absolute;
    top: 4px;
    left: 10%;
    width: 196px;
    rotate: -4deg;
  }
  .wa {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-whatsapp-wall);
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .wa-haut {
    background: var(--color-white);
    box-shadow: 0 1px 0 var(--color-ligne-claire);
  }
  .wa-statut {
    padding: 4.5cqw 10cqw 2cqw;
    font-size: 5.2cqw;
    font-weight: 600;
  }
  .wa-tete {
    display: flex;
    align-items: center;
    gap: 2.4cqw;
    padding: 1.5cqw 4cqw 3cqw;
    font-size: 5.4cqw;
  }
  .wa-tete :global(.wa-retour) {
    width: 6cqw;
    height: 6cqw;
    color: var(--color-statut-bleu);
  }
  .wa-avatar {
    display: grid;
    place-items: center;
    width: 10cqw;
    height: 10cqw;
    border-radius: 999px;
    background: var(--color-orange-tint);
    color: var(--color-orange-txt);
  }
  .wa-avatar :global(svg) {
    width: 5.6cqw;
    height: 5.6cqw;
  }
  .wa-fil {
    display: flex;
    flex-direction: column;
    gap: 3cqw;
    padding: 5cqw 4cqw;
  }
  .bulle {
    max-width: 84%;
    padding: 2.6cqw 3.4cqw;
    border-radius: 3.4cqw;
    box-shadow: 0 0.4cqw 0 color-mix(in srgb, var(--color-shadow) 8%, transparent);
    font-size: 5.4cqw;
    line-height: 1.4;
  }
  .bulle-agent {
    align-self: flex-start;
    background: var(--color-white);
  }
  .bulle-candidat {
    display: flex;
    align-items: flex-end;
    gap: 1.6cqw;
    align-self: flex-end;
    background: var(--color-whatsapp);
  }
  .bulle-candidat :global(.wa-coche) {
    flex: none;
    width: 4.6cqw;
    height: 4.6cqw;
    color: var(--color-whatsapp-tick);
  }
  .criteres {
    position: absolute;
    top: 40%;
    right: 2%;
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--color-white);
    box-shadow:
      0 0 0 1px var(--color-ligne-claire),
      0 16px 32px color-mix(in srgb, var(--color-shadow) 18%, transparent);
    rotate: 3deg;
  }
  .criteres li {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-gray-700);
  }
  .criteres li.ok {
    color: var(--color-success-txt);
  }

  /* Le suivi de chantier: the restaurant under works, the documents still expected laid over it. */
  :global(.mur .t-sparrow-chantier .tuile-tete) {
    position: relative;
    z-index: 1;
    padding: 22px 14px 0;
  }
  :global(.mur .tuile.t-sparrow-chantier .tuile-tete h3) {
    color: var(--color-white);
    text-shadow: 0 1px 10px color-mix(in srgb, var(--color-shadow) 60%, transparent);
  }
  .chantier-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  :global(.mur .t-sparrow-chantier .tuile-corps) {
    justify-content: flex-end;
    min-height: 120px;
    padding: 0 10px 12px;
  }
  .pieces {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    width: 100%;
  }
  .piece {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px 4px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 90%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-1);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-amber-txt);
  }
  .piece.recu {
    color: var(--color-success-txt);
  }

  /* Un espace porteur de projet: the project owner's tasks as nine squares, six ticked. */
  .espace {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .cases {
    display: grid;
    grid-template-columns: repeat(3, 22px);
    gap: 5px;
    padding: 8px;
    border-radius: 10px;
    background: var(--color-white);
    box-shadow:
      0 0 0 1px var(--color-ligne-claire),
      0 8px 18px color-mix(in srgb, var(--color-shadow) 12%, transparent);
    rotate: -4deg;
  }
  .case {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px var(--color-ligne-claire);
  }
  .case.faite {
    box-shadow: none;
    background: var(--color-copper);
    color: var(--color-white);
  }
  .espace-chiffre {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ratio {
    font: 700 38px/1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .ratio small {
    font-size: 22px;
    color: var(--color-gray-700);
  }
  .espace-legende {
    font-size: 11px;
    line-height: 1.3;
    color: var(--color-gray-700);
  }

  /* Le projet d'ouverture: the back-schedule on a tablet run off the tile's corner; its bars fill
     in turn, then the opening day moves into place as the plan is recalculated. */
  :global(.mur .t-sparrow-ouverture .tuile-corps) {
    align-items: flex-start;
    overflow: visible;
