---
import * as icones from '@lucide/astro';

/**
 * A Lucide icon by its kebab-case name (`message-circle`), as written in the content: the icons of
 * the product mock-ups on the agent pages (Pencil uses Lucide). An unknown name fails the build.
 */
interface Props {
  nom: string;
  taille?: number;
  class?: string;
}
const { nom, taille = 16, class: className } = Astro.props;
const pascal = nom.replace(/(^|-)([a-z0-9])/g, (_, __, c: string) => c.toUpperCase());
const Composant = (icones as unknown as Record<string, typeof icones.Mail>)[pascal];
if (!Composant) throw new Error(`No Lucide icon "${nom}" (${pascal})`);
---

<Composant size={taille} stroke-width={1.75} class={className} aria-hidden="true" />
