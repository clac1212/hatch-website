---
/**
 * "What Robin does": four features beside one iPhone running WhatsApp for iOS (ui/WhatsApp.astro,
 * César 09/11: « du WhatsApp ultra réaliste »). Robin is a WhatsApp contact during the beta, so
 * everything happens in what WhatsApp can display: a link preview, a photo, a picture Robin sends
 * (the checked invoice, a chart), a document with its preview, reply buttons, a voice note.
 *   1. Plugs into your tools: a link to connect the inbox, what he found, the month's books in Excel.
 *   2. Checks every invoice: the delivery note photo, the invoice checked line by line, the gap,
 *      the credit request drafted on a "yes".
 *   3. Helps you decide: "worth staying open 2 to 6?", the answer with a chart.
 *   4. Does the prep work: a voice note, the temp contract filled from the template, sent on approval.
 * Four rows one after the other (César 10/11: unfolded, nobody clicks; no phones, too tall): the
 * title and text, beside them a window on the WhatsApp chat (ui/WhatsApp `nu`), sides alternating. Each chat plays once (~4 s) when its window comes into view, then
 * stays to be read and can be scrolled. Without JS or with
 * reduced motion: every chat in its final state. Situations from the Bilal interview (Robin discovery, 05/11).
 * Copy in src/content/sections/robinSituations/{fr,en}.yaml; the numbers are illustrative.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/portraits/robin.jpg';
import WhatsApp from '../ui/WhatsApp.astro';
import Heure from '../ui/WhatsAppHeure.astro';
import { section } from '../../content/section';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await section('robinSituations', locale);
const { conversation, connexion, facture, decision, preparation } = t;

const situations = t.situations;


/** Heights of the voice note's waveform bars. */
const onde = [4, 9, 6, 12, 8, 14, 5, 10, 7, 13, 6, 9, 11, 5, 8, 12, 6, 10, 4, 7, 9, 5];
---

<div class="grille" data-fonctions>
  {
    situations.map((s, i) => {
      const h = s.moment.heure;
      return (
        <article class:list={['fn', i % 2 === 1 && 'inverse']}>
          <div class="fn-texte">
            <h3 class="font-display text-section font-semibold text-balance">{s.titre}</h3>
            <p class="mt-4 max-w-lead text-punch text-(--doux)">{s.texte}</p>
          </div>
          <div class="fn-chat">
              <WhatsApp
                nu
                contact={conversation.contact}
                statut={conversation.enLigne}
                ecrit={conversation.ecrit}
                avatar={portrait}
                saisie={conversation.saisie}
                ariaLabel={conversation.ariaLabel}
              >
                <div class="wa-fil" data-situ={i}>
                <span class="wa-jour">{s.moment.jour}</span>

                {i === 0 && (
                  <>
                    <div class="b in" data-etat="a">
                      <span class="wa-apercu" data-cible="lien">
                        <Image src={portrait} alt="" width={64} densities={[1, 2]} />
                        <span>
                          <b>{connexion.lien.titre}</b>
                          <span>{connexion.lien.sousTitre}</span>
                          <span class="dom">{connexion.lien.domaine}</span>
                        </span>
                      </span>
                      {connexion.demande} <span class="wa-lien">{connexion.lien.url}</span>
                      <Heure heure={h} />
                    </div>
                    <div class="b in" data-etat="c">
                      {connexion.trouve}
                      <span class="puces">
                        {connexion.trouvailles.map((p) => (
                          <span>• {p}</span>
                        ))}
                      </span>
                      <Heure heure={h} />
                    </div>
                    <div class="b in" data-etat="d">
                      {connexion.compta}
                      <Heure heure={h} />
                    </div>
                    <div class="b in fin" data-etat="e">
                      <span class="wa-doc">
                        <span class="wa-doc-ico xls">
                          <span>{connexion.fichier.type}</span>
                        </span>
                        <span>
                          <span>{connexion.fichier.nom}</span>
                          <span class="meta">{connexion.fichier.meta}</span>
                        </span>
                      </span>
                      {connexion.fichier.statut}
                      <Heure heure={h} />
                    </div>
                  </>
                )}

                {i === 1 && (
                  <>
                    <div class="b out media fin" data-etat="a">
                      <span class="media-img photo-bl" aria-hidden="true">
                        <span class="papier">
                          <b>{facture.photo.titre}</b>
                          <i />
                          <i />
                          <i />
                          <i />
                          <i />
                        </span>
                      </span>
                      <span class="media-legende">
                        {facture.photo.legende}
                        <Heure heure={h} lu />
                      </span>
                    </div>
                    <div class="b in media" data-etat="b">
                      <span class="media-img recap">
                        <span class="doc-tete">{facture.document.titre}</span>
                        <span class="lignes">
                          {facture.document.lignes.map((l, k) => (
                            <span class:list={['ligne', l.ecart && 'a-ecart']} data-etat={`l${k}`}>
                              <span>{l.nom}</span>
                              <span>{l.facture}</span>
                              <span class="bl">
                                {facture.document.prefixeBl} {l.livre}
                              </span>
                              <b class="coche" aria-hidden="true">
                                {l.ecart ? '≠' : '✓'}
                              </b>
                            </span>
                          ))}
                        </span>
                        <Heure heure={h} />
                      </span>
                    </div>
                    <div class="b in avec-choix" data-etat="c">
                      {facture.ecart}
                      <Heure heure={h} />
                    </div>
                    <div class="wa-choix" data-etat="d">
                      <span data-cible="oui">{facture.boutons.oui}</span>
                      <span>{facture.boutons.non}</span>
                    </div>
                    <p class="b out fin" data-etat="e">
                      {facture.reponse}
                      <Heure heure={h} lu />
                    </p>
                    <div class="b in fin" data-etat="f">
                      <span class="wa-doc">
                        <span class="wa-doc-ico pdf">
                          <span>{facture.avoir.type}</span>
                        </span>
                        <span>
                          <span>{facture.avoir.nom}</span>
                          <span class="meta">{facture.avoir.meta}</span>
                        </span>
                      </span>
                      {facture.avoir.statut}
                      <Heure heure={h} />
                    </div>
                  </>
                )}

                {i === 2 && (
                  <>
                    <p class="b out fin" data-etat="a">
                      {decision.question}
                      <Heure heure={h} lu />
                    </p>
                    <div class="b in media fin" data-etat="b">
                      <span class="media-img graphe" data-etat="g">
                        <span class="g-titre">{decision.graphe.titre}</span>
                        <span class="graph">
                          <span class="seuil" aria-hidden="true">
                            <span>{decision.graphe.seuil}</span>
                          </span>
                          {decision.graphe.jours.map((d) => (
                            <span
                              class:list={['barre', d.auDessus && 'au-dessus']}
                              style={`--h:${d.ventes}`}
                            >
                              <i />
                              <span>{d.jour}</span>
                            </span>
                          ))}
                        </span>
                      </span>
                      <span class="media-legende">
                        {decision.reponse}
                        <Heure heure={h} />
                      </span>
                    </div>
                  </>
                )}

                {i === 3 && (
                  <>
                    <div class="b out vocal fin" data-etat="a">
                      <span class="v-lecture" aria-hidden="true">
                        <svg viewBox="0 0 12 14">
                          <path d="M1 1.6v10.8c0 .8.9 1.3 1.6.8l8.6-5.4c.6-.4.6-1.3 0-1.6L2.6.8C1.9.3 1 .8 1 1.6Z" />
                        </svg>
                      </span>
                      <span class="v-piste">
                        <span class="v-onde" aria-hidden="true">
                          {onde.map((v) => (
                            <i style={`--v:${v}`} />
                          ))}
                        </span>
                        <span class="v-pied">
                          <span>{preparation.vocal.duree}</span>
                          <Heure heure={h} lu />
                        </span>
                      </span>
                      <span class="v-av" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <circle cx="12" cy="9" r="4.2" />
                          <path d="M3.5 21c.9-4.2 4.3-6.6 8.5-6.6s7.6 2.4 8.5 6.6Z" />
                        </svg>
                        <span class="v-micro" />
                      </span>
                      <span class="v-transcrit">{preparation.vocal.transcription}</span>
                    </div>
                    <div class="b in avec-choix" data-etat="b">
                      <span class="wa-docbloc">
                        <span class="contrat" aria-hidden="true">
                          <span class="c-tete">
                            {preparation.contrat.titre}
                            <span class="tampon" data-etat="tampon">
                              {preparation.contrat.tampon}
                            </span>
                          </span>
                          {preparation.contrat.champs.map((c, k) => (
                            <span class="champ-c" data-etat={`c${k}`}>
                              <span class="ck">{c.cle}</span>
                              <span class="cv">
                                <span class="vide" />
                                <span class="val">{c.valeur}</span>
                              </span>
                            </span>
                          ))}
                        </span>
                        <span class="wa-doc">
                          <span class="wa-doc-ico pdf">
                            <span>PDF</span>
                          </span>
                          <span>
                            <span>{preparation.contrat.nom}</span>
                            <span class="meta">{preparation.contrat.meta}</span>
                          </span>
                        </span>
                      </span>
                      {preparation.question}
                      <Heure heure={h} />
                    </div>
                    <div class="wa-choix" data-etat="d">
                      <span data-cible="envoyer">{preparation.boutons.oui}</span>
                      <span>{preparation.boutons.non}</span>
                    </div>
                    <p class="b out fin" data-etat="e">
                      {preparation.reponse}
                      <Heure heure={h} lu />
                    </p>
                    <p class="b in fin" data-etat="f">
                      {preparation.confirmation}
                      <Heure heure={h} />
                    </p>
                  </>
                )}
                </div>
                <span class="doigt" aria-hidden="true" />
              </WhatsApp>
          </div>
        </article>
      );
    })
  }
</div>

<script>
  // Each scene is a list of steps { t: ms, on: [states to turn on, 'name' or 'name:class'],
  // off: [states to turn off], tap: the target the thumb taps }. 'tete' is the chat's header.
  // Fast on purpose (César 09/11): the whole chat is on screen within ~4 s, then it is read.
  type Etape = { t: number; on?: string[]; off?: string[]; tap?: string };
const SCENARIOS: Record<string, Etape[]> = {
    0: [
      { t: 150, on: ['tete:ecrit'] },
      { t: 550, on: ['a'], off: ['tete:ecrit'] },
      { t: 1200, tap: 'lien' },
      { t: 1500, on: ['tete:ecrit'] },
      { t: 1950, on: ['c'], off: ['tete:ecrit'] },
      { t: 2350, on: ['tete:ecrit'] },
      { t: 2750, on: ['d'], off: ['tete:ecrit'] },
      { t: 3150, on: ['e'] },
    ],
    1: [
      { t: 150, on: ['a'] },
      { t: 450, on: ['tete:ecrit'] },
      { t: 850, on: ['b'], off: ['tete:ecrit'] },
      { t: 1100, on: ['l0:lu'] },
      { t: 1350, on: ['l0:ok', 'l1:lu'] },
      { t: 1600, on: ['l1:ok', 'l2:lu'] },
      { t: 1900, on: ['l2:ecart'] },
      { t: 2300, on: ['c', 'd'] },
      { t: 2900, tap: 'oui' },
      { t: 3200, on: ['e'] },
      { t: 3400, on: ['tete:ecrit'] },
      { t: 3800, on: ['f'], off: ['tete:ecrit'] },
    ],
    2: [
      { t: 150, on: ['a'] },
      { t: 450, on: ['tete:ecrit'] },
      { t: 1100, on: ['b'], off: ['tete:ecrit'] },
      { t: 1400, on: ['g:lu'] },
    ],
    3: [
      { t: 150, on: ['a'] },
      { t: 500, on: ['tete:ecrit'] },
      { t: 900, on: ['b'], off: ['tete:ecrit'] },
      { t: 1100, on: ['c0'] },
      { t: 1300, on: ['c1'] },
      { t: 1500, on: ['c2'] },
      { t: 1700, on: ['c3'] },
      { t: 2000, on: ['tampon'] },
      { t: 2300, on: ['d'] },
      { t: 2900, tap: 'envoyer' },
      { t: 3200, on: ['e'] },
      { t: 3400, on: ['tete:ecrit'] },
      { t: 3800, on: ['f'], off: ['tete:ecrit'] },
    ],
  };
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const racine = document.querySelector<HTMLElement>('[data-fonctions]');

  // One chat per row: it plays once when its phone comes into view, then stays to be read.
  const scene = (fil: HTMLElement) => {
    const etapes = SCENARIOS[fil.dataset.situ ?? ''] ?? [];
    const ecran = fil.closest<HTMLElement>('.wai-zone')!;
    // The bare chat has no header: the « typing » steps then do nothing.
    const tete = fil.closest('.wai')!.querySelector<HTMLElement>('[data-tete]');
    const doigt = ecran.querySelector<HTMLElement>('.doigt');
    const el = (nom: string) =>
      nom === 'tete' ? tete : fil.querySelector<HTMLElement>(`[data-etat="${nom}"]`);

    // The iOS tail sits on the last visible bubble of each speaker's group.
    const queues = () => {
      const vus = [...fil.querySelectorAll<HTMLElement>('.b.on, .wa-choix.on')];
      vus.forEach((b, k) => {
        const suivant = vus[k + 1];
        const cote = b.classList.contains('out');
        const fin =
          b.classList.contains('b') &&
          !b.classList.contains('avec-choix') &&
          (!suivant ||
            !suivant.classList.contains('b') ||
            suivant.classList.contains('out') !== cote);
        b.classList.toggle('fin', fin);
      });
    };
    const basculer = (spec: string, oui: boolean) => {
      const [nom, cls = 'on'] = spec.split(':');
      const e = el(nom);
      if (!e) return;
      e.classList.toggle(cls, oui);
      if (oui && e !== tete) {
        queues();
        fil.scrollTo({ top: fil.scrollHeight, behavior: reduit ? 'auto' : 'smooth' });
      }
    };
    const taper = (nom: string) => {
      const c = fil.querySelector<HTMLElement>(`[data-cible="${nom}"]`);
      if (!c || !doigt) return;
      const r = ecran.getBoundingClientRect();
      const b = c.getBoundingClientRect();
      doigt.style.setProperty('--x', `${b.left - r.left + b.width / 2}px`);
      doigt.style.setProperty('--y', `${b.top - r.top + b.height / 2}px`);
      c.classList.add('presse');
      c.parentElement!.classList.add('fait');
      doigt.classList.remove('tape');
      void doigt.offsetWidth;
      doigt.classList.add('tape');
    };
    const appliquer = (e: Etape, sansDoigt = false) => {
      e.on?.forEach((n) => basculer(n, true));
      e.off?.forEach((n) => basculer(n, false));
      if (e.tap && !sansDoigt) taper(e.tap);
    };
    return () => {
      if (reduit) {
        etapes.forEach((e) => appliquer(e, true));
        fil.querySelectorAll('.wa-choix').forEach((c) => c.classList.add('fait'));
        tete?.classList.remove('ecrit');
        return;
      }
      etapes.forEach((e) => window.setTimeout(() => appliquer(e), e.t));
    };
  };

  if (racine) {
    racine.classList.add('js');
    const obs = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) {
          if (!e.isIntersecting) continue;
          obs.unobserve(e.target);
          jouer.get(e.target)?.();
        }
      },
      { threshold: 0.45 },
    );
    const jouer = new Map<Element, () => void>();
    racine.querySelectorAll<HTMLElement>('[data-situ]').forEach((fil) => {
      const fenetre = fil.closest('.fn-chat')!;
      jouer.set(fenetre, scene(fil));
      obs.observe(fenetre);
    });
  }
</script>

<style>
  /* --- Four rows one after the other: the text, the chat window beside it, sides alternating --- */
  .grille {
    display: grid;
    gap: clamp(3rem, 1.5rem + 4vw, 5.5rem);
  }
  .fn {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  /* The chat window: the conversation on its wallpaper, a fixed height so every row has the same
     rhythm; the oldest messages fade out at the top as new ones arrive. */
  .fn-chat {
    /* exception: the window's height, enough for the longest exchange's last messages */
    height: 400px;
    overflow: clip;
    border-radius: var(--radius-card);
    corner-shape: squircle;
    box-shadow: var(--shadow-2);
  }
  @media (width >= 64rem) {
    .fn {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 6.5rem);
    }
    .fn.inverse .fn-texte {
      order: 2;
    }
    .fn-chat {
      height: 420px;
    }
  }

  /* --- The chats --- */
  /* Messages arrive one by one with JS; without it, they are all there. */
  .js .b,
  .js .wa-choix {
    display: none;
  }
  .js .b.on {
    display: block;
    animation: arrive 0.3s var(--ease-hatch) both;
  }
  .js .wa-choix.on {
    display: flex;
    animation: arrive 0.3s var(--ease-hatch) both;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 0.5em;
    }
  }
  .puces {
    display: block;
    margin-top: 0.15em;
  }
  .puces > span {
    display: block;
  }

  /* exception: the pictures sent in the chat are drawn here, sized in em like the chat itself. */
  /* The delivery note, photographed on the steel counter. */
  .photo-bl {
    display: grid;
    place-items: center;
    width: 14em;
    aspect-ratio: 4 / 3;
    background: var(--color-metal);
  }
  .papier {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    width: 62%;
    padding: 0.7em 0.7em 0.9em;
    background: var(--color-white);
    rotate: -4deg;
    box-shadow: 0 0.2em 0.5em color-mix(in srgb, var(--color-black) 22%, transparent);
  }
  .papier b {
    font-size: 0.42em;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .papier i {
    height: 0.28em;
    border-radius: 0.15em;
    background: var(--color-gray-400);
  }
  .papier i:nth-child(odd) {
    width: 70%;
  }

  /* The checked invoice, a picture Robin sends. */
  .recap {
    width: 21.5em;
    padding: 0.7em 0.7em 1.9em;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-gray-100);
    font-size: 0.82em;
  }
  .doc-tete {
    display: block;
    margin-bottom: 0.4em;
    font-weight: 600;
  }
  .lignes {
    display: flex;
    flex-direction: column;
  }
  .ligne {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr auto;
    white-space: nowrap;
    gap: 0.35em;
    align-items: center;
    padding: 0.42em 0.35em;
    border-top: 1px solid var(--color-gray-100);
    transition: background-color 0.3s;
  }
  .ligne.lu {
    background: var(--color-gray-50);
  }
  .bl {
    color: var(--color-whatsapp-meta);
  }
  .coche {
    display: grid;
    place-items: center;
    width: 1.25em;
    height: 1.25em;
    border-radius: 999px;
    font-size: 0.8em;
    opacity: 0;
    scale: 0.5;
    transition:
      opacity 0.25s,
      scale 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ligne.ok .coche,
  .ligne.ecart .coche,
  .fonctions:not(.js) .coche {
    opacity: 1;
    scale: 1;
  }
  .ligne.ok .coche,
  .fonctions:not(.js) .ligne:not(.a-ecart) .coche {
    background: var(--color-success);
    color: var(--color-white);
  }
  .ligne.ecart,
  .fonctions:not(.js) .a-ecart {
    background: var(--color-amber-tint);
  }
  .ligne.ecart .coche,
  .fonctions:not(.js) .a-ecart .coche {
    background: var(--color-whatsapp-pdf);
    color: var(--color-white);
  }
  .ligne.ecart > span:nth-child(2),
  .ligne.ecart .bl {
    font-weight: 700;
    color: var(--color-whatsapp-pdf);
  }

  /* The chart, a picture Robin sends. */
  .graphe {
    width: 17.6em;
    padding: 0.75em 0.8em 0.6em;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-gray-100);
  }
  .g-titre {
    display: block;
    margin-bottom: 0.3em;
    font-size: 0.68em;
    font-weight: 600;
    color: var(--color-whatsapp-meta);
  }
  .graph {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: end;
    gap: 0.5em;
    height: 7.4em;
    padding-top: 0.4em;
  }
  .seuil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(55 * 0.075em + 1em);
    border-top: 1.5px dashed var(--color-whatsapp-ink);
    opacity: 0.55;
  }
  .seuil span {
    position: absolute;
    left: 0;
    bottom: 0.2em;
    padding-right: 0.3em;
    background: var(--color-white);
    font-size: 0.55em;
  }
  .barre {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25em;
    height: 100%;
  }
  .barre i {
    display: block;
    width: 100%;
    height: calc(var(--h) * 0.075em);
    border-radius: 0.25em 0.25em 0.06em 0.06em;
    background: var(--color-gray-100);
    transition: background-color 0.5s;
  }
  .barre span {
    height: 0.75em;
    font-size: 0.6em;
    color: var(--color-whatsapp-meta);
  }
  .graphe.lu .barre i,
  .fonctions:not(.js) .barre i {
    background: var(--color-gray-400);
  }
  .graphe.lu .barre.au-dessus i,
  .fonctions:not(.js) .barre.au-dessus i {
    background: var(--color-whatsapp-brand);
  }

  /* The voice note (sent, listened to), then its transcript. */
  .js .b.vocal.on,
  .fonctions:not(.js) .b.vocal {
    display: grid;
