---
/**
 * "What Robin does": four situations, each played out in a WhatsApp conversation (Robin's
 * interface during the beta, there is no app yet). Everything that moves happens in elements
 * WhatsApp can display: a link, a photo, a document, a chart sent as an image, quick reply
 * buttons. The owner's thumb taps on them.
 *   1. Plugs into your tools: a link to connect the inbox, what he found, and the month's books
 *      prepared in an Excel file, to review before sending to the accountant.
 *   2. Checks every invoice: the delivery note photo, the invoice checked line by line, the gap,
 *      the credit request drafted on a "yes".
 *   3. Helps you decide: "worth staying open 2 to 6?", the answer with a chart.
 *   4. Does the prep work: a voice note, the temp contract filled from the template, sent on approval.
 * Situations taken from the Bilal interview (Robin discovery, 05/11). Each scene plays once when it
 * scrolls into view and stops on its final state (no loop, so no pause needed); "Replay" restarts
 * it. Without JS or with reduced motion: the final state, straight away.
 * Copy in src/content/sections/robinSituations/{fr,en}.yaml; the numbers are illustrative.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/portraits/robin.jpg';
import Iphone from '../ui/Iphone.astro';
import { section } from '../../content/section';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await section('robinSituations', locale);
const { conversation, connexion, facture, decision, preparation } = t;

const situations = t.situations;

/** Heights of the voice note's waveform bars. */
const onde = [4, 9, 6, 12, 8, 14, 5, 10, 7, 13, 6, 9, 11, 5, 8, 12, 6, 10, 4, 7, 9, 5];
---

<div class="fonctions" data-fonctions>
  <!-- The four features: each lights in turn (a bar fills, then the next one), a click picks one -->
  <ol class="liste" role="list">
    {
      situations.map((s, i) => (
        <li class:list={['fn', i === 0 && 'on']} data-fn={i}>
          <button type="button" class="fn-btn" aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="fn-barre" aria-hidden="true">
              <i />
            </span>
            <span class="fn-num font-mono text-kicker">0{i + 1}</span>
            <span class="fn-titre font-display font-semibold">{s.titre}</span>
            <span class="fn-plie">
              <span class="fn-texte text-body text-(--doux)">{s.texte}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ol>
  <!-- On phones the list is a row of tabs: the active feature's text sits under it -->
  <div class="fn-detail text-body text-(--doux)">
    {situations.map((s, i) => <p class:list={[i === 0 && 'on']}>{s.texte}</p>)}
  </div>

  <!-- One realistic phone: one chat with Robin, each feature a day of it, slid in like WhatsApp -->
  <div class="tel-zone">
    <Iphone class="tel">
      <div class="wa" aria-label={conversation.ariaLabel}>
        <header class="wa-tete" data-tete>
          <span class="wa-retour" aria-hidden="true">←</span>
          <Image src={portrait} alt="" width={36} densities={[1, 2]} class="wa-av" />
          <span class="wa-qui">
            <b>{conversation.contact}</b>
            <span class="st-ligne">{conversation.enLigne}</span>
            <span class="st-ecrit">{conversation.ecrit}</span>
          </span>
          <span class="wa-icones" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 7h12v10H3zM16 10l5-3v10l-5-3z" /></svg>
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" /></svg>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="12" cy="19" r="2" /></svg>
          </span>
        </header>

        <div class="wa-fils">
        {
          situations.map((s, i) => (
            <div class:list={['wa-fil', i === 0 && 'on']} data-situ={i} style={`--heure:"${s.moment.heure}"`}>
              <span class="jour">{s.moment.jour}</span>
              {/* 1 · The link to connect the inbox */}
              {i === 0 && (
                <>
                  <div class="m robin" data-etat="a">
                    {connexion.demande}
                    <span class="carte-lien" data-cible="lien">
                      <span class="cl-ico">{connexion.lien.icone}</span>
                      <span class="cl-txt">
                        <b>{connexion.lien.titre}</b>
                        <span>{connexion.lien.sousTitre}</span>
                      </span>
                      <span class="cl-ok" data-etat="ok">✓</span>
                    </span>
                  </div>
                  <p class="m sys" data-etat="b">{connexion.systeme}</p>
                  <div class="m robin" data-etat="c">
                    {connexion.trouve}
                    <span class="puces">
                      {connexion.trouvailles.map((p, k) => (
                        <span class="puce" style={`--k:${k}`}>
                          {p}
                        </span>
                      ))}
                    </span>
                  </div>
                  <div class="m robin" data-etat="d">
                    {connexion.compta}
                    <span class="fichier xls">
                      <span class="f-ico">{connexion.fichier.type}</span>
                      <span class="f-txt">
                        <b>{connexion.fichier.nom}</b>
                        <span>{connexion.fichier.statut}</span>
                      </span>
                    </span>
                  </div>
                </>
              )}

              {/* 2 · The delivery note photo, the checked invoice, the credit request on a "yes" */}
              {i === 1 && (
                <>
                  <div class="m patron photo" data-etat="a">
                    <span class="bl-photo" aria-hidden="true">
                      <b>{facture.photo.titre}</b>
                      <i />
                      <i />
                      <i />
                      <i />
                    </span>
                    {facture.photo.legende}
                  </div>
                  <div class="m robin" data-etat="b">
                    <span class="doc-tete">{facture.document.titre}</span>
                    <span class="lignes">
                      {facture.document.lignes.map((l, k) => (
                        <span class:list={['ligne', l.ecart && 'a-ecart']} data-etat={`l${k}`}>
                          <span>{l.nom}</span>
                          <span>{l.facture}</span>
                          <span class="bl">
                            {facture.document.prefixeBl} {l.livre} <b class="coche" aria-hidden="true">{l.ecart ? '≠' : '✓'}</b>
                          </span>
                        </span>
                      ))}
                    </span>
                  </div>
                  <div class="m robin avec-boutons" data-etat="c">
                    {facture.ecart}
                  </div>
                  <div class="boutons" data-etat="d">
                    <span data-cible="oui">{facture.boutons.oui}</span>
                    <span>{facture.boutons.non}</span>
                  </div>
                  <p class="m patron" data-etat="e">{facture.reponse}</p>
                  <div class="m robin" data-etat="f">
                    <span class="fichier">
                      <span class="f-ico">{facture.avoir.type}</span>
                      <span class="f-txt">
                        <b>{facture.avoir.nom}</b>
                        <span>{facture.avoir.statut}</span>
                      </span>
                    </span>
                  </div>
                </>
              )}

              {/* 3 · The question, the answer with the chart */}
              {i === 2 && (
                <>
                  <p class="m patron" data-etat="a">{decision.question}</p>
                  <div class="m robin image" data-etat="b">
                    <span class="graphe" data-etat="g">
                      <span class="g-titre">{decision.graphe.titre}</span>
                      <span class="graph">
                        <span class="seuil" aria-hidden="true">
                          <span>{decision.graphe.seuil}</span>
                        </span>
                        {decision.graphe.jours.map((d) => (
                          <span class:list={['barre', d.auDessus && 'au-dessus']} style={`--h:${d.ventes}`}>
                            <i />
                            <span>{d.jour}</span>
                          </span>
                        ))}
                      </span>
                    </span>
                    <span class="leg">{decision.reponse}</span>
                  </div>
                </>
              )}

              {/* 4 · A voice note, the contract filled from the template, sent on approval */}
              {i === 3 && (
                <>
                  <div class="m patron vocal" data-etat="a">
                    <span class="v-lecture" aria-hidden="true">▶</span>
                    <span class="v-onde" aria-hidden="true">
                      {onde.map((v) => (
                        <i style={`--v:${v}`} />
                      ))}
                    </span>
                    <span class="v-duree">{preparation.vocal.duree}</span>
                    <span class="v-transcrit">{preparation.vocal.transcription}</span>
                  </div>
                  <div class="m robin" data-etat="b">
                    <span class="contrat">
                      <span class="doc-tete c-tete">
                        {preparation.contrat.titre}
                        <span class="tampon" data-etat="tampon">
                          {preparation.contrat.tampon}
                        </span>
                      </span>
                      <span class="champs">
                        {preparation.contrat.champs.map((c, k) => (
                          <span class="champ-c" data-etat={`c${k}`}>
                            <span class="ck">{c.cle}</span>
                            <span class="cv">
                              <span class="vide" aria-hidden="true" />
                              <span class="val">{c.valeur}</span>
                            </span>
                          </span>
                        ))}
                      </span>
                    </span>
                    {preparation.question}
                  </div>
                  <div class="boutons" data-etat="d">
                    <span data-cible="envoyer">{preparation.boutons.oui}</span>
                    <span>{preparation.boutons.non}</span>
                  </div>
                  <p class="m patron" data-etat="e">{preparation.reponse}</p>
                  <p class="m robin" data-etat="f">
                    {preparation.confirmation}
                  </p>
                </>
              )}
            </div>

          ))
        }
        </div>

        <div class="wa-saisie" aria-hidden="true">
          <span>{conversation.saisie}</span>
          <span class="micro">
            <svg viewBox="0 0 24 24"><path d="M12 15a3 3 0 003-3V6a3 3 0 00-6 0v6a3 3 0 003 3zm5-3a5 5 0 01-10 0H5a7 7 0 006 6.9V21h2v-2.1a7 7 0 006-6.9z" /></svg>
          </span>
        </div>
        <span class="doigt" aria-hidden="true" />
      </div>
    </Iphone>
  </div>
</div>

<script is:inline data-keep>
  // Each scene is a list of steps { t: ms, on: [states to turn on, 'name' or 'name:class'],
  // off: [states to turn off], tap: the target the thumb taps }. 'tete' is the shared chat header.
  // Fast on purpose (César 09/11): the whole chat is on screen within ~4 s, then it is read.
  (function () {
    var SCENARIOS = {
      0: [
        { t: 150, on: ['tete:ecrit'] },
        { t: 500, on: ['a'], off: ['tete:ecrit'] },
        { t: 1000, tap: 'lien' },
        { t: 1200, on: ['ok'] },
        { t: 1500, on: ['b'] },
        { t: 1700, on: ['tete:ecrit'] },
        { t: 2100, on: ['c'], off: ['tete:ecrit'] },
        { t: 2700, on: ['tete:ecrit'] },
        { t: 3100, on: ['d'], off: ['tete:ecrit'] },
      ],
      1: [
        { t: 150, on: ['a'] },
        { t: 450, on: ['tete:ecrit'] },
        { t: 850, on: ['b'], off: ['tete:ecrit'] },
        { t: 1100, on: ['l0:lu'] },
        { t: 1350, on: ['l0:ok', 'l1:lu'] },
        { t: 1600, on: ['l1:ok', 'l2:lu'] },
        { t: 1900, on: ['l2:ecart'] },
        { t: 2300, on: ['c', 'd'] },
        { t: 2900, tap: 'oui' },
        { t: 3200, on: ['e'] },
        { t: 3400, on: ['tete:ecrit'] },
        { t: 3800, on: ['f'], off: ['tete:ecrit'] },
      ],
      2: [
        { t: 150, on: ['a'] },
        { t: 450, on: ['tete:ecrit'] },
        { t: 1100, on: ['b'], off: ['tete:ecrit'] },
        { t: 1400, on: ['g:lu'] },
      ],
      3: [
        { t: 150, on: ['a'] },
        { t: 500, on: ['tete:ecrit'] },
        { t: 900, on: ['b'], off: ['tete:ecrit'] },
        { t: 1100, on: ['c0'] },
        { t: 1300, on: ['c1'] },
        { t: 1500, on: ['c2'] },
        { t: 1700, on: ['c3'] },
        { t: 2000, on: ['tampon'] },
        { t: 2300, on: ['d'] },
        { t: 2900, tap: 'envoyer' },
        { t: 3200, on: ['e'] },
        { t: 3400, on: ['tete:ecrit'] },
        { t: 3800, on: ['f'], off: ['tete:ecrit'] },
      ],
    };
    var SORTIE = 450; // ms, the outgoing chat's slide (matches the CSS)
    var reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var racine = document.querySelector('[data-fonctions]');
    if (!racine) return;
    var ecran = racine.querySelector('.wa');
    var tete = racine.querySelector('[data-tete]');
    var doigt = racine.querySelector('.doigt');

    function scene(fil) {
      var etapes = SCENARIOS[fil.getAttribute('data-situ')] || [];
      var minuteries = [];
      var allumes = [];
      function el(nom) {
        return nom === 'tete' ? tete : fil.querySelector('[data-etat="' + nom + '"]');
      }
      function basculer(spec, oui) {
        var p = spec.split(':');
        var e = el(p[0]);
        if (!e) return;
        var cls = p[1] || 'on';
        e.classList.toggle(cls, oui);
        if (oui && e !== tete) {
          allumes.push([e, cls]);
          fil.scrollTo({ top: fil.scrollHeight, behavior: reduit ? 'auto' : 'smooth' });
        }
      }
      function taper(nom) {
        var c = fil.querySelector('[data-cible="' + nom + '"]');
        if (!c || !doigt) return;
        var r = ecran.getBoundingClientRect();
        var b = c.getBoundingClientRect();
        doigt.style.setProperty('--x', b.left - r.left + b.width / 2 + 'px');
        doigt.style.setProperty('--y', b.top - r.top + b.height / 2 + 'px');
        c.classList.add('presse');
        allumes.push([c, 'presse']);
        doigt.classList.remove('tape');
        void doigt.offsetWidth;
        doigt.classList.add('tape');
      }
      function appliquer(e, sansDoigt) {
        (e.on || []).forEach(function (n) {
          basculer(n, true);
        });
        (e.off || []).forEach(function (n) {
          basculer(n, false);
        });
        if (e.tap && !sansDoigt) taper(e.tap);
      }
      function vider() {
        minuteries.forEach(clearTimeout);
        minuteries = [];
        allumes.forEach(function (a) {
          a[0].classList.remove(a[1]);
        });
        allumes = [];
      }
      return {
        fil: fil,
        jouer: function () {
          vider();
          fil.scrollTop = 0;
          if (reduit) {
            etapes.forEach(function (e) {
              appliquer(e, true);
            });
            tete.classList.remove('ecrit');
            return;
          }
          etapes.forEach(function (e) {
            minuteries.push(setTimeout(appliquer, e.t, e));
          });
        },
        // Once its slide-out is over, so the outgoing chat does not empty while it leaves.
        ranger: function () {
          minuteries.forEach(clearTimeout);
          minuteries = [setTimeout(vider, SORTIE)];
        },
      };
    }

    racine.classList.add('js');
    var scenes = [].slice.call(racine.querySelectorAll('[data-situ]')).map(scene);
    var items = [].slice.call(racine.querySelectorAll('[data-fn]'));
    var liste = racine.querySelector('.liste');
    var details = [].slice.call(racine.querySelectorAll('.fn-detail p'));
    var actif = -1;

    function activer(i) {
      if (i === actif) return;
      var avant = actif;
      actif = i;
      tete.classList.remove('ecrit');
      if (doigt) doigt.classList.remove('tape');
      items.forEach(function (it, k) {
        it.classList.toggle('on', k === i);
        it.querySelector('button').setAttribute('aria-pressed', k === i ? 'true' : 'false');
      });
      // Phones: the tab row follows the active tab (scrolls the row only, never the page).
      if (liste.scrollWidth > liste.clientWidth) {
        liste.scrollTo({
          left: items[i].offsetLeft - items[0].offsetLeft,
          behavior: reduit ? 'auto' : 'smooth',
        });
      }
      details.forEach(function (d, k) {
        d.classList.toggle('on', k === i);
      });
      scenes.forEach(function (sc, k) {
        sc.fil.classList.toggle('on', k === i);
        sc.fil.classList.toggle('sort', k === avant);
      });
      if (avant > -1) scenes[avant].ranger();
      scenes[i].jouer();
    }

    // Autoplay: the active feature's bar fills (CSS), at its end the next one takes over. A click
    // picks a feature and stops it; the bar pauses while the section is off screen or the pointer
    // is on the phone (someone scrolling the chat by hand).
    if (!reduit) racine.classList.add('auto');
    items.forEach(function (it, k) {
      it.querySelector('button').addEventListener('click', function () {
        racine.classList.remove('auto');
        activer(k);
      });
      it.querySelector('.fn-barre i').addEventListener('animationend', function () {
        if (racine.classList.contains('auto') && k === actif) activer((k + 1) % items.length);
      });
    });
    var tel = racine.querySelector('.tel-zone');
    tel.addEventListener('pointerenter', function () {
      racine.classList.add('pause');
    });
    tel.addEventListener('pointerleave', function () {
      racine.classList.remove('pause');
    });
    new IntersectionObserver(
      function (entries) {
        var vu = entries[0].isIntersecting;
        racine.classList.toggle('hors', !vu);
        if (vu && actif === -1) activer(0);
      },
      { threshold: 0.4 },
    ).observe(tel);
  })();
</script>

<style>
  /* --- The list beside the phone --- */
  .fonctions {
    display: grid;
    gap: 24px;
  }
  /* exception: the tab row scrolls under the page gutters (the conteneur's own clamp) */
  .liste {
    display: flex;
    gap: 8px;
    margin-inline: calc(-1 * clamp(1.25rem, 4.4vw, 4rem));
    padding-inline: clamp(1.25rem, 4.4vw, 4rem);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fn-btn {
    position: relative;
    display: grid;
    justify-items: start;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }
  .fn-btn:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .fn-num {
    color: var(--doux);
  }
  .fn.on .fn-num {
    color: var(--color-orange-txt);
  }
  /* The bar: a track along the item, the active one fills over its turn. */
  .fn-barre {
    position: absolute;
    overflow: clip;
    background: var(--filet);
    border-radius: 2px;
  }
  .fn-barre i {
    position: absolute;
    inset: 0;
    background: var(--color-orange);
    transform: scale(0);
  }
  .fn.on .fn-barre i {
    transform: none;
  }
  .fonctions.auto .fn.on .fn-barre i {
    /* exception: one feature's turn, the chat plays in ~4 s then stays to be read */
    animation: tour 9s linear both;
  }
  .fonctions.auto:is(.pause, .hors) .fn.on .fn-barre i {
    animation-play-state: paused;
  }

  /* Phones: a row of tabs (number + title), the active text under it, the phone below. */
  .fn {
    flex: none;
  }
  .fn-btn {
    gap: 2px;
    padding: 12px 16px 14px;
    border-radius: var(--radius-card-sm);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }
  .fn.on .fn-btn {
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }
  .fn-titre {
    font-size: var(--text-body); /* a tab label: four card titles would not fit in a row */
    white-space: nowrap;
  }
  .fn-barre {
    left: 16px;
    right: 16px;
    bottom: 6px;
    height: 2px;
  }
  .fn-barre i {
    transform-origin: left;
  }
  .fn-plie {
    display: none;
  }
  .fn-detail {
    display: grid;
    min-height: 3lh;
  }
  .fn-detail p {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease-hatch);
  }
  .fn-detail p.on {
    opacity: 1;
    visibility: visible;
  }
  .tel-zone {
    display: flex;
    justify-content: center;
  }
  .tel-zone :global(.tel) {
    width: min(320px, 82vw);
  }

  /* Wide screens: the list on the left, every title visible, the active one opens its text. */
  @media (width >= 64rem) {
    .fonctions {
      grid-template-columns: minmax(0, 28rem) auto;
      justify-content: center;
      align-items: center;
      column-gap: 96px;
    }
    .liste {
      flex-direction: column;
      gap: 4px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .fn-detail {
      display: none;
    }
    .tel-zone {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
    .tel-zone :global(.tel) {
      width: 330px;
    }
    .fn-btn {
      gap: 6px;
      padding: 18px 0 18px 28px;
      border-radius: 0;
      background: none;
      opacity: 0.55;
      transition: opacity 0.3s var(--ease-hatch);
    }
    .fn.on .fn-btn {
      background: none;
      box-shadow: none;
      opacity: 1;
    }
    .fn-btn:hover {
      opacity: 1;
    }
    .fn-titre {
      font-size: var(--text-card);
      white-space: normal;
    }
    .fn-barre {
      left: 0;
      right: auto;
      top: 18px;
      bottom: 18px;
      width: 2px;
      height: auto;
    }
    .fn-barre i {
      transform-origin: top;
    }
    .fn-plie {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.45s var(--ease-hatch);
    }
    .fn-plie > span {
      overflow: hidden;
      padding-top: 4px;
    }
    .fn.on .fn-plie {
      grid-template-rows: 1fr;
    }
  }
  @keyframes tour {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  /* --- The phone: one chat, a shared header and input bar, the four days slide in between --- */
  .wa {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-whatsapp-wall);
    font: 400 13.5px/1.4 var(--font-sans);
    text-align: left;
  }
  .wa-fils {
