---
/**
 * 04 — Diorama demo (César, 01/10). Three places on scroll (head office, kitchen, build site), one
 * layout and one logic for all three: the scene is the setting, each agent's demo plays on a device
 * mock-up (DemoEcran.astro), one after the other. Where (place, 0n / 03) top left, what (agent, one
 * sentence) bottom left, the device on the right, a chapters bar at the bottom.
 * The motion (camera, focus, screens) is one GSAP timeline per place, demo-motion.ts, loaded when
 * the section comes near the viewport; time plays it and the scroll pushes it (mode `mixte`).
 *
 * Scroll rules (research: NN/g on scroll-jacking, Apple product pages):
 * - the scroll position picks the place DIRECTLY (no queue): a fast scroll lands on a clean state;
 * - the wheel is never captured; soft snap points (`proximity`) help stop on each place's wide shot.
 * Without JS, the three places stack, each with its first demo in its final state.
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { section } from '../../content/section';
import type { Locale } from '../../i18n/ui';
import siegeFond from '../../assets/demo/siege/fond.jpg';
import imgLark from '../../assets/demo/siege/lark.png';
import imgFinch from '../../assets/demo/siege/finch.png';
import imgJay from '../../assets/demo/siege/jay.png';
import imgPeep from '../../assets/demo/siege/peep.png';
import cuisineFond from '../../assets/demo/cuisine/fond.jpg';
import imgOwl from '../../assets/demo/cuisine/owl.png';
import imgPecker from '../../assets/demo/cuisine/pecker.png';
import chantierFond from '../../assets/demo/chantier/fond.jpg';
import imgSparrow from '../../assets/demo/chantier/sparrow.png';
import avPeep from '../../assets/hero/agents/peep.webp';
import avLark from '../../assets/hero/agents/lark.webp';
import avJay from '../../assets/hero/agents/jay.webp';
import avFinch from '../../assets/hero/agents/finch.webp';
import avOwl from '../../assets/hero/agents/owl.webp';
import avPecker from '../../assets/hero/agents/pecker.webp';
import avSparrow from '../../assets/demo/avatars/sparrow.png';
import DemoEcran from './DemoEcran.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const data = await section('demo', locale);
type Cle = (typeof data.lieux)[number]['agents'][number]['cle'];

/** Camera: focus point (fractions of the image) and zoom. */
type Cam = [fx: number, fy: number, z: number];
/**
 * Keep the image edges outside the frame: the focus is clamped by the zoom and by where it sits in
 * the viewport (`o`, 0.5 = centred; autoplay places put the agent left of centre, see --ox/--oy).
 */
const centre = (v: number, z: number, o: number) => Math.min(Math.max(v, o / z), 1 - (1 - o) / z);
const camStyle = ([fx, fy, z]: Cam, [ox, oy] = [0.5, 0.5]) =>
  `--cx:${centre(fx, z, ox)};--cy:${centre(fy, z, oy)};--z:${z}`;
/** Where the focus sits in the viewport on desktop (wide shot and agents), mirrored in the CSS (--ox/--oy). */
const VISEE: [number, number] = [0.27, 0.4];

/**
 * Places, in YAML order: background, wide shot, cut-out agents (fractions of the image, from the v4
 * prototype geometry). `cles` = the demos this cut-out belongs to (Sparrow carries two).
 */
const LIEUX: {
  fond: ImageMetadata;
  vue: Cam;
  decoupes: { img: ImageMetadata; cles: Cle[]; x: number; y: number; w: number }[];
}[] = [
  {
    fond: siegeFond,
    vue: [0.45, 0.52, 1.08],
    decoupes: [
      { img: imgLark, cles: ['lark'], x: 0.1523, y: 0.3743, w: 0.1286 },
      { img: imgFinch, cles: ['finch'], x: 0.2747, y: 0.4577, w: 0.1188 },
      { img: imgJay, cles: ['jay'], x: 0.4873, y: 0.3789, w: 0.1352 },
      { img: imgPeep, cles: ['peep'], x: 0.609, y: 0.5645, w: 0.1112 },
    ],
  },
  {
    fond: cuisineFond,
    vue: [0.42, 0.55, 1.12],
    decoupes: [
      { img: imgOwl, cles: ['owl'], x: 0.141, y: 0.3874, w: 0.1399 },
      { img: imgPecker, cles: ['pecker'], x: 0.5487, y: 0.556, w: 0.1126 },
    ],
  },
  {
    fond: chantierFond,
    vue: [0.53, 0.53, 1.2],
    decoupes: [
      {
        img: imgSparrow,
        cles: ['sparrow-candidats', 'sparrow-ouverture'],
        x: 0.4684,
        y: 0.416,
        w: 0.1148,
      },
    ],
  },
];

/** Per demo: the camera on its agent, and the agent's avatar (legend, chapters, screens). */
const DEMOS: Record<Cle, { cam: Cam; avatar: ImageMetadata }> = {
  lark: { cam: [0.215, 0.47, 1.6], avatar: avLark },
  finch: { cam: [0.335, 0.55, 1.6], avatar: avFinch },
  jay: { cam: [0.55, 0.49, 1.6], avatar: avJay },
  peep: { cam: [0.665, 0.64, 1.6], avatar: avPeep },
  owl: { cam: [0.25, 0.47, 1.5], avatar: avOwl },
  pecker: { cam: [0.62, 0.66, 1.5], avatar: avPecker },
  'sparrow-candidats': { cam: [0.5, 0.45, 1.6], avatar: avSparrow },
  'sparrow-ouverture': { cam: [0.62, 0.58, 1.6], avatar: avSparrow },
};

const lieux = data.lieux.map((l, i) => ({ ...l, ...LIEUX[i] }));
for (const l of lieux) {
  const ici = l.decoupes.flatMap((d) => d.cles);
  const ailleurs = l.agents.filter((a) => !ici.includes(a.cle));
  if (ailleurs.length)
    throw new Error(`Demo "${l.surtitre}": no agent cut-out for ${ailleurs.map((a) => a.cle)}`);
}
---

<section class="d2" style={`--n:${lieux.length}`} aria-labelledby="d2-titre">
  <h2 id="d2-titre" class="sr-only">{data.titre}</h2>
  {lieux.map((_, i) => <div class="d2-ancre" style={`--i:${i}`} aria-hidden="true" />)}
  <div class="d2-scene-fixe">
    {
      lieux.map((l, i) => (
        <div class:list={['d2-lieu', { on: i === 0 }]} data-vue={camStyle(l.vue, VISEE)}>
          <div class="d2-plateau">
            <div class="d2-calque" style={camStyle(l.vue, VISEE)}>
              <Picture
                src={l.fond}
                formats={['avif', 'webp']}
                widths={[960, 1440, 2048]}
                sizes="max(100vw, 179vh)"
                alt=""
                loading="lazy"
                class="d2-fond"
              />
              {l.decoupes.map((a) => (
                <Image
                  src={a.img}
                  alt=""
                  widths={[200, 400]}
                  sizes="12vw"
                  loading="lazy"
                  class="d2-agent"
                  data-cles={a.cles.join(' ')}
                  style={`left:${a.x * 100}%;top:${a.y * 100}%;width:${a.w * 100}%`}
                />
              ))}
              <div class="d2-voile" aria-hidden="true" />
            </div>
          </div>

          <div class="d2-ui">
            {/* Where: the place, and where it sits in the section. Stays put for the whole place. */}
            <p class="d2-ou">
              <span>{l.surtitre}</span>
              <span class="d2-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')} / {String(lieux.length).padStart(2, '0')}
              </span>
            </p>
            {/* What: the agent on stage and what its demo shows. Fixed height, cross-fades. */}
            <div class="d2-legende">
              {l.agents.map((d, j) => (
                <div class:list={['d2-leg', { on: j === 0 }]} data-titre={j}>
                  <p class="d2-qui">
                    <Image
                      src={DEMOS[d.cle].avatar}
                      alt=""
                      width={28}
                      height={28}
                      densities={[1, 2]}
                      class="d2-av"
                    />
                    <span>
                      <b>{d.nom}</b> {d.role}
                    </span>
                  </p>
                  <h3 class="d2-titre">{d.titre}</h3>
                </div>
              ))}
            </div>
            {/* Chapters: one segment per demo, filled by the timeline, like a video player. */}
            <div class="d2-chapitres">
              {l.agents.map((d, j) => (
                <button
                  type="button"
                  class:list={{ on: j === 0 }}
                  data-onglet={j}
                  aria-pressed={j === 0 ? 'true' : 'false'}
                >
                  <span class="d2-barre" aria-hidden="true">
                    <span />
                  </span>
                  <span class="d2-chap">
                    <Image
                      src={DEMOS[d.cle].avatar}
                      alt=""
                      width={20}
                      height={20}
                      densities={[1, 2]}
                      class="d2-av"
                    />
                    {d.nom}
                  </span>
                </button>
              ))}
            </div>
            <div class="d2-appareils">
              {l.agents.map((d, j) => (
                <div
                  class:list={['d2-ecran', d.ecran.appareil, { on: j === 0 }]}
                  data-cam={camStyle(DEMOS[d.cle].cam, VISEE)}
                >
                  <DemoEcran ecran={d.ecran} avatar={DEMOS[d.cle].avatar} />
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .d2 {
    --pas: 90svh;
    position: relative;
    height: calc(var(--n) * var(--pas) + 100svh);
    background: var(--color-scene);
  }
  .d2-ancre {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    /* Mid-range, not on the boundary between two places (where rounding picks either). */
    top: calc((var(--i) + 0.5) * var(--pas));
    scroll-snap-align: start;
  }
  :global(html:has(.d2.js)) {
    scroll-snap-type: y proximity;
  }
  .d2-scene-fixe {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* A place: its scene and its overlays. Hidden places leave the tab order (visibility). */
  .d2-lieu {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s var(--ease-hatch),
      visibility 0s 0.6s;
  }
  .d2-lieu.on {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* The scene: an image box covering the viewport; the camera moves it so the focus sits centred. */
  .d2-plateau {
    /* --ox/--oy = where the focus sits in the viewport. */
    --ox: 0.5;
    --oy: 0.5;
    position: absolute;
    inset: 0;
    container-type: size;
  }
  .d2-calque {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, calc(100cqh * 2400 / 1340));
    aspect-ratio: 2400 / 1340;
    /* --oy = where the focus sits vertically: centred, or high on phones where the cards fill the bottom. */
    translate: calc(-50% + (var(--ox) - 0.5) * 100cqw) calc(-50% + (var(--oy) - 0.5) * 100cqh);
    transform-origin: calc(var(--cx) * 100%) calc(var(--cy) * 100%);
    transform: translate(calc((0.5 - var(--cx)) * 100%), calc((0.5 - var(--cy)) * 100%))
      scale(var(--z));
    transition:
      transform 1s cubic-bezier(0.32, 0.72, 0, 1),
      transform-origin 1s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .d2-calque :global(.d2-fond) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The cut-out agents stay still: their soft-edged patches show as soon as they move. */
  .d2-calque :global(.d2-agent) {
    position: absolute;
    height: auto;
  }

  /* Overlay of a place: where, what, the device, the chapters. */
  .d2-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s 0.5s;
  }
  .d2-ui > * {
    opacity: 0;
    translate: 0 14px;
    pointer-events: auto;
    transition:
      opacity 0.45s var(--ease-hatch),
      translate 0.7s var(--ease-hatch);
  }
  .d2-lieu.on > .d2-ui {
    visibility: visible;
    transition-delay: 0s;
  }
  .d2-lieu.on > .d2-ui > * {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.35s;
  }

  .d2-titre {
    margin-top: 8px;
    font: 700 clamp(24px, 2.4vw, 34px) / 1.12 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .d2 :global(.d2-av) {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-white);
    object-fit: cover;
  }

  /* The agent sits left of centre, its device on the right (VISEE in the frontmatter). */
  .d2-plateau {
    --ox: 0.27;
    --oy: 0.4;
  }
  /* Focus: the whole scene dims, agents included, so the device is the subject. */
  .d2-voile {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: color-mix(in srgb, var(--color-night) 40%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  /* One layout for every place (César 01/10): where (top left), what (bottom left), the proof
     (the device, right), and the chapters bar (bottom), always at the same spot. */
  .d2-ou {
    position: absolute;
    left: clamp(16px, 4vw, 64px);
    top: clamp(88px, 12vh, 112px);
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.86);
    box-shadow: var(--shadow-1);
    font: 400 12px/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  .d2-num {
    color: var(--color-soft);
  }
  .d2-legende {
    position: absolute;
    left: clamp(16px, 4vw, 64px);
    bottom: calc(clamp(24px, 4vh, 40px) + 76px);
    display: grid;
    width: min(440px, calc(100vw - 32px));
  }
  /* One caption per demo in the same cell: out, then in (a cross-fade would overlap two texts). */
  .d2-leg {
    grid-area: 1 / 1;
    align-self: end;
    padding: 18px 22px 20px;
    border-radius: var(--radius-glass);
    background: rgb(255 255 255 / 0.9);
    box-shadow: var(--shadow-2);
    opacity: 0;
    visibility: hidden;
    translate: 0 8px;
    transition:
      opacity 0.3s var(--ease-sortie),
      translate 0.3s var(--ease-sortie),
      visibility 0s 0.3s;
  }
  .d2-leg.on {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity 0.5s var(--ease-doux) 0.3s,
      translate 0.7s var(--ease-entree) 0.3s,
      visibility 0s;
  }
  .d2-qui {
    display: flex;
    gap: 10px;
    align-items: center;
    font: 500 14px/1.3 var(--font-sans);
    color: var(--color-soft);
  }
  .d2-qui b {
    color: var(--color-ink);
  }
  .d2-leg .d2-titre {
    margin-top: 10px;
    font-size: clamp(22px, 1.9vw, 28px);
  }
  .d2-chapitres {
    position: absolute;
    left: clamp(16px, 4vw, 64px);
    right: clamp(16px, 4vw, 64px);
    bottom: clamp(24px, 4vh, 40px);
    display: flex;
    gap: 6px;
    align-items: stretch;
    padding: 6px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.86);
    box-shadow: var(--shadow-2);
  }
  .d2-chapitres [data-onglet] {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px 9px;
    border-radius: 11px;
    font: 500 13px/1.2 var(--font-sans);
    color: var(--color-soft);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .d2-chapitres [data-onglet]:hover {
    background: var(--color-cream);
  }
  .d2-chapitres [data-onglet].on {
    color: var(--color-ink);
  }
  .d2-chapitres button:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .d2-chap {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 600;
  }
  .d2-chap :global(.d2-av) {
    width: 20px;
    height: 20px;
  }
  .d2-barre {
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-line);
  }
  /* Filled by the timeline, in step with its demo. */
  .d2-barre > span {
    display: block;
    height: 100%;
    background: var(--color-orange);
    transform-origin: left;
    transform: scaleX(0);
  }
  /* Centred with the grid, not with translate: the overlay's entrance animates translate. */
  .d2-appareils {
    position: absolute;
    right: clamp(16px, 5vw, 96px);
    top: clamp(72px, 9vh, 96px);
    bottom: calc(clamp(24px, 4vh, 40px) + 76px);
    display: grid;
    place-items: center;
    align-content: center;
    pointer-events: none;
  }
  .d2-appareils > * {
    pointer-events: auto;
  }
  /* Devices: shown by the timeline (inline styles). Without JS, the first one stays. */
  .d2-ecran {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .d2:not(.js) .d2-ecran.on {
    visibility: visible;
  }
  .d2-ecran:is(.tablette, .tableau) {
    width: min(700px, 47vw, 108svh);
  }
  .d2-ecran.telephone {
    width: min(330px, 24vw, 37svh);
  }

  @media (max-width: 47.99rem) {
    .d2-plateau {
      --ox: 0.5;
      --oy: 0.25;
    }
    .d2-appareils {
      left: 16px;
      right: 16px;
      top: 116px;
      bottom: auto;
    }
    .d2-ecran:is(.tablette, .tableau) {
      width: 100%;
    }
    .d2-ecran.telephone {
      width: min(230px, 52vw, 50svh);
    }
    .d2-legende {
      bottom: calc(clamp(24px, 4vh, 40px) + 64px);
    }
    .d2-leg {
      padding: 14px 16px 16px;
    }
    .d2-ou {
      top: 76px;
    }
  }

  /* Without JS: the three places stack, each with its first demo in its final state. */
  .d2:not(.js) {
    height: auto;
  }
  .d2:not(.js) .d2-scene-fixe {
    position: relative;
    height: auto;
  }
  .d2:not(.js) .d2-lieu {
    position: relative;
    height: 100svh;
    opacity: 1;
    visibility: visible;
  }
  .d2:not(.js) .d2-ui,
  .d2:not(.js) .d2-ui > * {
    visibility: visible;
    opacity: 1;
    translate: none;
  }
  .d2:not(.js) .d2-barre {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .d2 *,
    .d2 *::after {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
      animation: none !important;
    }
  }
</style>

<script>
  import type { Mode, Pilote } from './demo-motion';
  /**
   * The scroll position picks the place directly (no queue, so a fast scroll never leaves a step
   * pending); inside a place, its timeline (demo-motion.ts) plays the demos.
   */
  const sec = document.querySelector<HTMLElement>('.d2')!;
  const lieux = [...sec.querySelectorAll<HTMLElement>('.d2-lieu')];
  sec.classList.add('js');

  let k = 0;

  /**
   * demo-motion.ts `Mode`: `mixte` by default, `?scroll=1` (scroll only) and `?auto=1` (time only)
   * to compare. With the scroll in play, a place gets several steps of scroll instead of one, so
   * scrolling through it covers its whole timeline.
   */
  const params = new URLSearchParams(location.search);
  const mode: Mode = params.has('scroll') ? 'scroll' : params.has('auto') ? 'auto' : 'mixte';
  const POIDS = { auto: 1, scroll: 5, mixte: 3 }[mode];
  const poids = lieux.map(() => POIDS);
  const debuts = poids.map((_, i) => poids.slice(0, i).reduce((a, b) => a + b, 0));
  const total = poids.reduce((a, b) => a + b, 0);
  if (POIDS > 1) {
    sec.classList.add('long');
    sec.style.setProperty('--n', String(total));
    // Soft snap points on each place's opening wide shot (the page helps you stop there, it never
    // holds the wheel).
    sec.querySelectorAll<HTMLElement>('.d2-ancre').forEach((a, i) => {
      a.style.top = `calc(${debuts[i] + 0.12} * var(--pas))`;
    });
  }
  if (mode === 'scroll') sec.classList.add('scrub');
  /** Where the scroll is: the place, and the position inside it (0–1). */
  function ici() {
    const r = sec.getBoundingClientRect();
    const u = Math.min(Math.max(-r.top / (r.height - innerHeight), 0), 0.9999) * total;
    const i = debuts.findLastIndex((d) => u >= d);
    return { i, q: (u - debuts[i]) / poids[i] };
  }

  /** The places' timelines: GSAP and the choreography load when the section comes near. */
  const pilotes = new Map<HTMLElement, Pilote>();
  new IntersectionObserver(
    async (entrees, io) => {
      if (!entrees.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const { piloter } = await import('./demo-motion');
      lieux.forEach((l) => pilotes.set(l, piloter(l, mode)));
      maj();
    },
    { rootMargin: '100% 0px' },
  ).observe(sec);

  /**
   * A place plays only while the section is pinned (César 01/10: the head office's first demo had
   * played out of sight, while the section was still scrolling in from below). Above it, the first
   * place waits on its wide shot; past it, the last one freezes where it is.
   */
  let enJeu = false;
  function maj() {
    const r = sec.getBoundingClientRect();
    const epingle = r.top <= 1 && r.bottom >= innerHeight - 1;
    const { i: suivant, q } = ici();
    if (suivant !== k) {
      if (enJeu) pilotes.get(lieux[k])?.arreter();
      enJeu = false;
      k = suivant;
      lieux.forEach((l, i) => l.classList.toggle('on', i === k));
    }
    const pilote = pilotes.get(lieux[k]);
    if (!pilote) return;
    if (!epingle) {
      if (enJeu) pilote.arreter(r.top > 1);
      enJeu = false;
    } else if (!enJeu) {
      pilote.entrer(q);
      enJeu = true;
    } else pilote.suivre(q);
  }

  sec.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const lieu = t.closest<HTMLElement>('.d2-lieu');
    if (!lieu) return;
    const onglet = t.closest<HTMLElement>('[data-onglet]');
    const pilote = pilotes.get(lieu);
    if (onglet && mode === 'scroll' && pilote) {
      // Scroll mode: a tab scrolls to where its demo starts.
      const i = lieux.indexOf(lieu);
      const u = debuts[i] + poids[i] * pilote.position(Number(onglet.dataset.onglet));
      const r = sec.getBoundingClientRect();
      const top = scrollY + r.top + (u / total) * (r.height - innerHeight);
      return scrollTo({
        top,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    }
    if (onglet) pilote?.jouer(Number(onglet.dataset.onglet));
  });

  let raf = 0;
  addEventListener('scroll', () => (raf ||= requestAnimationFrame(() => ((raf = 0), maj()))), {
    passive: true,
  });
  addEventListener('resize', maj);
  maj();
</script>
