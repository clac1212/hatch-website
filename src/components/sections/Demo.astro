---
/**
 * 04 — Diorama demo (César, 01/10). Three places on scroll (head office, kitchen, build site); inside a
 * place, the visitor opens an agent's demo on demand: markers on the agents and the menu card both
 * open it, the camera zooms on the agent and its card replaces the menu. Back, Escape, a click on the
 * scene or leaving the place closes it.
 * Pilot (01/10): a place whose demos all carry an `ecran` (the kitchen) plays them instead, one after
 * the other, as animated device mock-ups (DemoEcran.astro) with tabs, progress bars and a pause button.
 * Its motion design (camera, focus, agents, screens) is one GSAP timeline, demo-motion.ts, loaded
 * when the section comes near the viewport.
 *
 * Scroll rules (research: NN/g on scroll-jacking, Apple product pages):
 * - the scroll position picks the place DIRECTLY (no queue): a fast scroll lands on a clean state,
 *   CSS transitions then play at their own pace;
 * - the wheel is never captured; soft snap points (`proximity`) help stop on each place.
 * Without JS, the three places stack, each with its menu. Videos will later replace the still scenes:
 * one calm loop per place, one short clip per agent demo.
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { section } from '../../content/section';
import type { Locale } from '../../i18n/ui';
import siegeFond from '../../assets/demo/siege/fond.jpg';
import imgLark from '../../assets/demo/siege/lark.png';
import imgFinch from '../../assets/demo/siege/finch.png';
import imgJay from '../../assets/demo/siege/jay.png';
import imgPeep from '../../assets/demo/siege/peep.png';
import cuisineFond from '../../assets/demo/cuisine/fond.jpg';
import imgOwl from '../../assets/demo/cuisine/owl.png';
import imgPecker from '../../assets/demo/cuisine/pecker.png';
import chantierFond from '../../assets/demo/chantier/fond.jpg';
import imgSparrow from '../../assets/demo/chantier/sparrow.png';
import avPeep from '../../assets/hero/agents/peep.webp';
import avLark from '../../assets/hero/agents/lark.webp';
import avJay from '../../assets/hero/agents/jay.webp';
import avFinch from '../../assets/hero/agents/finch.webp';
import avOwl from '../../assets/hero/agents/owl.webp';
import avPecker from '../../assets/hero/agents/pecker.webp';
import avSparrow from '../../assets/demo/avatars/sparrow.png';
import DemoEcran from './DemoEcran.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const data = await section('demo', locale);
type Cle = (typeof data.lieux)[number]['agents'][number]['cle'];

/** Camera: focus point (fractions of the image) and zoom. */
type Cam = [fx: number, fy: number, z: number];
/**
 * Keep the image edges outside the frame: the focus is clamped by the zoom and by where it sits in
 * the viewport (`o`, 0.5 = centred; autoplay places put the agent left of centre, see --ox/--oy).
 */
const centre = (v: number, z: number, o: number) => Math.min(Math.max(v, o / z), 1 - (1 - o) / z);
const camStyle = ([fx, fy, z]: Cam, [ox, oy] = [0.5, 0.5]) =>
  `--cx:${centre(fx, z, ox)};--cy:${centre(fy, z, oy)};--z:${z}`;
/** Focus position of autoplay places on desktop (wide shot and agents), mirrored in the CSS (.d2-lieu.auto --ox/--oy). */
const VISEE_AUTO: [number, number] = [0.3, 0.45];

/**
 * Places, in YAML order: background, wide shot, cut-out agents (fractions of the image, from the v4
 * prototype geometry). `cles` = the demos that highlight this cut-out (Sparrow carries two).
 */
const LIEUX: {
  fond: ImageMetadata;
  vue: Cam;
  decoupes: { img: ImageMetadata; cles: Cle[]; x: number; y: number; w: number; d: number }[];
}[] = [
  {
    fond: siegeFond,
    vue: [0.45, 0.52, 1.08],
    decoupes: [
      { img: imgLark, cles: ['lark'], x: 0.1523, y: 0.3743, w: 0.1286, d: 0 },
      { img: imgFinch, cles: ['finch'], x: 0.2747, y: 0.4577, w: 0.1188, d: 0.8 },
      { img: imgJay, cles: ['jay'], x: 0.4873, y: 0.3789, w: 0.1352, d: 1.6 },
      { img: imgPeep, cles: ['peep'], x: 0.609, y: 0.5645, w: 0.1112, d: 2.4 },
    ],
  },
  {
    fond: cuisineFond,
    vue: [0.42, 0.55, 1.12],
    decoupes: [
      { img: imgOwl, cles: ['owl'], x: 0.141, y: 0.3874, w: 0.1399, d: 0 },
      { img: imgPecker, cles: ['pecker'], x: 0.5487, y: 0.556, w: 0.1126, d: 1.2 },
    ],
  },
  {
    fond: chantierFond,
    vue: [0.53, 0.53, 1.2],
    decoupes: [
      {
        img: imgSparrow,
        cles: ['sparrow-candidats', 'sparrow-ouverture'],
        x: 0.4684,
        y: 0.416,
        w: 0.1148,
        d: 0,
      },
    ],
  },
];

/**
 * Per demo: marker point over the scene (fractions of the image), side its label opens to, camera.
 * Sparrow's two demos sit left (on Sparrow: candidates) and right (on the franchisee: openings).
 */
const DEMOS: Record<
  Cle,
  { repere: [number, number]; cote: 'g' | 'd'; cam: Cam; avatar: ImageMetadata }
> = {
  lark: { repere: [0.216, 0.39], cote: 'd', cam: [0.215, 0.47, 1.6], avatar: avLark },
  finch: { repere: [0.334, 0.47], cote: 'd', cam: [0.335, 0.55, 1.6], avatar: avFinch },
  jay: { repere: [0.555, 0.39], cote: 'd', cam: [0.55, 0.49, 1.6], avatar: avJay },
  peep: { repere: [0.665, 0.575], cote: 'd', cam: [0.665, 0.64, 1.6], avatar: avPeep },
  owl: { repere: [0.211, 0.4], cote: 'd', cam: [0.25, 0.47, 1.5], avatar: avOwl },
  pecker: { repere: [0.605, 0.57], cote: 'd', cam: [0.62, 0.66, 1.5], avatar: avPecker },
  'sparrow-candidats': {
    repere: [0.526, 0.43],
    cote: 'g',
    cam: [0.5, 0.45, 1.6],
    avatar: avSparrow,
  },
  'sparrow-ouverture': {
    repere: [0.625, 0.455],
    cote: 'd',
    cam: [0.62, 0.58, 1.6],
    avatar: avSparrow,
  },
};
const AVATARS: Record<string, ImageMetadata> = {
  peep: avPeep,
  lark: avLark,
  jay: avJay,
  finch: avFinch,
  owl: avOwl,
  pecker: avPecker,
  sparrow: avSparrow,
};
/** Avatar of a message sender, when it is an agent ("Owl · sur la tablette" → owl). */
const avatar = (qui: string) => AVATARS[qui.split(/[ ·]/)[0].toLowerCase()];
/** "Sparrow · Candidats" → "Sparrow", for the kicker. */
const prenom = (nom: string) => nom.split(' · ')[0];

const lieux = data.lieux.map((l, i) => {
  const auto = l.agents.every((a) => a.ecran);
  if (!auto && l.agents.some((a) => a.ecran))
    throw new Error(
      `Demo "${l.surtitre}": a place is either autoplay (all screens) or on demand (all cards)`,
    );
  return { ...l, ...LIEUX[i], auto };
});
for (const l of lieux) {
  const ici = l.decoupes.flatMap((d) => d.cles);
  const ailleurs = l.agents.filter((a) => !ici.includes(a.cle));
  if (ailleurs.length)
    throw new Error(`Demo "${l.surtitre}": no agent cut-out for ${ailleurs.map((a) => a.cle)}`);
}
---

<section class="d2" style={`--n:${lieux.length}`} aria-labelledby="d2-titre">
  <h2 id="d2-titre" class="sr-only">{data.titre}</h2>
  {lieux.map((_, i) => <div class="d2-ancre" style={`--i:${i}`} aria-hidden="true" />)}
  <div class="d2-scene-fixe">
    {
      lieux.map((l, i) => (
        <div
          class:list={['d2-lieu', { on: i === 0, auto: l.auto }]}
          data-vue={camStyle(l.vue, l.auto ? VISEE_AUTO : undefined)}
        >
          <div class="d2-plateau">
            <div class="d2-calque" style={camStyle(l.vue, l.auto ? VISEE_AUTO : undefined)}>
              <Picture
                src={l.fond}
                formats={['avif', 'webp']}
                widths={[960, 1440, 2048]}
                sizes="max(100vw, 179vh)"
                alt=""
                loading="lazy"
                class="d2-fond"
              />
              {l.decoupes.map((a) => (
                <Image
                  src={a.img}
                  alt=""
                  widths={[200, 400]}
                  sizes="12vw"
                  loading="lazy"
                  class="d2-agent"
                  data-cles={a.cles.join(' ')}
                  style={`left:${a.x * 100}%;top:${a.y * 100}%;width:${a.w * 100}%;animation-delay:${-a.d}s`}
                />
              ))}
              {l.auto && <div class="d2-voile" aria-hidden="true" />}
              {!l.auto &&
                l.agents.map((d) => {
                  const g = DEMOS[d.cle];
                  return (
                    <button
                      type="button"
                      class:list={['d2-repere', g.cote === 'g' && 'gauche']}
                      style={`left:${g.repere[0] * 100}%;top:${g.repere[1] * 100}%`}
                      data-ouvrir={d.cle}
                      aria-controls={`d2-${d.cle}`}
                      aria-expanded="false"
                    >
                      <span class="d2-point" aria-hidden="true" />
                      <span>{d.nom}</span>
                    </button>
                  );
                })}
            </div>
          </div>

          {l.auto ? (
            <div class="d2-ui d2-auto">
              <div class="d2-panneau">
                <p class="d2-surtitre">{l.surtitre}</p>
                <div class="d2-titres">
                  {l.agents.map((d, j) => (
                    <h3 class:list={['d2-titre', { on: j === 0 }]}>{d.titre}</h3>
                  ))}
                </div>
                <div class="d2-onglets">
                  {l.agents.map((d, j) => (
                    <button
                      type="button"
                      class:list={{ on: j === 0 }}
                      data-onglet={j}
                      aria-pressed={j === 0 ? 'true' : 'false'}
                    >
                      <Image
                        src={DEMOS[d.cle].avatar}
                        alt=""
                        width={28}
                        height={28}
                        densities={[1, 2]}
                        class="d2-av"
                      />
                      <span>
                        <b>{d.nom}</b> {d.role}
                      </span>
                      <span class="d2-barre" aria-hidden="true">
                        <span />
                      </span>
                    </button>
                  ))}
                  <button
                    type="button"
                    class="d2-pause"
                    aria-label={data.pause}
                    data-pause={data.pause}
                    data-lecture={data.lecture}
                  >
                    <svg viewBox="0 0 24 24" class="i-pause" aria-hidden="true">
                      <path d="M7 5h4v14H7zM13 5h4v14h-4z" />
                    </svg>
                    <svg viewBox="0 0 24 24" class="i-lecture" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="d2-appareils">
                {l.agents.map(
                  (d, j) =>
                    d.ecran && (
                      <div
                        class:list={['d2-ecran', d.ecran.appareil, { on: j === 0 }]}
                        data-cle={d.cle}
                        data-cam={camStyle(DEMOS[d.cle].cam, VISEE_AUTO)}
                      >
                        <DemoEcran ecran={d.ecran} avatar={DEMOS[d.cle].avatar} />
                      </div>
                    ),
                )}
              </div>
            </div>
          ) : (
            <>
              <div class="d2-ui d2-vue">
                <div class="d2-panneau">
                  <p class="d2-surtitre">{l.surtitre}</p>
                  <h3 class="d2-titre">{l.titre}</h3>
                </div>
                <div class="d2-carte">
                  <p class="d2-consigne">{data.consigne}</p>
                  <ul class="d2-menu">
                    {l.agents.map((d) => (
                      <li>
                        <button
                          type="button"
                          data-ouvrir={d.cle}
                          aria-controls={`d2-${d.cle}`}
                          aria-expanded="false"
                        >
                          <Image
                            src={DEMOS[d.cle].avatar}
                            alt=""
                            width={28}
                            height={28}
                            densities={[1, 2]}
                            class="d2-av"
                          />
                          <span>
                            <b>{d.nom}</b> {d.role}
                          </span>
                          <svg viewBox="0 0 24 24" class="d2-fleche" aria-hidden="true">
                            <path d="M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zm-2 4V7h2v8zm-2 2V5h2v12z" />
                          </svg>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {l.agents.map((d) => (
                <div
                  class="d2-ui d2-demo"
                  id={`d2-${d.cle}`}
                  data-cle={d.cle}
                  data-cam={camStyle(DEMOS[d.cle].cam)}
                  role="region"
                  aria-label={d.nom}
                >
                  <div class="d2-panneau">
                    <button type="button" class="d2-retour" data-fermer>
                      <span aria-hidden="true">←</span> {l.retour}
                    </button>
                    <p class="d2-surtitre">
                      {l.surtitre} · {prenom(d.nom)}
                    </p>
                    <h3 class="d2-titre">{d.titre}</h3>
                  </div>
                  <div class="d2-carte">
                    {/* On-demand places only hold card demos (checked above); the type keeps `carte` optional. */}
                    {d.carte &&
                      ('lignes' in d.carte ? (
                        <ul class="d2-lignes">
                          {d.carte.lignes.map((ligne) => (
                            <li>
                              {avatar(ligne.agent) && (
                                <Image
                                  src={avatar(ligne.agent)}
                                  alt=""
                                  width={28}
                                  height={28}
                                  densities={[1, 2]}
                                  class="d2-av"
                                />
                              )}
                              <span>
                                <b>{ligne.agent}</b> {ligne.texte}
                              </span>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <div class="d2-fil">
                          {[d.carte, d.carte.reponse].map((m, j) => (
                            <div class:list={['d2-msg', { 'd2-rep': j === 1 }]}>
                              {avatar(m.qui) && (
                                <Image
                                  src={avatar(m.qui)}
                                  alt=""
                                  width={28}
                                  height={28}
                                  densities={[1, 2]}
                                  class="d2-av"
                                />
                              )}
                              <span>
                                <b>{m.qui}</b>
                                {m.texte}
                              </span>
                            </div>
                          ))}
                        </div>
                      ))}
                  </div>
                </div>
              ))}
            </>
          )}
        </div>
      ))
    }

    <ol class="d2-points" aria-hidden="true">
      {lieux.map((_, i) => <li class:list={{ on: i === 0 }} />)}
    </ol>
  </div>
</section>

<style>
  .d2 {
    --pas: 90svh;
    position: relative;
    height: calc(var(--n) * var(--pas) + 100svh);
    background: var(--color-scene);
  }
  .d2-ancre {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    /* Mid-range, not on the boundary between two places (where rounding picks either). */
    top: calc((var(--i) + 0.5) * var(--pas));
    scroll-snap-align: start;
  }
  :global(html:has(.d2.js:not(.scrub))) {
    scroll-snap-type: y proximity;
  }
  /* Scroll mode: the scroll is the playhead, so no snap points pulling it and no pause button. */
  .d2.scrub .d2-pause {
    display: none;
  }
  .d2-scene-fixe {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* A place: its scene and its overlays. Hidden places leave the tab order (visibility). */
  .d2-lieu {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s var(--ease-hatch),
      visibility 0s 0.6s;
  }
  .d2-lieu.on {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* The scene: an image box covering the viewport; the camera moves it so the focus sits centred. */
  .d2-plateau {
    /* --ox/--oy = where the focus sits in the viewport. */
    --ox: 0.5;
    --oy: 0.5;
    position: absolute;
    inset: 0;
    container-type: size;
  }
  .d2-calque {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, calc(100cqh * 2400 / 1340));
    aspect-ratio: 2400 / 1340;
    /* --oy = where the focus sits vertically: centred, or high on phones where the cards fill the bottom. */
    translate: calc(-50% + (var(--ox) - 0.5) * 100cqw) calc(-50% + (var(--oy) - 0.5) * 100cqh);
    transform-origin: calc(var(--cx) * 100%) calc(var(--cy) * 100%);
    transform: translate(calc((0.5 - var(--cx)) * 100%), calc((0.5 - var(--cy)) * 100%))
      scale(var(--z));
    transition:
      transform 1s cubic-bezier(0.32, 0.72, 0, 1),
      transform-origin 1s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .d2-calque :global(.d2-fond) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .d2-calque :global(.d2-agent) {
    position: absolute;
    height: auto;
    transform-origin: 50% 100%;
    animation: d2-respire 4s ease-in-out infinite;
    transition:
      translate 0.5s var(--ease-hatch),
      filter 0.5s var(--ease-hatch);
  }
  .d2-lieu:not([data-ouvert]) .d2-calque :global(.d2-agent.survol) {
    translate: 0 -3%;
    filter: drop-shadow(0 0 0.2vw rgb(255 255 255 / 0.85));
  }
  @keyframes d2-respire {
    50% {
      transform: scaleY(1.025);
    }
  }

  /* Markers: a pulsing dot on the agent, its name beside. Counter-scaled so the zoom keeps them crisp. */
  .d2-repere {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    box-shadow: var(--shadow-2);
    font: 600 13px/1 var(--font-sans);
    color: var(--color-ink);
    white-space: nowrap;
    cursor: pointer;
    translate: -14px -50%;
    transform-origin: 14px 50%;
    scale: calc(1 / var(--z));
    transition:
      opacity 0.4s var(--ease-hatch),
      background-color 0.3s,
      visibility 0s;
  }
  .d2-repere.gauche {
    flex-direction: row-reverse;
    padding: 5px 5px 5px 12px;
    translate: calc(-100% + 14px) -50%;
    transform-origin: calc(100% - 14px) 50%;
  }
  .d2-repere:hover,
  .d2-repere:focus-visible {
    background: var(--color-orange-tint);
  }
  .d2-repere:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .d2-point {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-orange);
    box-shadow: inset 0 0 0 4px var(--color-white);
  }
  .d2-point::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--color-orange);
    animation: d2-pulse 2.2s var(--ease-hatch) infinite;
  }
  @keyframes d2-pulse {
    from {
      scale: 1;
      opacity: 0.8;
    }
    to {
      scale: 2.4;
      opacity: 0;
    }
  }
  .d2-lieu[data-ouvert] .d2-repere {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0s 0.3s;
  }

  /* Overlays: the wide shot (panel + menu) or one agent demo (panel + card). */
  .d2-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s 0.5s;
  }
  .d2-ui > * {
    opacity: 0;
    translate: 0 14px;
    pointer-events: auto;
    transition:
      opacity 0.45s var(--ease-hatch),
      translate 0.7s var(--ease-hatch);
  }
  .d2-lieu.on:not([data-ouvert]) > .d2-vue,
  .d2-lieu.on > .d2-demo.on,
  .d2-lieu.on > .d2-auto {
    visibility: visible;
    transition-delay: 0s;
  }
  .d2-lieu.on:not([data-ouvert]) > .d2-vue > *,
  .d2-lieu.on > .d2-demo.on > *,
  .d2-lieu.on > .d2-auto > * {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.35s;
  }
  .d2-lieu.on:not([data-ouvert]) > .d2-vue > .d2-carte,
  .d2-lieu.on > .d2-demo.on > .d2-carte {
    transition-delay: 0.55s;
  }

  .d2-panneau {
    position: absolute;
    left: clamp(16px, 4vw, 64px);
    bottom: clamp(56px, 9vh, 96px);
    max-width: min(560px, calc(100vw - 32px));
    padding: 22px 26px 24px;
    border-radius: 22px;
    background: linear-gradient(-120deg, rgb(255 255 255 / 0.78), rgb(255 255 255 / 0.58));
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    box-shadow:
      0 18px 44px color-mix(in srgb, var(--color-navy) 22%, transparent),
      inset 0 1px 0 var(--color-white);
  }
  .d2-retour {
    display: inline-flex;
    gap: 6px;
    margin-bottom: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--color-ink);
    font: 600 13px/1.2 var(--font-sans);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .d2-retour:hover {
    background: var(--color-orange-txt);
  }
  .d2-retour:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .d2-surtitre,
  .d2-consigne {
    font: 400 12px/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  .d2-titre {
    margin-top: 8px;
    font: 700 clamp(24px, 2.4vw, 34px) / 1.12 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .d2-carte {
    position: absolute;
    right: clamp(16px, 6vw, 120px);
    top: clamp(96px, 18vh, 200px);
    width: min(380px, calc(100vw - 32px));
    padding: 14px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 16px 40px color-mix(in srgb, var(--color-navy) 22%, transparent);
    font: 500 14px/1.4 var(--font-sans);
    color: var(--color-ink);
  }
  .d2-consigne {
    padding: 2px 4px 10px;
  }
  .d2-menu {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .d2-menu button {
    display: flex;
    width: 100%;
    gap: 10px;
    align-items: center;
    padding: 8px;
    border-radius: 12px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .d2-menu button > span {
    flex: 1;
  }
  .d2-menu button:hover,
  .d2-menu button:focus-visible,
  .d2-menu button.survol {
    background: var(--color-cream-2);
  }
  .d2-menu button:focus-visible {
    outline: 2px solid var(--color-orange-txt);
  }
  .d2-fleche {
    flex: none;
    width: 16px;
    height: 16px;
    fill: var(--color-soft);
    transition:
      fill 0.3s,
      translate 0.35s var(--ease-hatch);
  }
  .d2-menu button:hover .d2-fleche,
  .d2-menu button.survol .d2-fleche {
    fill: var(--color-orange-txt);
    translate: 3px 0;
  }
  .d2-lignes {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .d2-lignes li,
  .d2-msg {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .d2-fil {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .d2-msg > span {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 12px;
    border-radius: 14px;
    background: var(--color-cream-2);
  }
  .d2-msg b {
    font-size: 12px;
    color: var(--color-soft);
  }
  .d2-rep > span {
    background: var(--color-orange-tint);
  }
  .d2 :global(.d2-av) {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-white);
    object-fit: cover;
  }
  .d2-points {
    position: absolute;
    right: clamp(16px, 3vw, 40px);
    top: 50%;
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .d2-points li {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-ink) 25%, transparent);
    transition:
      background-color 0.4s,
      scale 0.4s var(--ease-hatch);
  }
  .d2-points li.on {
    background: var(--color-orange);
    scale: 1.35;
  }

  /* Autoplay place: the agent sits left of centre, its device on the right. The timeline drives
     the camera, so no CSS transition smooths it a second time. */
  .d2-lieu.auto .d2-plateau {
    --ox: 0.3;
    --oy: 0.45;
  }
  .d2-lieu.auto .d2-calque {
    transition: none;
  }
  /* The agent's reaction (squash and stretch from its feet), driven by --saut in the timeline. */
  .d2-lieu.auto .d2-calque :global(.d2-agent) {
    --saut: 0;
    scale: 1 calc(1 + var(--saut) * 0.05);
    transition: none;
  }
  /* Focus: the scene dims, the agent on stage is lifted above this layer (z-index, timeline). */
  .d2-voile {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: color-mix(in srgb, var(--color-night) 32%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .d2-titres {
    display: grid;
  }
  /* Titles and devices swap out then in (a cross-fade would overlap two texts). */
  .d2-titres > .d2-titre {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease-hatch),
      visibility 0s 0.3s;
  }
  .d2-titres > .d2-titre.on {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.4s var(--ease-hatch) 0.3s,
      visibility 0s;
  }
  .d2-onglets {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .d2-onglets [data-onglet] {
    position: relative;
    display: flex;
    flex: 1;
    gap: 8px;
    align-items: center;
    padding: 9px 10px 13px;
    overflow: hidden;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.55);
    font: 500 13px/1.3 var(--font-sans);
    color: var(--color-soft);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .d2-onglets [data-onglet] b {
    color: var(--color-ink);
  }
  .d2-onglets [data-onglet]:hover {
    background: var(--color-white);
  }
  .d2-onglets [data-onglet].on {
    background: var(--color-white);
    color: var(--color-ink);
  }
  .d2-onglets button:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .d2-barre {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 6px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-line);
  }
  /* Filled by the timeline, in step with its demo. */
  .d2-barre > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-orange);
    transform-origin: left;
    transform: scaleX(0);
  }
  .d2-pause {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    border-radius: 12px;
    background: var(--color-ink);
    cursor: pointer;
  }
  .d2-pause svg {
    width: 16px;
    fill: var(--color-white);
  }
  .d2-pause .i-lecture,
  .d2-lieu.pause .d2-pause .i-pause {
    display: none;
  }
  .d2-lieu.pause .d2-pause .i-lecture {
    display: block;
  }
  /* Centred with the grid, not with translate: the overlay's entrance animates translate. */
  .d2-appareils {
    position: absolute;
    right: clamp(16px, 6vw, 120px);
    top: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    align-content: center;
    pointer-events: none;
  }
  .d2-appareils > * {
    pointer-events: auto;
  }
  /* Devices: shown by the timeline (inline styles). Without JS, the first one stays. */
  .d2-ecran {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .d2:not(.js) .d2-ecran.on {
    visibility: visible;
  }
  .d2-ecran.tablette {
    width: min(620px, 43vw);
  }
  .d2-ecran.telephone {
    width: min(310px, 23vw, 33svh);
  }

  @media (max-width: 47.99rem) {
    .d2-lieu.auto .d2-plateau {
      --ox: 0.5;
      --oy: 0.25;
    }
    .d2-appareils {
      left: 16px;
      right: 16px;
      top: 80px;
      bottom: auto;
    }
    .d2-ecran.tablette {
      width: 100%;
    }
    .d2-ecran.telephone {
      width: min(230px, 52vw, 50svh);
    }
    .d2-onglets [data-onglet] span:not(.d2-barre) {
      font-size: 12px;
    }
    .d2-plateau {
      --oy: 0.27;
    }
    .d2-carte {
      left: 16px;
      right: 16px;
      width: auto;
      top: auto;
      bottom: calc(clamp(56px, 9vh, 96px) + 150px);
    }
    .d2-panneau {
      right: 16px;
      padding: 18px 20px;
    }
  }

  /* Without JS: the three places stack, each with its wide shot and its menu. */
  .d2:not(.js) {
    height: auto;
  }
  .d2:not(.js) .d2-scene-fixe {
    position: relative;
    height: auto;
  }
  .d2:not(.js) .d2-lieu {
    position: relative;
    height: 100svh;
    opacity: 1;
    visibility: visible;
  }
  .d2:not(.js) :is(.d2-vue, .d2-auto),
  .d2:not(.js) :is(.d2-vue, .d2-auto) > * {
    visibility: visible;
    opacity: 1;
    translate: none;
  }
  .d2:not(.js) :is(.d2-repere, .d2-points, .d2-fleche, .d2-pause, .d2-barre) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Nothing plays: a tab shows its demo's final state, so there is nothing to pause. */
    .d2-pause {
      display: none;
    }
    .d2 *,
    .d2 *::after {
      transition-duration: 0s !important;
      transition-delay: 0s !important;
      animation: none !important;
    }
  }
</style>

<script>
  import type { Pilote } from './demo-motion';
  /**
   * The scroll position picks the place directly: place = floor(progress × n). No queue, so a fast
   * scroll never leaves a step pending. Inside a place, agent demos open on demand, or play on their
   * own (autoplay places, timeline in demo-motion.ts).
   */
  const sec = document.querySelector<HTMLElement>('.d2')!;
  const lieux = [...sec.querySelectorAll<HTMLElement>('.d2-lieu')];
  const points = [...sec.querySelectorAll<HTMLElement>('.d2-points li')];
  sec.classList.add('js');

  let k = 0;
  let source: HTMLElement | null = null;
  const auto = (lieu: HTMLElement) => lieu.classList.contains('auto');

  /**
   * Test variant `?scroll=1` (César, 01/10): autoplay places don't play, the scroll drives their
   * timeline. They get SCRUB steps of scroll instead of one, so the demo reads at scroll pace.
   */
  const scrub = new URLSearchParams(location.search).has('scroll');
  const SCRUB = 5;
  const poids = lieux.map((l) => (scrub && auto(l) ? SCRUB : 1));
  const debuts = poids.map((_, i) => poids.slice(0, i).reduce((a, b) => a + b, 0));
  const total = poids.reduce((a, b) => a + b, 0);
  if (scrub) {
    sec.classList.add('scrub');
    sec.style.setProperty('--n', String(total));
  }
  /** Where the scroll is in the section, in place steps (0 → total). */
  function pas() {
    const r = sec.getBoundingClientRect();
    return Math.min(Math.max(-r.top / (r.height - innerHeight), 0), 0.9999) * total;
  }

  /** Autoplay places' timelines: GSAP and the choreography load when the section comes near. */
  const pilotes = new Map<HTMLElement, Pilote>();
  new IntersectionObserver(
    async (entrees, io) => {
      if (!entrees.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const { piloter } = await import('./demo-motion');
      lieux.filter(auto).forEach((l) => pilotes.set(l, piloter(l, { scroll: scrub })));
      if (auto(lieux[k])) pilotes.get(lieux[k])!.jouer(0);
      maj();
    },
    { rootMargin: '100% 0px' },
  ).observe(sec);

  const calque = (lieu: HTMLElement) => lieu.querySelector<HTMLElement>('.d2-calque')!;
  const demos = (lieu: HTMLElement) => [...lieu.querySelectorAll<HTMLElement>('.d2-demo')];

  function survol(lieu: HTMLElement, cle: string | null) {
    lieu.querySelectorAll<HTMLElement>('.d2-agent').forEach((a) => {
      a.classList.toggle('survol', !!cle && a.dataset.cles!.split(' ').includes(cle));
    });
    lieu.querySelectorAll<HTMLElement>('.d2-menu [data-ouvrir]').forEach((b) => {
      b.classList.toggle('survol', b.dataset.ouvrir === cle);
    });
  }

  function marquer(lieu: HTMLElement, cle: string | null) {
    lieu.querySelectorAll<HTMLElement>('[data-ouvrir]').forEach((b) => {
      b.setAttribute('aria-expanded', String(b.dataset.ouvrir === cle));
    });
  }

  function ouvrir(lieu: HTMLElement, cle: string, depuis: HTMLElement) {
    const demo = demos(lieu).find((d) => d.dataset.cle === cle)!;
    demos(lieu).forEach((d) => d.classList.toggle('on', d === demo));
    lieu.dataset.ouvert = cle;
    calque(lieu).setAttribute('style', demo.dataset.cam!);
    survol(lieu, cle);
    marquer(lieu, cle);
    source = depuis;
    requestAnimationFrame(() =>
      demo.querySelector<HTMLElement>('[data-fermer]')!.focus({ preventScroll: true }),
    );
  }

  function fermer(lieu: HTMLElement, rendreFocus: boolean) {
    if (!lieu.dataset.ouvert) return;
    delete lieu.dataset.ouvert;
    demos(lieu).forEach((d) => d.classList.remove('on'));
    calque(lieu).setAttribute('style', lieu.dataset.vue!);
    survol(lieu, null);
    marquer(lieu, null);
    if (rendreFocus && source?.isConnected) {
      // The marker that opened the demo fades back in; the menu line is always focusable.
      const cible = source.classList.contains('d2-repere')
        ? lieu.querySelector<HTMLElement>(`.d2-menu [data-ouvrir="${source.dataset.ouvrir}"]`)
        : source;
      cible?.focus({ preventScroll: true });
    }
    source = null;
  }

  /** The pause button shows the visitor's state (icon and label). */
  function pause(lieu: HTMLElement, oui: boolean) {
    lieu.classList.toggle('pause', oui);
    const b = lieu.querySelector<HTMLElement>('.d2-pause')!;
    b.setAttribute('aria-label', oui ? b.dataset.lecture! : b.dataset.pause!);
  }

  function maj() {
    const u = pas();
    const suivant = debuts.findLastIndex((d) => u >= d);
    if (scrub && auto(lieux[suivant]))
      pilotes.get(lieux[suivant])?.scruter((u - debuts[suivant]) / poids[suivant]);
    if (suivant === k) return;
    fermer(lieux[k], false);
    if (auto(lieux[k])) {
      pilotes.get(lieux[k])?.arreter();
      pause(lieux[k], false);
    }
    k = suivant;
    lieux.forEach((l, i) => l.classList.toggle('on', i === k));
    if (auto(lieux[k])) pilotes.get(lieux[k])?.jouer(0);
    points.forEach((el, i) => el.classList.toggle('on', i === k));
  }

  sec.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const lieu = t.closest<HTMLElement>('.d2-lieu');
    if (!lieu) return;
    const onglet = t.closest<HTMLElement>('[data-onglet]');
    const pilote = pilotes.get(lieu);
    if (onglet && scrub && pilote) {
      // Scroll mode: a tab scrolls to where its demo starts.
      const i = lieux.indexOf(lieu);
      const u = debuts[i] + poids[i] * pilote.position(Number(onglet.dataset.onglet));
      const r = sec.getBoundingClientRect();
      const top = scrollY + r.top + (u / total) * (r.height - innerHeight);
      return scrollTo({
        top,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    }
    if (onglet) {
      pause(lieu, false);
      return pilote?.jouer(Number(onglet.dataset.onglet));
    }
    if (t.closest('.d2-pause')) return pilote && pause(lieu, pilote.basculer());
    const b = t.closest<HTMLElement>('[data-ouvrir]');
    if (b) return ouvrir(lieu, b.dataset.ouvrir!, b);
    if (t.closest('[data-fermer]')) return fermer(lieu, true);
    // A click on the scene itself (not on a card) goes back to the wide shot.
    if (t.closest('.d2-plateau')) fermer(lieu, false);
  });
  for (const [on, off] of [
    ['pointerover', 'pointerout'],
    ['focusin', 'focusout'],
  ]) {
    sec.addEventListener(on, (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-ouvrir]');
      const lieu = b?.closest<HTMLElement>('.d2-lieu');
      if (b && lieu && !lieu.dataset.ouvert) survol(lieu, b.dataset.ouvrir!);
    });
    sec.addEventListener(off, (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-ouvrir]');
      const lieu = b?.closest<HTMLElement>('.d2-lieu');
      if (b && lieu && !lieu.dataset.ouvert) survol(lieu, null);
    });
  }
  addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && lieux[k].dataset.ouvert) fermer(lieux[k], true);
  });

  let raf = 0;
  addEventListener('scroll', () => (raf ||= requestAnimationFrame(() => ((raf = 0), maj()))), {
    passive: true,
  });
  addEventListener('resize', maj);
  maj();
</script>
