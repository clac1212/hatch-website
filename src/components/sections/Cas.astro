---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { section } from '../../content/section';
import type { Locale } from '../../i18n/ui';
import { casVisuels as visuals } from './cas-visuels';
import voxelJay from '../../assets/cas/voxel-jay.webp';
import voxelPeep from '../../assets/cas/voxel-peep.webp';
import voxelOwl from '../../assets/cas/voxel-owl.webp';

/**
 * 06 — "Ils l'ont déployé dans leur réseau": a shelf of slices (Pencil node OjYOb, note wZ8mR, chosen
 * 02/10 over the v4 carousel). One slice per customer in its brand colour; one is open (logo in its on-brand version,
 * quote, figures, storefront, "Avec <agent>"), the others are closed (agent voxel, vertical name, site
 * count). Auto-advance every 7 s (white bar under the text), paused on hover, keyboard focus, off-screen
 * and under reduced motion; clicking a slice opens it (width 0.7 s, content fades in after).
 * The bar's CSS animation is the clock: its `animationend` opens the next slice.
 * From lg the slices sit side by side (+124 px per case); below lg they stack, closed ones as rows.
 * Without JS: the first case is open, all content in the markup.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('cas', locale);

const voxels = { jay: voxelJay, peep: voxelPeep, owl: voxelOwl };

const cases = await Promise.all(
  data.cases.map(async (c) => {
    const agent = await getEntry('agents', `${locale}/${c.agent}`);
    if (!agent) throw new Error(`Missing src/content/agents/${locale}/${c.agent}.md`);
    return { ...c, ...visuals[c.id], voxel: voxels[c.agent], agentName: agent.data.name };
  }),
);
const fill = (s: string, vars: Record<string, string>) =>
  s.replace(/\{(\w+)\}/g, (_, k: string) => vars[k]!);
---

<section
  id="cas-clients"
  aria-labelledby="cas-titre"
  class="section-y px-5 md:px-12"
  data-rv-groupe
>
  <div class="mx-auto flex max-w-[1200px] flex-col gap-10 lg:gap-12">
    <h2
      id="cas-titre"
      data-rv
      class="font-display text-[34px] leading-[1.1] font-bold tracking-[-1.2px] text-ink lg:text-[44px] lg:leading-[54px]"
    >
      {data.title}
    </h2>

    <div
      data-rv
      style={`--rd:.09s;--n:${cases.length}`}
      class="etagere"
      role="region"
      aria-label={data.label}
      data-etagere
    >
      {
        cases.map((c, k) => (
          <article
            class="tranche"
            style={`--marque:${c.color}`}
            data-ouvert={k === 0 ? '' : undefined}
            aria-labelledby={`cas-${c.id}-nom`}
          >
            {/* Closed face: the whole slice is the button that opens it. */}
            <button
              type="button"
              class="ferme"
              aria-expanded={k === 0 ? 'true' : 'false'}
              aria-controls={`cas-${c.id}`}
              aria-label={fill(data.open, { client: c.client })}
              data-ouvrir={k}
            >
              <span class="avatar" aria-hidden="true">
                <Picture
                  src={c.voxel}
                  alt=""
                  formats={['avif', 'webp']}
                  width={42}
                  densities={[1, 2]}
                  class="size-[42px] object-contain"
                />
              </span>
              <span id={`cas-${c.id}-nom`} class="nom font-display">
                {c.client}
              </span>
              <span class="compte" aria-hidden="true">
                <span class="font-display text-[36px] leading-none">{c.figures[0].value}</span>
                <span class="text-[14px]">{data.sites}</span>
              </span>
            </button>

            {/* Open content: laid out at the open width, so it never reflows while the slice grows. */}
            <div id={`cas-${c.id}`} class="ouvert" inert={k === 0 ? undefined : true}>
              <div class="texte">
                <div class="flex flex-col gap-6">
                  <Picture
                    src={c.logo}
                    alt={c.client}
                    formats={['avif', 'webp']}
                    height={c.logoH}
                    densities={[1, 2]}
                    style={`--h:${c.logoH}px`}
                    class="logo w-auto self-start object-contain object-left"
                  />
                  <blockquote class="citation font-display text-white">
                    <p>{c.quote}</p>
                  </blockquote>
                  <p class="text-[14px] text-white/85">{c.author}</p>
                </div>
                <div class="flex flex-wrap items-end gap-x-10 gap-y-5">
                  <dl class="flex gap-10">
                    {c.figures.map((f) => (
                      <div class="flex flex-col-reverse gap-1.5">
                        <dt class="text-[14px] text-white/85">{f.label}</dt>
                        <dd class="font-display text-[44px] leading-none tracking-[-1.5px] text-white lg:text-[56px]">
                          {f.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  {c.href && (
                    <a
                      href={c.href}
                      class="rounded-full bg-white px-4 py-2.5 text-[14px] font-semibold text-(--marque)"
                    >
                      {data.readCase} →
                    </a>
                  )}
                </div>
                <span class="lecture" aria-hidden="true">
                  <span />
                </span>
              </div>
              <div class="devanture">
                <Picture
                  src={c.front}
                  alt={c.visualAlt}
                  formats={['avif', 'webp']}
                  widths={[340, 680]}
                  sizes="340px"
                  loading="lazy"
                  class="size-full object-contain object-bottom"
                />
              </div>
              <p class="agent">
                <Picture
                  src={c.voxel}
                  alt=""
                  formats={['avif', 'webp']}
                  width={28}
                  densities={[1, 2]}
                  class="size-7 object-contain"
                />
                {data.with} {c.agentName}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tranche {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background-color: var(--marque);
    color: var(--color-white);
  }

  .ferme {
    display: flex;
    cursor: pointer;
    text-align: left;
    transition: opacity 0.25s var(--ease-hatch);
  }
  .ferme:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: -6px;
    border-radius: 28px;
  }
  .avatar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-white) 12%, transparent);
  }
  .nom {
    font-size: 30px;
    letter-spacing: -0.4px;
    line-height: 1;
    transition: translate 0.4s var(--ease-hatch);
  }
  .compte {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .texte {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }
  .logo {
    height: calc(var(--h) * 0.85);
  }
  @media (width >= 64rem) {
    .logo {
      height: var(--h);
    }
  }
  .citation {
    font-size: clamp(1.375rem, 2.4cqw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.4px;
    max-width: 32rem;
  }
  .agent {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background-color: var(--color-white);
    padding: 5px 14px 5px 5px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }

  /* Reading bar: the auto-advance clock (JS sets data-auto unless reduced motion). */
  .lecture {
    position: absolute;
    height: 4px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-white) 20%, transparent);
    overflow: hidden;
  }
  .lecture > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background-color: var(--color-white);
    transform-origin: 0 50%;
    scale: 0 1;
  }
  .etagere:not([data-auto]) .lecture {
    display: none;
  }
  .etagere[data-auto] .tranche[data-ouvert] .lecture > span {
    animation: lecture 7s linear forwards;
  }
  .etagere[data-auto]:is(:hover, :focus-within, :not([data-visible]))
    .tranche[data-ouvert]
    .lecture
    > span {
    animation-play-state: paused;
  }
  @keyframes lecture {
    to {
      scale: 1 1;
    }
  }

  /* ---------- Below lg: stacked; closed slices are rows, the open one a card ---------- */
  @media (width < 64rem) {
    .etagere {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .tranche {
      border-radius: 22px;
    }
    .ferme {
      width: 100%;
      align-items: center;
      gap: 14px;
      padding: 12px 20px 12px 12px;
    }
    .avatar {
      width: 48px;
      height: 48px;
    }
    .nom {
      flex: 1;
      font-size: 24px;
    }
    .compte {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
    }
    .compte > :first-child {
      font-size: 28px;
    }
    .tranche[data-ouvert] .ferme,
    .tranche:not([data-ouvert]) .ouvert {
      display: none;
    }
    .ouvert {
      display: flex;
      flex-direction: column;
      animation: apparait 0.5s var(--ease-hatch);
    }
    .texte {
      padding: 76px 22px 44px;
    }
    .lecture {
      bottom: 22px;
      left: 22px;
      right: 22px;
    }
    .devanture {
      height: 220px;
      padding-inline: 12%;
    }
    .agent {
      top: 18px;
      left: 18px;
    }
  }

  /* ---------- lg+: slices side by side, the open one takes the rest of the width ---------- */
  @media (width >= 64rem) {
    .etagere {
      container-type: inline-size;
      display: flex;
      gap: 12px;
      height: 420px;
    }
    .tranche {
      flex: 0 0 112px;
      transition: flex-grow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .tranche[data-ouvert] {
      flex-grow: 1;
    }
    .ferme {
      position: absolute;
      inset: 0;
      flex-direction: column;
      align-items: center;
      padding: 24px 0 33px;
    }
    .nom {
      margin-top: auto;
      margin-bottom: 30px;
      writing-mode: vertical-rl;
      rotate: 180deg;
      white-space: nowrap;
    }
    .compte {
      align-self: flex-start;
      margin-left: 28px;
    }
    /* Hovering a closed slice: only its name moves, never the slice (Pencil note). */
    .tranche:not([data-ouvert]):hover .nom {
      translate: 0 -8px;
    }
    .tranche[data-ouvert] .ferme {
      opacity: 0;
      pointer-events: none;
    }

    .ouvert {
      position: absolute;
      inset: 0 auto 0 0;
      width: calc(100cqw - (var(--n) - 1) * 124px);
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(220px, 36%, 340px);
      column-gap: 26px;
      opacity: 0;
      transition: opacity 0.2s var(--ease-hatch);
    }
    .tranche[data-ouvert] .ouvert {
      opacity: 1;
      transition: opacity 0.45s var(--ease-hatch) 0.3s;
    }
    .texte {
      padding: 40px 0 52px 44px;
    }
    .lecture {
      left: 44px;
      right: 0;
      bottom: 24px;
      max-width: 476px;
    }
    .devanture {
      align-self: end;
      height: 285px;
      margin-right: 26px;
    }
    .agent {
      top: 32px;
      right: 30px;
    }
  }

  @keyframes apparait {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tranche,
    .ouvert,
    .ferme,
    .nom {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  /**
   * Customer cases shelf: one slice open at a time. A click on a closed slice opens it; the open
   * slice's reading bar (CSS, 7 s) opens the next one when it ends. The bar pauses on hover, keyboard
   * focus and off-screen (CSS, from `data-visible`); no auto-advance under reduced motion.
   */
  const shelf = document.querySelector<HTMLElement>('[data-etagere]');
  if (shelf) {
    const slices = [...shelf.querySelectorAll<HTMLElement>('.tranche')];
    const n = slices.length;
    let open = slices.findIndex((s) => s.hasAttribute('data-ouvert'));

    function show(k: number) {
      open = (k + n) % n;
      slices.forEach((s, j) => {
        const on = j === open;
        s.toggleAttribute('data-ouvert', on);
        s.querySelector('.ferme')!.setAttribute('aria-expanded', String(on));
        s.querySelector<HTMLElement>('.ouvert')!.inert = !on;
      });
    }

    slices.forEach((s, k) => {
      s.querySelector('.ferme')!.addEventListener('click', () => show(k));
      s.querySelector('.lecture > span')!.addEventListener('animationend', () => show(k + 1));
    });

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const auto = () => shelf.toggleAttribute('data-auto', !reduced.matches);
    reduced.addEventListener('change', auto);
    auto();

    new IntersectionObserver((e) => shelf.toggleAttribute('data-visible', e[0]!.isIntersecting), {
      threshold: 0.4,
    }).observe(shelf);
  }
</script>
