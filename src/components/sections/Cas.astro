---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { section } from '../../content/section';
import type { CaseId } from '../../content/schemas/cas';
import type { Locale } from '../../i18n/ui';
import meulerieFront from '../../assets/cas/la-meulerie-devanture.png';
import nobinobiFront from '../../assets/cas/nobinobi-devanture.png';
import pnyFront from '../../assets/cas/pny-devanture.png';
import meulerieLogo from '../../assets/cas/logo-la-meulerie.png';
import nobinobiLogo from '../../assets/cas/logo-nobinobi.png';
import pnyLogo from '../../assets/cas/logo-pny.png';
import voxelJay from '../../assets/cas/voxel-jay.webp';
import voxelPeep from '../../assets/cas/voxel-peep.webp';
import voxelOwl from '../../assets/cas/voxel-owl.webp';

/**
 * 06 — "Ils l'ont déployé dans leur réseau" (v4 node VEEFh): carousel of customer cases.
 * From lg: three rotating slots, 1032 px apart at 1440 (the whole 1000 × 520 card is scaled down
 * below that width), side cards at 45 %; arrows, dots, auto-advance every 6 s paused on hover,
 * keyboard focus, off-screen, reduced motion or the pause button.
 * Below lg: full-width cards in a horizontal scroll-snap strip, same controls.
 * Without JS: the strip (mobile) or the prototype's initial state (desktop), all content readable.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('cas', locale);

/**
 * Drawn layout of each storefront inside the 560 × 520 visual, in % (v4 px / 560 or / 520).
 * Nobinobi's storefront overflows its card on desktop (drawn that way in the v4); below lg it is
 * fitted inside the visual (`fit`). `badge` = position of the "Avec <agent>" pill.
 */
const drawn: Record<
  CaseId,
  {
    front: ImageMetadata;
    logo: ImageMetadata;
    box: [left: number, top: number, width: number, height: number];
    overflow: boolean;
    badge: 'top' | 'bottom';
  }
> = {
  'la-meulerie': {
    front: meulerieFront,
    logo: meulerieLogo,
    box: [12.5, 21.154, 75, 60.577],
    overflow: false,
    badge: 'top',
  },
  nobinobi: {
    front: nobinobiFront,
    logo: nobinobiLogo,
    box: [-26.786, -2.692, 132.143, 107.885],
    overflow: true,
    badge: 'bottom',
  },
  pny: {
    front: pnyFront,
    logo: pnyLogo,
    box: [12.5, 21.154, 75, 60.577],
    overflow: false,
    badge: 'top',
  },
};
const voxels = { jay: voxelJay, peep: voxelPeep, owl: voxelOwl };

const cases = await Promise.all(
  data.cases.map(async (c) => {
    const agent = await getEntry('agents', `${locale}/${c.agent}`);
    if (!agent) throw new Error(`Missing src/content/agents/${locale}/${c.agent}.md`);
    return { ...c, ...drawn[c.id], voxel: voxels[c.agent], agentName: agent.data.name };
  }),
);
const total = cases.length;
/** The v4 opens on the second case, centred. */
const first = 1;
const fill = (s: string, vars: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k]));

const arrow =
  'M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zm-2 4V7h2v8zm-2 2V5h2v12z';
---

<section
  id="cas-clients"
  aria-labelledby="cas-titre"
  class="cas-section section-y overflow-hidden"
  data-rv-groupe
>
  <div data-rv class="flex flex-col items-center gap-3.5 px-5 text-center">
    <p class="font-mono text-[13px] leading-[1.27] tracking-[0.08em] text-orange-txt uppercase">
      {data.kicker}
    </p>
    <h2
      id="cas-titre"
      class="font-display text-[34px] leading-[1.1] font-bold tracking-[-1.2px] text-ink lg:text-[44px] lg:leading-[54px] lg:whitespace-nowrap"
    >
      {data.title}
    </h2>
  </div>

  <div
    class="carrousel relative mt-12 grid grid-cols-[auto_1fr_auto] items-center gap-y-8 lg:mt-[88px] lg:flex lg:flex-col lg:items-stretch lg:gap-y-[88px]"
    role="region"
    aria-roledescription={data.controls.carousel}
    aria-label={data.label}
    data-carrousel
  >
    <div
      data-rv
      style="--rd:.09s"
      class="fleche-pos fleche-prec col-start-1 row-start-2 pl-5 lg:pl-0"
    >
      <button
        type="button"
        data-prec
        aria-label={data.controls.previous}
        aria-controls="cas-diapos"
        class="fleche flex size-11 cursor-pointer items-center justify-center rounded-full bg-white outline outline-1 -outline-offset-[0.5px] outline-line lg:size-14"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="size-5 -scale-x-100 fill-ink lg:size-[22px]"
        >
          <path d={arrow}></path>
        </svg>
      </button>
    </div>

    <div data-rv style="--rd:.18s" class="col-start-2 row-start-2 flex items-center justify-center">
      <!-- The pause button hangs off the right of the dots, so the dots stay centred as in the v4. -->
      <div class="relative flex items-center">
        {
          cases.map((c, k) => (
            <button
              type="button"
              data-pastille={k}
              aria-label={fill(data.controls.dot, { client: c.client })}
              aria-controls="cas-diapos"
              aria-current={k === first ? 'true' : undefined}
              class="group flex h-6 cursor-pointer items-center px-1"
            >
              <span class="pastille block h-2 w-2 rounded-full bg-line group-aria-[current=true]:w-7 group-aria-[current=true]:bg-orange" />
            </button>
          ))
        }
        <button
          type="button"
          data-pause
          aria-label={data.controls.pause}
          data-label-pause={data.controls.pause}
          data-label-play={data.controls.play}
          class="group absolute top-1/2 left-full ml-2 flex size-7 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full text-soft outline outline-1 -outline-offset-1 outline-line transition-colors hover:text-ink [.no-js_&]:hidden"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-3.5 fill-current group-data-[etat=lecture]:hidden"
          >
            <path d="M6 5h4v14H6zm8 0h4v14h-4z"></path>
          </svg>
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="hidden size-3.5 fill-current group-data-[etat=lecture]:block"
          >
            <path d="M7 4v16l13-8z"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      data-rv
      style="--rd:.09s"
      class="fleche-pos fleche-suiv col-start-3 row-start-2 pr-5 lg:pr-0"
    >
      <button
        type="button"
        data-suiv
        aria-label={data.controls.next}
        aria-controls="cas-diapos"
        class="fleche flex size-11 cursor-pointer items-center justify-center rounded-full bg-night lg:size-14"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-white lg:size-[22px]">
          <path d={arrow}></path>
        </svg>
      </button>
    </div>

    <div
      id="cas-diapos"
      data-rv
      style="--rd:.09s"
      aria-live="off"
      class="diapos col-span-3 row-start-1 lg:order-first"
      data-diapos
    >
      {
        cases.map((c, k) => (
          <div
            class="cas group"
            role="group"
            aria-roledescription={data.controls.slideRole}
            aria-label={`${c.client} · ${fill(data.controls.slide, { n: k + 1, total })}`}
            style={`--s:${k - first}`}
            data-actif={k === first ? '' : undefined}
          >
            <div
              class:list={[
                'carte flex h-full flex-col overflow-hidden rounded-[28px] bg-white outline outline-1 -outline-offset-[0.5px] outline-line lg:flex-row',
                c.overflow && 'lg:overflow-visible',
              ]}
            >
              <div class="visuel relative aspect-[560/520] shrink-0 lg:aspect-auto lg:h-full lg:w-[560px] lg:rounded-l-[28px]">
                <div
                  class:list={['devanture absolute', c.overflow && 'devanture-ajustee']}
                  style={`--l:${c.box[0]}%;--t:${c.box[1]}%;--w:${c.box[2]}%;--h:${c.box[3]}%`}
                >
                  <Picture
                    src={c.front}
                    alt={c.visualAlt}
                    formats={['avif', 'webp']}
                    widths={c.overflow ? [600, 900, 1200] : [420, 640, 840]}
                    sizes={
                      c.overflow
                        ? '(min-width: 1024px) 740px, 100vw'
                        : '(min-width: 1024px) 420px, 75vw'
                    }
                    class="size-full object-contain object-bottom lg:object-center"
                  />
                </div>
                <p
                  class:list={[
                    'absolute left-4 z-1 flex items-center gap-2 rounded-full bg-white/85 py-1.5 pr-3.5 pl-1.5 text-sm font-semibold text-ink lg:left-7',
                    c.badge === 'top' ? 'top-4 lg:top-7' : 'bottom-4 lg:bottom-5',
                  ]}
                >
                  <Picture
                    src={c.voxel}
                    alt=""
                    formats={['avif', 'webp']}
                    width={30}
                    densities={[1, 2]}
                    class="size-[30px] object-contain"
                  />
                  {data.with} {c.agentName}
                </p>
              </div>

              <div class="flex flex-1 flex-col gap-8 p-6 lg:gap-0 lg:px-12 lg:pt-12 lg:pb-11">
                <Picture
                  src={c.logo}
                  alt={c.client}
                  formats={['avif', 'webp']}
                  height={44}
                  densities={[1, 2]}
                  class="h-9 w-auto self-start lg:h-11"
                />
                <dl class="flex flex-col gap-5 lg:my-auto lg:gap-[26px]">
                  {c.figures.map((f, i) => (
                    <div class="flex flex-col-reverse gap-1">
                      <dt class="text-[15px] text-soft lg:text-base">{f.label}</dt>
                      <dd
                        class:list={[
                          'font-display text-[44px] leading-none font-normal tracking-[-1.5px] lg:text-[60px] lg:tracking-[-2px]',
                          i === 1 ? 'text-orange-txt' : 'text-ink',
                        ]}
                      >
                        {f.value}
                      </dd>
                    </div>
                  ))}
                </dl>
                {c.href && (
                  <a
                    href={c.href}
                    class="inline-flex items-center gap-2 self-start border-b-[1.5px] border-ink pb-1 text-[15px] font-semibold text-ink"
                  >
                    {data.readCase}
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-ink">
                      <path d={arrow} />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cas-section {
    container-type: inline-size;
  }

  /* Storefront visual: pale peach of the v4 (#F7E4CB), mixed from the two closest tokens. */
  .visuel {
    background-color: color-mix(in srgb, var(--color-cream-2) 50%, var(--color-sand));
    transition: scale 1.2s var(--ease-hatch);
  }
  .devanture {
    left: var(--l);
    top: var(--t);
    width: var(--w);
    height: var(--h);
  }

  .carte {
    box-shadow: 0 24px 60px color-mix(in srgb, var(--color-shadow) 10%, transparent);
  }

  .fleche {
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-ink) 15%, transparent);
    transition:
      scale 0.3s var(--ease-hatch),
      background-color 0.3s;
  }
  .fleche:hover {
    background-color: var(--color-orange);
    scale: 1.08;
  }

  .pastille {
    transition:
      width 0.5s var(--ease-hatch),
      background-color 0.5s;
  }

  /* ---------- Below lg: full-width cards in a scroll-snap strip ---------- */
  @media (width < 64rem) {
    .diapos {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-inline: 1.25rem;
      scroll-padding-inline: 1.25rem;
      position: relative;
    }
    .diapos::-webkit-scrollbar {
      display: none;
    }
    .cas {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }
    /* Nobinobi's storefront is drawn wider than its card: fit it inside the visual. */
    .devanture-ajustee {
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }
  @media (48rem <= width < 64rem) {
    .diapos {
      padding-inline: calc(50% - 18.75rem);
      scroll-padding-inline: calc(50% - 18.75rem);
    }
    .cas {
      flex-basis: 37.5rem;
    }
  }

  /* ---------- lg+: three rotating slots, the 1000 × 520 card of the v4 scaled to fit ---------- */
  @media (width >= 64rem) {
    .carrousel {
      /* Scale factor: 1 from 1288 px up, down to ≈ 0.74 at 1024 px (card + arrows + margins). */
      --k: min(1, tan(atan2(100cqw - 288px, 1000px)));
    }
    .diapos {
      position: relative;
      height: calc(520px * var(--k));
    }
    .cas {
      position: absolute;
      top: 0;
      width: 1000px;
      height: 520px;
      left: calc(50% - 500px * var(--k) + var(--s) * 1032px * var(--k));
      transform-origin: 0 0;
      scale: var(--k);
      opacity: 0.45;
      z-index: 0;
      transition:
        left 0.8s var(--ease-hatch),
        opacity 0.8s var(--ease-hatch);
    }
    .cas[data-actif] {
      opacity: 1;
      z-index: 1;
    }
    /* Wrapping from one side to the other: jump without sliding across the screen, then fade in. */
    .cas.saute {
      transition: none;
      opacity: 0;
    }
    .cas:hover .visuel {
      scale: 1.03;
    }
    .fleche-pos {
      position: absolute;
      z-index: 3;
      top: calc(260px * var(--k) - 28px);
    }
    .fleche-prec {
      left: calc(50% - 574px * var(--k) - 56px);
    }
    .fleche-suiv {
      left: calc(50% + 574px * var(--k));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cas,
    .visuel {
      transition: none !important;
    }
  }
</style>

<script>
  /**
   * Customer cases carousel (ported from the v4 prototype, site.js "Carrousel cas clients").
   * lg+: the active case sits in the centre slot, the others at ±1 slot (`--s`); a case wrapping from
   * one side to the other jumps invisibly then fades in. Below lg: the strip scrolls to the case.
   * Auto-advance every 6 s while visible and not hovered, focused (keyboard), paused or reduced-motion.
   */
  const root = document.querySelector<HTMLElement>('[data-carrousel]');
  if (root) {
    const strip = root.querySelector<HTMLElement>('[data-diapos]')!;
    const slides = [...strip.querySelectorAll<HTMLElement>('.cas')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-pastille]')];
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const n = slides.length;
    const desktop = matchMedia('(min-width: 64rem)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let active = slides.findIndex((s) => s.hasAttribute('data-actif'));
    const slots = slides.map((_, k) => k - active);
    let hovered = false;
    let focused = false;
    let visible = false;
    let paused = reduced.matches;

    /** Slot of case k relative to the active one: -1, 0 or 1. */
    const slotOf = (k: number) => ((((k - active + 1) % n) + n) % n) - 1;

    function mark() {
      slides.forEach((s, k) => {
        s.toggleAttribute('data-actif', k === active);
        s.inert = k !== active;
      });
      dots.forEach((d, k) => {
        if (k === active) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    }

    function place(jump: boolean) {
      slides.forEach((s, k) => {
        const slot = slotOf(k);
        const wraps = jump && Math.abs(slot - slots[k]!) > 1;
        if (wraps) s.classList.add('saute');
        s.style.setProperty('--s', String(slot));
        if (wraps) {
          void s.offsetWidth;
          s.classList.remove('saute');
        }
        slots[k] = slot;
      });
    }

    function scrollToActive(smooth: boolean) {
      const s = slides[active]!;
      strip.scrollTo({
        left: s.offsetLeft - (strip.clientWidth - s.clientWidth) / 2,
        behavior: smooth && !reduced.matches ? 'smooth' : 'auto',
      });
    }

    function go(k: number) {
      active = (k + n) % n;
      mark();
      if (desktop.matches) place(true);
      else scrollToActive(true);
    }

    root.querySelector('[data-prec]')!.addEventListener('click', () => go(active - 1));
    root.querySelector('[data-suiv]')!.addEventListener('click', () => go(active + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));

    // Below lg, a swipe changes the active case.
    const seen = new IntersectionObserver(
      (entries) => {
        if (desktop.matches) return;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const k = slides.indexOf(e.target as HTMLElement);
          if (k !== active) {
            active = k;
            mark();
          }
        }
      },
      { root: strip, threshold: 0.6 },
    );
    slides.forEach((s) => seen.observe(s));

    desktop.addEventListener('change', () => {
      place(false);
      if (!desktop.matches) scrollToActive(false);
    });

    function setPaused(p: boolean) {
      paused = p;
      pause.dataset.etat = p ? 'lecture' : 'pause';
      pause.setAttribute('aria-label', (p ? pause.dataset.labelPlay : pause.dataset.labelPause)!);
      strip.setAttribute('aria-live', p ? 'polite' : 'off');
    }
    pause.addEventListener('click', () => setPaused(!paused));
    setPaused(paused);

    root.addEventListener('mouseenter', () => (hovered = true));
    root.addEventListener('mouseleave', () => (hovered = false));
    root.addEventListener('focusin', () => {
      focused = root.querySelector(':focus-visible') !== null;
    });
    root.addEventListener('focusout', () => (focused = false));
    new IntersectionObserver((e) => (visible = e[0]!.isIntersecting), { threshold: 0.4 }).observe(
      root,
    );

    mark();
    place(false);
    scrollToActive(false);

    setInterval(() => {
      if (visible && !hovered && !focused && !paused && !document.hidden) go(active + 1);
    }, 6000);
  }
</script>
