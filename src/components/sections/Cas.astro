---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { section } from '../../content/section';
import type { CaseId } from '../../content/schemas/cas';
import type { Locale } from '../../i18n/ui';
import meulerieFront from '../../assets/cas/la-meulerie-devanture.png';
import nobinobiFront from '../../assets/cas/nobinobi-devanture.png';
import pnyFront from '../../assets/cas/pny-devanture.png';
import meulerieLogo from '../../assets/cas/logo-la-meulerie.png';
import nobinobiLogo from '../../assets/cas/logo-nobinobi.png';
import pnyLogo from '../../assets/cas/logo-pny.png';
import voxelJay from '../../assets/cas/voxel-jay.webp';
import voxelPeep from '../../assets/cas/voxel-peep.webp';
import voxelOwl from '../../assets/cas/voxel-owl.webp';

/**
 * 06 — "Ils l'ont déployé dans leur réseau" (v4 node VEEFh): carousel of customer cases.
 * Compact card (César 02/10: the v4's 1000 × 520 card was oversized): 840 × 340 from lg, storefront
 * on the left, logo and two figures on the right. Three rotating slots 872 px apart (the card is
 * scaled down below 1080 px), side cards at 45 %; arrows, dots, auto-advance every 6 s paused on hover,
 * keyboard focus, off-screen or reduced motion. No pause button (César 02/10).
 * Below lg: full-width cards in a horizontal scroll-snap strip, same controls.
 * Without JS: the strip (mobile) or the prototype's initial state (desktop), all content readable.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('cas', locale);

/** Storefront (transparent voxel PNG) and logo of each case. */
const visuals: Record<CaseId, { front: ImageMetadata; logo: ImageMetadata }> = {
  'la-meulerie': { front: meulerieFront, logo: meulerieLogo },
  nobinobi: { front: nobinobiFront, logo: nobinobiLogo },
  pny: { front: pnyFront, logo: pnyLogo },
};
const voxels = { jay: voxelJay, peep: voxelPeep, owl: voxelOwl };

const cases = await Promise.all(
  data.cases.map(async (c) => {
    const agent = await getEntry('agents', `${locale}/${c.agent}`);
    if (!agent) throw new Error(`Missing src/content/agents/${locale}/${c.agent}.md`);
    return { ...c, ...visuals[c.id], voxel: voxels[c.agent], agentName: agent.data.name };
  }),
);
const total = cases.length;
/** The v4 opens on the second case, centred. */
const first = 1;
const fill = (s: string, vars: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k]));

const arrow =
  'M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zm-2 4V7h2v8zm-2 2V5h2v12z';
---

<section
  id="cas-clients"
  aria-labelledby="cas-titre"
  class="cas-section section-y overflow-hidden"
  data-rv-groupe
>
  <div data-rv class="flex flex-col items-center gap-3.5 px-5 text-center">
    <p class="font-mono text-[13px] leading-[1.27] tracking-[0.08em] text-orange-txt uppercase">
      {data.kicker}
    </p>
    <h2
      id="cas-titre"
      class="font-display text-[34px] leading-[1.1] font-bold tracking-[-1.2px] text-ink lg:text-[44px] lg:leading-[54px] lg:whitespace-nowrap"
    >
      {data.title}
    </h2>
  </div>

  <div
    class="carrousel relative mt-10 grid grid-cols-[auto_1fr_auto] items-center gap-y-6 lg:mt-14 lg:flex lg:flex-col lg:items-stretch lg:gap-y-10"
    role="region"
    aria-roledescription={data.controls.carousel}
    aria-label={data.label}
    data-carrousel
  >
    <div
      data-rv
      style="--rd:.09s"
      class="fleche-pos fleche-prec col-start-1 row-start-2 pl-5 lg:pl-0"
    >
      <button
        type="button"
        data-prec
        aria-label={data.controls.previous}
        aria-controls="cas-diapos"
        class="fleche flex size-10 cursor-pointer items-center justify-center rounded-full bg-white outline outline-1 -outline-offset-[0.5px] outline-line lg:size-12"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-[18px] -scale-x-100 fill-ink">
          <path d={arrow}></path>
        </svg>
      </button>
    </div>

    <div data-rv style="--rd:.18s" class="col-start-2 row-start-2 flex items-center justify-center">
      {
        cases.map((c, k) => (
          <button
            type="button"
            data-pastille={k}
            aria-label={fill(data.controls.dot, { client: c.client })}
            aria-controls="cas-diapos"
            aria-current={k === first ? 'true' : undefined}
            class="group flex h-6 cursor-pointer items-center px-1"
          >
            <span class="pastille block h-1.5 w-1.5 rounded-full bg-line group-aria-[current=true]:w-6 group-aria-[current=true]:bg-orange" />
          </button>
        ))
      }
    </div>

    <div
      data-rv
      style="--rd:.09s"
      class="fleche-pos fleche-suiv col-start-3 row-start-2 pr-5 lg:pr-0"
    >
      <button
        type="button"
        data-suiv
        aria-label={data.controls.next}
        aria-controls="cas-diapos"
        class="fleche flex size-10 cursor-pointer items-center justify-center rounded-full bg-night lg:size-12"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-[18px] fill-white">
          <path d={arrow}></path>
        </svg>
      </button>
    </div>

    <div
      id="cas-diapos"
      data-rv
      style="--rd:.09s"
      aria-live="off"
      class="diapos col-span-3 row-start-1 lg:order-first"
      data-diapos
    >
      {
        cases.map((c, k) => (
          <div
            class="cas group"
            role="group"
            aria-roledescription={data.controls.slideRole}
            aria-label={`${c.client} · ${fill(data.controls.slide, { n: k + 1, total })}`}
            style={`--s:${k - first}`}
            data-actif={k === first ? '' : undefined}
          >
            <div class="carte flex h-full flex-col overflow-hidden rounded-card bg-white outline outline-1 -outline-offset-[0.5px] outline-line lg:flex-row">
              <div class="visuel relative aspect-[16/10] shrink-0 overflow-hidden lg:aspect-auto lg:h-full lg:w-[340px]">
                <Picture
                  src={c.front}
                  alt={c.visualAlt}
                  formats={['avif', 'webp']}
                  widths={[320, 480, 680]}
                  sizes="(min-width: 1024px) 300px, 80vw"
                  class="devanture absolute top-[24%] left-[12%] h-[68%] w-[76%] lg:top-[18%] lg:left-[10%] lg:h-[75%] lg:w-[80%] object-contain object-bottom"
                />
                <p class="absolute top-3.5 left-3.5 z-1 flex items-center gap-1.5 rounded-full bg-white/85 py-1 pr-3 pl-1 text-[13px] font-semibold text-ink">
                  <Picture
                    src={c.voxel}
                    alt=""
                    formats={['avif', 'webp']}
                    width={24}
                    densities={[1, 2]}
                    class="size-6 object-contain"
                  />
                  {data.with} {c.agentName}
                </p>
              </div>

              <div class="flex flex-1 flex-col gap-7 p-6 lg:gap-0 lg:px-11 lg:py-10">
                <Picture
                  src={c.logo}
                  alt={c.client}
                  formats={['avif', 'webp']}
                  height={32}
                  densities={[1, 2]}
                  class="h-7 w-auto self-start lg:h-8"
                />
                <dl class="grid grid-cols-2 gap-6 lg:mt-auto lg:gap-10">
                  {c.figures.map((f, i) => (
                    <div class="flex flex-col-reverse gap-1.5">
                      <dt class="text-[14px] leading-snug text-soft">{f.label}</dt>
                      <dd
                        class:list={[
                          'font-display text-[36px] leading-none tracking-[-1px] lg:text-[44px] lg:tracking-[-1.5px]',
                          i === 1 ? 'text-orange-txt' : 'text-ink',
                        ]}
                      >
                        {f.value}
                      </dd>
                    </div>
                  ))}
                </dl>
                {c.href && (
                  <a
                    href={c.href}
                    class="inline-flex items-center gap-2 self-start border-b-[1.5px] border-ink pb-1 text-[14px] font-semibold text-ink lg:mt-7"
                  >
                    {data.readCase}
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-ink">
                      <path d={arrow} />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cas-section {
    container-type: inline-size;
  }

  /* Storefront visual: pale peach of the v4 (#F7E4CB), mixed from the two closest tokens. */
  .visuel {
    background-color: color-mix(in srgb, var(--color-cream-2) 50%, var(--color-sand));
  }
  .devanture {
    transition: scale 1.2s var(--ease-hatch);
    transform-origin: 50% 100%;
  }

  .carte {
    box-shadow: 0 16px 40px color-mix(in srgb, var(--color-shadow) 8%, transparent);
  }

  .fleche {
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-ink) 12%, transparent);
    transition:
      scale 0.3s var(--ease-hatch),
      background-color 0.3s;
  }
  .fleche:hover {
    background-color: var(--color-orange);
    scale: 1.08;
  }

  .pastille {
    transition:
      width 0.5s var(--ease-hatch),
      background-color 0.5s;
  }

  /* ---------- Below lg: cards in a scroll-snap strip, the next one peeking ---------- */
  @media (width < 64rem) {
    .diapos {
      display: flex;
      gap: 0.875rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-inline: 1.25rem;
      scroll-padding-inline: 1.25rem;
      position: relative;
    }
    .diapos::-webkit-scrollbar {
      display: none;
    }
    .cas {
      flex: 0 0 min(86%, 26rem);
      scroll-snap-align: center;
    }
  }
  @media (48rem <= width < 64rem) {
    .diapos {
      padding-inline: calc(50% - 13rem);
      scroll-padding-inline: calc(50% - 13rem);
    }
  }

  /* ---------- lg+: three rotating slots, the 840 × 340 card scaled to fit ---------- */
  @media (width >= 64rem) {
    .carrousel {
      /* Scale factor: 1 from 1080 px up, down to ≈ 0.93 at 1024 px (card + arrows + margins). */
      --k: min(1, tan(atan2(100cqw - 240px, 840px)));
    }
    .diapos {
      position: relative;
      height: calc(340px * var(--k));
    }
    .cas {
      position: absolute;
      top: 0;
      width: 840px;
      height: 340px;
      left: calc(50% - 420px * var(--k) + var(--s) * 872px * var(--k));
      transform-origin: 0 0;
      scale: var(--k);
      opacity: 0.45;
      z-index: 0;
      transition:
        left 0.8s var(--ease-hatch),
        opacity 0.8s var(--ease-hatch);
    }
    .cas[data-actif] {
      opacity: 1;
      z-index: 1;
    }
    /* Wrapping from one side to the other: jump without sliding across the screen, then fade in. */
    .cas.saute {
      transition: none;
      opacity: 0;
    }
    .cas:hover .devanture {
      scale: 1.04;
    }
    /* Arrows 24 px off the active card's edges, centred on its height. */
    .fleche-pos {
      position: absolute;
      z-index: 3;
      top: calc(170px * var(--k) - 24px);
    }
    .fleche-prec {
      left: calc(50% - 420px * var(--k) - 72px);
    }
    .fleche-suiv {
      left: calc(50% + 420px * var(--k) + 24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cas,
    .devanture {
      transition: none !important;
    }
  }
</style>

<script>
  /**
   * Customer cases carousel (ported from the v4 prototype, site.js "Carrousel cas clients").
   * lg+: the active case sits in the centre slot, the others at ±1 slot (`--s`); a case wrapping from
   * one side to the other jumps invisibly then fades in. Below lg: the strip scrolls to the case.
   * Auto-advance every 6 s while visible and not hovered, focused (keyboard) or reduced-motion.
   */
  const root = document.querySelector<HTMLElement>('[data-carrousel]');
  if (root) {
    const strip = root.querySelector<HTMLElement>('[data-diapos]')!;
    const slides = [...strip.querySelectorAll<HTMLElement>('.cas')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-pastille]')];
    const n = slides.length;
    const desktop = matchMedia('(min-width: 64rem)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let active = slides.findIndex((s) => s.hasAttribute('data-actif'));
    const slots = slides.map((_, k) => k - active);
    let hovered = false;
    let focused = false;
    let visible = false;

    /** Slot of case k relative to the active one: -1, 0 or 1. */
    const slotOf = (k: number) => ((((k - active + 1) % n) + n) % n) - 1;

    function mark() {
      slides.forEach((s, k) => {
        s.toggleAttribute('data-actif', k === active);
        s.inert = k !== active;
      });
      dots.forEach((d, k) => {
        if (k === active) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    }

    function place(jump: boolean) {
      slides.forEach((s, k) => {
        const slot = slotOf(k);
        const wraps = jump && Math.abs(slot - slots[k]!) > 1;
        if (wraps) s.classList.add('saute');
        s.style.setProperty('--s', String(slot));
        if (wraps) {
          void s.offsetWidth;
          s.classList.remove('saute');
        }
        slots[k] = slot;
      });
    }

    function scrollToActive(smooth: boolean) {
      const s = slides[active]!;
      strip.scrollTo({
        left: s.offsetLeft - (strip.clientWidth - s.clientWidth) / 2,
        behavior: smooth && !reduced.matches ? 'smooth' : 'auto',
      });
    }

    function go(k: number) {
      active = (k + n) % n;
      mark();
      if (desktop.matches) place(true);
      else scrollToActive(true);
    }

    root.querySelector('[data-prec]')!.addEventListener('click', () => go(active - 1));
    root.querySelector('[data-suiv]')!.addEventListener('click', () => go(active + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));

    // Below lg, a swipe changes the active case.
    const seen = new IntersectionObserver(
      (entries) => {
        if (desktop.matches) return;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const k = slides.indexOf(e.target as HTMLElement);
          if (k !== active) {
            active = k;
            mark();
          }
        }
      },
      { root: strip, threshold: 0.6 },
    );
    slides.forEach((s) => seen.observe(s));

    desktop.addEventListener('change', () => {
      place(false);
      if (!desktop.matches) scrollToActive(false);
    });

    root.addEventListener('mouseenter', () => (hovered = true));
    root.addEventListener('mouseleave', () => (hovered = false));
    root.addEventListener('focusin', () => {
      focused = root.querySelector(':focus-visible') !== null;
    });
    root.addEventListener('focusout', () => (focused = false));
    new IntersectionObserver((e) => (visible = e[0]!.isIntersecting), { threshold: 0.4 }).observe(
      root,
    );

    mark();
    place(false);
    scrollToActive(false);

    setInterval(() => {
      if (visible && !hovered && !focused && !reduced.matches && !document.hidden) go(active + 1);
    }, 6000);
  }
</script>
