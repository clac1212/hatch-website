---
/**
 * Device mock-up of an agent demo (kitchen, César 01/10): an iPad Pro in landscape running Owl's
 * kitchen app, or an iPhone 17 Pro in a WhatsApp chat with Pecker. Devices are drawn in CSS (edge,
 * black glass, camera, buttons, glare) so they stay sharp at any camera zoom and can tilt in 3D.
 * The markup renders the FINAL state, which is what shows without JS and under reduced motion. The
 * GSAP timeline (demo-motion.ts) hides and reveals each element on its beat (`data-t`, from
 * demo-ecran.ts); nothing here animates on its own.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EcranTablette, EcranTelephone } from '../../content/schemas/demo';
import { chronoTablette, chronoTelephone } from './demo-ecran';

interface Props {
  ecran: EcranTablette | EcranTelephone;
  avatar: ImageMetadata;
}
const { ecran, avatar } = Astro.props;
const s = (t: number) => t.toFixed(2);
const tab = ecran.appareil === 'tablette' ? chronoTablette(ecran) : null;
const tel = ecran.appareil === 'telephone' ? chronoTelephone(ecran) : null;
/** Waveform bars of the voice card. */
const BARRES = 17;
/** "Owl · Tablette cuisine" → app name, then where it runs. */
const [appNom, appLieu] = ecran.appareil === 'tablette' ? ecran.entete.split(' · ') : ['', ''];
/** "Étape {n} sur {total}" around a rolling digit. */
const [compteurAvant, compteurApres] =
  ecran.appareil === 'tablette'
    ? ecran.compteur.replace('{total}', String(ecran.etapes.length)).split('{n}')
    : ['', ''];

const I = {
  ok: 'M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z',
  lus: 'M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41 6 19l1.41-1.41L1.83 12 .41 13.41z',
  wifi: 'M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8 3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4 2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z',
  micro:
    'M12 15a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v7a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-2.1a7 7 0 0 0 6-6.9h-2Z',
  hp: 'M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4ZM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6Z',
  retour: 'M15.4 4.6 8 12l7.4 7.4 1.4-1.4-6-6 6-6z',
  video:
    'M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z',
  appel:
    'M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z',
  plus: 'M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z',
  photo:
    'M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM9 2 7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z',
  envoi: 'M2.01 21 23 12 2.01 3 2 10l15 2-15 2z',
  liste: 'M3 5h2v2H3zm4 0h14v2H7zM3 11h2v2H3zm4 0h14v2H7zm-4 6h2v2H3zm4 0h14v2H7z',
};
---

{
  ecran.appareil === 'tablette' && tab && (
    <div
      class="ecr tablette"
      data-duree={s(tab.duree)}
      data-debut={s(tab.debutMots)}
      data-reponse={s(tab.reponse)}
      data-prepare={s(tab.prepare)}
      data-resolu={s(tab.resolu)}
      data-voix={s(tab.voix)}
      data-fin={s(tab.finVoix)}
      data-etape={s(tab.parEtape)}
    >
      <div class="ipad">
        <span class="bouton haut" aria-hidden="true" />
        <div class="vitre">
          <span class="t-camera" aria-hidden="true" />
          <div class="t-ecran">
            <div class="t-statut" aria-hidden="true">
              <span>{ecran.heure}</span>
              <span class="icones">
                <svg viewBox="0 0 24 24">
                  <path d={I.wifi} />
                </svg>
                <svg class="batterie" viewBox="0 0 28 13">
                  <rect x="0.5" y="0.5" width="23" height="12" rx="3.5" />
                  <rect class="plein" x="2" y="2" width="18" height="9" rx="2" />
                  <rect class="borne" x="25" y="4.5" width="2" height="4" rx="1" />
                </svg>
              </span>
            </div>
            <header class="t-barre">
              <Image src={avatar} alt="" width={40} height={40} densities={[1, 2]} class="t-av" />
              <span class="t-app">
                <b>{appNom}</b>
                <span>{appLieu}</span>
              </span>
              <span class="t-direct">
                <span class="t-rec" aria-hidden="true" />
                <span class="t-statuts">
                  <span class="t-ecoute">{ecran.ecoute}</span>
                  <span class="t-prepare">{ecran.prepare}</span>
                  <span class="t-lit">{ecran.lit}</span>
                </span>
              </span>
            </header>
            <div class="t-fil">
              {/* The question, heard: a voice bubble transcribed word by word. */}
              <div class="t-bulle">
                <span class="t-micro" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d={I.micro} />
                  </svg>
                </span>
                <p class="t-question">
                  {tab.mots.map(({ m, t }) => (
                    <>
                      <span class="t-mot" data-t={s(t)}>
                        {m}
                      </span>{' '}
                    </>
                  ))}
                </p>
                <span class="t-onde" aria-hidden="true">
                  {Array.from({ length: 9 }, () => (
                    <span />
                  ))}
                </span>
              </div>
              {/* The answer: Owl speaks it (audio pill) and shows it as UI it generates. */}
              <div class="t-reponse">
                <div class="t-voix">
                  <span class="t-hp" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d={I.hp} />
                    </svg>
                  </span>
                  <span class="t-eq" aria-hidden="true">
                    {Array.from({ length: 14 }, () => (
                      <span />
                    ))}
                  </span>
                  <span class="t-legende">{ecran.pied}</span>
                  <span class="t-progression" aria-hidden="true">
                    <span />
                  </span>
                </div>
                <div class="t-carte">
                  <div class="t-squelette" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                  </div>
                  <div class="t-contenu">
                    <p class="t-source">{ecran.source}</p>
                    <div class="t-titre">
                      <p>{ecran.fiche}</p>
                      <p class="t-compteur">
                        {compteurAvant}
                        <span class="t-fenetre">
                          <span class="t-roue">
                            {ecran.etapes.map((_, i) => (
                              <span>{i + 1}</span>
                            ))}
                          </span>
                        </span>
                        {compteurApres}
                      </p>
                    </div>
                    <ol class="t-etapes">
                      {ecran.etapes.map((etape, i) => (
                        <li data-t={s(tab.etapes[i])}>
                          <span class="t-surligne" aria-hidden="true" />
                          <span class="t-pastille" aria-hidden="true">
                            <span class="t-num">{i + 1}</span>
                            <span class="t-fait">
                              <svg viewBox="0 0 24 24">
                                <path d={I.ok} />
                              </svg>
                            </span>
                          </span>
                          <span class="t-txt">{etape}</span>
                          <span class="t-lu" aria-hidden="true" />
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <span class="reflet" aria-hidden="true" />
      </div>
    </div>
  )
}

{
  ecran.appareil === 'telephone' && tel && (
    <div class="ecr telephone" data-duree={s(tel.duree)}>
      <div class="iphone">
        <span class="bouton action" aria-hidden="true" />
        <span class="bouton volume-haut" aria-hidden="true" />
        <span class="bouton volume-bas" aria-hidden="true" />
        <span class="bouton alimentation" aria-hidden="true" />
        <span class="bouton capture" aria-hidden="true" />
        <div class="vitre">
          <div class="p-ecran">
            <div class="p-statut" aria-hidden="true">
              <span>{ecran.heure}</span>
              <span class="icones">
                <svg class="reseau" viewBox="0 0 18 12">
                  <rect x="0" y="8" width="3" height="4" rx="1" />
                  <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
                  <rect x="10" y="3" width="3" height="9" rx="1" />
                  <rect x="15" y="0" width="3" height="12" rx="1" />
                </svg>
                <svg viewBox="0 0 24 24">
                  <path d={I.wifi} />
                </svg>
                <svg class="batterie" viewBox="0 0 28 13">
                  <rect x="0.5" y="0.5" width="23" height="12" rx="3.5" />
                  <rect class="plein" x="2" y="2" width="16" height="9" rx="2" />
                  <rect class="borne" x="25" y="4.5" width="2" height="4" rx="1" />
                </svg>
              </span>
            </div>
            <span class="p-ile" aria-hidden="true" />
            <header class="p-barre">
              <svg class="p-retour" viewBox="0 0 24 24" aria-hidden="true">
                <path d={I.retour} />
              </svg>
              <Image src={avatar} alt="" width={40} height={40} densities={[1, 2]} class="p-av" />
              <span class="p-contact">
                <b>{ecran.contact}</b>
                <span class="p-statuts">
                  <span class="p-st">{ecran.statut}</span>
                  <span class="p-ecrit">{ecran.ecrit}</span>
                </span>
              </span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={I.video} />
              </svg>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={I.appel} />
              </svg>
            </header>
            <div class="p-fil">
              <p class="p-jour">{ecran.jour}</p>
              {tel.fil.map((b) =>
                'quiz' in b.item ? (
                  <div class="p-ligne agent" data-t={s(b.t)} data-c={s(b.choix ?? b.t)}>
                    <div class="p-msg p-sondage">
                      <p class="p-question">{b.item.quiz.question}</p>
                      <p class="p-aide">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d={I.liste} />
                        </svg>
                        {b.item.quiz.aide}
                      </p>
                      <ul>
                        {b.item.quiz.options.map((o, j) => (
                          <li class:list={{ bonne: 'quiz' in b.item && j === b.item.quiz.bonne }}>
                            <span class="p-radio" aria-hidden="true">
                              <span class="p-coche">
                                <svg viewBox="0 0 24 24">
                                  <path d={I.ok} />
                                </svg>
                              </span>
                            </span>
                            <span class="p-opt">{o}</span>
                            <span class="p-nb" aria-hidden="true">
                              {'quiz' in b.item && j === b.item.quiz.bonne ? 1 : 0}
                            </span>
                            <span class="p-jauge" aria-hidden="true">
                              <span />
                            </span>
                            {'quiz' in b.item && j === b.item.quiz.bonne && (
                              <span class="p-doigt" aria-hidden="true" />
                            )}
                          </li>
                        ))}
                      </ul>
                      <span class="p-meta">{ecran.heure}</span>
                    </div>
                  </div>
                ) : (
                  <>
                    {b.frappe !== undefined && (
                      <div class="p-ligne agent p-frappe" data-t={s(b.frappe)} aria-hidden="true">
                        <div class="p-msg">
                          <span />
                          <span />
                          <span />
                        </div>
                      </div>
                    )}
                    <div class:list={['p-ligne', b.item.de]} data-t={s(b.t)}>
                      <div class="p-msg">
                        {b.item.texte}
                        <span class="p-meta">
                          {ecran.heure}
                          {b.item.de === 'equipe' && (
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d={I.lus} />
                            </svg>
                          )}
                        </span>
                      </div>
                    </div>
                  </>
                ),
              )}
            </div>
            <footer class="p-saisie" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d={I.plus} />
              </svg>
              <span class="p-champ">
                <span class="p-indice">{ecran.saisie}</span>
                {tel.fil.map(
                  (b) =>
                    b.brouillon !== undefined &&
                    !('quiz' in b.item) && (
                      <span class="p-brouillon" data-t={s(b.brouillon)} data-envoi={s(b.t)}>
                        {b.item.texte}
                      </span>
                    ),
                )}
              </span>
              <span class="p-photo">
                <svg viewBox="0 0 24 24">
                  <path d={I.photo} />
                </svg>
              </span>
              <span class="p-actions">
                <svg class="p-micro" viewBox="0 0 24 24">
                  <path d={I.micro} />
                </svg>
                <span class="p-envoyer">
                  <svg viewBox="0 0 24 24">
                    <path d={I.envoi} />
                  </svg>
                </span>
              </span>
            </footer>
            <span class="p-accueil" aria-hidden="true" />
          </div>
        </div>
        <span class="reflet" aria-hidden="true" />
      </div>
      <div class="p-suivi" data-t={s(tel.suivi)}>
        <Image src={avatar} alt="" width={40} height={40} densities={[1, 2]} class="p-icone" />
        <span class="p-notif">
          <span class="p-tete">
            <b>{ecran.suivi.app}</b>
            <span>{ecran.suivi.quand}</span>
          </span>
          <b>{ecran.suivi.titre}</b>
          {ecran.suivi.texte}
        </span>
      </div>
    </div>
  )
}

<style>
  /* ================= Devices ================= */
  /* A silver edge (--bord), black glass inside it (--verre), the screen inside the glass. Every
     radius derives from the outer one (--rayon), so the corners stay concentric. */
  .ipad,
  .iphone {
    position: relative;
    container-type: inline-size;
    border-radius: var(--rayon);
    background: var(--color-metal);
    box-shadow:
      inset 0 0 0 0.15cqw var(--color-metal-dark),
      inset 0 0.35cqw 0.25cqw var(--color-metal-light),
      inset 0 -0.35cqw 0.35cqw var(--color-metal-dark),
      0 1px 2px color-mix(in srgb, var(--color-shadow) 25%, transparent),
      0 18px 36px -14px color-mix(in srgb, var(--color-shadow) 45%, transparent),
      0 44px 80px -36px color-mix(in srgb, var(--color-shadow) 40%, transparent);
  }
  .vitre {
    position: absolute;
    inset: var(--bord);
    border-radius: calc(var(--rayon) - var(--bord));
    background: var(--color-glass);
    box-shadow: 0 0 0 0.12cqw var(--color-metal-dark);
  }
  /* The screen, inside the glass. */
  .t-ecran,
  .p-ecran {
    position: absolute;
    inset: var(--verre);
    border-radius: calc(var(--rayon) - var(--bord) - var(--verre));
  }
  .bouton {
    position: absolute;
    border-radius: 0.6cqw;
    background: var(--color-metal);
    box-shadow:
      inset 0 0 0 0.12cqw var(--color-metal-dark),
      inset 0.2cqw 0 0.2cqw var(--color-metal-light);
  }
  /* A soft glare across the glass; the timeline sweeps it once when the device lands. */
  .reflet {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      115deg,
      transparent 30%,
      color-mix(in srgb, var(--color-white) 16%, transparent) 45%,
      transparent 60%
    );
    opacity: 0;
    pointer-events: none;
  }
  .icones {
    display: flex;
    align-items: center;
  }
  .icones svg {
    fill: currentColor;
  }
  .batterie rect {
    fill: none;
    stroke: currentColor;
    opacity: 0.45;
  }
  .batterie .plein,
  .batterie .borne {
    fill: currentColor;
    stroke: none;
    opacity: 1;
  }
  .batterie .borne {
    opacity: 0.45;
  }

  /* ---------- iPad Pro 13", landscape (281.6 × 215.5 mm) ---------- */
  .tablette {
    width: 100%;
  }
  .ipad {
    --rayon: 6.6cqw;
    --bord: 0.55cqw;
    --verre: 2.1cqw;
    aspect-ratio: 281.6 / 215.5;
  }
  .ipad .haut {
    top: -0.35cqw;
    right: 14%;
    width: 6%;
    height: 0.5cqw;
  }
  .t-camera {
    position: absolute;
    left: 50%;
    top: calc(var(--verre) / 2 - 0.4cqw);
    width: 0.8cqw;
    height: 0.8cqw;
    margin-left: -0.4cqw;
    border-radius: 999px;
    background: var(--color-night-2);
    box-shadow: inset 0 0 0 0.18cqw var(--color-line-night);
  }
  .t-ecran {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-cream);
    font: 500 2.2cqw/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .t-statut {
    display: flex;
    justify-content: space-between;
    padding: 1.3cqw 3cqw 0;
    font: 600 1.6cqw/1 var(--font-sans);
  }
  .t-statut .icones {
    gap: 0.8cqw;
  }
  .t-statut svg {
    width: 2.1cqw;
  }
  .t-statut .batterie {
    width: 3cqw;
  }
  .t-barre {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.4cqw 3cqw 1.6cqw;
    border-bottom: 1px solid var(--color-line);
  }
  .t-barre :global(.t-av) {
    width: 4.6cqw;
    height: 4.6cqw;
    border-radius: 1.3cqw;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  .t-app {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .t-app b {
    font: 700 2.7cqw/1.1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .t-app span {
    font-size: 1.75cqw;
    color: var(--color-soft);
  }
  .t-direct {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    margin-left: auto;
    padding: 0.85cqw 1.7cqw 0.85cqw 1.3cqw;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-line),
      var(--shadow-1);
    font: 600 1.75cqw/1 var(--font-sans);
  }
  .t-rec {
    width: 1cqw;
    height: 1cqw;
    border-radius: 999px;
    background: var(--color-orange);
    box-shadow: 0 0 0 0.35cqw var(--color-orange-tint);
  }
  /* The three statuses share one cell; the timeline swaps them. Final state: reading. */
  .t-statuts {
    display: grid;
    justify-items: end;
  }
  .t-statuts > * {
    grid-area: 1 / 1;
  }
  .t-ecoute,
  .t-prepare {
    opacity: 0;
  }

  /* The conversation: the heard question on the right, Owl's answer below it. */
  .t-fil {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.8cqw;
    min-height: 0;
    padding: 2.2cqw 3cqw 2.6cqw;
  }
  .t-bulle {
    display: flex;
    align-items: center;
    align-self: flex-end;
    gap: 1.3cqw;
    max-width: 70%;
    padding: 1.1cqw 1.8cqw 1.1cqw 1.1cqw;
    border-radius: 3cqw;
    border-bottom-right-radius: 0.8cqw;
    background: var(--color-night);
    color: var(--color-white);
  }
  .t-micro {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.8cqw;
    height: 3.8cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .t-micro svg {
    width: 2.1cqw;
    fill: var(--color-ink);
  }
  .t-question {
    font: 600 2.3cqw/1.3 var(--font-sans);
  }
  .t-mot {
    display: inline-block;
  }
  .t-onde {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.35cqw;
    height: 2.6cqw;
  }
  .t-onde span {
    width: 0.4cqw;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 75%, transparent);
    transform: scaleY(0.2);
  }
  .t-reponse {
    display: flex;
    flex-direction: column;
    gap: 1.1cqw;
    min-height: 0;
  }
  /* Audio pill: the answer is also spoken; its bar runs while Owl speaks. */
  .t-voix {
    position: relative;
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: 1.2cqw;
    padding: 0.9cqw 1.8cqw 0.9cqw 0.9cqw;
