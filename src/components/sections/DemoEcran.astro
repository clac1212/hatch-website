---
/**
 * Animated device mock-up of an agent demo (kitchen, César 01/10): a kitchen tablet (Owl) or a phone
 * (Pecker). The markup renders the FINAL state, which is what shows without JS and under reduced
 * motion. The GSAP timeline (demo-motion.ts) hides and reveals each element on its beat (`data-t`,
 * from demo-ecran.ts); nothing here animates on its own.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EcranTablette, EcranTelephone } from '../../content/schemas/demo';
import cadre from '../../assets/probleme/iphone-cadre.png';
import { chronoTablette, chronoTelephone } from './demo-ecran';

interface Props {
  ecran: EcranTablette | EcranTelephone;
  avatar: ImageMetadata;
}
const { ecran, avatar } = Astro.props;
const s = (t: number) => t.toFixed(2);
const tab = ecran.appareil === 'tablette' ? chronoTablette(ecran) : null;
const tel = ecran.appareil === 'telephone' ? chronoTelephone(ecran) : null;
/** Waveform bars, resting height then peak height while the question is spoken. */
const BARRES = 15;
const ICONE_OK = 'M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z';
---

{
  ecran.appareil === 'tablette' && tab && (
    <div
      class="ecr tablette"
      data-duree={s(tab.duree)}
      data-debut={s(tab.debutMots)}
      data-reponse={s(tab.reponse)}
      data-etape={s(tab.parEtape)}
    >
      <div class="t-ecran">
        <header class="t-barre">
          <Image src={avatar} alt="" width={32} height={32} densities={[1, 2]} class="t-av" />
          <b>{ecran.entete}</b>
          <span class="t-direct">
            <span class="t-rec" aria-hidden="true" />
            <span class="t-statuts">
              <span class="t-ecoute">{ecran.ecoute}</span>
              <span class="t-lit">{ecran.lit}</span>
            </span>
          </span>
        </header>
        <div class="t-corps">
          <div class="t-gauche">
            <div class="t-micro" aria-hidden="true">
              <span class="t-anneau" />
              <span class="t-anneau" />
              <svg viewBox="0 0 24 24">
                <path d="M12 15a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v7a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-2.1a7 7 0 0 0 6-6.9h-2Z" />
              </svg>
            </div>
            <div class="t-onde" aria-hidden="true">
              {Array.from({ length: BARRES }, () => (
                <span />
              ))}
            </div>
            <p class="t-question">
              {tab.mots.map(({ m, t }) => (
                <>
                  <span class="t-mot" data-t={s(t)}>
                    {m}
                  </span>{' '}
                </>
              ))}
            </p>
          </div>
          <div class="t-droite">
            <p class="t-fiche">{ecran.fiche}</p>
            <p class="t-source">{ecran.source}</p>
            <ol class="t-etapes">
              {ecran.etapes.map((etape, i) => (
                <li data-t={s(tab.etapes[i])}>
                  <span class="t-surligne" aria-hidden="true" />
                  <span class="t-num">{i + 1}</span>
                  <span class="t-txt">{etape}</span>
                  <span class="t-etat" aria-hidden="true">
                    <svg class="t-hp" viewBox="0 0 24 24">
                      <path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4ZM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6Z" />
                    </svg>
                    <svg class="t-ok" viewBox="0 0 24 24">
                      <path d={ICONE_OK} />
                    </svg>
                  </span>
                  <span class="t-lu" aria-hidden="true" />
                </li>
              ))}
            </ol>
            <p class="t-pied" data-t={s(tab.pied)}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4Z" />
              </svg>
              {ecran.pied}
            </p>
          </div>
        </div>
      </div>
    </div>
  )
}

{
  ecran.appareil === 'telephone' && tel && (
    <div class="ecr telephone" data-duree={s(tel.duree)}>
      <div class="p-tel">
        <div class="p-ecran">
          <header class="p-barre">
            <Image src={avatar} alt="" width={36} height={36} densities={[1, 2]} class="p-av" />
            <div>
              <b>{ecran.contact}</b>
              <span>{ecran.statut}</span>
            </div>
          </header>
          <div class="p-fil">
            {tel.fil.map((b) =>
              'quiz' in b.item ? (
                <div class="p-ligne" data-t={s(b.t)} data-c={s(b.choix ?? b.t)}>
                  <div class="p-quiz">
                    <p>{b.item.quiz.question}</p>
                    <ul>
                      {b.item.quiz.options.map((o, j) =>
                        'quiz' in b.item && j === b.item.quiz.bonne ? (
                          <li class="bonne">
                            <span class="p-teinte" aria-hidden="true" />
                            <span>{o}</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d={ICONE_OK} />
                            </svg>
                            <span class="p-doigt" aria-hidden="true" />
                          </li>
                        ) : (
                          <li>
                            <span>{o}</span>
                          </li>
                        ),
                      )}
                    </ul>
                  </div>
                </div>
              ) : (
                <>
                  {b.frappe !== undefined && (
                    <div class="p-ligne p-frappe" data-t={s(b.frappe)} aria-hidden="true">
                      <div>
                        <span />
                        <span />
                        <span />
                      </div>
                    </div>
                  )}
                  <div class:list={['p-ligne', b.item.de]} data-t={s(b.t)}>
                    <div class="p-msg">{b.item.texte}</div>
                  </div>
                </>
              ),
            )}
          </div>
        </div>
        <Image src={cadre} alt="" widths={[300, 600]} sizes="300px" class="p-cadre" />
      </div>
      <div class="p-suivi" data-t={s(tel.suivi)}>
        <span class="p-coche" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d={ICONE_OK} />
          </svg>
        </span>
        <span>
          <b>{ecran.suivi.titre}</b>
          {ecran.suivi.texte}
        </span>
      </div>
    </div>
  )
}

<style>
  /* ---------- Tablet (Owl) ---------- */
  .tablette {
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 2.4cqw;
    border-radius: 4.5cqw;
    background: var(--color-night);
    box-shadow:
      var(--shadow-3),
      inset 0 0 0 0.4cqw var(--color-line-night);
  }
  .t-ecran {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 2.4cqw;
    background: var(--color-cream);
    font: 500 2.7cqw/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .t-barre {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.8cqw 2.4cqw;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .t-barre :global(.t-av) {
    width: 4.6cqw;
    height: 4.6cqw;
    border-radius: 999px;
  }
  .t-direct {
    display: flex;
    align-items: center;
    gap: 1cqw;
    margin-left: auto;
    font-size: 2.3cqw;
    color: var(--color-soft);
  }
  .t-rec {
    width: 1.4cqw;
    height: 1.4cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  /* The two statuses share one cell; the timeline swaps them. Final state: reading. */
  .t-statuts {
    display: grid;
    justify-items: end;
  }
  .t-statuts > * {
    grid-area: 1 / 1;
  }
  .t-ecoute {
    opacity: 0;
  }
  .t-corps {
    display: grid;
    grid-template-columns: 38% 1fr;
    flex: 1;
    min-height: 0;
  }
  .t-gauche {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.4cqw;
    padding: 3cqw 2.4cqw;
    border-right: 1px solid var(--color-line);
    text-align: center;
  }
  .t-micro {
    position: relative;
    display: grid;
    place-items: center;
    width: 11cqw;
    height: 11cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .t-micro svg {
    position: relative;
    width: 5.4cqw;
    fill: var(--color-ink);
  }
  .t-anneau {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 0.5cqw solid var(--color-orange);
    opacity: 0;
  }
  .t-onde {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    height: 6cqw;
  }
  .t-onde span {
    width: 0.8cqw;
    height: 100%;
    border-radius: 999px;
    background: var(--color-copper);
    transform: scaleY(0.12);
  }
  .t-question {
    font: 600 3.1cqw/1.3 var(--font-sans);
    text-wrap: balance;
  }
  .t-mot {
    display: inline-block;
  }
  .t-droite {
    display: flex;
    flex-direction: column;
    padding: 2.6cqw 3cqw;
  }
  .t-fiche {
    font: 700 3.6cqw/1.15 var(--font-display);
  }
  .t-source {
    align-self: flex-start;
    margin-top: 1cqw;
    padding: 0.4cqw 1.2cqw;
    border-radius: 999px;
    background: var(--color-sand);
    font: 400 1.9cqw/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-soft);
  }
  .t-etapes {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
    margin-top: 2.2cqw;
  }
  .t-etapes li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.3cqw 1.6cqw;
    overflow: hidden;
    border-radius: 1.6cqw;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  /* The step being read: tinted, with a reading bar along its bottom edge. */
  .t-surligne {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--color-orange);
    background: var(--color-orange-tint);
    opacity: 0;
  }
  .t-lu {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0.5cqw;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
  }
  .t-num {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 3.6cqw;
    height: 3.6cqw;
    border-radius: 999px;
    background: var(--color-ink);
    font: 700 2cqw/1 var(--font-sans);
    color: var(--color-white);
  }
  .t-txt {
    position: relative;
    flex: 1;
  }
  .t-etat {
    position: relative;
    display: grid;
    flex: none;
    width: 3cqw;
  }
  .t-etat svg {
    grid-area: 1 / 1;
    width: 100%;
  }
  .t-hp {
    fill: var(--color-orange-txt);
    opacity: 0;
  }
  .t-ok {
    fill: var(--color-success-txt);
  }
  .t-pied {
    display: flex;
    align-items: center;
    gap: 1cqw;
    margin-top: auto;
    font-size: 2.3cqw;
    color: var(--color-soft);
  }
  .t-pied svg {
    width: 2.8cqw;
    fill: currentColor;
  }

  /* ---------- Phone (Pecker): Probleme's iPhone frame, screen inset measured on it ---------- */
  .telephone {
    position: relative;
    width: 100%;
  }
  .p-tel {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 805 / 1600;
    filter: drop-shadow(0 30px 40px color-mix(in srgb, var(--color-black) 35%, transparent));
  }
  .p-tel :global(.p-cadre) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .p-ecran {
    position: absolute;
    left: 5.21%;
    top: 2.25%;
    width: 89.58%;
    height: 95.38%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12.4cqw;
    background: var(--color-cream-2);
    font: 500 4.5cqw/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .p-barre {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 13cqw 5cqw 3cqw;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .p-barre :global(.p-av) {
    width: 9cqw;
    height: 9cqw;
    border-radius: 999px;
    background: var(--color-cream);
  }
  .p-barre div {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .p-barre span {
    font-size: 3.6cqw;
    color: var(--color-soft);
  }
  .p-fil {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 0 4cqw 7cqw;
  }
  /* One line of the thread. The timeline grows its height from zero so it pushes the thread up;
     the padding gives the bubble's shadow room inside the clipped box. */
  .p-ligne {
    display: flex;
    flex-direction: column;
    flex: none;
    margin-inline: -2cqw;
    padding: 2.6cqw 2cqw 1cqw;
    margin-bottom: -1cqw;
    overflow: hidden;
  }
  .p-msg {
    max-width: 82%;
    padding: 2.4cqw 3.4cqw;
    border-radius: 4cqw;
  }
  .agent .p-msg {
    align-self: flex-start;
    border-bottom-left-radius: 1cqw;
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    transform-origin: 0 100%;
  }
  .equipe .p-msg {
    align-self: flex-end;
    border-bottom-right-radius: 1cqw;
    background: var(--color-whatsapp);
    transform-origin: 100% 100%;
  }
  /* Typing indicator: closed in the final state, the timeline opens then closes it. */
  .p-frappe {
    height: 0;
    padding-block: 0;
  }
  .p-frappe > div {
    align-self: flex-start;
    display: flex;
    gap: 1.4cqw;
    margin-top: 2.6cqw;
    padding: 3.2cqw 3.4cqw;
    border-radius: 4cqw;
    background: var(--color-surface);
  }
  .p-frappe span {
    width: 1.8cqw;
    height: 1.8cqw;
    border-radius: 999px;
    background: var(--color-muted);
  }
  .p-quiz {
    padding: 0 3.4cqw;
    border-radius: 4cqw;
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    transform-origin: 0 100%;
  }
  .p-quiz p {
    padding-top: 3cqw;
    font-weight: 600;
  }
  .p-quiz ul {
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 2.4cqw 0 3.4cqw;
  }
  .p-quiz li {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
    padding: 2cqw 2.8cqw;
    border-radius: 2.6cqw;
    border: 1px solid var(--color-line);
    font-size: 4cqw;
  }
  .p-quiz li > * {
    position: relative;
  }
  .p-quiz li > .p-teinte {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--color-orange);
    background: var(--color-orange-tint);
  }
  .p-quiz svg {
    width: 4.4cqw;
    fill: var(--color-success-txt);
  }
  /* A fingertip, only seen during the tap. */
  .p-quiz li > .p-doigt {
    position: absolute;
    left: 58%;
    top: 50%;
    width: 9cqw;
    height: 9cqw;
    margin: -4.5cqw 0 0 -4.5cqw;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 22%, transparent);
    box-shadow: 0 0 0 0.6cqw color-mix(in srgb, var(--color-white) 70%, transparent);
    opacity: 0;
  }
  /* Beside the phone (over the scene); on phones, over the phone's bottom edge so it stays on screen. */
  .p-suivi {
    position: absolute;
    right: calc(100% + 12px);
    bottom: 5%;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: max-content;
    max-width: 260px;
    padding: 12px 14px;
    border-radius: var(--radius-glass);
    background: var(--color-surface);
    box-shadow: var(--shadow-3);
    font: 500 13px/1.4 var(--font-sans);
    color: var(--color-ink);
  }
  .p-suivi b {
    display: block;
    font: 400 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  @media (max-width: 47.99rem) {
    .p-suivi {
      right: auto;
      left: -14%;
      bottom: 2%;
      max-width: 230px;
    }
  }
  .p-coche {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--color-orange-tint);
  }
  .p-coche svg {
    width: 16px;
    fill: var(--color-success-txt);
  }
</style>
