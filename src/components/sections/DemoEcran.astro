---
/**
 * Animated device mock-up of an agent demo (pilot, kitchen, César 01/10): a kitchen tablet (Owl) or a
 * phone (Pecker). Every element appears at its beat (`--t`, from demo-ecran.ts) once the root gets
 * `.joue`; removing and re-adding `.joue` replays it. `.fige` (reduced motion) and the no-JS page show
 * the final state. `.pause` on an ancestor freezes it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EcranTablette, EcranTelephone } from '../../content/schemas/demo';
import cadre from '../../assets/probleme/iphone-cadre.png';
import { chronoTablette, chronoTelephone } from './demo-ecran';

interface Props {
  ecran: EcranTablette | EcranTelephone;
  avatar: ImageMetadata;
}
const { ecran, avatar } = Astro.props;
const s = (t: number) => `${t.toFixed(2)}s`;
const tab = ecran.appareil === 'tablette' ? chronoTablette(ecran) : null;
const tel = ecran.appareil === 'telephone' ? chronoTelephone(ecran) : null;
/** Waveform bars while the question is spoken. */
const BARRES = 14;
---

{
  ecran.appareil === 'tablette' && tab && (
    <div
      class="ecr tablette"
      style={`--d:${s(tab.parEtape)};--n-micro:${Math.ceil(tab.ecoute / 1.1)};--n-onde:${2 * Math.round(tab.ecoute / 0.84)}`}
    >
      <div class="t-ecran">
        <header class="t-barre">
          <Image src={avatar} alt="" width={32} height={32} densities={[1, 2]} class="t-av" />
          <b>{ecran.entete}</b>
          <span class="t-direct">
            <span class="t-rec" aria-hidden="true" />
            {ecran.ecoute}
          </span>
        </header>
        <div class="t-corps">
          <div class="t-gauche">
            <div class="t-micro" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 15a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v7a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-2.1a7 7 0 0 0 6-6.9h-2Z" />
              </svg>
            </div>
            <div class="t-onde" aria-hidden="true">
              {Array.from({ length: BARRES }, (_, i) => (
                <span style={`--i:${i};--h:${0.35 + 0.65 * Math.abs(Math.sin(i * 1.7))}`} />
              ))}
            </div>
            <p class="t-question">
              {tab.mots.map(({ m, t }) => (
                <span class="e" style={`--t:${s(t)}`}>
                  {m}{' '}
                </span>
              ))}
            </p>
          </div>
          <div class="t-droite e" style={`--t:${s(tab.reponse)}`}>
            <p class="t-fiche">{ecran.fiche}</p>
            <p class="t-source">{ecran.source}</p>
            <ol class="t-etapes">
              {ecran.etapes.map((etape, i) => (
                <li class="e lit" style={`--t:${s(tab.etapes[i])}`}>
                  <span class="t-num">{i + 1}</span>
                  <span class="t-txt">{etape}</span>
                  <svg class="t-hp" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4ZM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6Z" />
                  </svg>
                  <svg class="t-ok" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
                  </svg>
                </li>
              ))}
            </ol>
            <p class="t-pied e" style={`--t:${s(tab.pied)}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4Z" />
              </svg>
              {ecran.pied}
            </p>
          </div>
        </div>
      </div>
    </div>
  )
}

{
  ecran.appareil === 'telephone' && tel && (
    <div class="ecr telephone" style={`--frappe:${s(tel.frappe)}`}>
      <div class="p-tel">
        <div class="p-ecran">
          <header class="p-barre">
            <Image src={avatar} alt="" width={36} height={36} densities={[1, 2]} class="p-av" />
            <div>
              <b>{ecran.contact}</b>
              <span>{ecran.statut}</span>
            </div>
          </header>
          <div class="p-fil">
            {tel.fil.map((b) =>
              'quiz' in b.item ? (
                <div class="p-quiz pousse" style={`--t:${s(b.t)};--c:${s(b.choix ?? b.t)}`}>
                  <p>{b.item.quiz.question}</p>
                  <ul>
                    {b.item.quiz.options.map((o, j) => (
                      <li class:list={{ bonne: 'quiz' in b.item && j === b.item.quiz.bonne }}>
                        <span>{o}</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
                        </svg>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <>
                  {b.frappe !== undefined && (
                    <div class="p-frappe" style={`--t:${s(b.frappe)}`} aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </div>
                  )}
                  <div class:list={['p-msg pousse', b.item.de]} style={`--t:${s(b.t)}`}>
                    {b.item.texte}
                  </div>
                </>
              ),
            )}
          </div>
        </div>
        <Image src={cadre} alt="" widths={[300, 600]} sizes="300px" class="p-cadre" />
      </div>
      <div class="p-suivi e" style={`--t:${s(tel.suivi)}`}>
        <span class="p-coche" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z" />
          </svg>
        </span>
        <span>
          <b>{ecran.suivi.titre}</b>
          {ecran.suivi.texte}
        </span>
      </div>
    </div>
  )
}

<style>
  /* ---------- Beats ---------- */
  .e {
    opacity: 0;
    translate: 0 6px;
  }
  .joue .e {
    animation: ecr-entre 0.45s var(--ease-hatch) var(--t) both;
  }
  @keyframes ecr-entre {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  :global(.pause) .ecr *,
  :global(.pause) .ecr *::after {
    animation-play-state: paused !important;
  }

  /* ---------- Tablet (Owl) ---------- */
  .tablette {
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 2.4cqw;
    border-radius: 4.5cqw;
    background: var(--color-night);
    box-shadow:
      var(--shadow-3),
      inset 0 0 0 0.4cqw var(--color-line-night);
  }
  .t-ecran {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 2.4cqw;
    background: var(--color-cream);
    font: 500 2.7cqw/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .t-barre {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.8cqw 2.4cqw;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .t-barre :global(.t-av) {
    width: 4.6cqw;
    height: 4.6cqw;
    border-radius: 999px;
  }
  .t-direct {
    display: flex;
    align-items: center;
    gap: 1cqw;
    margin-left: auto;
    font-size: 2.3cqw;
    color: var(--color-soft);
  }
  .t-rec {
    width: 1.4cqw;
    height: 1.4cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .joue .t-rec {
    animation: t-clignote 0.9s ease-in-out infinite alternate;
  }
  @keyframes t-clignote {
    to {
      opacity: 0.25;
    }
  }
  .t-corps {
    display: grid;
    grid-template-columns: 38% 1fr;
    flex: 1;
    min-height: 0;
  }
  .t-gauche {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.4cqw;
    padding: 3cqw 2.4cqw;
    border-right: 1px solid var(--color-line);
    text-align: center;
  }
  .t-micro {
    position: relative;
    display: grid;
    place-items: center;
    width: 11cqw;
    height: 11cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .t-micro svg {
    width: 5.4cqw;
    fill: var(--color-ink);
  }
  .t-micro::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 0.5cqw solid var(--color-orange);
    opacity: 0;
  }
  .joue .t-micro::after {
    animation: t-ondule 1.1s ease-out 0.6s var(--n-micro) both;
  }
  @keyframes t-ondule {
    from {
      scale: 1;
      opacity: 0.8;
    }
    to {
      scale: 1.7;
      opacity: 0;
    }
  }
  .t-onde {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    height: 6cqw;
  }
  .t-onde span {
    width: 0.8cqw;
    height: 100%;
    border-radius: 999px;
    background: var(--color-copper);
    scale: 1 0.12;
  }
  .joue .t-onde span {
    animation: t-onde 0.42s ease-in-out calc(0.8s + var(--i) * 0.04s) var(--n-onde) alternate;
  }
  @keyframes t-onde {
    to {
      scale: 1 var(--h);
    }
  }
  .t-question {
    font: 600 3.1cqw/1.3 var(--font-sans);
    text-wrap: balance;
  }
  .t-droite {
    display: flex;
    flex-direction: column;
    padding: 2.6cqw 3cqw;
  }
  .t-fiche {
    font: 700 3.6cqw/1.15 var(--font-display);
  }
  .t-source {
    align-self: flex-start;
    margin-top: 1cqw;
    padding: 0.4cqw 1.2cqw;
    border-radius: 999px;
    background: var(--color-sand);
    font: 400 1.9cqw/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-soft);
  }
  .t-etapes {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
    margin-top: 2.2cqw;
  }
  .t-etapes li {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.3cqw 1.6cqw;
    border-radius: 1.6cqw;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .joue .lit {
    animation:
      ecr-entre 0.45s var(--ease-hatch) var(--t) both,
      t-lit var(--d) linear var(--t) both;
  }
  @keyframes t-lit {
    0%,
    88% {
      border-color: var(--color-orange);
      background: var(--color-orange-tint);
    }
  }
  .t-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.6cqw;
    height: 3.6cqw;
    border-radius: 999px;
    background: var(--color-ink);
    font: 700 2cqw/1 var(--font-sans);
    color: var(--color-white);
  }
  .t-txt {
    flex: 1;
  }
  .t-hp,
  .t-ok {
    flex: none;
    width: 3cqw;
    opacity: 0;
  }
  .t-hp {
    fill: var(--color-orange-txt);
  }
  .t-ok {
    margin-left: -4.6cqw;
    fill: var(--color-success-txt);
  }
  .joue .t-hp {
    animation: t-parle var(--d) linear var(--t) both;
  }
  @keyframes t-parle {
    0%,
    86% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .joue .t-ok {
    animation: ecr-entre 0.3s var(--ease-hatch) calc(var(--t) + var(--d) * 0.88) both;
  }
  .t-pied {
    display: flex;
    align-items: center;
    gap: 1cqw;
    margin-top: auto;
    font-size: 2.3cqw;
    color: var(--color-soft);
  }
  .t-pied svg {
    width: 2.8cqw;
    fill: currentColor;
  }

  /* ---------- Phone (Pecker): Probleme's iPhone frame, screen inset measured on it ---------- */
  .telephone {
    position: relative;
    width: 100%;
  }
  .p-tel {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 805 / 1600;
    filter: drop-shadow(0 30px 40px color-mix(in srgb, var(--color-black) 35%, transparent));
  }
  .p-tel :global(.p-cadre) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .p-ecran {
    position: absolute;
    left: 5.21%;
    top: 2.25%;
    width: 89.58%;
    height: 95.38%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12.4cqw;
    background: var(--color-cream-2);
    font: 500 4.5cqw/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .p-barre {
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 13cqw 5cqw 3cqw;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .p-barre :global(.p-av) {
    width: 9cqw;
    height: 9cqw;
    border-radius: 999px;
    background: var(--color-cream);
  }
  .p-barre div {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .p-barre span {
    font-size: 3.6cqw;
    color: var(--color-soft);
  }
  .p-fil {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 0 4cqw 7cqw;
  }
  /* Messages push the thread up as they arrive: they grow from zero height. */
  .pousse,
  .p-frappe {
    flex: none;
    max-height: 0;
    margin-top: 0;
    opacity: 0;
    overflow: hidden;
  }
  .joue .pousse {
    animation: p-pousse 0.5s var(--ease-hatch) var(--t) both;
  }
  @keyframes p-pousse {
    to {
      max-height: 120cqw;
      margin-top: 2.6cqw;
      opacity: 1;
    }
  }
  .p-msg {
    max-width: 82%;
    padding: 2.4cqw 3.4cqw;
    border-radius: 4cqw;
  }
  .p-msg.agent {
    align-self: flex-start;
    border-bottom-left-radius: 1cqw;
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }
  .p-msg.equipe {
    align-self: flex-end;
    border-bottom-right-radius: 1cqw;
    background: var(--color-whatsapp);
  }
  .p-frappe {
    align-self: flex-start;
    display: flex;
    gap: 1.4cqw;
    padding: 0 3.4cqw;
    border-radius: 4cqw;
    background: var(--color-surface);
  }
  .joue .p-frappe {
    animation: p-frappe var(--frappe) linear var(--t) both;
  }
  @keyframes p-frappe {
    0% {
      max-height: 0;
      margin-top: 0;
      padding-block: 0;
      opacity: 0;
    }
    20%,
    80% {
      max-height: 20cqw;
      margin-top: 2.6cqw;
      padding-block: 3.2cqw;
      opacity: 1;
    }
    100% {
      max-height: 0;
      margin-top: 0;
      padding-block: 0;
      opacity: 0;
    }
  }
  .p-frappe span {
    width: 1.8cqw;
    height: 1.8cqw;
    border-radius: 999px;
    background: var(--color-muted);
  }
  .joue .p-frappe span {
    animation: p-point 0.6s ease-in-out infinite alternate;
  }
  .p-frappe span:nth-child(2) {
    animation-delay: 0.15s !important;
  }
  .p-frappe span:nth-child(3) {
    animation-delay: 0.3s !important;
  }
  @keyframes p-point {
    to {
      translate: 0 -0.8cqw;
      opacity: 0.4;
    }
  }
  .p-quiz {
    align-self: stretch;
    padding: 0 3.4cqw;
    border-radius: 4cqw;
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }
  .p-quiz p {
    padding-top: 3cqw;
    font-weight: 600;
  }
  .p-quiz ul {
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 2.4cqw 0 3.4cqw;
  }
  .p-quiz li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
    padding: 2cqw 2.8cqw;
    border-radius: 2.6cqw;
    border: 1px solid var(--color-line);
    font-size: 4cqw;
  }
  .p-quiz svg {
    width: 4.4cqw;
    fill: var(--color-success-txt);
    opacity: 0;
  }
  .joue .p-quiz li.bonne {
    animation: p-choix 0.35s var(--ease-hatch) var(--c) both;
  }
  .joue .p-quiz li.bonne svg {
    animation: ecr-entre 0.3s var(--ease-hatch) calc(var(--c) + 0.25s) both;
  }
  @keyframes p-choix {
    to {
      border-color: var(--color-orange);
      background: var(--color-orange-tint);
    }
  }
  /* Beside the phone (over the scene); on phones, over the phone's bottom edge so it stays on screen. */
  .p-suivi {
    position: absolute;
    right: calc(100% + 12px);
    bottom: 5%;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: max-content;
    max-width: 260px;
    padding: 12px 14px;
    border-radius: var(--radius-glass);
    background: var(--color-surface);
    box-shadow: var(--shadow-3);
    font: 500 13px/1.4 var(--font-sans);
    color: var(--color-ink);
  }
  .p-suivi b {
    display: block;
    font: 400 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }
  @media (max-width: 47.99rem) {
    .p-suivi {
      right: auto;
      left: -14%;
      bottom: 2%;
      max-width: 230px;
    }
  }
  .p-coche {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--color-orange-tint);
  }
  .p-coche svg {
    width: 16px;
    fill: var(--color-success-txt);
  }

  /* ---------- Final state: reduced motion, or no JS ---------- */
  :is(.fige, :global(.d2:not(.js)) .ecr) :is(.e, .pousse) {
    animation: none !important;
    opacity: 1;
    translate: none;
  }
  :is(.fige, :global(.d2:not(.js)) .ecr) .pousse {
    max-height: none;
    margin-top: 2.6cqw;
  }
  :is(.fige, :global(.d2:not(.js)) .ecr) .p-frappe {
    display: none;
  }
  :is(.fige, :global(.d2:not(.js)) .ecr) :is(.t-ok, .p-quiz svg) {
    animation: none !important;
    opacity: 1;
  }
  :is(.fige, :global(.d2:not(.js)) .ecr) .p-quiz li.bonne {
    border-color: var(--color-orange);
    background: var(--color-orange-tint);
  }
</style>
