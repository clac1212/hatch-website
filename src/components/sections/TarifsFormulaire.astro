---
import { section } from '../../content/section';
import { routes, useTranslations, type Locale } from '../../i18n/ui';
import peep from '../../assets/portraits/peep.jpg';
import owl from '../../assets/portraits/owl.jpg';
import jay from '../../assets/portraits/jay.jpg';
import lark from '../../assets/portraits/lark.jpg';
import finch from '../../assets/portraits/finch.jpg';
import pecker from '../../assets/portraits/pecker.jpg';
import sparrow from '../../assets/portraits/sparrow.jpg';

/**
 * Pricing as a form: pick agents, describe the network, leave contact details. On submit, the
 * answers are summarised into `{ name, email, notes }` in sessionStorage ('hatch-demo') and the
 * visitor goes to /demo, which prefills the Cal.com booking with them. Nothing is ever posted and
 * no personal data goes in the URL. Without JS the submit button stays hidden and a plain link to
 * /demo replaces it.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = await section('tarifsFormulaire', locale);
const t = useTranslations(locale);
const demo = routes.demo[locale];

/** Each agent faces us in a circle; when checked, it plays its job's gesture. */
const portraits = { peep, owl, jay, lark, finch, pecker, sparrow };

/** Strings the validation and submit script needs. */
const textes = JSON.stringify({ reste: c.reste, notes: c.notes });
---

<section id="tarifs" class="bg-cream pt-16 pb-20 lg:pt-20 lg:pb-28">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
    <div class="mx-auto mb-10 flex max-w-[760px] flex-col items-center gap-4 text-center lg:mb-14">
      <h2
        class="font-display text-[36px] leading-[1.06] font-semibold tracking-[-0.02em] text-ink lg:text-[54px]"
      >
        {c.titre}
      </h2>
      <p class="text-[16px] leading-7 text-soft lg:text-[17px]">
        {c.intro}
      </p>
    </div>

    <div
      class="grid grid-cols-[minmax(0,1fr)] items-start gap-5 lg:grid-cols-[minmax(0,1fr)_340px]"
    >
      <!-- method="dialog" outside a <dialog> never navigates: a safety net so the form cannot post anywhere. -->
      <form
        data-tarifs
        data-demo={demo}
        data-textes={textes}
        method="dialog"
        novalidate
        class="flex min-w-0 flex-col gap-9 rounded-[28px] bg-surface p-6 shadow-1 ring-1 ring-line sm:p-8 lg:rounded-[36px] lg:p-10"
      >
        <!-- 1 · Agents -->
        <fieldset class="flex min-w-0 flex-col gap-4">
          <legend class="etape" data-etape="1"><span>1</span>{c.etapes.agents}</legend>
          <button
            type="button"
            class="anim-pause"
            data-anim-pause
            data-label-pause={c.pause.pause}
            data-label-reprendre={c.pause.reprendre}
            aria-pressed="false"
            hidden
          >
            <span class="ap-ico" aria-hidden="true"></span>
            <span data-anim-label>{c.pause.pause}</span>
          </button>
          <div class="grid gap-3 sm:grid-cols-3" data-equipe>
            {
              c.offres.map((o) => (
                <label class:list={['agent', o.id === 'socle' && 'socle sm:col-span-3']}>
                  <input
                    type="checkbox"
                    id={`a-${o.id}`}
                    name="agents"
                    value={o.id}
                    data-note={o.id === 'socle' ? c.notes.socle : o.nom}
                    checked={o.id === 'socle'}
                    class="sr-only"
                  />
                  <span class="troupe" aria-hidden="true">
                    {o.agents.map((ag, k) => (
                      <span class="membre" style={`--k:${k}`}>
                        <span class="rond">
                          <video
                            src={`/anim/${ag.id}-geste.mp4`}
                            poster={portraits[ag.id].src}
                            muted
                            playsinline
                            preload="none"
                          />
                        </span>
                        {o.id === 'socle' && (
                          <span class="membre-nom">
                            <b>{ag.nom}</b> {ag.role}
                          </span>
                        )}
                      </span>
                    ))}
                  </span>
                  <span class="flex flex-col gap-1">
                    {(o.id === 'finch' || o.id === 'pecker') && (
                      <span class="avec-socle">
                        <span aria-hidden="true">+</span> {c.avecSocle}
                      </span>
                    )}
                    <span class="flex flex-wrap items-baseline gap-x-3">
                      <b class="font-display text-[20px] text-ink">{o.nom}</b>
                      <span class="font-mono text-[11px] tracking-[0.14em] text-orange-txt uppercase">
                        {o.tag}
                      </span>
                    </span>
                    <span class="text-[14px] leading-5 text-soft">{o.texte}</span>
                    {o.id === 'socle' && (
                      <span class="requis" data-requis>
                        {c.requis}
                      </span>
                    )}
                  </span>
                  <span class="coche" aria-hidden="true">
                    ✓
                  </span>
                </label>
              ))
            }
          </div>
          <!-- Only shown when Sparrow is checked: this is what sets its price. -->
          <div class="ouvertures flex-col gap-3 rounded-2xl bg-surface-2 p-5 ring-1 ring-line">
            <span class="text-[14px] font-semibold text-ink">{c.ouvertures.question}</span>
            <div class="flex flex-wrap gap-2">
              {
                c.ouvertures.choix.map((v, i) => (
                  <label class="choix">
                    <input
                      type="radio"
                      name="ouvertures"
                      value={v}
                      checked={i === 1}
                      class="sr-only"
                    />
                    <span>{v}</span>
                  </label>
                ))
              }
            </div>
          </div>
        </fieldset>

        <!-- 2 · Network -->
        <fieldset class="flex min-w-0 flex-col gap-4">
          <legend class="etape" data-etape="2"><span>2</span>{c.etapes.reseau}</legend>
          <div class="grid gap-3 sm:grid-cols-[1fr_220px]">
            <label class="champ"
              ><span>{c.champs.enseigne.label}</span><input
                id="t-enseigne"
                name="enseigne"
                required
                data-e="2"
                placeholder={c.champs.enseigne.placeholder}
                autocomplete="organization"
              /></label
            >
            <label class="champ"
              ><span>{c.champs.etablissements.label}</span><input
                id="t-etablissements"
                name="etablissements"
                type="number"
                min="1"
                required
                data-e="2"
                placeholder={c.champs.etablissements.placeholder}
              /></label
            >
          </div>
        </fieldset>

        <!-- 3 · Contact -->
        <fieldset class="flex min-w-0 flex-col gap-4">
          <legend class="etape" data-etape="3"><span>3</span>{c.etapes.contact}</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="champ"
              ><span>{c.champs.nom.label}</span><input
                id="t-nom"
                name="nom"
                required
                data-e="3"
                placeholder={c.champs.nom.placeholder}
                autocomplete="name"
              /></label
            >
            <label class="champ"
              ><span>{c.champs.role.label}</span><input
                id="t-role"
                name="role"
                required
                data-e="3"
                placeholder={c.champs.role.placeholder}
                autocomplete="organization-title"
              /></label
            >
            <label class="champ"
              ><span>{c.champs.email.label}</span><input
                id="t-email"
                name="email"
                type="email"
                required
                data-e="3"
                placeholder={c.champs.email.placeholder}
                autocomplete="email"
              /></label
            >
            <label class="champ"
              ><span>{c.champs.telephone.label}</span><input
                id="t-tel"
                name="telephone"
                type="tel"
                required
                data-e="3"
                placeholder={c.champs.telephone.placeholder}
                autocomplete="tel"
              /></label
            >
          </div>
          <label class="decide">
            <input type="checkbox" name="decisionnaire" class="sr-only" />
            <span class="decide-case" aria-hidden="true">✓</span>
            <span>{c.decisionnaire}</span>
          </label>
        </fieldset>

        <div
          class="flex flex-col items-start gap-3 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between"
        >
          <p class="max-w-[380px] text-[13.5px] leading-5 text-soft" data-reste aria-live="polite">
            {c.reste.initial}
          </p>
          <!-- Hidden until the script runs: without JS, the link below takes its place. -->
          <button
            type="submit"
            data-envoi
            hidden
            class="envoi btn-vif inline-flex items-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink shadow-[0_10px_24px_rgb(248_122_1/0.4)]"
          >
            {c.envoi}
            <span aria-hidden="true">→</span>
          </button>
          <noscript>
            <a
              href={demo}
              class="envoi btn-vif inline-flex items-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink shadow-[0_10px_24px_rgb(248_122_1/0.4)]"
            >
              {t('cta.demo')}
              <span aria-hidden="true">→</span>
            </a>
          </noscript>
        </div>
      </form>

      <!-- How it works -->
      <aside
        class="flex flex-col gap-6 rounded-[28px] bg-night p-7 text-cream lg:sticky lg:top-28 lg:rounded-[36px] lg:p-8"
      >
        <span class="font-mono text-[12px] tracking-[0.16em] text-peach uppercase"
          >{c.deroule.kicker}</span
        >
        <ol class="flex flex-col gap-5">
          {
            c.deroule.etapes.map(({ titre, texte }, i) => (
              <li class="flex gap-4">
                <span class="flex size-8 flex-none items-center justify-center rounded-full bg-orange font-mono text-[13px] text-ink">
                  {i + 1}
                </span>
                <span class="flex flex-col gap-1">
                  <b class="text-[15px]">{titre}</b>
                  <span class="text-[13.5px] leading-5 text-cream/70">{texte}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="border-t border-line-night pt-5 text-[13px] leading-5 text-cream/70">
          {c.deroule.mention}
        </p>
      </aside>
    </div>
  </div>
</section>
<script is:inline data-keep>
  // All three steps are required: at least one agent, the brand and its size, contact details
  // (the decision-maker box is optional). While something is missing, the button is inactive and the
  // line next to it says what's left; each completed step turns its badge into a check. Once
  // everything is valid, submitting stores a summary for the booking page and goes there.
  (function () {
    var form = document.querySelector('[data-tarifs]');
    if (!form) return;
    var bouton = form.querySelector('[data-envoi]');
    var reste = form.querySelector('[data-reste]');
    var textes = JSON.parse(form.getAttribute('data-textes'));
    var r = textes.reste;
    var notes = textes.notes;
    var noms = { 1: r.noms.agents, 2: r.noms.reseau, 3: r.noms.contact };
    bouton.hidden = false;
    function ok(e) {
      if (e === 1) return !!form.querySelector('input[name="agents"]:checked');
      return [].slice.call(form.querySelectorAll('[data-e="' + e + '"]')).every(function (i) {
        return i.value.trim() !== '' && i.checkValidity();
      });
    }
    function regler() {
      var manque = [];
      [1, 2, 3].forEach(function (e) {
        var bon = ok(e);
        form.querySelector('[data-etape="' + e + '"]').classList.toggle('faite', bon);
        if (!bon) manque.push(e);
      });
      var pret = manque.length === 0;
      bouton.setAttribute('aria-disabled', pret ? 'false' : 'true');
      reste.textContent = pret
        ? r.pret
        : r.manque +
          ' ' +
          manque
            .map(function (e) {
              return noms[e] + ' (' + r.etape + ' ' + e + ')';
            })
            .join(', ') +
          '.';
    }
    function valeur(id) {
      return document.getElementById(id).value.trim();
    }
    // Short multi-line summary in the page language, attached to the booking by /demo.
    function resume() {
      var agents = [].slice
        .call(form.querySelectorAll('input[name="agents"]:checked'))
        .map(function (i) {
          return i.getAttribute('data-note');
        });
      var lignes = [notes.agents + ' ' + agents.join(', ')];
      var sparrow = document.getElementById('a-sparrow');
      var ouvertures = form.querySelector('input[name="ouvertures"]:checked');
      if (sparrow && sparrow.checked && ouvertures)
        lignes.push(notes.ouvertures + ' ' + ouvertures.value);
      lignes.push(notes.enseigne + ' ' + valeur('t-enseigne'));
      lignes.push(notes.etablissements + ' ' + valeur('t-etablissements'));
      lignes.push(notes.role + ' ' + valeur('t-role'));
      lignes.push(notes.telephone + ' ' + valeur('t-tel'));
      var decide = form.querySelector('input[name="decisionnaire"]').checked;
      lignes.push(notes.decisionnaire + ' ' + (decide ? notes.oui : notes.non));
      return lignes.join('\n');
    }
    form.addEventListener('input', regler);
    form.addEventListener('change', regler);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (bouton.getAttribute('aria-disabled') === 'true') {
        [].slice.call(form.querySelectorAll('[data-e]')).some(function (i) {
          if (i.value.trim() === '' || !i.checkValidity()) {
            i.focus();
            return true;
          }
          return false;
        });
        return;
      }
      // Personal data stays in this tab's sessionStorage, never in the URL.
      try {
        sessionStorage.setItem(
          'hatch-demo',
          JSON.stringify({ name: valeur('t-nom'), email: valeur('t-email'), notes: resume() }),
        );
      } catch (err) {
        // Storage unavailable (private mode, blocked): the booking page simply starts empty.
      }
      location.href = form.getAttribute('data-demo');
    });
    regler();
  })();
</script>
<script is:inline data-keep>
  // The Core is required for Finch or Pecker: as soon as either is checked, the Core gets checked
  // and locked (it can't be unchecked); it unlocks when neither is checked.
  (function () {
    var socle = document.getElementById('a-socle');
    if (!socle) return;
    var lies = ['a-finch', 'a-pecker']
      .map(function (id) {
        return document.getElementById(id);
      })
      .filter(Boolean);
    var carte = socle.closest('.agent');
    function regler() {
      var verrou = lies.some(function (i) {
        return i.checked;
      });
      if (verrou && !socle.checked) {
        socle.checked = true;
        socle.dispatchEvent(new Event('change'));
      }
      carte.classList.toggle('verrou', verrou);
      socle.setAttribute('aria-disabled', verrou ? 'true' : 'false');
    }
    socle.addEventListener('click', function (e) {
      if (carte.classList.contains('verrou')) e.preventDefault();
    });
    lies.forEach(function (i) {
      i.addEventListener('change', regler);
    });
    regler();
  })();
</script>
<script is:inline data-keep>
  // The team feels alive: checking (or hovering) an agent plays its job gesture, then each checked
  // agent repeats it now and then at its own pace (6 to 10 s), so the chosen team moves and the others
  // stay still. Since it loops, a button pauses everything (WCAG 2.2.2). Reduced motion: no gesture, no button.
  (function () {
    var root = document.querySelector('[data-equipe]');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var bouton = document.querySelector('[data-anim-pause]');
    var label = document.querySelector('[data-anim-label]');
    var pause = false;
    var cartes = [].slice.call(root.querySelectorAll('.agent'));
    var n = 0;
    function jouer(v) {
      if (pause) return;
      clearTimeout(v._t);
      v.currentTime = 0;
      v.play().catch(function () {});
    }
    function geste(carte) {
      [].slice.call(carte.querySelectorAll('video')).forEach(function (v, k) {
        clearTimeout(v._t);
        v._t = setTimeout(function () {
          jouer(v);
        }, k * 220);
      });
    }
    cartes.forEach(function (carte) {
      var input = carte.querySelector('input');
      [].slice.call(carte.querySelectorAll('video')).forEach(function (v) {
        var rythme = 6000 + (n++ % 5) * 900;
        // Gesture ended: if checked, the agent will do it again a bit later.
        v.addEventListener('ended', function () {
          clearTimeout(v._t);
          if (!input.checked || pause) return;
          v._t = setTimeout(
            function () {
              if (input.checked) jouer(v);
            },
            rythme + Math.random() * 1500,
          );
        });
      });
      input.addEventListener('change', function () {
        if (input.checked) geste(carte);
      });
      carte.addEventListener('mouseenter', function () {
        geste(carte);
      });
    });
    if (bouton) {
      bouton.hidden = false;
      bouton.addEventListener('click', function () {
        pause = !pause;
        bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
        label.textContent = bouton.getAttribute(
          pause ? 'data-label-reprendre' : 'data-label-pause',
        );
        cartes.forEach(function (carte) {
          [].slice.call(carte.querySelectorAll('video')).forEach(function (v) {
            clearTimeout(v._t);
            if (pause) v.pause();
          });
          if (!pause && carte.querySelector('input').checked) geste(carte);
        });
      });
    }
    // On arrival, the checked team waves once, then keeps moving on its own.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (e) {
          if (e[0].isIntersecting) {
            io.disconnect();
            cartes.forEach(function (c) {
              if (c.querySelector('input').checked) geste(c);
            });
          }
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    }
  })();
</script>
<style>
  .etape {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
  }
  /* Completed step: the badge turns orange with a check. */
  .etape.faite span {
    background: var(--color-orange);
    color: transparent;
    position: relative;
  }
  .etape.faite span::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-ink);
    font: 700 14px/1 var(--font-sans);
  }
  /* Button inactive until all three steps are complete. */
  .envoi[aria-disabled='true'] {
    background: var(--color-stone);
    box-shadow: none;
    color: var(--color-soft);
    cursor: not-allowed;
  }
  /* The submit button only exists with JS (the script reveals it). */
  .envoi[hidden] {
    display: none;
  }
  .etape span {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-cream);
    font: 400 13px var(--font-mono);
  }

  /* Selectable agent card: a real hidden checkbox, state shown on the card. Agents face us,
     each in a circle; when checked, they rise a little and wave. */
  .agent {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 18px 18px;
    border-radius: 20px;
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
    cursor: pointer;
    transition:
      box-shadow 0.2s,
      background 0.2s;
  }
  .agent:hover {
    box-shadow: inset 0 0 0 1px var(--color-stone);
  }
  .agent:has(input:checked) {
    background: var(--color-peach-2);
    box-shadow: inset 0 0 0 2px var(--color-orange);
  }
  .agent:has(input:focus-visible) {
    outline: 3px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .troupe {
    display: flex;
    gap: 18px;
  }
  .membre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .rond {
    display: block;
    width: 84px;
    height: 84px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-cream-2);
    box-shadow: 0 0 0 3px var(--color-surface);
    transition: translate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--k) * 60ms);
  }
  .rond video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .agent:has(input:checked) .rond {
    translate: 0 -4px;
  }
  .membre-nom {
    font-size: 12.5px;
    line-height: 1.25;
    text-align: center;
    color: var(--color-soft);
  }
  .membre-nom b {
    display: block;
    font-size: 14px;
    color: var(--color-ink);
  }
  /* The Core: the four in a row, text beside them on very wide screens, below otherwise. */
  .socle {
    gap: 18px;
  }
  @media (min-width: 80rem) {
    .socle {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      padding: 22px 56px 22px 24px;
    }
    .socle .troupe {
      flex: none;
    }
  }
  @media (max-width: 30rem) {
    /* Phone: the four of the core share the card width, names wrap under their circle. */
    .socle .troupe {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin-right: 30px; /* room for the check mark, top right */
    }
    .socle .membre {
      min-width: 0;
    }
    .socle .rond {
      width: 100%;
      max-width: 64px;
      height: auto;
      aspect-ratio: 1;
    }
    .socle .membre-nom {
      font-size: 11px;
      overflow-wrap: anywhere;
    }
    .socle .membre-nom b {
      font-size: 12.5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rond {
      transition: none;
    }
  }
  /* Discreet animation pause button, right-aligned above the grid. */
  .anim-pause {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-end;
    margin-top: -8px;
    padding: 6px 11px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    font: 600 12px/1 var(--font-sans);
    color: var(--color-soft);
    cursor: pointer;
  }
  .anim-pause[hidden] {
    display: none;
  }
  .anim-pause:hover,
  .anim-pause:focus-visible {
    color: var(--color-ink);
  }
  .anim-pause:focus-visible {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .ap-ico {
    width: 8px;
    height: 9px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .anim-pause[aria-pressed='true'] .ap-ico {
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-right: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }
  /* Finch and Pecker add to the Core; the locked Core says so. */
  .avec-socle {
