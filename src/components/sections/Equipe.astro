---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { section } from '../../content/section';
import { entryRoutes, type Locale } from '../../i18n/ui';
import peep from '../../assets/equipe/peep.jpg';
import finch from '../../assets/equipe/finch.jpg';
import owl from '../../assets/equipe/owl.jpg';
import jay from '../../assets/equipe/jay.jpg';
import pecker from '../../assets/equipe/pecker.jpg';
import lark from '../../assets/equipe/lark.jpg';
import sparrow from '../../assets/equipe/sparrow.jpg';
import { cadrage } from './equipe-cadrage';

/**
 * 05 — "Rencontrez vos nouveaux collègues" (v4 node W8OOQW): a 3-column mosaic of the seven agents.
 * The agents fill the mosaic slots by `order` (column 1: title + 2 tiles, column 2: 3 tiles, column 3: 2 tiles).
 * A tile links to /agents/<slug>, with its arrow, once the agent has a published `page`.
 * Below lg, the columns dissolve into a 2-column grid; tall tiles span both columns.
 * Hover (v4 "tuiles"): photo zooms, label rises, arrow turns orange, orange border — the border is an
 * ::after overlay, since an inset outline would be painted under the positioned photo.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('equipe', locale);

const photos: Record<string, ImageMetadata> = { peep, finch, owl, jay, pecker, lark, sparrow };

const agents = (await getCollection('agents', (e) => e.id.startsWith(`${locale}/`)))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => {
    const slug = e.id.slice(locale.length + 1);
    const photo = photos[slug];
    const cadre = cadrage[slug];
    if (!photo || !cadre) throw new Error(`No tile photo or framing for agent "${slug}"`);
    const [x0, y0, x1, y1] = cadre.sujet;
    const [o0, o1] = cadre.oiseau;
    const style = [
      `--sx:${x0}`,
      `--sy:${y0}`,
      `--sw:${x1 - x0}`,
      `--sh:${y1 - y0}`,
      `--ratio:${photo.height / photo.width}`,
      `--oiseau:${((o1 - o0) * photo.height) / photo.width}`,
      `background-color:${cadre.fond}`,
    ].join(';');
    return { slug, photo, style, ...e.data };
  });

/**
 * Mosaic slots of the v4, column by column. `size` = tile height at 1440 (537 / 403 / 302 px for a
 * 403 px column); `rd` = reveal rank, the prototype's cascade order (title first, then row by row).
 */
type Size = 'tall' | 'mid' | 'short';
const columns: { size: Size; rd: number }[][] = [
  [
    { size: 'tall', rd: 3 },
    { size: 'short', rd: 7 },
  ],
  [
    { size: 'mid', rd: 1 },
    { size: 'mid', rd: 4 },
    { size: 'short', rd: 6 },
  ],
  [
    { size: 'tall', rd: 2 },
    { size: 'tall', rd: 5 },
  ],
];
const slotCount = columns.flat().length;
if (agents.length !== slotCount) {
  throw new Error(`The agents mosaic has ${slotCount} slots, found ${agents.length} agents`);
}

// Desktop ratios = the v4 mosaic flattened to ~70-80 % of its height (César: keep the masonry, make it
// more compact), so the whole section fits in one screen at 1440 × 900.
const sizeClass: Record<Size, string> = {
  tall: 'col-span-2 aspect-[4/3] md:aspect-[16/10] lg:aspect-[403/376]',
  mid: 'aspect-square lg:aspect-[403/282]',
  short: 'aspect-square lg:aspect-[403/280]',
};
// The framed photo can be wider than its tile (it is sized on the subject, not on the tile).
const sizes: Record<Size, string> = {
  tall: '(min-width: 1024px) 520px, (min-width: 768px) 720px, 100vw',
  mid: '(min-width: 1024px) 460px, 60vw',
  short: '(min-width: 1024px) 420px, 60vw',
};

let next = 0;
const mosaic = columns.map((col) => col.map((slot) => ({ ...slot, agent: agents[next++]! })));
const pageHref = (slug: string) => entryRoutes.agents(slug)[locale];
---

<section id="agents" aria-labelledby="equipe-titre" class="bg-white" data-rv-groupe>
  <div class="section-y mx-auto max-w-[1216px] px-5 md:px-12">
    <div class="grid grid-cols-2 gap-3 md:gap-4 lg:flex lg:items-start">
      {
        mosaic.map((col, c) => (
          <div class="contents lg:flex lg:flex-1 lg:flex-col lg:gap-4">
            {c === 0 && (
              <div data-rv class="col-span-2 flex flex-col gap-3 pt-1 pr-2 pb-2 lg:pb-3">
                <h2
                  id="equipe-titre"
                  class="font-display text-[32px] leading-[1.08] font-bold tracking-[-1px] text-ink lg:text-[38px] lg:leading-[41px]"
                >
                  {data.title}
                </h2>
                <p class="max-w-[34rem] text-[15px] leading-[23px] text-soft">{data.lead}</p>
              </div>
            )}
            {col.map(({ size, rd, agent }) => {
              // Only a published page is linked: drafts wait for the second wave (César 06/10).
              const publiee = agent.page && !agent.page.brouillon;
              const Tag = publiee ? 'a' : 'div';
              return (
                <div data-rv style={`--rd:${rd * 0.09}s`} class={sizeClass[size]}>
                  <Tag
                    href={publiee ? pageHref(agent.slug) : undefined}
                    style={agent.style}
                    class="tuile group relative block size-full overflow-hidden rounded-[20px] after:pointer-events-none after:absolute after:inset-0 after:rounded-[20px] after:border-2 after:border-transparent after:transition-colors after:duration-400 hover:after:border-orange focus-visible:after:border-orange"
                  >
                    <Picture
                      src={agent.photo}
                      alt=""
                      formats={['avif', 'webp']}
                      widths={[360, 540, 720, 820]}
                      sizes={sizes[size]}
                      class="photo-cadree transition-transform duration-[1.4s] ease-hatch group-hover:scale-[1.07] group-focus-visible:scale-[1.07]"
                    />
                    <div class="absolute inset-x-2 bottom-2 flex min-h-[56px] items-center justify-between gap-2 rounded-[14px] bg-white/55 py-2 pr-2 pl-3 shadow-[0_8px_20px_color-mix(in_srgb,var(--color-shadow)_12%,transparent)] outline outline-1 -outline-offset-[0.5px] outline-white/80 backdrop-blur-[7px] transition-[translate,background-color] duration-600 ease-hatch group-hover:-translate-y-[3px] group-hover:bg-white/80 group-focus-visible:-translate-y-[3px] group-focus-visible:bg-white/80 md:inset-x-3 md:bottom-3 md:h-14 md:py-0 md:pr-2 md:pl-3.5">
                      <div class="flex min-w-0 flex-col-reverse gap-[3px]">
                        <h3 class="font-display text-[18px] leading-tight font-bold text-ink md:text-[19px]">
                          {agent.name}
                        </h3>
                        <p class="font-mono text-[10px] leading-[1.27] tracking-[0.05em] text-orange-txt uppercase md:tracking-[0.1em]">
                          {agent.job}
                        </p>
                      </div>
                      {/* The arrow promises a page: only shown once the agent has one (César 06/10). */}
                      {publiee && (
                        <span
                          aria-hidden="true"
                          class="flex size-8 shrink-0 items-center justify-center rounded-full bg-ink transition-[background-color,translate] duration-[350ms] ease-hatch group-hover:translate-x-[3px] group-hover:bg-orange group-focus-visible:translate-x-[3px] group-focus-visible:bg-orange md:size-9"
                        >
                          <svg viewBox="0 0 24 24" class="size-4 fill-white">
                            <path d="M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zm-2 4V7h2v8zm-2 2V5h2v12z" />
                          </svg>
                        </span>
                      )}
                    </div>
                  </Tag>
                </div>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
   * Per-agent framing (values in equipe-cadrage.ts): every photo is sized so that its bird's body is
   * --taille-oiseau tall — the same in all tiles, so the seven read as one team — then its subject is
   * centred in the zone above the label. Where the photo doesn't reach the tile edges, the tile shows
   * the render's backdrop colour and the photo's edges are feathered, so no seam shows.
   */
  .tuile {
    container-type: size;
    --etiquette: 72px;
  }
  @media (min-width: 768px) {
    .tuile {
      --etiquette: 70px;
    }
  }
  .tuile :global(img.photo-cadree) {
    /* Container units resolve against the tile here (not on .tuile itself, which can't query itself). */
    --zone: calc(100cqh - var(--etiquette));
    /* Same bird height in every tile (desktop columns share one width). */
    --taille-oiseau: 26cqw;
    --largeur: min(calc(var(--taille-oiseau) / var(--oiseau)), calc(88cqw / var(--sw)));
    position: absolute;
    max-width: none;
    width: var(--largeur);
    height: auto;
    left: calc(50cqw - (var(--sx) + var(--sw) / 2) * var(--largeur));
    /* Subject centred in the zone above the label, but never cut at the top: a subject taller than the
       zone slides down, its bottom going under the glass label. */
    top: max(
      calc(var(--zone) / 2 - (var(--sy) + var(--sh) / 2) * var(--ratio) * var(--largeur)),
      calc(4cqh - var(--sy) * var(--ratio) * var(--largeur))
    );
    mask-image:
      linear-gradient(to right, transparent, black 14%, black 86%, transparent),
      linear-gradient(to bottom, transparent, black 14%, black 86%, transparent);
    mask-composite: intersect;
  }
</style>
