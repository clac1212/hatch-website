---
/**
 * Security on the home page (the crossroads), under the two spaces: a compact band, not the Security
 * page itself (César 09/11). The orange grain of the Security page, its title and lead, its four themes
 * as a band (César 09/11: compact): the head and the link on the left, the four promises on the right,
 * each a slim card with its voxel character on a small tinted stage, its title and one line. For
 * access control, the three roles of the page's access screen, the crew member's highlighted.
 * Content: the Security page's (src/content/pages/security/{fr,en}.yaml); the link's label lives in
 * src/content/sections/accueil/{fr,en}.yaml under `securite`.
 */
import { getEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from '../layout/Section.astro';
import EnTete from '../ui/EnTete.astro';
import Carte from '../ui/Carte.astro';
import fond from '../../assets/securite/fond-orange-grain.jpg';
import jay from '../../assets/securite/jay.png';
import owl from '../../assets/securite/owl.png';
import finch from '../../assets/securite/finch.png';
import { section } from '../../content/section';
import { routes, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entry = await getEntry('securityPage', locale);
if (!entry) throw new Error(`Missing src/content/pages/security/${locale}.yaml`);
const { hero, sections, screen } = entry.data;
const ui = (await section('accueil', locale)).securite;
const bg = await getImage({ src: fond, format: 'webp', width: 1600, quality: 70 });
const AGENTS: Record<'jay' | 'owl' | 'finch', ImageMetadata> = { jay, owl, finch };
const TEINTES = { jay: 'bg-sand', owl: 'bg-stone', finch: 'bg-peach', ecran: 'bg-cream-2' };
---

<Section
  id="securite"
  ton="orange"
  aria-labelledby="securite-titre"
  class="bg-cover bg-center"
  style={`background-image:url(${bg.src})`}
>
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div class="flex flex-col items-start gap-8">
      <EnTete id="securite-titre" titre={hero.title} intro={hero.lead} />
      <!-- exception: the underlined text link (also on the 404) is not a DS component yet -->
      <a
        href={routes.security[locale]}
        class="border-b-[1.5px] border-ink pb-[3px] text-caption font-semibold transition-colors hover:border-transparent"
      >
        {ui.lien}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        sections.map((s) => (
          <Carte as="li" class="flex items-center gap-4 p-3 pr-5">
            <div
              class:list={[
                'vignette rounded-interieur grid shrink-0 place-items-center',
                TEINTES[s.visual],
              ]}
            >
              {s.visual === 'ecran' ? (
                <ul class="roles" aria-hidden="true">
                  {screen.roles.map((r, k) => (
                    <li class:list={{ on: k === screen.roles.length - 1 }}>{r}</li>
                  ))}
                </ul>
              ) : (
                <Picture
                  src={AGENTS[s.visual]}
                  alt={hero.alts[s.visual]}
                  height={192}
                  densities={[1, 2]}
                  formats={['avif', 'webp']}
                  loading="lazy"
                  class="vignette-img"
                />
              )}
            </div>
            <div class="flex min-w-0 flex-col gap-1">
              <h3 class="font-display text-card font-semibold text-balance">{s.title}</h3>
              <p class="text-caption text-soft">{s.subtitle}</p>
            </div>
          </Carte>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  /* The small tinted stage of each promise, concentric with its card (card radius − 12 px padding). */
  .vignette {
    width: 6rem;
    aspect-ratio: 1;
    padding: 6px;
    overflow: hidden;
  }
  .vignette > :global(picture) {
    width: 100%;
    height: 100%;
  }
  .vignette :global(.vignette-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Access control: the three roles, the crew member's highlighted (scene sizes). */
  .roles {
    display: grid;
    gap: 4px;
    font: 600 10px/1 var(--font-sans);
  }
  .roles li {
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-soft);
    text-align: center;
    white-space: nowrap;
  }
  .roles li.on {
    background: var(--color-ink);
    color: var(--color-cream);
  }
</style>
