---
import { Image, Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import LisierePixel from '../ui/LisierePixel.astro';
import { section } from '../../content/section';
import { routes, useTranslations, type Locale } from '../../i18n/ui';
import carteFrance from '../../assets/hero/carte-v5-1.jpg';
import carteEurope from '../../assets/hero/carte-europe.jpg';
import grain from '../../assets/hero/grain.png';
import boutiques from './hero-boutiques.json';
import peep from '../../assets/hero/agents/peep.webp';
import lark from '../../assets/hero/agents/lark.webp';
import jay from '../../assets/hero/agents/jay.webp';
import finch from '../../assets/hero/agents/finch.webp';
import owl from '../../assets/hero/agents/owl.webp';
import pecker from '../../assets/hero/agents/pecker.webp';
import sparrow from '../../assets/hero/agents/sparrow.png';
import oiseauxPos from './hero-oiseaux.json';

/**
 * Hero of the home: full-screen voxel map of the network (hero v3), liquid-glass title card, and one
 * living rule on top of the map (César, 01/10): a shop writes, its agent answers. Each event, in turn:
 *   1. a real shop sends a ground wave;
 *   2. the agent's card appears right above that shop, "running";
 *   3. it switches to "done", then fades out, and the next shop takes over.
 * No wave is ever sent without its card. The image already carries its clouds and sea reflections.
 * The loop starts with the three agents drawn on the map (Peep, Lark, Sparrow), then one agent off the
 * map, and restarts (César, 01/10: otherwise one gets lost). While the card of a bird drawn on the map
 * says "running", a "typing" bubble shows above that bird: subtle on purpose (César tried growing birds
 * and message arcs, both too heavy). The birds themselves stay still.
 *
 * Coordinates are in the image's frame (1440 × 804) and expressed in % of it, so they stay on their
 * shop whatever the screen: the shops' ground points are measured by the composition script
 * (hero-boutiques.json), only the choice of shops and the card anchors are made here.
 */
interface Props {
  locale: Locale;
  /**
   * The network page's map of Western Europe (relief, an established network, the agents at work). Its
   * places differ from the France map, so the map-anchored pings, bubbles and task cards are left out
   * until they are re-anchored. The scene is pinned left so the Atlantic sits under the glass card.
   */
  europe?: boolean;
}

const { locale, europe = false } = Astro.props;
const carte = europe ? carteEurope : carteFrance;
const K = europe ? 0.5176 : 1;
const cadre = (x: number, y: number): [number, number] =>
  europe ? [358.2 + x * K, 157.5 + y * K] : [x, y];
const data = await section('hero', locale);
const t = useTranslations(locale);
const { status, events } = data.tasks;

const W = 1440;
const H = 804;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const avatars = { peep, lark, jay, finch, owl, pecker, sparrow };
/** Birds drawn on the map and their box in the frame (hero-oiseaux.json): anchors of the bubbles. */
const OISEAUX = { lark: oiseauxPos.lark, peep: oiseauxPos.peep, sparrow: oiseauxPos.sparrow };
type Oiseau = keyof typeof OISEAUX;
const surCarte = (agent: string): agent is Oiseau => agent in OISEAUX;

/**
 * The shop of each event (index in hero-boutiques.json), in the order of `tasks.events`. Picked among
 * the shops visible on every screen (right of the title card, below the nav). `anchor` keeps the card
 * inside the frame near its right edge.
 */
type Ancre = 'center' | 'right';
const SHOPS: (
  | { shop: number; anchor: Ancre }
  | { x: number; y: number; roof: number; anchor: Ancre }
)[] = [
  { shop: 12, anchor: 'center' }, // Dijon (Peep)
  { shop: 8, anchor: 'right' }, // Strasbourg (Lark), close to the right edge of the screen
  // Marseille opening (Sparrow): the construction site of the map (decor, not a shop), card above its crane
  { x: 1190, y: 650, roof: 140, anchor: 'center' },
  // Huesca (Owl, off the map), Spanish side of the middle of the Pyrenees: Owl answers in the team's language
  { shop: 25, anchor: 'center' },
];
if (SHOPS.length !== events.length) {
  throw new Error(
    `Hero: ${events.length} events in the content, ${SHOPS.length} shops in Hero.astro`,
  );
}
/** Shop height in the frame: the card sits just above the roof. */
const ROOF = 30;
/**
 * Europe map: chaque carte de tâche se pose au-dessus de l'agent dessiné sur la carte (tête),
 * et l'onde part de ses pieds. Pixels de l'image 3840 × 2143, même ratio que le cadre 1440 × 804.
 */
const AGENTS_EUROPE: Record<string, { x: number; tete: number; pieds: number }> = {
  peep: { x: 2430, tete: 1000, pieds: 1070 }, // devant BunBun Lyon
  lark: { x: 2215, tete: 750, pieds: 830 }, // au siège, avec le directeur
  sparrow: { x: 2490, tete: 1232, pieds: 1320 }, // chantier du sud
  owl: { x: 1990, tete: 1208, pieds: 1305 }, // avec le chef de BunBun Bordeaux
};
const enCadre = (v: number, de: number, vers: number) => (v / de) * vers;
const steps = events.map((e, i) => {
  if (europe) {
    const a = AGENTS_EUROPE[e.agent];
    const texte = e.europe ?? e;
    return {
      ...e,
      ...texte,
      x: enCadre(a.x, 3840, W),
      y: enCadre(a.pieds, 2143, H),
      roof: enCadre(a.pieds - a.tete + 14, 2143, H),
      anchor: 'center' as Ancre,
      avatar: avatars[e.agent],
    };
  }
  const at = SHOPS[i];
  const [x, y] = cadre(
    ...('shop' in at ? (boutiques.shops[at.shop] as [number, number]) : [at.x, at.y]),
  );
  const roof = ('shop' in at ? ROOF : at.roof) * K;
  return { ...e, x, y, roof, anchor: at.anchor, avatar: avatars[e.agent] };
});
/** Seconds per event (wave, card running, card done, exit). */
const STEP = 5.6;

/** Europe map: les trois chantiers (cadre 3840 × 2143 de l'image) et les nuages. */
const GRUES = [
  { id: 'de', x: `${(2640 / 3840) * 100}%`, y: `${(180 / 2143) * 100}%` },
  { id: 'fr', x: `${(2400 / 3840) * 100}%`, y: `${(960 / 2143) * 100}%` },
  { id: 'es', x: `${(1280 / 3840) * 100}%`, y: `${(1320 / 2143) * 100}%` },
];
const NUAGES = [
  { id: 1, y: '60%', w: '11%', d: 70, t: 10 },
  { id: 2, y: '90%', w: '9%', d: 80, t: 45 },
  { id: 3, y: '120%', w: '12%', d: 75, t: 30 },
  { id: 2, y: '45%', w: '7%', d: 85, t: 62 },
  { id: 1, y: '75%', w: '8%', d: 78, t: 52 },
  { id: 3, y: '105%', w: '9%', d: 72, t: 2 },
  { id: 1, y: '135%', w: '10%', d: 82, t: 66 },
];

const tick =
  'M10 18H8v-2h2v2Zm-2-2H6v-2h2v2Zm4-2v2h-2v-2h2Zm-6 0H4v-2h2v2Zm8 0h-2v-2h2v2Zm2-2h-2v-2h2v2Zm2-2h-2V8h2v2Zm2-2h-2V6h2v2Z';
---

<section
  class:list={[
    'hero relative h-dvh min-h-[640px] overflow-hidden bg-night [container-type:size]',
    europe && 'hero-europe',
  ]}
  aria-labelledby="hero-titre"
  data-rv-groupe
>
  <div class="h-decor" aria-hidden="true">
    <Picture
      src={carte}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600, 2000, 2400, 2880, 3840]}
      quality={80}
      sizes="max(100vw, 179.1vh, 1146px)"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover"
    />
    {
      /* Europe map: les grues des trois chantiers pivotent (vidéos en boucle posées sur
         l'image) et des nuages traversent la carte. Un bouton met tout en pause. */
      europe && (
        <>
          <div class="h-grues">
            {GRUES.map((g) => (
              <video
                class="h-grue"
                src={`/anim/grue-${g.id}.mp4`}
                style={`left:${g.x};top:${g.y}`}
                autoplay
                muted
                loop
                playsinline
              />
            ))}
          </div>
          <div class="h-nuages">
            {NUAGES.map((n) => (
              <img
                class="h-nuage"
                src={`/anim/nuage-${n.id}.webp`}
                alt=""
                style={`--y0:${n.y};width:${n.w};animation-duration:${n.d}s;animation-delay:-${n.t}s`}
              />
            ))}
          </div>
        </>
      )
    }
    {
      steps.map((e) => (
        <div class="h-ping" style={`left:${pct(e.x, W)};top:${pct(e.y, H)}`}>
          <span />
          <span />
        </div>
      ))
    }
    {
      !europe &&
        (Object.keys(OISEAUX) as Oiseau[]).map((agent) => {
          const o = OISEAUX[agent];
          const [bl, bt] = cadre(o.left, o.top);
          const b = { left: bl, top: bt, width: o.width * K, height: o.height * K };
          return (
            <div
              class="h-oiseau"
              data-agent={agent}
              style={`left:${pct(b.left, W)};top:${pct(b.top, H)};width:${pct(b.width, W)};height:${pct(b.height, H)}`}
            >
              <span class="h-bulle">
                <i />
                <i />
                <i />
              </span>
            </div>
          );
        })
    }
  </div>

  <!-- Film grain at screen scale (the photo itself is denoised): hides the AI micro-texture and the
       banding, stays fine whatever image size is served. Under the piles and the glass card. -->
  <div class="h-grain" aria-hidden="true" style={`background-image:url(${grain.src})`}></div>

  <!-- Pixel edge into the clients band below (white): over the map and the grain, under the piles
       and the glass card. -->
  {
    !europe && (
      <div class="absolute inset-x-0 bottom-0 z-0">
        <LisierePixel color="var(--color-white)" />
      </div>
    )
  }

  <div
    class="relative z-1 mx-auto flex h-full max-w-[1440px] flex-col justify-end gap-2 px-4 pt-24 pb-4 sm:px-6 sm:pb-6 lg:static lg:justify-center lg:gap-0 lg:px-14 lg:pt-36 lg:pb-12"
  >
    <div class="h-piles" aria-hidden="true" data-pas={STEP}>
      {
        steps.map((e) => (
          <div
            class="h-pile"
            data-agent={e.agent}
            style={`--x:${pct(e.x, W)};--y:${pct(e.y - e.roof, H)};--dx:${e.anchor === 'right' ? '-78%' : '-50%'};--ax:${e.anchor === 'right' ? '78%' : '50%'}`}
          >
            <div class="h-slot">
              <div>
                <div class="h-tache">
                  <Image
                    src={e.avatar}
                    width={40}
                    height={40}
                    densities={[1, 2]}
                    format="webp"
                    alt=""
                    class="h-avatar"
                  />
                  <span class="h-corps">
                    <span class="h-titre h-bascule">
                      <span class="lib-cours">{e.running.title}</span>
                      <span class="lib-fait">{e.done.title}</span>
                    </span>
                    <span class="h-meta">
                      <span class="h-statut">
                        <span class="h-point" />
                        <svg class="h-coche" viewBox="0 0 24 24">
                          <path d={tick} />
                        </svg>
                        <span class="h-etat lib-cours">{status.running}</span>
                        <span class="h-etat lib-fait">{status.done}</span>
                      </span>
                      <span class="h-detail h-bascule">
                        <span class="lib-cours">{e.running.detail}</span>
                        <span class="lib-fait">{e.done.detail}</span>
                      </span>
                    </span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="carte-hero vitre z-2 flex flex-col items-start gap-[18px] rounded-[28px] px-5 pt-6 pb-6 sm:gap-6 sm:px-8 sm:pt-8 sm:pb-9 md:max-w-[600px] lg:w-[clamp(520px,47.2vw,680px)] lg:max-w-none lg:gap-[26px] lg:rounded-[36px] lg:px-[clamp(36px,3.334vw,48px)] lg:pt-[clamp(34px,3.195vw,46px)] lg:pb-[clamp(38px,3.473vw,50px)]"
      data-rv
      style="--rd: 0.2s"
    >
      <h1
        id="hero-titre"
        class="font-display text-[32px] leading-[1.06] font-semibold tracking-[-0.018em] text-ink sm:text-[38px] md:text-[44px] lg:text-[clamp(40px,3.5vw,50px)]"
      >
        {data.title.join(' ')}
      </h1>
      <!-- Lighter and grey under the title, for hierarchy (César, 01/10). On the liquid glass the plain
           `soft` grey fell to 4.3:1 on its darkest spots: a quarter of ink brings it back above AA. -->
      <p
        class="lead text-[15px] leading-6 font-normal text-[color-mix(in_srgb,var(--color-soft)_75%,var(--color-ink))] lg:text-base lg:leading-[26px]"
      >
        {data.lead}
      </p>
      <!-- The demo alone (the platform's sign-in lives on the home page's nav). Same size as the nav's
           demo pill (César 06/10): the title carries the weight, not the buttons. -->
      <div class="flex flex-wrap gap-3">
        <Button href={routes.demo[locale]} variant="orange">{t('cta.demo')}</Button>
      </div>
    </div>
  </div>
  {
    europe && (
      <button
        type="button"
        class="h-pause"
        data-hero-pause
        data-pause={t('hero.mapPause')}
        data-play={t('hero.mapPlay')}
        aria-pressed="false"
      >
        <span class="sr-only" data-hero-pause-label>
          {t('hero.mapPause')}
        </span>
        <span class="h-pause-ico" aria-hidden="true" />
      </button>
    )
  }
</section>
<!-- The Europe map: its own loop of task cards, the pause button and the cranes (no-op elsewhere). -->
<script is:inline>
  (function () {
    var hero = document.querySelector('.hero-europe');
    if (!hero) return;
    var bouton = hero.querySelector('[data-hero-pause]');
    var label = hero.querySelector('[data-hero-pause-label]');
    var videos = [].slice.call(hero.querySelectorAll('.h-grue'));
    function regler(pause) {
      hero.classList.toggle('h-en-pause', pause);
      bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
      label.textContent = bouton.getAttribute(pause ? 'data-play' : 'data-pause');
      videos.forEach(function (v) {
        if (pause) v.pause();
        else v.play().catch(function () {});
      });
    }
    bouton.addEventListener('click', function () {
      regler(!hero.classList.contains('h-en-pause'));
    });
    regler(matchMedia('(prefers-reduced-motion: reduce)').matches);

    // Boucle des cartes de tâche (même rythme que la carte de France : onde, carte en cours,
    // terminé, sortie, puis l'agent suivant). Suspendue par le bouton pause.
    var piles = [].slice.call(hero.querySelectorAll('.h-pile'));
    var pings = [].slice.call(hero.querySelectorAll('.h-ping'));
    var STEP = Number(hero.querySelector('.h-piles').dataset.pas);
    var CYCLE = STEP * piles.length;
    function clamp(x) {
      return Math.min(1, Math.max(0, x));
    }
    function ease(x) {
      return 1 - Math.pow(1 - x, 3);
    }
    function rendu(t) {
      var tc = t % CYCLE;
      piles.forEach(function (pile, i) {
        var r = tc - i * STEP;
        var actif = r >= 0 && r < STEP;
        var p = actif ? r / 1.4 : 1;
        var g = pings[i];
        g.style.setProperty('--p1', String(ease(clamp(p))));
        g.style.setProperty('--p2', String(ease(clamp((p - 0.3) / 0.7))));
        g.style.setProperty('--g', String(p < 1 ? Math.sin(Math.PI * clamp(p)) * 0.8 : 0));
        pile.querySelector('.h-slot').classList.toggle('on', actif && r >= 1.0);
        pile.classList.toggle('sort', actif && r >= 5.0);
        pile.querySelector('.h-tache').classList.toggle('fait', actif && r >= 3.2);
      });
    }
    // Garde chaque carte dans l'écran, à droite de la carte de titre : on la décale, sa pointe
    // reste sur l'agent. Recalculé au redimensionnement.
    var titre = hero.querySelector('.carte-hero');
    function caler() {
      var large = matchMedia('(min-width: 64rem)').matches;
      var zone = hero.getBoundingClientRect();
      if (!zone.width) return; // not laid out yet
      var gauche = zone.left + 16 + (large ? titre.getBoundingClientRect().right - zone.left : 0);
      var droite = zone.right - 16;
      piles.forEach(function (pile) {
        pile.style.setProperty('--decal', '0px');
        if (!large) return;
        var c = pile.querySelector('.h-tache').getBoundingClientRect();
        var d = 0;
        if (c.right > droite) d = droite - c.right;
        if (c.left + d < gauche) d = gauche - c.left;
        var max = c.width / 2 - 24;
        d = Math.max(-max, Math.min(max, d));
        pile.style.setProperty('--decal', d + 'px');
      });
    }
    caler();
    addEventListener('resize', caler);
    addEventListener('hashchange', function () {
      setTimeout(caler, 50);
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rendu(2);
      return;
    }
    var t = 0,
      avant = null,
      images = 0;
    function boucle(maintenant) {
      if (avant !== null && !hero.classList.contains('h-en-pause'))
        t += Math.min(maintenant - avant, 100) / 1000;
      avant = maintenant;
      rendu(t);
      if (++images % 30 === 0) caler();
      requestAnimationFrame(boucle);
    }
    requestAnimationFrame(boucle);
  })();
</script>

<script>
  /**
   * Hero loop: one shop at a time. Wave on the shop (0 → 1.4 s), then its card appears above it at
   * 1 s ("running"), switches to "done" at 3.2 s, leaves at 5 s; next shop at STEP (5.6 s). Each state
   * stays ~2 s so its line can be read (César, 01/10). A bird of the map "types" while its card runs.
   * Paused off screen.
   * `?t=<s>` freezes the loop at an instant (captures); reduced motion shows a still frame.
   */
  // The Europe map drives its own loop (inline script below the section): this one runs the France map.
  const leHero = document.querySelector<HTMLElement>('.hero:not(.hero-europe)');
  if (leHero) demarrer(leHero);

  function demarrer(hero: HTMLElement) {
    const STEP = Number(hero.querySelector<HTMLElement>('.h-piles')!.dataset.pas);
    const piles = [...hero.querySelectorAll<HTMLElement>('.h-pile')];
    const taches = piles.map((p) => p.querySelector<HTMLElement>('.h-tache')!);
    const slots = piles.map((p) => p.querySelector<HTMLElement>('.h-slot')!);
    const pings = [...hero.querySelectorAll<HTMLElement>('.h-ping')];
    const oiseaux = [...hero.querySelectorAll<HTMLElement>('.h-oiseau')];
    const CYCLE = STEP * piles.length;
    const ENTREE = 1.0;
    const BASCULE = 3.2;
    const SORTIE = 5.0;
    /** p = wave progress (0 → 1; ≥ 1 = idle). The second ring follows 0.3 behind the first. */
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    function ping(el: HTMLElement, p: number) {
      const ease = (x: number) => 1 - (1 - x) ** 3;
      el.style.setProperty('--p1', String(ease(clamp(p))));
      el.style.setProperty('--p2', String(ease(clamp((p - 0.3) / 0.7))));
      el.style.setProperty('--g', String(p < 1 ? Math.sin(Math.PI * clamp(p)) * 0.8 : 0));
    }

    function rendu(t: number) {
      const tc = t % CYCLE;
      // the bird whose card is "running" types its answer
      const actifs = new Set<string>();
      piles.forEach((pile, i) => {
        const r = tc - i * STEP;
        if (r >= ENTREE && r < BASCULE) actifs.add(pile.dataset.agent!);
      });
      oiseaux.forEach((o) => o.classList.toggle('parle', actifs.has(o.dataset.agent!)));
      piles.forEach((pile, i) => {
        const r = tc - i * STEP;
        const actif = r >= 0 && r < STEP;
        ping(pings[i], actif ? r / 1.4 : 1);
        slots[i].classList.toggle('on', actif && r >= ENTREE);
        pile.classList.toggle('sort', actif && r >= SORTIE);
        taches[i].classList.toggle('fait', actif && r >= BASCULE);
      });
    }

    const fige = new URLSearchParams(location.search).get('t');
    if (fige !== null) rendu(Number.parseFloat(fige));
    else if (matchMedia('(prefers-reduced-motion: reduce)').matches) rendu(2);
    else {
      let t = 0;
      let avant: number | null = null;
      let raf = 0;
      const boucle = (maintenant: number) => {
        // Capped step: a background tab resumes where it left off instead of jumping ahead.
        if (avant !== null) t += Math.min(maintenant - avant, 100) / 1000;
        avant = maintenant;
        rendu(t);
        raf = requestAnimationFrame(boucle);
      };
      new IntersectionObserver(([e]) => {
        hero.classList.toggle('h-pause', !e.isIntersecting);
        if (e.isIntersecting) raf ||= requestAnimationFrame(boucle);
        else {
          cancelAnimationFrame(raf);
          raf = 0;
          avant = null;
        }
      }).observe(hero);
    }
  }
</script>

<style>
  /* Europe map: grues, nuages, pause. */
  .h-grue {
    position: absolute;
    width: 12.5%;
    height: 22.4%;
    object-fit: cover;
    -webkit-mask-image: radial-gradient(circle at 55% 45%, #000 38%, transparent 62%);
    mask-image: radial-gradient(circle at 55% 45%, #000 38%, transparent 62%);
  }
  .h-nuages {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.92;
  }
  .h-nuage {
    position: absolute;
    height: auto;
    animation-name: h-nuage;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    filter: drop-shadow(0 30px 24px color-mix(in srgb, var(--color-navy) 35%, transparent));
  }
  @keyframes h-nuage {
    /* En diagonale, du bas gauche vers le haut droit, tous dans le même sens. */
    from {
      left: -15%;
      top: var(--y0);
    }
    to {
      left: 105%;
      top: calc(var(--y0) - 120%);
    }
  }
  .h-pause {
    position: absolute;
    right: max(16px, 2vw);
    bottom: 28px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-night) 70%, transparent);
    color: var(--color-cream);
    cursor: pointer;
  }
  /* Phone and tablet: the title card fills the bottom, so the pause sits top right, under the nav. */
