---
import { Image, Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import { section } from '../../content/section';
import { routes, useTranslations, type Locale } from '../../i18n/ui';
import carte from '../../assets/hero/carte-v5-1.jpg';
import grain from '../../assets/hero/grain.png';
import boutiques from './hero-boutiques.json';
import peep from '../../assets/hero/agents/peep.webp';
import lark from '../../assets/hero/agents/lark.webp';
import jay from '../../assets/hero/agents/jay.webp';
import finch from '../../assets/hero/agents/finch.webp';
import owl from '../../assets/hero/agents/owl.webp';
import pecker from '../../assets/hero/agents/pecker.webp';
import sparrow from '../../assets/hero/agents/sparrow.png';
import oiseauxPos from './hero-oiseaux.json';

/**
 * Hero of the home: full-screen voxel map of the network (hero v3), the text block, and one living
 * rule on top of the map (César, 01/10): a shop writes, its agent answers. Each event, in turn:
 *   1. a real shop sends a ground wave;
 *   2. the agent's card appears right above that shop, "running";
 *   3. it switches to "done", then fades out, and the next shop takes over.
 * No wave is ever sent without its card. The image already carries its clouds and sea reflections.
 * The loop starts with the three agents drawn on the map (Peep, Lark, Sparrow), then one agent off the
 * map, and restarts (César, 01/10: otherwise one gets lost). While the card of a bird drawn on the map
 * says "running", a "typing" bubble shows above that bird: subtle on purpose (César tried growing birds
 * and message arcs, both too heavy). The birds themselves stay still.
 *
 * Coordinates are in the image's frame (1440 × 804) and expressed in % of it, so they stay on their
 * shop whatever the screen: the shops' ground points are measured by the composition script
 * (hero-boutiques.json), only the choice of shops and the card anchors are made here.
 *
 * Text block (cofounders, 02/10): the glass title card took too much room. The H1 is now a short fact
 * in Departure Mono, the former Fraunces title becomes the tagline under it, then two CTAs: try it now
 * (the app's signup, primary) and book a demo (secondary). Three layouts are on trial (?hero=1|2|3,
 * described above the variant styles); the cards and the birds' bubbles were checked clear of the text
 * in each, from 1024 × 768 to 1920 × 1080 and at 390 × 844.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('hero', locale);
const t = useTranslations(locale);
const { status, events } = data.tasks;

const W = 1440;
const H = 804;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const avatars = { peep, lark, jay, finch, owl, pecker, sparrow };
/** Birds drawn on the map and their box in the frame (hero-oiseaux.json): anchors of the bubbles. */
const OISEAUX = { lark: oiseauxPos.lark, peep: oiseauxPos.peep, sparrow: oiseauxPos.sparrow };
type Oiseau = keyof typeof OISEAUX;
const surCarte = (agent: string): agent is Oiseau => agent in OISEAUX;

/**
 * The shop of each event (index in hero-boutiques.json), in the order of `tasks.events`. Picked among
 * the shops visible on every screen (right of the text column, below the nav). `anchor` keeps the card
 * inside the frame near its right edge.
 */
type Ancre = 'center' | 'right';
const SHOPS: (
  | { shop: number; anchor: Ancre }
  | { x: number; y: number; roof: number; anchor: Ancre }
)[] = [
  { shop: 12, anchor: 'center' }, // Dijon (Peep)
  { shop: 8, anchor: 'right' }, // Strasbourg (Lark), close to the right edge of the screen
  // Marseille opening (Sparrow): the construction site of the map (decor, not a shop), card above its crane
  { x: 1190, y: 650, roof: 140, anchor: 'center' },
  // Huesca (Owl, off the map), Spanish side of the middle of the Pyrenees: Owl answers in the team's language
  { shop: 25, anchor: 'center' },
];
if (SHOPS.length !== events.length) {
  throw new Error(
    `Hero: ${events.length} events in the content, ${SHOPS.length} shops in Hero.astro`,
  );
}
/** Shop height in the frame: the card sits just above the roof. */
const ROOF = 30;
const steps = events.map((e, i) => {
  const at = SHOPS[i];
  const [x, y] = 'shop' in at ? (boutiques.shops[at.shop] as [number, number]) : [at.x, at.y];
  const roof = 'shop' in at ? ROOF : at.roof;
  return { ...e, x, y, roof, anchor: at.anchor, avatar: avatars[e.agent] };
});
/** Seconds per event (wave, card running, card done, exit). */
const STEP = 5.6;

/** Primary CTA: the app's self-serve signup. Same URL in both locales: the app has no locale prefix. */
const SIGNUP = 'https://app.gethatch.io/auth?tab=signup';
/**
 * Layout variant served without `?hero=` (the three are described in the <style> below). The inline
 * script at the top of the section swaps it for `?hero=1|2|3` before the first paint.
 */
const DEFAUT = '1';

const tick =
  'M10 18H8v-2h2v2Zm-2-2H6v-2h2v2Zm4-2v2h-2v-2h2Zm-6 0H4v-2h2v2Zm8 0h-2v-2h2v2Zm2-2h-2v-2h2v2Zm2-2h-2V8h2v2Zm2-2h-2V6h2v2Z';
---

<section
  class="hero relative h-dvh min-h-[640px] overflow-hidden bg-night [container-type:size]"
  data-hero={DEFAUT}
  aria-labelledby="hero-titre"
  data-rv-groupe
>
  <script is:inline>
    // Layout variant under test (?hero=1|2|3), set before the first paint: nothing shifts.
    (function (hero) {
      var v = new URLSearchParams(location.search).get('hero');
      if (v === '1' || v === '2' || v === '3') hero.dataset.hero = v;
    })(document.currentScript.parentElement);
  </script>

  <div class="h-scene" aria-hidden="true">
    <div class="h-decor">
      <Picture
        src={carte}
        formats={['avif', 'webp']}
        widths={[800, 1200, 1600, 2000, 2400, 2880, 3840]}
        quality={80}
        sizes="max(100vw, 179.1vh, 1146px)"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 size-full object-cover"
      />
      {
        steps.map((e) => (
          <div class="h-ping" style={`left:${pct(e.x, W)};top:${pct(e.y, H)}`}>
            <span />
            <span />
          </div>
        ))
      }
      {
        (Object.keys(OISEAUX) as Oiseau[]).map((agent) => {
          const b = OISEAUX[agent];
          return (
            <div
              class="h-oiseau"
              data-agent={agent}
              style={`left:${pct(b.left, W)};top:${pct(b.top, H)};width:${pct(b.width, W)};height:${pct(b.height, H)}`}
            >
              <span class="h-bulle">
                <i />
                <i />
                <i />
              </span>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- Film grain at screen scale (the photo itself is denoised): hides the AI micro-texture and the
       banding, stays fine whatever image size is served. Under the piles and the text. -->
  <div class="h-grain" aria-hidden="true" style={`background-image:url(${grain.src})`}></div>

  <div
    class="h-contenu relative z-1 mx-auto flex h-full max-w-[1440px] flex-col justify-end gap-2 px-4 pt-24 pb-4 sm:px-6 sm:pb-6 lg:static lg:gap-0 lg:px-14 lg:pt-16"
  >
    <div class="h-piles" aria-hidden="true" data-pas={STEP}>
      <div class="h-cadre">
        {
          steps.map((e) => (
            <div
              class="h-pile"
              data-agent={e.agent}
              style={`--x:${pct(e.x, W)};--y:${pct(e.y - e.roof, H)};--dx:${e.anchor === 'right' ? '-78%' : '-50%'};--ax:${e.anchor === 'right' ? '78%' : '50%'}`}
            >
              <div class="h-slot">
                <div>
                  <div class="h-tache">
                    <Image
                      src={e.avatar}
                      width={40}
                      height={40}
                      densities={[1, 2]}
                      format="webp"
                      alt=""
                      class="h-avatar"
                    />
                    <span class="h-corps">
                      <span class="h-titre h-bascule">
                        <span class="lib-cours">{e.running.title}</span>
                        <span class="lib-fait">{e.done.title}</span>
                      </span>
                      <span class="h-meta">
                        <span class="h-statut">
                          <span class="h-point" />
                          <svg class="h-coche" viewBox="0 0 24 24">
                            <path d={tick} />
                          </svg>
                          <span class="h-etat lib-cours">{status.running}</span>
                          <span class="h-etat lib-fait">{status.done}</span>
                        </span>
                        <span class="h-detail h-bascule">
                          <span class="lib-cours">{e.running.detail}</span>
                          <span class="lib-fait">{e.done.detail}</span>
                        </span>
                      </span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="h-bloc" data-rv style="--rd: 0.2s">
      <h1 id="hero-titre" class="h-h1 font-mono text-ink">{data.title}</h1>
      <div class="h-carte">
        <p class="h-ligne font-display font-semibold text-ink">{data.tagline}</p>
        <!-- Grey under the tagline, for hierarchy (César, 01/10): a quarter of ink keeps the plain
             `soft` grey above AA over the scrim's lightest-covered spots. -->
        <p class="h-lead text-[color-mix(in_srgb,var(--color-soft)_75%,var(--color-ink))]">
          {data.lead}
        </p>
        <div class="h-ctas">
          <Button href={SIGNUP} variant="orange" size="lg">{t('cta.try')}</Button>
          <Button href={routes.demo[locale]} variant="secondary" size="lg">
            {t('cta.demoAsk')}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Hero loop: one shop at a time. Wave on the shop (0 → 1.4 s), then its card appears above it at
   * 1 s ("running"), switches to "done" at 3.2 s, leaves at 5 s; next shop at STEP (5.6 s). Each state
   * stays ~2 s so its line can be read (César, 01/10). A bird of the map "types" while its card runs.
   * Paused off screen.
   * `?t=<s>` freezes the loop at an instant (captures); reduced motion shows a still frame.
   */
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const STEP = Number(hero.querySelector<HTMLElement>('.h-piles')!.dataset.pas);
  const piles = [...hero.querySelectorAll<HTMLElement>('.h-pile')];
  const taches = piles.map((p) => p.querySelector<HTMLElement>('.h-tache')!);
  const slots = piles.map((p) => p.querySelector<HTMLElement>('.h-slot')!);
  const pings = [...hero.querySelectorAll<HTMLElement>('.h-ping')];
  const oiseaux = [...hero.querySelectorAll<HTMLElement>('.h-oiseau')];
  const CYCLE = STEP * piles.length;
  const ENTREE = 1.0;
  const BASCULE = 3.2;
  const SORTIE = 5.0;
  /** p = wave progress (0 → 1; ≥ 1 = idle). The second ring follows 0.3 behind the first. */
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  function ping(el: HTMLElement, p: number) {
    const ease = (x: number) => 1 - (1 - x) ** 3;
    el.style.setProperty('--p1', String(ease(clamp(p))));
    el.style.setProperty('--p2', String(ease(clamp((p - 0.3) / 0.7))));
    el.style.setProperty('--g', String(p < 1 ? Math.sin(Math.PI * clamp(p)) * 0.8 : 0));
  }

  function rendu(t: number) {
    const tc = t % CYCLE;
    // the bird whose card is "running" types its answer
    const actifs = new Set<string>();
    piles.forEach((pile, i) => {
      const r = tc - i * STEP;
      if (r >= ENTREE && r < BASCULE) actifs.add(pile.dataset.agent!);
    });
    oiseaux.forEach((o) => o.classList.toggle('parle', actifs.has(o.dataset.agent!)));
    piles.forEach((pile, i) => {
      const r = tc - i * STEP;
      const actif = r >= 0 && r < STEP;
      ping(pings[i], actif ? r / 1.4 : 1);
      slots[i].classList.toggle('on', actif && r >= ENTREE);
      pile.classList.toggle('sort', actif && r >= SORTIE);
      taches[i].classList.toggle('fait', actif && r >= BASCULE);
    });
  }

  const fige = new URLSearchParams(location.search).get('t');
  if (fige !== null) rendu(Number.parseFloat(fige));
  else if (matchMedia('(prefers-reduced-motion: reduce)').matches) rendu(2);
  else {
    let t = 0;
    let avant: number | null = null;
    let raf = 0;
    const boucle = (maintenant: number) => {
      // Capped step: a background tab resumes where it left off instead of jumping ahead.
      if (avant !== null) t += Math.min(maintenant - avant, 100) / 1000;
      avant = maintenant;
      rendu(t);
      raf = requestAnimationFrame(boucle);
    };
    new IntersectionObserver(([e]) => {
      hero.classList.toggle('h-pause', !e.isIntersecting);
      if (e.isIntersecting) raf ||= requestAnimationFrame(boucle);
      else {
        cancelAnimationFrame(raf);
        raf = 0;
        avant = null;
      }
    }).observe(hero);
  }
</script>

<style>
  /* The scene: the image's 1440 × 804 frame, covering its stage (container units), pinned right. The
     stage is the whole section, except in variant 2 where it is the space under the text. */
  .hero {
    --sw: max(100cqw, calc(100cqh * 1440 / 804));
    --sh: calc(var(--sw) * 804 / 1440);
    --fx: 0.78;
  }
  .h-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }
  .h-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-size: 128px 128px;
    mix-blend-mode: soft-light;
    opacity: 0.08;
  }
  .h-decor {
    position: absolute;
    width: var(--sw);
    height: var(--sh);
    left: calc((100cqw - var(--sw)) * var(--fx));
    top: calc((100cqh - var(--sh)) / 2);
  }

  /* Birds on the map: an empty box over the bird of the image, anchoring its bubble. */
  .h-oiseau {
    position: absolute;
  }
  /* "Typing" bubble above the head while the bird's event is running. */
  .h-bulle {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    display: flex;
    gap: 4px;
    padding: 7px 10px;
    border-radius: 999px 999px 4px 999px;
    background: var(--color-white);
    box-shadow: var(--shadow-2);
    opacity: 0;
    /* opens to the left of the head: the task cards always sit to the right of the birds */
    transform: translate(-80%, 6px) scale(0.8);
    transform-origin: 80% 100%;
    transition:
      opacity 0.35s var(--ease-doux),
      transform 0.5s var(--ease-pop);
  }
  .h-bulle i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .parle .h-bulle {
    opacity: 1;
    transform: translate(-80%, 0) scale(1);
  }
  .parle .h-bulle i {
    animation: h-tape 0.9s ease-in-out infinite;
  }
  .parle .h-bulle i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .parle .h-bulle i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes h-tape {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.45;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }
  .h-pause .h-bulle i {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .h-bulle i {
      animation: none;
    }
  }

  /* Ground wave of a shop: two rings on the map plane (an ellipse flattened by the 50° camera) and a
     soft glow at the base. JS drives one progress per ping (--p1 / --p2 rings, --g glow). */
  .h-ping {
    position: absolute;
    width: 3.2%;
    aspect-ratio: 1 / 0.56;
    transform: translate(-50%, -50%);
  }
  .h-ping::before {
    content: '';
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-orange) 45%, transparent),
      transparent
    );
    opacity: var(--g, 0);
  }
  .h-ping > span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-orange) 85%, var(--color-white));
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-orange) 35%, transparent);
    opacity: 0;
  }
  .h-ping > span:first-child {
    opacity: calc((1 - var(--p1, 1)) * 0.9);
    transform: scale(calc(0.25 + var(--p1, 1) * 0.95));
  }
  .h-ping > span:last-child {
    opacity: calc((1 - var(--p2, 1)) * 0.6);
    transform: scale(calc(0.25 + var(--p2, 1) * 0.95));
  }

  /* Task stacks. Mobile: a single slot just above the text (below it in variant 2); lg+: each card on
     its shop, in a copy of the scene's frame (.h-cadre) laid over the same stage. */
  .h-piles {
    position: relative;
    z-index: 1; /* above the text's scrim, which rises behind the slot on mobile */
    height: 84px;
    flex: none;
    pointer-events: none;
  }
  .h-pile {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: max-content;
    max-width: 100%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      --fx: 1;
    }
    .h-piles {
      position: absolute;
      inset: 0;
      z-index: 1;
      height: auto;
      container-type: size;
    }
    .h-cadre {
      position: absolute;
      width: var(--sw);
      height: var(--sh);
      left: calc((100cqw - var(--sw)) * var(--fx));
      top: calc((100cqh - var(--sh)) / 2);
    }
    .h-pile {
      left: var(--x);
      top: var(--y);
      bottom: auto;
      width: max-content;
      max-width: none;
      transform: translate(var(--dx), -100%);
    }
  }
  .h-slot {
    display: grid;
    grid-template-rows: 0fr;
    max-width: 100%;
    transition: grid-template-rows 0.6s var(--ease-hatch);
  }
  /* No overflow clipping here: it cut the card's soft shadow into a faint rectangle (César, 01/10). The
     card's own fade and slide make the entrance; the grid row only gives the slot its height. */
  .h-slot > div {
    min-width: 0; /* lets the card shrink to the frame on mobile instead of overflowing it */
    min-height: 0;
    padding: 3px 2px;
  }
  .h-slot.on {
    grid-template-rows: 1fr;
  }
  /* ---------- Task cards ----------
     Light card in the language of the title card (white rim, generous radius), made opaque and bigger
     so it reads at first glance over the map: the earlier 12-13 px glass pill was too small to notice
     (cofounder's feedback, 02/10). Two lines, outcome first: title in ink, then status and detail. */
  .h-tache {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 18px 9px 9px;
    border-radius: var(--radius-glass);
    color: var(--color-ink);
    background: var(--color-surface);
    box-shadow:
      var(--shadow-2),
      0 0 0 1px var(--color-line),
      inset 0 1px 0 var(--color-white);
    opacity: 0;
    filter: blur(6px);
    transform: translateY(14px) scale(0.94);
    transition:
      opacity 0.45s var(--ease-doux),
      filter 0.45s var(--ease-doux),
      transform 0.7s var(--ease-entree);
  }
  .h-slot.on .h-tache {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .h-pile.sort .h-tache {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(-10px) scale(0.98);
    transition-duration: 0.3s;
    transition-timing-function: var(--ease-sortie);
  }
  .h-avatar {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    object-fit: cover;
    background: var(--color-white);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  .h-corps {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 5px;
  }
  .h-titre {
    font: 600 15px/1.25 var(--font-sans);
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .h-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* One line in practice (short copy); wraps rather than truncating if a screen is narrower still. */
  .h-detail {
    min-width: 0;
    font: 500 13px/1.3 var(--font-sans);
    color: var(--color-soft);
  }
  /* Both states share one grid cell, the idle one only hidden: the card keeps the width of its
     longest line when it switches from running to done, instead of jumping. */
  .h-bascule {
    display: grid;
  }
  .h-bascule > * {
    grid-area: 1 / 1;
  }
  .h-tache.fait .lib-cours,
  .h-tache:not(.fait) .lib-fait {
    visibility: hidden;
  }
  /* The status chip, though, just swaps its label: a "Done" chip as wide as "In progress" looked empty. */
  .h-tache.fait .h-etat.lib-cours,
  .h-tache:not(.fait) .h-etat.lib-fait {
    display: none;
  }
  .h-statut {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    padding: 4px 7px;
    border-radius: 999px;
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
    background: var(--color-orange-tint);
  }
  .fait .h-statut {
    color: var(--color-soft);
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }
  .h-point {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange);
    animation: h-pulse 1.4s ease-out infinite;
  }
  @keyframes h-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-orange) 55%, transparent);
    }
    to {
      box-shadow: 0 0 0 6px transparent;
    }
  }
  .h-coche {
    width: 11px;
    height: 11px;
    display: none;
    fill: currentColor;
  }
  .h-tache.fait .h-point {
    display: none;
  }
  .h-tache.fait .h-coche {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .h-point {
