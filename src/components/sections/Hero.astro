---
import { Image, Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import { section } from '../../content/section';
import { routes, useTranslations, type Locale } from '../../i18n/ui';
import carte from '../../assets/hero/carte-v3-2.jpg';
import grain from '../../assets/hero/grain.png';
import boutiques from './hero-boutiques.json';
import peep from '../../assets/hero/peep.jpg';
import lark from '../../assets/hero/lark.jpg';
import sparrow from '../../assets/hero/sparrow.jpg';

/**
 * Hero of the home (v4 node EnmYf, animation from prototypes/hero/hero-c1.html): full-screen voxel
 * map of the network, liquid-glass title card, and a living scene on top of the map: task cards
 * stacked above each agent + human duo (Peep → Lark → Sparrow → Barcelona, 17 s loop) and orange
 * ground waves on the shops. The image (hero v3) already carries its clouds, their shadows and the sea
 * reflections, so nothing else is animated on top of it.
 *
 * Every scene coordinate below is in the prototype's frame: the image reduced to 1440 × 804. The
 * scene (`--sw` × `--sh`) is that frame covering the section, pinned right (we lose sea on the left,
 * never France), so pings and stacks stay on their cube whatever the crop.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('hero', locale);
const t = useTranslations(locale);
const { status } = data.tasks;

const W = 1440;
const H = 804;
const pos = ([x, y]: readonly [number, number]) =>
  `left:${((x / W) * 100).toFixed(3)}%;top:${((y / H) * 100).toFixed(3)}%`;

type Anchor = 'left' | 'right' | 'center';
const anchors: Record<Anchor, { dx: string; align: string }> = {
  left: { dx: '0%', align: 'flex-start' },
  right: { dx: '-100%', align: 'flex-end' },
  center: { dx: '-50%', align: 'center' },
};

/** A card is "done" from the start, or "running" until `switchAt` seconds into its scene. */
type Card = { text: string; done: true } | { text: string; done: false; switchAt?: number };

const scenes: {
  avatar: ImageMetadata;
  start: number;
  duration: number;
  ping: [number, number];
  stack: { at: [number, number]; anchor: Anchor };
  cards: Card[];
}[] = [
  {
    avatar: peep,
    start: 0,
    duration: 4.6,
    ping: [1086, 446], // the Lyon restaurant
    stack: { at: [1432, 318], anchor: 'right' }, // above the Lyon restaurant, flush right
    cards: [
      { text: data.tasks.lyon[0], done: false, switchAt: 2 },
      { text: data.tasks.lyon[1], done: true },
    ],
  },
  {
    avatar: lark,
    start: 4.6,
    duration: 4.6,
    ping: [905, 232], // the head office
    stack: { at: [1126, 128], anchor: 'left' }, // right of Lark
    cards: [
      { text: data.tasks.headOffice[0], done: true },
      { text: data.tasks.headOffice[1], done: false },
    ],
  },
  {
    avatar: sparrow,
    start: 9.2,
    duration: 4.6,
    ping: [1188, 676], // the Marseille construction site
    stack: { at: [930, 770], anchor: 'center' }, // below the Marseille duo
    cards: [
      { text: data.tasks.marseille[0], done: false },
      { text: data.tasks.marseille[1], done: true },
    ],
  },
  {
    avatar: peep,
    start: 13.8,
    duration: 3.2,
    ping: [666, 776], // the Barcelona shop
    stack: { at: [670, 742], anchor: 'center' },
    cards: [{ text: data.tasks.barcelona[0], done: true }],
  },
];

/** Shops that send a ground wave now and then between two task scenes ("your sites write to you"):
 * the footprint centre of every shop, measured on the composed image (see hero-boutiques.json). */
const cubes = boutiques.shops as [number, number][];

/** The second card of a stack slides in once the first one has been read. */
const entries = [0.5, 2.4];
const tick =
  'M10 18H8v-2h2v2Zm-2-2H6v-2h2v2Zm4-2v2h-2v-2h2Zm-6 0H4v-2h2v2Zm8 0h-2v-2h2v2Zm2-2h-2v-2h2v2Zm2-2h-2V8h2v2Zm2-2h-2V6h2v2Z';
---

<section
  class="hero relative h-dvh min-h-[640px] overflow-hidden bg-night [container-type:size]"
  aria-labelledby="hero-titre"
  data-rv-groupe
>
  <div class="h-decor" aria-hidden="true">
    <Picture
      src={carte}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600, 2000, 2400, 2880, 3840]}
      quality={80}
      sizes="max(100vw, 179.1vh, 1146px)"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover"
    />
    {
      scenes.map((s) => (
        <div class="h-ping grand" data-ping="scene" style={pos(s.ping)}>
          <span />
          <span />
        </div>
      ))
    }
    {
      cubes.map(([x, y]) => (
        <div class="h-ping" data-ping="cube" style={pos([x, y])}>
          <span />
          <span />
        </div>
      ))
    }
  </div>

  <!-- Film grain at screen scale (the photo itself is denoised): hides the AI micro-texture and the
       banding, stays fine whatever image size is served. Under the piles and the glass card. -->
  <div class="h-grain" aria-hidden="true" style={`background-image:url(${grain.src})`}></div>

  <div
    class="relative z-1 mx-auto flex h-full max-w-[1440px] flex-col justify-end gap-2 px-4 pt-24 pb-4 sm:px-6 sm:pb-6 lg:static lg:justify-center lg:gap-0 lg:px-14 lg:pt-16 lg:pb-[149px]"
  >
    <div class="h-piles" aria-hidden="true">
      {
        scenes.map((s) => (
          <div
            class="h-pile"
            data-debut={s.start}
            data-duree={s.duration}
            style={`--x:${((s.stack.at[0] / W) * 100).toFixed(3)}%;--y:${((s.stack.at[1] / H) * 100).toFixed(3)}%;--dx:${anchors[s.stack.anchor].dx};--align:${anchors[s.stack.anchor].align}`}
          >
            {s.cards.map((card, j) => (
              <div
                class="h-slot"
                data-entree={entries[j]}
                data-bascule={!card.done && card.switchAt !== undefined ? card.switchAt : undefined}
              >
                <div>
                  <div class:list={['h-tache', card.done && 'fait']}>
                    <Image
                      src={s.avatar}
                      width={28}
                      height={28}
                      densities={[1, 2]}
                      format="webp"
                      alt=""
                      class="h-avatar"
                    />
                    <span class="h-corps">
                      <span class="h-ligne">
                        <span class="h-statut">
                          <span class="h-point" />
                          <svg class="h-coche" viewBox="0 0 24 24">
                            <path d={tick} />
                          </svg>
                          <span class="lib-cours">{status.running}</span>
                          <span class="lib-fait">{status.done}</span>
                        </span>
                        <span class="h-sep" />
                        <span class="h-texte">{card.text}</span>
                      </span>
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div
      class="carte-hero relative z-2 flex flex-col items-start gap-[18px] rounded-[28px] px-5 pt-6 pb-6 sm:gap-6 sm:px-8 sm:pt-8 sm:pb-9 md:max-w-[600px] lg:w-[clamp(480px,45.56vw,656px)] lg:max-w-none lg:gap-[26px] lg:rounded-[36px] lg:px-[clamp(36px,3.334vw,48px)] lg:pt-[clamp(34px,3.195vw,46px)] lg:pb-[clamp(38px,3.473vw,50px)]"
      data-rv
      style="--rd: 0.2s"
    >
      <h1
        id="hero-titre"
        class="titre-hero font-mono text-[26px] leading-[1.14] tracking-[-0.01em] text-ink sm:text-[30px] md:text-[34px] lg:text-[clamp(28px,2.604vw,37.5px)]"
      >
        {
          data.title.map((line, i) => (
            <>
              {line}
              {i < data.title.length - 1 && (
                <>
                  {' '}
                  <br class="max-lg:hidden" />
                </>
              )}
            </>
          ))
        }
      </h1>
      <p
        class="lead text-base leading-6 font-medium text-ink sm:text-[17px] lg:text-lg lg:leading-[27px]"
      >
        {data.lead}
      </p>
      <Button href={routes.demo[locale]} variant="orange" size="lg">{t('cta.demo')}</Button>
    </div>
  </div>
</section>

<script>
  /**
   * Hero loop (prototypes/hero/hero-c1.html): one duo at a time, its cube pings, then its task cards
   * stack up ("running" → "done") and fade out. Paused off screen. `?t=<s>` freezes the loop at an
   * instant (captures); reduced motion shows a still frame.
   */
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const CYCLE = 17;
  const piles = [...hero.querySelectorAll<HTMLElement>('.h-pile')].map((pile) => ({
    pile,
    debut: Number(pile.dataset.debut),
    duree: Number(pile.dataset.duree),
    slots: [...pile.querySelectorAll<HTMLElement>('.h-slot')].map((slot) => ({
      slot,
      tache: slot.querySelector<HTMLElement>('.h-tache')!,
      entree: Number(slot.dataset.entree),
      bascule: slot.dataset.bascule === undefined ? null : Number(slot.dataset.bascule),
    })),
  }));
  const pings = [...hero.querySelectorAll<HTMLElement>('[data-ping="scene"]')];
  const cubes = [...hero.querySelectorAll<HTMLElement>('[data-ping="cube"]')];

  /** p = wave progress (0 → 1; ≥ 1 = idle). The second ring follows 0.3 behind the first. */
  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  function ping(el: HTMLElement, p: number) {
    const ease = (x: number) => 1 - (1 - x) ** 3;
    el.style.setProperty('--p1', String(ease(clamp(p))));
    el.style.setProperty('--p2', String(ease(clamp((p - 0.3) / 0.7))));
    el.style.setProperty('--g', String(p < 1 ? Math.sin(Math.PI * clamp(p)) * 0.8 : 0));
  }

  function rendu(t: number) {
    const tc = t % CYCLE;
    piles.forEach(({ pile, debut, duree, slots }, i) => {
      const r = tc - debut;
      const actif = r >= 0 && r < duree;
      ping(pings[i], actif ? r / 1.6 : 1);
      pile.classList.toggle('sort', actif && r >= duree - 0.5);
      for (const { slot, tache, entree, bascule } of slots) {
        slot.classList.toggle('on', actif && r >= entree);
        if (bascule !== null) tache.classList.toggle('fait', r >= bascule);
      }
    });
    // Ambient waves: every 2.3 s, one shop (5 steps apart) sends a soft ground wave.
    const n = Math.floor(t / 2.3);
    const q = (t % 2.3) / 1.6;
    cubes.forEach((el, k) => ping(el, k === (n * 5) % cubes.length ? q : 1));
  }

  const fige = new URLSearchParams(location.search).get('t');
  if (fige !== null) rendu(Number.parseFloat(fige));
  else if (matchMedia('(prefers-reduced-motion: reduce)').matches) rendu(1.2);
  else {
    let t = 0;
    let avant: number | null = null;
    let raf = 0;
    const boucle = (maintenant: number) => {
      // Capped step: a background tab resumes where it left off instead of jumping ahead.
      if (avant !== null) t += Math.min(maintenant - avant, 100) / 1000;
      avant = maintenant;
      rendu(t);
      raf = requestAnimationFrame(boucle);
    };
    new IntersectionObserver(([e]) => {
      hero.classList.toggle('h-pause', !e.isIntersecting);
      if (e.isIntersecting) raf ||= requestAnimationFrame(boucle);
      else {
        cancelAnimationFrame(raf);
        raf = 0;
        avant = null;
      }
    }).observe(hero);
  }
</script>

<style>
  /* The scene: the image's 1440 × 804 frame, covering the section (container units), pinned right. */
  .hero {
    --sw: max(100cqw, calc(100cqh * 1440 / 804));
    --sh: calc(var(--sw) * 804 / 1440);
    --fx: 0.78;
  }
  .h-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-size: 128px 128px;
    mix-blend-mode: soft-light;
    opacity: 0.08;
  }
  .h-decor {
    position: absolute;
    z-index: 0;
    width: var(--sw);
    height: var(--sh);
    left: calc((100cqw - var(--sw)) * var(--fx));
    top: calc((100cqh - var(--sh)) / 2);
    pointer-events: none;
  }

  /* Ground wave of a shop: two rings on the map plane (an ellipse flattened by the 50° camera) and a
     soft glow at the base. JS drives one progress per ping (--p1 / --p2 rings, --g glow). */
  .h-ping {
    position: absolute;
    width: 3.2%;
    aspect-ratio: 1 / 0.56;
    transform: translate(-50%, -50%);
  }
  .h-ping.grand {
    width: 6.4%;
  }
  .h-ping::before {
    content: '';
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-orange) 45%, transparent),
      transparent
    );
    opacity: var(--g, 0);
  }
  .h-ping > span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-orange) 85%, var(--color-white));
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-orange) 35%, transparent);
    opacity: 0;
  }
  .h-ping > span:first-child {
    opacity: calc((1 - var(--p1, 1)) * 0.9);
    transform: scale(calc(0.25 + var(--p1, 1) * 0.95));
  }
  .h-ping > span:last-child {
    opacity: calc((1 - var(--p2, 1)) * 0.6);
    transform: scale(calc(0.25 + var(--p2, 1) * 0.95));
  }

  /* Task stacks. Mobile: a single slot just above the title card; lg+: on their duo, in the scene. */
  .h-piles {
    position: relative;
    height: 84px;
    flex: none;
    pointer-events: none;
  }
  .h-pile {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: max-content;
    max-width: 100%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      --fx: 1;
    }
    .h-piles {
      position: absolute;
      z-index: 1;
      width: var(--sw);
      height: var(--sh);
      left: calc((100cqw - var(--sw)) * var(--fx));
      top: calc((100cqh - var(--sh)) / 2);
    }
    .h-pile {
      left: var(--x);
      top: var(--y);
      bottom: auto;
      width: 420px;
      max-width: none;
      transform: translate(var(--dx), -100%);
      align-items: var(--align);
    }
  }
  .h-slot {
    display: grid;
    grid-template-rows: 0fr;
    max-width: 100%;
    transition: grid-template-rows 0.6s var(--ease-hatch);
  }
  .h-slot > div {
    min-height: 0;
    overflow: hidden;
    padding: 3px 2px;
  }
  .h-slot.on {
    grid-template-rows: 1fr;
  }
  /* ---------- Task cards ----------
     Light glass pill, the language of the title card (chosen by César among three looks, 01/10). */
  .h-tache {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font: 600 12px/1.25 var(--font-sans);
    opacity: 0;
    filter: blur(6px);
    transform: translateY(14px) scale(0.94);
    transition:
      opacity 0.45s var(--ease-hatch),
      filter 0.45s var(--ease-hatch),
      transform 0.7s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  @media (min-width: 40rem) {
    .h-tache {
      font-size: 13px;
    }
  }
  .h-slot.on .h-tache {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .h-pile.sort .h-tache {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(-10px) scale(0.98);
    transition-duration: 0.45s;
  }
  .h-avatar {
    flex: none;
    object-fit: cover;
  }
  .h-corps {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .h-ligne {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
  }
  .h-texte {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .h-statut {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    font: 400 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .h-point {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange);
    animation: h-pulse 1.4s ease-out infinite;
  }
  @keyframes h-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-orange) 55%, transparent);
    }
    to {
      box-shadow: 0 0 0 6px transparent;
    }
  }
  .h-coche {
    width: 11px;
    height: 11px;
    display: none;
    fill: currentColor;
  }
  .h-tache.fait .h-point,
  .h-tache.fait .lib-cours,
  .h-tache:not(.fait) .lib-fait {
    display: none;
  }
  .h-tache.fait .h-coche {
    display: block;
  }
  .h-sep {
    flex: none;
    width: 1px;
    height: 12px;
  }

  .h-tache {
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    color: var(--color-ink);
    background: linear-gradient(
      -120deg,
      color-mix(in srgb, var(--color-white) 78%, transparent),
      color-mix(in srgb, var(--color-white) 55%, transparent)
    );
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow:
      0 10px 28px color-mix(in srgb, var(--color-navy) 22%, transparent),
      inset 0 1px 0 var(--color-white),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 70%, transparent);
  }
  .h-avatar {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-white);
  }
  .h-statut {
    padding: 4px 7px;
    border-radius: 999px;
    color: var(--color-orange-txt);
    background: var(--color-orange-tint);
  }
  .fait .h-statut {
    color: var(--color-soft);
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }
  .h-sep {
    display: none;
  }

  .h-pause .h-point {
    animation-play-state: paused;
  }

  /* Liquid-glass title card; the gradient rim is a masked layer so it follows the radius. */
  .carte-hero {
    isolation: isolate;
    background-image: linear-gradient(
      -123deg,
      color-mix(in srgb, var(--color-white) 55%, transparent) 14.6%,
      color-mix(in srgb, var(--color-white) 20%, transparent) 53.5%,
      color-mix(in srgb, var(--color-peach-2) 5%, transparent) 85.4%
    );
    box-shadow:
      0 30px 70px color-mix(in srgb, var(--color-navy) 22%, transparent),
      inset 0 2px 1px color-mix(in srgb, var(--color-white) 70%, transparent),
      inset 0 -12px 30px color-mix(in srgb, var(--color-white) 20%, transparent);
    backdrop-filter: blur(18px) saturate(1.15);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
  }
  .carte-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    pointer-events: none;
    background: linear-gradient(
      -123deg,
      var(--color-white) 14%,
      color-mix(in srgb, var(--color-white) 15%, transparent) 50%,
      color-mix(in srgb, var(--color-white) 60%, transparent) 85%
    );
    -webkit-mask:
      linear-gradient(var(--color-black) 0 0) content-box,
      linear-gradient(var(--color-black) 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(var(--color-black) 0 0) content-box exclude,
      linear-gradient(var(--color-black) 0 0);
  }
  .titre-hero {
    text-shadow: 0 0 10px color-mix(in srgb, var(--color-white) 50%, transparent);
  }
  .lead {
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--color-white) 50%, transparent));
  }
</style>
