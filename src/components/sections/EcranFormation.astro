---
/**
 * Hatch's training web app on an iPhone (Pecker; César 02/10: "you just see Hatch's app, the person
 * reads something, answers a few questions and passes the training, that's all"). Mirrors the real
 * reader (hatch-assistant, learning/reader): a sticky header (chapter, page counter, progress bar),
 * one page at a time in a single cream column, a bottom bar with the button; then the closing
 * screen. Site fonts stand in for the app's (Fraunces for its serif headings, Inter for the rest).
 * The markup renders the FINAL state (training passed, head office notified), which is what shows
 * without JS and under reduced motion; the GSAP timeline (demo-motion.ts `formation`) replays it on
 * the beats from demo-ecran.ts.
 */
import type { ImageMetadata } from 'astro';
import type { EcranFormation } from '../../content/schemas/demo';
import Iphone from '../ui/Iphone.astro';
import DemoSuivi from './DemoSuivi.astro';
import { chronoFormation } from './demo-ecran';

interface Props {
  ecran: EcranFormation;
  avatar: ImageMetadata;
}
const { ecran, avatar } = Astro.props;
const c = chronoFormation(ecran);
const s = (t: number) => t.toFixed(2);
/** Pages of the reader: the reading page, then one per question. */
const total = 1 + ecran.questions.length;
/** "{n} / {total}" around a rolling digit. */
const [compteurAvant, compteurApres] = ecran.compteur
  .replace('{total}', String(total))
  .split('{n}');

const I = {
  ok: 'M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z',
  wifi: 'M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8 3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4 2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z',
  /** A bookmark drawn on a 12 × 14 pixel grid, its notch in steps (the DS pixel style). */
  signet: 'M1 0h10v14h-1v-1h-1v-1h-1v-1h-1v-1h-2v1h-1v1h-1v1h-1v1h-1z',
};
---

<div class="ecr formation" data-duree={s(c.duree)} data-taps={c.taps.map(s).join(' ')}>
  <Iphone>
    <div class="f-ecran">
      <div class="f-statut" aria-hidden="true">
        <span>{ecran.heure}</span>
        <span class="icones">
          <svg class="reseau" viewBox="0 0 18 12">
            <rect x="0" y="8" width="3" height="4" rx="1"></rect>
            <rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect>
            <rect x="10" y="3" width="3" height="9" rx="1"></rect>
            <rect x="15" y="0" width="3" height="12" rx="1"></rect>
          </svg>
          <svg viewBox="0 0 24 24">
            <path d={I.wifi}></path>
          </svg>
          <svg class="batterie" viewBox="0 0 28 13">
            <rect x="0.5" y="0.5" width="23" height="12" rx="3.5"></rect>
            <rect class="plein" x="2" y="2" width="16" height="9" rx="2"></rect>
            <rect class="borne" x="25" y="4.5" width="2" height="4" rx="1"></rect>
          </svg>
        </span>
      </div>
      <header class="f-tete">
        <p class="f-chapitre">{ecran.chapitre}</p>
        <p class="f-compteur">
          <span>{compteurAvant}</span>
          <span class="f-fenetre">
            <span class="f-roue">
              {Array.from({ length: total }, (_, i) => <span>{i + 1}</span>)}
            </span>
          </span>
          <span>{compteurApres}</span>
        </p>
        <span class="f-progres" aria-hidden="true"><span></span></span>
      </header>
      {/* One page at a time, in the same cell. Final state: the last question, answered. */}
      <div class="f-pages">
        <section class="f-page f-lecture" data-t={s(c.lecture)}>
          <p class="f-titre f-morceau">{ecran.lecture.titre}</p>
          {ecran.lecture.lignes.map((l) => <p class="f-ligne f-morceau">{l}</p>)}
          <div class="f-retenir" data-t={s(c.retenir)}>
            <svg class="f-signet" viewBox="0 0 12 14" aria-hidden="true">
              <path d={I.signet}></path>
            </svg>
            <div>
              <p class="f-retenir-lib">{ecran.lecture.retenir.libelle}</p>
              <p>{ecran.lecture.retenir.texte}</p>
            </div>
          </div>
        </section>
        {
          ecran.questions.map((q, i) => (
            <section
              class="f-page f-question"
              data-t={s(c.questions[i].t)}
              data-c={s(c.questions[i].choix)}
              data-r={s(c.questions[i].retour)}
            >
              <p class="f-q f-morceau">{q.question}</p>
              <ul class="f-options">
                {q.options.map((o, j) => (
                  <li class:list={['f-opt f-morceau', { bonne: j === q.bonne }]}>
                    <span class="f-radio" aria-hidden="true">
                      {j === q.bonne && (
                        <span class="f-coche">
                          <svg viewBox="0 0 24 24">
                            <path d={I.ok} />
                          </svg>
                        </span>
                      )}
                    </span>
                    <span>{o}</span>
                    {j === q.bonne && <span class="f-doigt" aria-hidden="true" />}
                  </li>
                ))}
              </ul>
              <div class="f-retour">
                <p class="f-retour-boite">
                  <span class="f-retour-lib">{ecran.bonneReponse}</span>
                  {q.retour}
                </p>
              </div>
            </section>
          ))
        }
      </div>
      <footer class="f-pied">
        <span class="f-cta">
          <span class="f-libelles">
            <span class="f-continuer">{ecran.continuer}</span>
            <span class="f-valider">{ecran.valider}</span>
          </span>
          <span class="f-doigt" aria-hidden="true"></span>
        </span>
      </footer>
      {/* The closing screen, over the reader. */}
      <div class="f-fin" data-t={s(c.fin)}>
        <span class="f-rond" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d={I.ok}></path>
          </svg>
        </span>
        <p class="f-fin-titre">{ecran.fin.titre}</p>
        <p class="f-fin-texte">{ecran.fin.texte}</p>
      </div>
      <span class="f-accueil" aria-hidden="true"></span>
    </div>
  </Iphone>
  <DemoSuivi suivi={ecran.suivi} avatar={avatar} t={c.suivi} />
</div>

<style>
  .formation {
    position: relative;
    width: 100%;
  }
  /* Screen in iOS points, like the WhatsApp screen (370 pt wide, a notch of "larger text"). */
  .f-ecran {
    --pt: calc(100cqw / 370);
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-cream);
    font: 400 calc(15 * var(--pt)) / 1.55 var(--font-sans);
    color: var(--color-ink);
  }

  /* Status bar. */
  .f-statut {
    display: flex;
    flex: none;
    justify-content: space-between;
    align-items: center;
    height: calc(54 * var(--pt));
    padding: calc(4 * var(--pt)) calc(34 * var(--pt)) 0 calc(48 * var(--pt));
    font: 600 calc(17 * var(--pt)) / 1 var(--font-sans);
  }
  .icones {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--pt));
  }
  .icones svg {
    height: calc(13 * var(--pt));
    fill: currentColor;
  }
  .icones .reseau {
    height: calc(11 * var(--pt));
  }
  .batterie rect {
    fill: none;
    stroke: currentColor;
    opacity: 0.45;
  }
  .batterie .plein,
  .batterie .borne {
    fill: currentColor;
    stroke: none;
    opacity: 1;
  }
  .batterie .borne {
    opacity: 0.45;
  }

  /* Reader header: chapter, page counter, progress bar. */
  .f-tete {
    position: relative;
    z-index: 1;
    flex: none;
    padding: calc(6 * var(--pt)) calc(24 * var(--pt)) calc(12 * var(--pt));
    background: color-mix(in srgb, var(--color-cream) 80%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .f-chapitre {
    margin-bottom: calc(4 * var(--pt));
    font: 600 calc(11 * var(--pt)) / 1.3 var(--font-sans);
    letter-spacing: 0.025em;
    text-transform: uppercase;
    text-align: center;
    color: color-mix(in srgb, var(--color-orange-txt) 75%, transparent);
  }
  .f-compteur {
    display: flex;
    justify-content: center;
    font: 500 calc(12 * var(--pt)) / 1.2 var(--font-sans);
    font-variant-numeric: tabular-nums;
    color: var(--color-soft);
  }
  /* "{n} / {total}": the spaces around the digit are part of the copy. */
  .f-compteur > :not(.f-fenetre) {
    white-space: pre;
  }
  /* Rolling digit: a column of numbers behind a one-line window. Final state: the last page. */
  .f-fenetre {
    height: 1.2em;
    overflow: hidden;
  }
  .f-roue {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(-100% + 1.2em));
  }
  .f-progres {
    display: block;
    height: calc(4 * var(--pt));
    margin-top: calc(8 * var(--pt));
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-line);
  }
  .f-progres span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--color-orange);
  }

  /* Pages share one cell; only the last shows in the final state. */
  .f-pages {
    display: grid;
    flex: 1;
    min-height: 0;
    padding: calc(28 * var(--pt)) calc(24 * var(--pt)) 0;
  }
  .f-page {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--pt));
  }
  .f-page:not(:last-child) {
    visibility: hidden;
    opacity: 0;
  }

  /* Reading page: a small serif title, a few lines, the key point box. */
  .f-lecture {
    gap: calc(10 * var(--pt));
  }
  .f-titre {
    margin-bottom: calc(4 * var(--pt));
    font: 600 calc(22 * var(--pt)) / 1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .f-retenir {
    display: flex;
    gap: calc(12 * var(--pt));
    margin-top: calc(10 * var(--pt));
    padding: calc(18 * var(--pt)) calc(18 * var(--pt)) calc(18 * var(--pt)) calc(16 * var(--pt));
    border: 1px solid var(--color-amber-line);
    border-radius: calc(16 * var(--pt));
    background: var(--color-amber-tint);
    box-shadow: var(--shadow-1);
  }
  .f-signet {
    flex: none;
    width: calc(17 * var(--pt));
    margin-top: calc(1 * var(--pt));
    fill: var(--color-amber-txt);
    shape-rendering: crispEdges;
  }
  .f-retenir-lib {
    margin-bottom: calc(6 * var(--pt));
    font: 700 calc(11 * var(--pt)) / 1 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-amber-txt);
  }

  /* A question: serif prompt, options as bordered rows. --v (0 → 1, timeline) turns the right
     one green once tapped. */
  .f-q {
    font: 600 calc(24 * var(--pt)) / 1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .f-options {
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--pt));
  }
  .f-opt {
    --v: 0;
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(12 * var(--pt));
    padding: calc(12 * var(--pt)) calc(14 * var(--pt));
    border: calc(1.5 * var(--pt)) solid
      color-mix(in srgb, var(--color-success) calc(var(--v) * 100%), var(--color-line));
    border-radius: calc(12 * var(--pt));
    background: color-mix(
      in srgb,
      var(--color-success-tint) calc(var(--v) * 100%),
      var(--color-surface)
    );
    font: 500 calc(14 * var(--pt)) / 1.35 var(--font-sans);
    color: color-mix(in srgb, var(--color-success-txt) calc(var(--v) * 100%), var(--color-soft));
  }
  .f-opt.bonne {
    --v: 1;
  }
  .f-radio {
    position: relative;
    flex: none;
    width: calc(20 * var(--pt));
    height: calc(20 * var(--pt));
    border-radius: 999px;
    box-shadow: inset 0 0 0 calc(1.5 * var(--pt)) var(--color-stone);
  }
  .f-coche {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    background: var(--color-success);
  }
  .f-coche svg {
    width: calc(14 * var(--pt));
    fill: var(--color-white);
  }
  /* Feedback once the right option is picked; the timeline opens it from zero height. */
  .f-retour {
    overflow: hidden;
  }
  .f-retour-boite {
    margin-top: calc(4 * var(--pt));
    padding: calc(12 * var(--pt)) calc(16 * var(--pt));
    border: 1px solid color-mix(in srgb, var(--color-orange) 20%, transparent);
    border-radius: calc(12 * var(--pt));
    background: var(--color-orange-tint);
    font-size: calc(13 * var(--pt));
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .f-retour-lib {
    display: block;
    margin-bottom: calc(6 * var(--pt));
    font: 600 calc(10 * var(--pt)) / 1 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-txt);
  }

  /* Bottom bar: the reader's one button (ink, as the site's ink button: no white text on orange). */
  .f-pied {
    flex: none;
    padding: calc(12 * var(--pt)) calc(16 * var(--pt)) calc(34 * var(--pt));
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-cream) 95%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .f-cta {
    position: relative;
    display: grid;
    place-items: center;
    height: calc(48 * var(--pt));
    border-radius: calc(8 * var(--pt));
    background: var(--color-ink);
    font: 600 calc(15 * var(--pt)) / 1 var(--font-sans);
    color: var(--color-white);
  }
  .f-libelles {
    display: grid;
    justify-items: center;
  }
  .f-libelles > * {
    grid-area: 1 / 1;
  }
  .f-continuer {
    visibility: hidden;
    opacity: 0;
  }

  /* A fingertip, only seen during a tap (as on the WhatsApp screens). */
  .f-doigt {
    position: absolute;
    left: 62%;
    top: 55%;
    width: calc(44 * var(--pt));
    height: calc(44 * var(--pt));
    margin: calc(-22 * var(--pt)) 0 0 calc(-22 * var(--pt));
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
    box-shadow: 0 0 0 calc(3 * var(--pt)) color-mix(in srgb, var(--color-white) 75%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .f-opt .f-doigt {
    left: 78%;
  }

  /* Closing screen: a check in a tinted circle, "passed", who and what. */
  .f-fin {
    position: absolute;
    inset: calc(54 * var(--pt)) 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(14 * var(--pt));
    padding: 0 calc(36 * var(--pt)) calc(70 * var(--pt));
    background: var(--color-cream);
    text-align: center;
  }
  .f-rond {
    display: grid;
    place-items: center;
    width: calc(64 * var(--pt));
    height: calc(64 * var(--pt));
    margin-bottom: calc(8 * var(--pt));
    border-radius: 999px;
    background: var(--color-orange-tint);
  }
  .f-rond svg {
    width: calc(32 * var(--pt));
    fill: var(--color-orange);
  }
  .f-fin-titre {
    font: 600 calc(26 * var(--pt)) / 1.15 var(--font-display);
    letter-spacing: -0.015em;
  }
  .f-fin-texte {
    max-width: calc(270 * var(--pt));
    font-size: calc(14 * var(--pt));
    line-height: 1.5;
    color: var(--color-soft);
    text-wrap: balance;
  }
  .f-accueil {
    position: absolute;
    left: 50%;
    bottom: calc(8 * var(--pt));
    z-index: 3;
    width: calc(134 * var(--pt));
    height: calc(5 * var(--pt));
    margin-left: calc(-67 * var(--pt));
    border-radius: 999px;
    background: var(--color-ink);
  }
</style>
