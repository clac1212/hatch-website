---
/**
 * One of the home page's two doors (signature section, César 09/11): the whole voxel illustration on
 * top (2:1), then the audience, the title, one or two lines and the button on the card's tone.
 * The whole card is the link; the button is drawn as a <span>.
 * - `ton`: `clair` (cream card, ink text) or `sombre` (night card, cream text).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Carte from '../ui/Carte.astro';

interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  kicker: string;
  titre: string;
  texte: string;
  cta: string;
  ton: 'clair' | 'sombre';
}
const { href, image, alt, kicker, titre, texte, cta, ton } = Astro.props;
const sombre = ton === 'sombre';
---

<Carte
  href={href}
  variante="image"
  taille="panneau"
  class:list={['porte flex flex-col', sombre ? 'porte-sombre' : 'porte-claire']}
  data-rv-groupe
>
  <!-- The illustration -->
  <div class="porte-image relative overflow-clip">
    <Picture
      src={image}
      alt={alt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 768px) 50vw, 100vw"
      formats={['avif', 'webp']}
      class="carte-zoom size-full object-cover object-[50%_40%]"
    />
  </div>

  <div
    class:list={[
      'plaque vitre rounded-interieur flex flex-col items-start gap-2',
      sombre ? 'plaque-sombre text-cream' : 'plaque-claire text-ink',
    ]}
  >
    <span
      class:list={[
        'kicker font-mono text-kicker uppercase',
        sombre ? 'text-peach' : 'text-orange-txt',
      ]}
    >
      {kicker}
    </span>
    <h2 class="font-display text-section font-semibold text-balance">{titre}</h2>
    <p class="texte max-w-lead text-body">{texte}</p>
    <span class="mt-3">
      <Button variant={sombre ? 'cream' : 'orange'}>{cta}</Button>
    </span>
  </div>
</Carte>

<style>
  /* Default layout (César 09/11): the whole illustration on top, the text below on the card's tone,
     nothing laid over the picture. */
  .porte-claire {
    background-color: var(--color-surface);
    box-shadow: var(--shadow-carte);
  }
  .porte-sombre {
    background-color: var(--color-night);
  }
  .porte-image {
    aspect-ratio: 2 / 1;
  }
  /* The picture fills the frame without sizing it (else its own 16:10 would win over the 2:1). */
  .porte-image > :global(picture),
  .porte-image > :global(img) {
    position: absolute;
    inset: 0;
  }
  .plaque {
    margin: 0;
    padding: 24px 28px 28px;
    background: none;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  @media (width >= 64rem) {
    .plaque {
      padding: 28px 36px 32px;
    }
  }
  .plaque::before {
    display: none;
  }
  .plaque-claire .texte {
    color: var(--color-soft);
  }
  .plaque-sombre .texte {
    color: color-mix(in srgb, var(--color-cream) 75%, transparent);
  }

  /* The other layout, being compared (dev switcher « Mise en page portes »): the illustration fills
     the card and the text sits on a glass plate over it. */
  :global(html[data-porte='plaque']) .porte {
    min-height: 40rem;
    justify-content: flex-end;
  }
  :global(html[data-porte='plaque']) .porte-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    aspect-ratio: auto;
  }
  :global(html[data-porte='plaque']) .plaque {
    --inset: 16px;
    margin: 16px;
    padding: 28px;
    transition: translate 0.5s var(--ease-hatch);
  }
  :global(html[data-porte='plaque']) .plaque::before {
    display: block;
  }
  :global(html[data-porte='plaque']) .plaque-claire {
    background-color: color-mix(in srgb, var(--color-cream) 88%, transparent);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px) var(--vitre-filtre,);
  }
  /* Dark glass, Apple's way: nearly clear, heavily blurred and saturated, a bright hairline rim. */
  :global(html[data-porte='plaque']) .plaque-sombre {
    background-color: color-mix(in srgb, var(--color-black) 30%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.8) brightness(0.85);
    backdrop-filter: blur(18px) var(--vitre-filtre,) saturate(1.8) brightness(0.85);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 35%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 14%, transparent);
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-black) 25%, transparent);
  }
  :global(html[data-porte='plaque']) :global(.carte-lien:hover) .plaque {
    translate: 0 -4px;
  }
</style>
