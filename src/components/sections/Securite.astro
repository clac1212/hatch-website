---
import { Picture, getImage } from 'astro:assets';
import { section } from '../../content/section';
import { routes, type Locale } from '../../i18n/ui';
import fond from '../../assets/securite/fond-orange-grain.jpg';
import jay from '../../assets/securite/jay.png';
import finch from '../../assets/securite/finch.png';
import owl from '../../assets/securite/owl.png';

/** 09 — Sécurité (v4 node P9SBbe): orange grain band, title + link, three voxel-bird guarantees. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('securite', locale);
const href = routes.security[locale];
const bg = await getImage({ src: fond, format: 'webp', width: 1440, quality: 70 });
// Europe, GDPR, no AI training — at 170 px high their natural widths match the mockup (169, 215, 165).
const oiseaux = [jay, finch, owl];
---

<section
  id="securite"
  aria-labelledby="securite-titre"
  data-rv-groupe
  class="bg-orange bg-cover bg-center px-6 py-14 md:px-12 md:py-[72px] xl:px-24"
  style={`background-image:url(${bg.src})`}
>
  <div class="mx-auto flex max-w-[1248px] flex-col gap-10 md:gap-12 xl:flex-row xl:items-center">
    <div data-rv class="flex flex-col items-start gap-3.5 xl:w-[380px] xl:shrink-0">
      <h2
        id="securite-titre"
        class="font-display text-[28px] leading-[1.09] font-bold tracking-[-0.8px] text-night md:text-[34px] md:leading-[37px]"
      >
        {data.titre}
      </h2>
      <a
        href={href}
        class="lien-secu -mb-[0.75px] inline-flex items-center gap-2 border-b-[1.5px] border-night pt-1 pb-[3px] text-[15px] font-semibold text-night"
      >
        {data.lien}
        <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor" aria-hidden="true">
          <path
            d="M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zm-2 4V7h2v8zm-2 2V5h2v12z"
          ></path>
        </svg>
      </a>
    </div>

    <ul class="flex flex-col gap-8 sm:flex-row sm:items-end sm:gap-0 xl:flex-1">
      {
        data.garanties.map((g, i) => (
          <li data-rv class="flex flex-1 flex-col items-start gap-[18px] sm:px-4 lg:px-7">
            <Picture
              src={oiseaux[i]}
              alt={g.alt}
              height={170}
              densities={[1, 2]}
              formats={['avif', 'webp']}
              class="h-[120px] w-auto max-w-full object-contain sm:h-[140px] md:h-[170px]"
            />
            <a
              href={href}
              class="lien-secu inline-flex items-center gap-2 text-[17px] font-bold text-night lg:whitespace-nowrap"
            >
              {g.titre}
              <svg
                viewBox="0 0 24 24"
                class="size-4 shrink-0"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zM14 15V7h2v8zm-2 2V5h2v12z" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lien-secu svg {
    transition: transform 0.35s var(--ease-hatch);
  }
  .lien-secu:hover svg {
    transform: translateX(4px);
  }
</style>
