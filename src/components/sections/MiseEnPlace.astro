---
import { Image } from 'astro:assets';
import { section } from '../../content/section';
import { routes, useTranslations, type Locale } from '../../i18n/ui';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import srcGoogleDrive from '../../assets/miseEnPlace/src-google-drive.png';
import srcNotion from '../../assets/miseEnPlace/src-notion.png';
import srcWord from '../../assets/miseEnPlace/src-word.png';
import srcPdf from '../../assets/miseEnPlace/src-pdf.jpg';
import srcExcel from '../../assets/miseEnPlace/src-excel.png';
import srcOnedrive from '../../assets/miseEnPlace/src-onedrive.png';
import sparrow from '../../assets/miseEnPlace/sparrow.png';
import jay from '../../assets/miseEnPlace/jay.png';
import owl from '../../assets/miseEnPlace/owl.png';

/**
 * "Mise en place" (v4 node REj0g): a pinned track with three app windows that cross-fade on scroll —
 * the sources connect one by one, the agents set themselves up, the teams use them.
 * Two layouts share this markup:
 * - pinned (`.epingle`, set by src/scripts/miseEnPlace.ts from md up when motion is allowed): a fixed
 *   1000 × 980 stage scaled by the shared track engine, one window at a time;
 * - stacked (default: mobile, no JS, reduced motion): the three windows one below the other, each under
 *   its step title, in their final state.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const data = await section('miseEnPlace', locale);
const { sources, agents, channels } = data;

const logos = {
  'google-drive': srcGoogleDrive,
  notion: srcNotion,
  word: srcWord,
  pdf: srcPdf,
  excel: srcExcel,
  onedrive: srcOnedrive,
};
const birds = { sparrow, jay, owl };

/** Pixel icons of the mockup (pixelarticons, 24 × 24; WhatsApp is Phosphor, 256 × 256). */
const icons = {
  euro: 'M19 20H9v-2h10v2ZM9 9h7v2H9v2h7v2H9v3H7v-3H5v-2h2v-2H5V9h2V6h2v3Zm10-3H9V4h10v2Z',
  calendar:
    'M5 4h14v2H5zm0 16h14v2H5zM3 10h2v10H3zm0-4h2v2H3zm16 0h2v2h-2zm0 4h2v10h-2zM3 8h18v2H3zm12-6h2v2h-2zM7 2h2v2H7z',
  shield:
    'M4 2h16v2H4zM2 4h2v10H2zm18 0h2v10h-2zM4 14h2v2H4zm2 2h2v2H6zm4 4h4v2h-4zm10-6h-2v2h2zm-2 2h-2v2h2zm-2 2h-2v2h2zm-6 0H8v2h2z',
  users:
    'M5 2h6v2H5zm10 0h4v2h-4zM5 10h6v2H5zm10 0h4v2h-4zm4-6h2v6h-2zm-8 0h2v6h-2zM3 4h2v6H3zM0 18h2v4H0zm14 0h2v4h-2zm8 0h2v4h-2zM4 14h8v2H4zm12 0h4v2h-4zM2 16h2v2H2zm10 0h2v2h-2zm8 0h2v2h-2z',
  check:
    'M10 18H8v-2h2v2Zm-2-2H6v-2h2v2Zm4-2v2h-2v-2h2Zm-6 0H4v-2h2v2Zm8 0h-2v-2h2v2Zm2-2h-2v-2h2v2Zm2-2h-2V8h2v2Zm2-2h-2V6h2v2Z',
  clock: 'M5 3h14v2H5zm0 16h14v2H5zM3 5h2v14H3zm16 0h2v14h-2zm-8 2h2v6h-2zm2 6h4v2h-4z',
  mail: 'M6 8h2v2H6zm2 2h2v2H8zm10-2h-2v2h2zm-2 2h-2v2h2zm-6 2h4v2h-4zM2 6h2v12H2zm18 0h2v12h-2zM4 4h16v2H4zm0 14h16v2H4z',
  tablet: 'M5 2h14v2H5zm0 18h14v2H5zM3 4h2v16H3zm16 0h2v16h-2zm-8 12h2v2h-2z',
  arrow:
    'M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2zM14 15V7h2v8zm-2 2V5h2v12z',
  close:
    'M7 19H5V17H7V19ZM19 19H17V17H19V19ZM9 15V17H7V15H9ZM17 17H15V15H17V17ZM11 15H9V13H11V15ZM15 15H13V13H15V15ZM13 13H11V11H13V13ZM11 11H9V9H11V11ZM15 11H13V9H15V11ZM9 9H7V7H9V9ZM17 9H15V7H17V9ZM7 7H5V5H7V7ZM19 7H17V5H19V7Z',
};
const whatsapp =
  'M187.3,159.06A36.09,36.09,0,0,1,152,188a84.09,84.09,0,0,1-84-84A36.09,36.09,0,0,1,96.94,68.7,12,12,0,0,1,110,75.1l11.48,23a12,12,0,0,1-.75,12l-8.52,12.78a44.56,44.56,0,0,0,20.91,20.91l12.78-8.52a12,12,0,0,1,12-.75l23,11.48A12,12,0,0,1,187.3,159.06ZM236,128A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z';
/** Channel tiles: WhatsApp green and Mail blue have no token yet (see the report), closest tokens used. */
const channelTile = { whatsapp: 'bg-whatsapp-brand', mail: 'bg-mail', tablet: 'bg-night' };

const connectedCount = sources.documents.items.filter((s) => s.connected).length;
const plural = new Intl.PluralRules(locale).select(connectedCount) === 'one' ? 'one' : 'other';
const counterText = sources.counter[plural].replace('{n}', String(connectedCount));

/** Light trails of the night background, in % of the 1440 × 980 v4 mockup so they follow any box. */
const trails = [
  { l: 5.56, t: 19.39, w: 69.44, h: 6, r: 8, o: 0.55, c: 'bg-orange' },
  { l: 36.11, t: 42.86, w: 62.5, h: 4, r: -6, o: 0.45, c: 'bg-orange' },
  { l: -4.17, t: 73.47, w: 83.33, h: 5, r: 5, o: 0.4, c: 'bg-peach' },
  { l: 48.61, t: 94.9, w: 55.56, h: 3, r: -9, o: 0.5, c: 'bg-orange' },
];

const label = 'font-mono text-[13px] tracking-[0.4px] text-gray-500 md:text-[12px]';
const avatar = 'relative shrink-0 overflow-hidden rounded-full bg-peach-2';
const bubble = 'px-3.5 py-2.5 text-[14px] max-md:leading-snug md:whitespace-nowrap';
---

<section
  id="mise-en-place"
  class="piste mep overflow-x-clip bg-night"
  data-piste="mep"
  data-longueurs="130,130,130"
  data-cadence="900"
  aria-labelledby="mep-titre"
>
  <div class="collant">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      {
        trails.map((tr) => (
          <span
            class:list={['trainee', tr.c]}
            style={`left:${tr.l}%;top:${tr.t}%;width:${tr.w}%;height:${tr.h}px;opacity:${tr.o};rotate:${tr.r}deg`}
          />
        ))
      }
    </div>

    <div class="cadre-piste px-4 py-20 md:px-8 md:py-28" data-largeur="1000" data-hauteur="980">
      <div class="halo" aria-hidden="true"></div>

      <h2
        id="mep-titre"
        class="mep-titre relative text-center font-sans text-[clamp(2.125rem,1.4rem+3vw,3.75rem)] leading-[1.08] font-semibold tracking-[-0.033em] text-balance text-white"
      >
        {data.title}
      </h2>

      <!-- Step indicator of the pinned layout (the stacked layout titles each window instead). -->
      <ol
        class="mep-etapes hidden items-center justify-center gap-5 leading-[normal]"
        aria-hidden="true"
      >
        {
          data.steps.map((step, i) => (
            <li
              class="pas flex items-center gap-5"
              data-mep-pas={i}
              data-etat={i === 0 ? 'actif' : 'a-venir'}
            >
              {i > 0 && <span class="trait h-px w-14" />}
              <span class="flex items-center gap-2.5">
                <span class="num grid size-6 place-items-center rounded-full font-mono text-[12px]">
                  {i + 1}
                </span>
                <span class="lib text-[15px] font-medium whitespace-nowrap">{step}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <ol class="mep-etats relative mt-12 flex flex-col gap-14 md:mt-16 md:gap-20">
        {
          [sources.title, agents.title, channels.title].map((windowTitle, i) => (
            <li class:list={['mep-etat', i === 0 && 'actif']} data-mep-etat={i}>
              <h3 class="mep-etat-titre mx-auto mb-4 flex max-w-[760px] items-center gap-2.5 text-[15px] font-medium text-white">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-orange font-mono text-[13px] text-white">
                  {i + 1}
                </span>
                {data.steps[i]}
              </h3>

              <div class="fenetre mx-auto w-full max-w-[760px] overflow-hidden leading-[normal] rounded-[10px] bg-white font-sans text-ink">
                <div class="flex items-center gap-3 px-4 py-4 md:px-7 md:py-5">
                  <div class="flex flex-1 items-center gap-3">
                    <Logo class="w-16 shrink-0" />
                    <p class="text-[16px] font-semibold md:text-[18px]">{windowTitle}</p>
                  </div>
                  <svg
                    viewBox="0 0 24 24"
                    class="size-[18px] shrink-0 text-gray-500"
                    aria-hidden="true"
                  >
                    <path d={icons.close} fill="currentColor" />
                  </svg>
                </div>

                <div class="flex flex-col gap-[18px] px-4 pt-1 pb-6 md:px-7">
                  {i === 0 && (
                    <>
                      <div
                        class="flex items-center gap-2.5 rounded-lg bg-gray-100/70 px-3.5 py-[11px] text-[14px] text-gray-500"
                        aria-hidden="true"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          class="size-4 shrink-0"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                        >
                          <circle cx="11" cy="11" r="7" />
                          <path d="m20 20-3.5-3.5" />
                        </svg>
                        {sources.search}
                      </div>

                      <div class="flex flex-col gap-2.5">
                        <p class={label}>{sources.documents.label}</p>
                        <ul class="grid grid-cols-3 gap-2 md:flex md:gap-3">
                          {sources.documents.items.map((src) => (
                            <li
                              class:list={[
                                'flex min-w-0 flex-1 flex-col gap-2.5 rounded-lg bg-white p-3 outline-1 -outline-offset-1 md:p-3.5',
                                src.connected ? 'outline-peach' : 'outline-gray-100',
                              ]}
                              data-source={src.connected ? 'connecte' : undefined}
                            >
                              <Image
                                src={logos[src.logo]}
                                alt=""
                                width={28}
                                densities={[1, 2]}
                                class="size-7 object-contain"
                              />
                              <p class="text-[13px] font-semibold">{src.name}</p>
                              <p class="flex items-center gap-1.5 text-[13px] md:text-[12px]">
                                <span
                                  class:list={[
                                    'point size-[7px] shrink-0 rounded-full',
                                    src.connected ? 'bg-success' : 'bg-stone',
                                  ]}
                                />
                                <span
                                  class:list={['libelle', !src.connected && 'text-gray-500']}
                                  data-on={sources.documents.connected}
                                  data-off={sources.documents.connect}
                                >
                                  {src.connected
                                    ? sources.documents.connected
                                    : sources.documents.connect}
                                </span>
                              </p>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="flex flex-col gap-2.5">
                        <p class={label}>{sources.tools.label}</p>
                        <ul class="grid grid-cols-2 gap-2 md:flex md:gap-3">
                          {sources.tools.items.map((tool) => (
                            <li class="flex min-w-0 flex-1 flex-col gap-2.5 rounded-lg bg-white p-3 outline-1 -outline-offset-1 outline-peach md:p-3.5">
                              <span class="grid size-7 place-items-center rounded-md bg-peach-2 text-orange">
                                <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
                                  <path d={icons[tool.icon]} fill="currentColor" />
                                </svg>
                              </span>
                              <p class="text-[13px] font-semibold">{tool.name}</p>
                              <p class="flex items-center gap-1.5 text-[13px] md:text-[12px]">
                                <span class="size-[7px] shrink-0 rounded-full bg-orange" />
                                {sources.tools.state}
                              </p>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </>
                  )}

                  {i === 1 && (
                    <>
                      <div class="flex flex-col gap-2.5">
                        <p class={label}>{agents.conversation.label}</p>
                        <ul class="flex flex-col gap-2.5">
                          {agents.conversation.messages.map((m) =>
                            m.from === 'agent' ? (
                              <li class="anim flex items-end gap-2.5" data-bulle>
                                <span class:list={[avatar, 'size-8']}>
                                  <Image
                                    src={birds[m.bird]}
                                    alt=""
                                    width={29}
                                    densities={[1, 2]}
                                    class="absolute top-0 left-0 size-[28.16px] object-contain"
                                  />
                                </span>
                                <p
                                  class:list={[
                                    bubble,
                                    'rounded-[14px_14px_14px_4px] bg-gray-100/80',
                                  ]}
                                >
                                  {m.text}
                                </p>
                              </li>
                            ) : (
                              <li class="anim flex justify-end" data-bulle>
                                <p
                                  class:list={[
                                    bubble,
                                    'rounded-[14px_14px_4px_14px] bg-orange text-white',
                                  ]}
                                >
                                  {m.text}
                                </p>
                              </li>
                            ),
                          )}
                        </ul>
                      </div>

                      <div class="flex flex-col gap-2.5">
                        <p class={label}>{agents.migration.label}</p>
                        <ul class="flex flex-col">
                          {agents.migration.rows.map((row) => {
                            const complete = row.done === row.total;
                            return (
                              <li
                                class="flex flex-wrap items-center gap-x-3.5 gap-y-2 border-b border-gray-100 py-2.5 last:border-b-0 md:flex-nowrap"
                                data-ligne
                                data-fait={row.done}
                                data-total={row.total}
                              >
                                <span class:list={[avatar, 'size-7']}>
                                  <Image
                                    src={birds[row.bird]}
                                    alt=""
                                    width={25}
                                    densities={[1, 2]}
                                    class="absolute top-0 left-0 size-[24.64px] object-contain"
                                  />
                                </span>
                                <p class="min-w-0 flex-1 text-[14px] font-semibold md:w-[170px] md:flex-none">
                                  {row.name}
                                </p>
                                <span class="relative order-last h-1 basis-full rounded-[2px] bg-gray-100 md:order-none md:flex-1 md:basis-auto">
                                  <span
                                    class:list={[
                                      'barre absolute inset-y-0 left-0 rounded-[2px]',
                                      complete ? 'bg-success' : 'bg-orange',
                                    ]}
                                    style={`width:${(row.done / row.total) * 100}%`}
                                    data-barre
                                  />
                                </span>
                                <p
                                  class="font-mono text-[13px] whitespace-nowrap text-gray-700 md:w-20 md:text-right"
                                  data-valeur
                                >
                                  {row.done} / {row.total}
                                </p>
                                <span
                                  class:list={[
                                    'anim grid size-[22px] shrink-0 place-items-center rounded-full',
                                    complete
                                      ? 'bg-success/10 text-success'
                                      : 'bg-peach-2 text-orange',
                                  ]}
                                  data-etat-ligne
                                >
                                  <svg viewBox="0 0 24 24" class="size-[13px]" aria-hidden="true">
                                    <path
                                      d={complete ? icons.check : icons.clock}
                                      fill="currentColor"
                                    />
                                  </svg>
                                </span>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    </>
                  )}

                  {i === 2 && (
                    <>
                      <div class="flex flex-col gap-2.5">
                        <p class={label}>{channels.label}</p>
                        <ul class="grid gap-2 sm:grid-cols-3 md:flex md:gap-3">
                          {channels.items.map((ch) => (
                            <li
                              class="anim flex min-w-0 flex-1 items-center gap-3 rounded-lg bg-white p-3.5 outline-1 -outline-offset-1 outline-peach"
                              data-canal
                            >
                              <span
                                class:list={[
                                  'grid size-8 shrink-0 place-items-center rounded-lg text-white',
                                  channelTile[ch.icon],
                                ]}
                              >
                                {ch.icon === 'whatsapp' ? (
                                  <svg viewBox="0 0 256 256" class="size-[19px]" aria-hidden="true">
                                    <path d={whatsapp} fill="currentColor" />
                                  </svg>
                                ) : (
                                  <svg viewBox="0 0 24 24" class="size-[17px]" aria-hidden="true">
                                    <path d={icons[ch.icon]} fill="currentColor" />
                                  </svg>
                                )}
                              </span>
                              <span class="flex flex-col gap-1">
                                <span class="text-[14px] font-semibold">{ch.name}</span>
                                <span class="flex items-center gap-1.5 text-[13px] md:text-[12px]">
                                  <span class="size-[7px] shrink-0 rounded-full bg-success" />
                                  {channels.active}
                                </span>
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="flex flex-col gap-2.5">
                        <p class={label}>{channels.thread.label}</p>
                        <div class="flex flex-col gap-3 rounded-lg bg-paper p-4 md:p-[18px]">
                          <div class="anim flex items-start gap-2.5" data-fil>
                            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-stone text-[13px] font-semibold text-ink md:text-[12px]">
                              {channels.thread.question.initials}
                            </span>
                            <div class="flex min-w-0 flex-col gap-1">
                              <p class="text-[13px] font-semibold text-soft md:text-[12px]">
                                {channels.thread.question.who}
                              </p>
                              <p class="rounded-[4px_14px_14px_14px] bg-white px-[13px] py-[9px] text-[14px] max-md:leading-snug md:whitespace-nowrap">
                                {channels.thread.question.text}
                              </p>
                            </div>
                          </div>
                          <div class="anim flex items-start gap-2.5" data-fil>
                            <span class:list={[avatar, 'size-8']}>
                              <Image
                                src={birds[channels.thread.answer.bird]}
                                alt=""
                                width={29}
                                densities={[1, 2]}
                                class="absolute top-[3.84px] left-[1.92px] size-[28.16px] object-contain"
                              />
                            </span>
                            <div class="flex min-w-0 flex-col gap-1">
                              <p class="text-[13px] font-semibold text-orange-txt md:text-[12px]">
                                {channels.thread.answer.who}
                              </p>
                              <p class="rounded-[4px_14px_14px_14px] bg-white px-[13px] py-[9px] text-[14px] max-md:leading-snug md:whitespace-nowrap">
                                {channels.thread.answer.text}
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </>
                  )}
                </div>

                <div class="flex flex-wrap items-center gap-3 border-t border-gray-100 bg-gray-50 px-4 py-4 md:px-7">
                  <p
                    class="flex-1 text-[14px] text-gray-700"
                    data-compteur={i === 0 ? '' : undefined}
                    data-one={i === 0 ? sources.counter.one : undefined}
                    data-other={i === 0 ? sources.counter.other : undefined}
                  >
                    {i === 0 ? counterText : i === 1 ? agents.footer : channels.footer}
                  </p>
                  {i < 2 ? (
                    <span
                      class="inline-flex items-center gap-2 rounded-[4px] bg-orange px-[18px] py-2.5 text-[14px] font-semibold text-white"
                      aria-hidden="true"
                    >
                      {data.next}
                      <svg viewBox="0 0 24 24" class="size-4">
                        <path d={icons.arrow} fill="currentColor" />
                      </svg>
                    </span>
                  ) : (
                    <Button href={routes.demo[locale]} variant="orange" size="sm" data-mep-cta>
                      {t('cta.demo')}
                    </Button>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '../../scripts/miseEnPlace';
</script>

<style>
  /* ---------- Night background ---------- */
  .trainee {
    position: absolute;
    filter: blur(20px);
    transform-origin: top left;
  }
  .halo {
    position: absolute;
    left: 50%;
    top: 20px;
    width: 600px;
    height: 300px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      color-mix(in srgb, var(--color-orange) 20%, transparent),
      transparent
    );
    pointer-events: none;
  }
  .fenetre {
    box-shadow:
      0 0 90px color-mix(in srgb, var(--color-orange) 25%, transparent),
      0 8px 24px color-mix(in srgb, var(--color-black) 4%, transparent);
  }

  /* ---------- Stacked layout (default): the shared engine sizes the track and stage inline, undo it ---------- */
  .mep:not(.epingle) {
    height: auto !important;
  }
  .mep:not(.epingle) .collant {
    position: static;
    height: auto;
    overflow: visible;
  }
  .mep:not(.epingle) .cadre-piste {
    position: relative;
    width: auto !important;
    height: auto !important;
    transform: none !important;
  }

  /* ---------- Pinned layout: 1000 × 980 stage, v4 positions (window at 340 px in the 1440 mockup) ---------- */
  .epingle .cadre-piste {
    padding: 0;
  }
  .epingle .mep-titre {
    position: absolute;
    top: 110px;
    left: 0;
    width: 100%;
    font-size: 60px;
    line-height: normal;
    letter-spacing: -2px;
    white-space: nowrap;
  }
  .epingle .mep-etats {
    position: static;
    margin: 0;
  }
  .epingle .mep-etat {
    position: absolute;
    left: 120px;
    top: 290px;
    width: 760px;
    opacity: 0;
    pointer-events: none;
    transform: translateX(48px) scale(0.98);
    transition:
      opacity 0.8s var(--ease-hatch),
      transform 1s var(--ease-hatch);
  }
