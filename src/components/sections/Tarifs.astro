---
import { Picture, Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { section } from '../../content/section';
import { routes, type Locale } from '../../i18n/ui';
import comptoir from '../../assets/tarifs/comptoir.jpg';
import cuisine from '../../assets/tarifs/cuisine.jpg';
import restaurant from '../../assets/tarifs/restaurant.jpg';
import peep from '../../assets/tarifs/agents/peep.png';
import owl from '../../assets/tarifs/agents/owl.png';
import pecker from '../../assets/tarifs/agents/pecker.png';
import lark from '../../assets/tarifs/agents/lark.png';
import jay from '../../assets/tarifs/agents/jay.png';
import finch from '../../assets/tarifs/agents/finch.png';
import sparrow from '../../assets/tarifs/agents/sparrow.png';

/**
 * 10 — Tarifs (v4 node sZQeq): monthly / yearly switch, three offers with a diorama, "all included" band.
 * The switch is two native radios: CSS (`:has(:checked)`) swaps the prices, so it works without JS;
 * the script only measures the pill so the dark cursor can slide between the two options.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await section('tarifs', locale);
const demo = routes.demo[locale];
const dioramas = [comptoir, cuisine, restaurant];
const agents = [peep, owl, pecker, lark, jay, finch, sparrow];
---

<section
  id="tarifs"
  aria-labelledby="tarifs-titre"
  data-rv-groupe
  class="tarifs section-y bg-cream px-5 md:px-12 xl:px-24"
>
  <div class="mx-auto flex max-w-[1248px] flex-col gap-10 md:gap-11">
    <div data-rv class="flex flex-col items-center gap-5 text-center md:gap-4">
      <h2
        id="tarifs-titre"
        class="font-display text-[36px] leading-[1.06] font-bold tracking-[-1px] text-ink md:text-[52px] md:leading-[54px] md:tracking-[-1.4px]"
      >
        {
          data.titre.map((ligne, i) => (
            <>
              {i > 0 && ' '}
              <span class="md:block">{ligne}</span>
            </>
          ))
        }
      </h2>

      <fieldset
        data-formule
        class="formule relative flex gap-1 rounded-full bg-white p-[5px] outline outline-line -outline-offset-1"
      >
        <legend class="sr-only">{data.formule.legende}</legend>
        <span class="formule-curseur" aria-hidden="true"></span>
        <label>
          <input type="radio" name="formule-tarifs" value="mensuel" class="sr-only" />
          {data.formule.mensuel}
        </label>
        <label>
          <input type="radio" name="formule-tarifs" value="annuel" class="sr-only" checked />
          {data.formule.annuel}
        </label>
      </fieldset>
    </div>

    <ul class="grid gap-5 lg:grid-cols-3">
      {
        data.offres.map((offre, i) => {
          const nuit = i === 2;
          return (
            <li data-rv class="offre">
              <article
                class:list={[
                  'carte flex h-full flex-col overflow-hidden rounded-[24px] lg:min-h-[605px]',
                  nuit
                    ? 'bg-night outline-2 outline-orange -outline-offset-1'
                    : 'bg-white outline outline-line -outline-offset-1',
                ]}
              >
                <div class="h-[260px] shrink-0 overflow-hidden sm:h-[340px]">
                  <Picture
                    pictureAttributes={{ class: 'block size-full' }}
                    src={dioramas[i]}
                    alt={offre.alt}
                    widths={[420, 640, 840]}
                    sizes="(min-width: 1440px) 402px, (min-width: 1024px) 31vw, (min-width: 768px) calc(100vw - 96px), calc(100vw - 40px)"
                    formats={['avif', 'webp']}
                    class="diorama size-full object-cover"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-3.5 px-6 pt-[22px] pb-6">
                  <div class="flex flex-col gap-1">
                    <h3
                      class:list={[
                        'font-display text-[26px] leading-[1.22] font-bold whitespace-pre-line xl:text-[28px]',
                        nuit ? 'text-paper' : 'text-ink',
                      ]}
                    >
                      {offre.nom}
                    </h3>
                    <p class:list={['text-[14px]', nuit ? 'text-white/70' : 'text-soft']}>
                      {offre.type}
                    </p>
                  </div>
                  <p class="mt-auto flex items-end gap-2 pt-1.5">
                    <span
                      class:list={[
                        'montants grid font-display text-[48px] leading-[48px] font-bold tracking-[-1.5px] whitespace-nowrap',
                        nuit ? 'text-paper' : 'text-ink',
                      ]}
                      style={`--i:${i}`}
                    >
                      <span class="montant montant-annuel">
                        {offre.prix.annuel} €<span class="sr-only"> {data.factureAnnuel}</span>
                      </span>
                      <span class="montant montant-mensuel">
                        {offre.prix.mensuel} €<span class="sr-only"> {data.factureMensuel}</span>
                      </span>
                    </span>
                    <span
                      aria-hidden="true"
                      class:list={['pb-1 text-[13px]', nuit ? 'text-white/70' : 'text-soft']}
                    >
                      {data.unite}
                    </span>
                  </p>
                  {nuit ? (
                    <Button href={demo} variant="cream" block>
                      {data.cta}
                    </Button>
                  ) : (
                    <Button
                      href={demo}
                      variant="ink"
                      block
                      class="[&_svg]:text-orange [&:hover_svg]:text-white"
                    >
                      {data.cta}
                    </Button>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>

    <div
      data-rv
      class="flex flex-col gap-4 rounded-[20px] bg-white px-[22px] py-[18px] outline outline-line -outline-offset-1 lg:flex-row lg:items-center lg:justify-between lg:gap-6"
    >
      <p class="flex items-center gap-2.5 font-display text-[19px] font-bold text-ink">
        <svg viewBox="0 0 24 24" class="size-5 shrink-0 fill-orange" aria-hidden="true">
          <path
            d="M10 18h-2v-2h2v2zm-2-2h-2v-2h2v2zm4-2v2h-2v-2h2zm-6 0h-2v-2h2v2zm8 0h-2v-2h2v2zm2-2h-2v-2h2v2zm2-2h-2v-2h2v2zm2-2h-2v-2h2v2z"
          ></path>
        </svg>
        {data.inclus.titre}
      </p>
      <ul class="flex flex-col gap-4 lg:contents">
        <li class="inclus-item flex items-center gap-3 xl:box-content xl:h-[34px] xl:w-[363.5px]">
          <span class="flex shrink-0">
            {
              agents.map((a) => (
                <Image
                  src={a}
                  alt=""
                  width={34}
                  densities={[1, 2]}
                  class="size-7 object-contain sm:size-[34px]"
                />
              ))
            }
          </span>
          {data.inclus.agents}
        </li>
        <li class="inclus-item flex items-center gap-3 xl:box-content xl:w-[197.5px]">
          <svg viewBox="0 0 24 24" class="size-[22px] shrink-0 fill-ink" aria-hidden="true">
            <path
              d="M5 2h6v2h-6zm10 0h4v2h-4zm-10 8h6v2h-6zm10 0h4v2h-4zm4-6h2v6h-2zm-8 0h2v6h-2zm-8 0h2v6h-2zm-3 14h2v4h-2zm14 0h2v4h-2zm8 0h2v4h-2zm-18-4h8v2h-8zm12 0h4v2h-4zm-14 2h2v2h-2zm10 0h2v2h-2zm8 0h2v2h-2z"
            ></path>
          </svg>
          {data.inclus.utilisateurs}
        </li>
        <li class="inclus-item flex items-center gap-3 xl:box-content xl:w-[284.5px]">
          <svg viewBox="0 0 24 24" class="size-[22px] shrink-0 fill-ink" aria-hidden="true">
            <path
              d="M20 2h-16v2h16zm0 14h-14v2h14zm2-12h-2v12h2zm-18 0h-2v18h2zm2 14h-2v2h2zm0-6h4v2h-4zm0-4h8v2h-8z"
            ></path>
          </svg>
          {data.inclus.canaux}
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---- Monthly / yearly switch ---- */
  .formule label {
    position: relative;
    z-index: 1;
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 14px;
    font-weight: 600;
    line-height: normal;
    white-space: nowrap;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      color 0.35s,
      background-color 0.35s;
  }
  .formule label:has(:checked) {
    color: var(--color-white);
    background-color: var(--color-ink);
  }
  .formule label:has(:focus-visible) {
    outline: 2px solid var(--color-orange-txt);
    outline-offset: 2px;
  }
  .formule-curseur {
    display: none;
  }
  /* Once measured (JS), the checked option is transparent and a single cursor slides behind it. */
  .formule.mesure label:has(:checked) {
    background-color: transparent;
  }
  .formule.mesure .formule-curseur {
    display: block;
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: var(--x);
    width: var(--w);
    border-radius: 999px;
    background-color: var(--color-ink);
    transition:
      left 0.5s var(--ease-hatch),
      width 0.5s var(--ease-hatch);
  }

  /* ---- Amounts: the outgoing one fades up, the incoming one drops in, card after card ---- */
  .montants > .montant {
    grid-area: 1 / 1;
  }
  .montant {
    transition:
      opacity 0.25s,
      translate 0.35s var(--ease-hatch),
      visibility 0s 0.25s;
  }
  .montant-mensuel,
  .tarifs:has(input[value='mensuel']:checked) .montant-annuel {
    opacity: 0;
    translate: 0 -10px;
    visibility: hidden;
    transition-delay: 0s, 0s, 0.25s;
  }
  .montant-annuel,
  .tarifs:has(input[value='mensuel']:checked) .montant-mensuel {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition-delay: calc(220ms + var(--i) * 60ms);
  }

  /* ---- Offer cards: static card, orange rim and diorama zoom on hover ---- */
  .carte {
    transition: outline-color 0.4s;
  }
  .offre:hover .carte {
    outline: 2px solid var(--color-orange);
    outline-offset: -2px;
  }
  .diorama {
    transition: transform 1.2s var(--ease-hatch);
  }
  .offre:hover .diorama {
    transform: scale(1.06);
  }

  /* ---- "All included" band: rules between items (top on mobile, left on desktop) ---- */
  .inclus-item {
    border-top: 1px solid var(--color-line);
    padding-top: 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .inclus-item {
      border-top: 0;
      border-left: 1px solid var(--color-line);
      padding-top: 0;
      padding-left: 22px;
    }
  }
</style>

<script>
  // Slide the dark cursor under the checked option (widths depend on the font, so re-measure on resize).
  document.querySelectorAll<HTMLFieldSetElement>('[data-formule]').forEach((f) => {
    const placer = () => {
      // One radio is `checked` in the markup and radios can't be unchecked, so a label always matches.
      const actif = f.querySelector('input:checked')!.closest('label')!;
      f.style.setProperty('--x', `${actif.offsetLeft}px`);
      f.style.setProperty('--w', `${actif.offsetWidth}px`);
    };
    placer();
    f.classList.add('mesure');
    f.addEventListener('change', placer);
    new ResizeObserver(placer).observe(f);
  });
</script>
