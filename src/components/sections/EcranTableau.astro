---
/**
 * Head-office dashboard on an iPad (Lark, Jay, Finch; César 01/10): the agent posts a line, then
 * the UI it generates resolves out of a skeleton, block by block — key figures counting up, an
 * alert with its button, a procedure line before/after, a broadcast to N sites, a score, gaps
 * turned into actions. The markup renders the FINAL state (no JS, reduced motion); the GSAP
 * timeline (demo-motion.ts `tableau`) replays it on the beats from demo-ecran.ts.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EcranTableau } from '../../content/schemas/demo';
import Ipad from '../ui/Ipad.astro';
import { chronoTableau } from './demo-ecran';

interface Props {
  ecran: EcranTableau;
  avatar: ImageMetadata;
}
const { ecran, avatar } = Astro.props;
const c = chronoTableau(ecran);
const s = (t: number) => t.toFixed(2);
const [appNom, appVue] = ecran.entete.split(' · ');
const nombre = new Intl.NumberFormat(Astro.currentLocale ?? 'fr').format;

const I = {
  ok: 'M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z',
  wifi: 'M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8 3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4 2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z',
  alerte: 'M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z',
  fleche: 'M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z',
};
---

<div
  class="ecr tableau"
  data-duree={s(c.duree)}
  data-intro={s(c.intro)}
  data-carte={s(c.carte)}
  data-resolu={s(c.resolu)}
>
  <Ipad>
    <div class="b-ecran">
      <div class="b-statut" aria-hidden="true">
        <span>{ecran.heure}</span>
        <span class="icones">
          <svg viewBox="0 0 24 24">
            <path d={I.wifi}></path>
          </svg>
          <svg class="batterie" viewBox="0 0 28 13">
            <rect x="0.5" y="0.5" width="23" height="12" rx="3.5"></rect>
            <rect class="plein" x="2" y="2" width="18" height="9" rx="2"></rect>
            <rect class="borne" x="25" y="4.5" width="2" height="4" rx="1"></rect>
          </svg>
        </span>
      </div>
      <header class="b-barre">
        <Image src={avatar} alt="" width={40} height={40} densities={[1, 2]} class="b-av" />
        <span class="b-app">
          <b>{appNom}</b>
          <span>{appVue}</span>
        </span>
        <span class="b-pastille">
          <span class="b-point" aria-hidden="true"></span>
          {ecran.statut}
        </span>
      </header>
      <div class="b-fil">
        <p class="b-intro">
          <Image src={avatar} alt="" width={28} height={28} densities={[1, 2]} class="b-av-s" />
          <span>{ecran.intro}</span>
        </p>
        <div class="b-carte">
          <div class="b-squelette" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="b-contenu">
            <header class="b-tete">
              <p class="b-titre">{ecran.titre}</p>
              <p class="b-source">{ecran.source}</p>
            </header>
            {
              ecran.blocs.map((b, i) => (
                <section
                  class:list={['b-bloc', `b-${b.type}`]}
                  data-type={b.type}
                  data-t={s(c.blocs[i].t)}
                  data-d={s(c.blocs[i].d)}
                >
                  {b.type === 'chiffres' &&
                    b.items.map((it) => (
                      <div class="b-tuile">
                        <span class="b-valeur" data-valeur={it.valeur}>
                          {nombre(it.valeur)}
                        </span>
                        <span class="b-libelle">{it.libelle}</span>
                      </div>
                    ))}
                  {b.type === 'alerte' && (
                    <>
                      <span class="b-alerte-icone" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d={I.alerte} />
                        </svg>
                      </span>
                      <p class="b-alerte-txt">{b.texte}</p>
                      <span class="b-bouton">
                        <span class="b-bouton-txt">{b.bouton}</span>
                        <svg class="b-bouton-ok" viewBox="0 0 24 24" aria-hidden="true">
                          <path d={I.ok} />
                        </svg>
                      </span>
                    </>
                  )}
                  {b.type === 'version' && (
                    <>
                      <p class="b-ligne b-avant">
                        <span class="b-v">{b.avant.version}</span>
                        <span class="b-texte">
                          {b.avant.texte}
                          <span class="b-rature" aria-hidden="true" />
                        </span>
                      </p>
                      <p class="b-ligne b-apres">
                        <span class="b-surligne" aria-hidden="true" />
                        <span class="b-v">{b.apres.version}</span>
                        <span class="b-texte">{b.apres.texte}</span>
                      </p>
                    </>
                  )}
                  {b.type === 'diffusion' && (
                    <>
                      <p class="b-compteur">
                        <span class="b-valeur" data-valeur={b.total}>
                          {nombre(b.total)}
                        </span>
                        <span class="b-libelle">{b.libelle}</span>
                      </p>
                      <div class="b-sites" aria-hidden="true">
                        {Array.from({ length: b.total }, () => (
                          <span />
                        ))}
                      </div>
                    </>
                  )}
                  {b.type === 'score' && (
                    <>
                      <p class="b-compteur">
                        <span class="b-valeur" data-valeur={b.valeur}>
                          {nombre(b.valeur)}
                        </span>
                        <span class="b-sur">/ {nombre(b.sur)}</span>
                        <span class="b-libelle">{b.libelle}</span>
                      </p>
                      <span class="b-jauge" aria-hidden="true">
                        <span style={`--p:${b.valeur / b.sur}`} data-p={b.valeur / b.sur} />
                      </span>
                    </>
                  )}
                  {b.type === 'ecarts' && (
                    <>
                      <p class="b-libelle b-plan">{b.libelle}</p>
                      {b.items.map((it) => (
                        <div class="b-ecart">
                          <span class="b-pb">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d={I.alerte} />
                            </svg>
                            {it.ecart}
                          </span>
                          <svg class="b-fleche" viewBox="0 0 24 24" aria-hidden="true">
                            <path d={I.fleche} />
                          </svg>
                          <span class="b-action">{it.action}</span>
                        </div>
                      ))}
                    </>
                  )}
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Ipad>
</div>

<style>
  .tableau {
    width: 100%;
  }
  /* The screen fills the frame's screen box; everything inside is sized in cqw of its width. */
  .b-ecran {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    background: var(--color-cream);
    font: 500 2.1cqw/1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .icones {
    display: flex;
    align-items: center;
    gap: 0.8cqw;
  }
  .icones svg {
    width: 2.1cqw;
    fill: currentColor;
  }
  .icones .batterie {
    width: 3cqw;
  }
  .batterie rect {
    fill: none;
    stroke: currentColor;
    opacity: 0.45;
  }
  .batterie .plein,
  .batterie .borne {
    fill: currentColor;
    stroke: none;
    opacity: 1;
  }
  .batterie .borne {
    opacity: 0.45;
  }
  .b-statut {
    display: flex;
    justify-content: space-between;
    padding: 1.3cqw 2.6cqw 0;
    font: 600 1.6cqw/1 var(--font-sans);
  }
  .b-barre {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.1cqw 2.6cqw 1.3cqw;
    border-bottom: 1px solid var(--color-line);
  }
  .b-barre :global(.b-av) {
    width: 4.4cqw;
    height: 4.4cqw;
    border-radius: 1.2cqw;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  .b-app {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .b-app b {
    font: 700 2.6cqw/1.1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .b-app span {
    font-size: 1.65cqw;
    color: var(--color-soft);
  }
  .b-pastille {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    margin-left: auto;
    padding: 0.8cqw 1.6cqw 0.8cqw 1.2cqw;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-line),
      var(--shadow-1);
    font: 600 1.65cqw/1 var(--font-sans);
  }
  .b-point {
    width: 1cqw;
    height: 1cqw;
    border-radius: 999px;
    background: var(--color-orange);
    box-shadow: 0 0 0 0.35cqw var(--color-orange-tint);
  }
  .b-fil {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.4cqw;
    min-height: 0;
    padding: 1.8cqw 2.6cqw 2.4cqw;
  }
  /* The agent's line, as a message. */
  .b-intro {
    display: flex;
    align-items: flex-end;
    align-self: flex-start;
    gap: 1cqw;
    max-width: 80%;
    transform-origin: 0 100%;
  }
  .b-intro :global(.b-av-s) {
    flex: none;
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 999px;
    background: var(--color-surface);
  }
  .b-intro span {
    padding: 1cqw 1.6cqw;
    border-radius: 2cqw;
    border-bottom-left-radius: 0.6cqw;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-line),
      var(--shadow-1);
    font-size: 1.9cqw;
  }
  /* The generated card: a skeleton first, then the blocks resolve in place. */
  /* Sized by its blocks (not stretched): the card ends where the answer ends. */
  .b-carte {
    position: relative;
    min-height: 0;
    padding: 1.8cqw 2cqw 2cqw;
    border-radius: 2.2cqw;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-line),
      var(--shadow-1);
  }
  .b-squelette {
    position: absolute;
    inset: 1.8cqw 2cqw 2cqw;
    display: flex;
    flex-direction: column;
    gap: 1.4cqw;
    opacity: 0;
  }
  .b-squelette span {
    flex: 1;
    border-radius: 1cqw;
    background: var(--color-cream-2);
  }
  .b-squelette span:first-child {
    flex: none;
    width: 45%;
    height: 3.4cqw;
  }
  .b-contenu {
    display: flex;
    flex-direction: column;
    gap: 1.7cqw;
  }
  .b-tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.6cqw;
  }
  .b-titre {
    font: 700 3.2cqw/1.1 var(--font-display);
    letter-spacing: -0.015em;
  }
  .b-source {
    flex: none;
    padding: 0.3cqw 0.9cqw;
    border-radius: 999px;
    background: var(--color-sand);
    font: 400 1.35cqw/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-soft);
  }
  .b-libelle {
    font-size: 1.6cqw;
    color: var(--color-soft);
  }
  .b-valeur {
    font: 700 4.6cqw/1 var(--font-display);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  /* Key figures. */
  .b-chiffres {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2cqw;
  }
  .b-tuile {
    display: flex;
    flex-direction: column;
    gap: 0.8cqw;
    padding: 1.6cqw 1.8cqw;
    border-radius: 1.6cqw;
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  /* Alert with its action. */
  .b-alerte {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.4cqw 1.6cqw;
    border-radius: 1.6cqw;
    background: var(--color-orange-tint);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-orange) 45%, transparent);
  }
  .b-alerte-icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 999px;
    background: var(--color-orange);
  }
  .b-alerte-icone svg {
    width: 1.9cqw;
    fill: var(--color-ink);
  }
  .b-alerte-txt {
    flex: 1;
    font-size: 1.9cqw;
    font-weight: 600;
  }
  .b-bouton {
    display: grid;
    place-items: center;
    flex: none;
    padding: 1cqw 2cqw;
    border-radius: 999px;
    background: var(--color-ink);
    font: 600 1.7cqw/1 var(--font-sans);
    color: var(--color-white);
  }
  .b-bouton > * {
    grid-area: 1 / 1;
  }
  .b-bouton-txt {
    opacity: 0;
  }
  .b-bouton-ok {
    width: 2.2cqw;
    fill: var(--color-white);
  }

  /* A procedure line, before (struck out) and after (highlighted). */
  .b-version {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
  }
  .b-ligne {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.4cqw 1.6cqw;
    overflow: hidden;
    border-radius: 1.4cqw;
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 2cqw;
  }
  .b-avant .b-texte {
    color: var(--color-soft);
  }
  .b-texte {
    position: relative;
  }
  .b-rature {
    position: absolute;
    left: 0;
    right: 0;
    top: 55%;
    height: 0.25cqw;
    background: var(--color-soft);
    transform-origin: left;
  }
  .b-surligne {
    position: absolute;
    inset: 0;
    background: var(--color-orange-tint);
    box-shadow: inset 0 0 0 1px var(--color-orange);
    border-radius: inherit;
    transform-origin: left;
  }
  .b-v {
    position: relative;
    flex: none;
    padding: 0.3cqw 0.9cqw;
    border-radius: 999px;
    background: var(--color-sand);
    font: 400 1.4cqw/1.3 var(--font-mono);
  }
  .b-apres .b-v {
    background: var(--color-orange);
  }

  /* Broadcast: the count runs while a dot per site lights up. */
  .b-diffusion {
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
  }
  .b-compteur {
    display: flex;
    align-items: baseline;
    gap: 1cqw;
  }
  .b-sites {
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    gap: 0.8cqw;
  }
  .b-sites span {
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-orange);
  }

  /* Score with its gauge. */
  .b-score {
    display: flex;
    flex-direction: column;
    gap: 1.1cqw;
    padding: 1.6cqw 1.8cqw;
    border-radius: 1.6cqw;
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .b-sur {
    font: 600 2cqw/1 var(--font-sans);
    color: var(--color-soft);
  }
  .b-score .b-libelle {
    margin-left: auto;
  }
  .b-jauge {
    height: 0.8cqw;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-cream-2);
  }
  .b-jauge span {
    display: block;
    height: 100%;
    background: var(--color-orange);
    transform-origin: left;
    transform: scaleX(var(--p));
  }

  /* Gaps found, each turned into an action. */
  .b-ecarts {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
  }
  .b-plan {
    font: 400 1.35cqw/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .b-ecart {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.2cqw;
  }
  .b-pb,
  .b-action {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    min-height: 100%;
    padding: 1.2cqw 1.4cqw;
    border-radius: 1.4cqw;
    font-size: 1.75cqw;
    line-height: 1.3;
  }
  .b-pb {
    background: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .b-pb svg {
    flex: none;
    width: 2cqw;
    fill: var(--color-orange-txt);
  }
  .b-action {
    background: var(--color-orange-tint);
    box-shadow: inset 0 0 0 1px var(--color-orange);
    font-weight: 600;
  }
  .b-fleche {
    width: 2.4cqw;
    fill: var(--color-soft);
  }
</style>
