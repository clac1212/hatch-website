---
import { demoUrl, type Locale } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  data: CollectionEntry<'landing'>['data']['pricing'];
}

const { locale, data } = Astro.props;
const demo = demoUrl(locale);
---

<section class="pricing bg-white py-14" id="pricing">
  <div class="container-site">
    <div class="pricing-header mb-10 text-center">
      <div
        class="mx-auto mb-5 inline-flex items-center gap-2 rounded-full border border-hatch-accent-bg-strong bg-hatch-accent-bg px-4 py-1.5 pl-2.5 text-xs font-semibold tracking-[0.04em] text-hatch-accent"
      >
        <span
          class="pulse-dot h-1.5 w-1.5 flex-shrink-0 rounded-full bg-hatch-accent shadow-[0_0_8px_rgba(234,88,12,0.5)]"
        ></span>
        <span>{data.label}</span>
      </div>
      <h2
        class="mb-4 mt-2 font-display font-bold"
        style="font-size: clamp(26px, 3.6vw, 40px); line-height: 1.08; letter-spacing: -0.02em;"
        set:html={data.h2}
      />
      <p class="mx-auto max-w-[520px] text-base text-slate-600">{data.sub}</p>
    </div>

    <!-- Monthly / Annual toggle -->
    <div class="toggle-wrap mb-11 flex justify-center">
      <div class="flex gap-1 rounded-[11px] bg-slate-100 p-1">
        <button
          type="button"
          id="toggle-monthly"
          class="pricing-toggle active rounded-lg border-none bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 shadow-[0_2px_8px_rgba(0,0,0,0.07)] transition"
        >
          {data.toggleMonthly}
        </button>
        <button
          type="button"
          id="toggle-annual"
          class="pricing-toggle rounded-lg border-none bg-transparent px-5 py-2.5 text-sm font-semibold text-slate-500 transition hover:text-slate-900"
        >
          {data.toggleAnnual}
        </button>
      </div>
    </div>

    <!-- 3 cards: S / M / L -->
    <div class="price-grid mx-auto grid max-w-[960px] gap-4 md:grid-cols-3 items-stretch">
      {
        data.plans.map((plan) => (
          <div class="price-card relative flex flex-col rounded-[20px] border-[1.5px] border-slate-200 bg-white px-7 pb-7 pt-9 transition hover:-translate-y-[3px] hover:shadow-[0_16px_48px_rgba(0,0,0,0.08)]">
            <!-- Size badge -->
            <div class="plan-size mb-3 inline-flex h-9 w-9 items-center justify-center rounded-[10px] bg-slate-100 text-base font-extrabold text-slate-800">
              {plan.size}
            </div>

            <!-- Segment label -->
            <div class="plan-segment mb-1 text-[13px] font-semibold text-slate-900">
              {plan.segment}
            </div>

            <!-- Employee desc -->
            <div class="plan-desc mb-6 text-[12px] text-slate-400">
              {plan.desc}
            </div>

            <!-- Price -->
            <div class="plan-price mb-1 flex items-baseline gap-0.5">
              <span class="text-[13px] font-medium text-slate-400">€</span>
              <span
                class="price-value text-[48px] font-extrabold leading-none tracking-[-0.04em] text-slate-900"
                data-monthly={plan.priceMonthly}
                data-annual={plan.priceAnnual}
              >
                {plan.priceMonthly}
              </span>
              <span class="ml-1 text-[13px] font-medium text-slate-400">/loc/mo</span>
            </div>

            <!-- Annual savings line (hidden in monthly mode) -->
            <div
              class="annual-savings mb-5 hidden text-[12px] font-medium text-hatch-accent"
              data-monthly-price={plan.priceMonthly}
              data-annual-price={plan.priceAnnual}
            >
              −{Math.round((1 - plan.priceAnnual / plan.priceMonthly) * 100)}% vs mensuel
            </div>
            <div class="monthly-spacer mb-5 h-[20px]"></div>

            <div class="flex-1"></div>

            <a
              href={demo}
              class="plan-btn mt-4 block w-full rounded-[10px] border-[1.5px] border-slate-200 bg-transparent py-3 text-center text-sm font-semibold text-slate-900 transition hover:border-slate-300 hover:bg-slate-50"
              set:html={plan.btn}
            />
          </div>
        ))
      }
    </div>

    <p
      class="price-footnote mt-6 text-center text-[13px] text-slate-500"
      set:html={data.footnote}
    />
  </div>
</section>

<script>
  const btnMonthly = document.getElementById('toggle-monthly') as HTMLButtonElement;
  const btnAnnual = document.getElementById('toggle-annual') as HTMLButtonElement;
  const priceValues = document.querySelectorAll<HTMLElement>('.price-value');
  const annualRows = document.querySelectorAll<HTMLElement>('.annual-savings');
  const monthlySpacers = document.querySelectorAll<HTMLElement>('.monthly-spacer');

  function setMode(mode: 'monthly' | 'annual') {
    const isAnnual = mode === 'annual';

    // Toggle button styles
    [btnMonthly, btnAnnual].forEach((btn) => {
      const active = isAnnual ? btn === btnAnnual : btn === btnMonthly;
      btn.classList.toggle('active', active);
      btn.style.background = active ? '#fff' : 'transparent';
      btn.style.color = active ? '#0f172a' : '#64748b';
      btn.style.boxShadow = active ? '0 2px 8px rgba(0,0,0,0.07)' : 'none';
    });

    // Swap prices
    priceValues.forEach((el) => {
      el.textContent = isAnnual ? (el.dataset.annual ?? '') : (el.dataset.monthly ?? '');
    });

    // Show/hide savings line
    annualRows.forEach((el) => el.classList.toggle('hidden', !isAnnual));
    monthlySpacers.forEach((el) => el.classList.toggle('hidden', isAnnual));
  }

  btnMonthly.addEventListener('click', () => setMode('monthly'));
  btnAnnual.addEventListener('click', () => setMode('annual'));
</script>
