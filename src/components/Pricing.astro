---
import { demoUrl, type Locale } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  data: CollectionEntry<'landing'>['data']['pricing'];
}

const { locale, data } = Astro.props;
const demo = demoUrl(locale);

// One accent color per plan size
const palette = [
  { border: '#386641', badge: 'rgba(56,102,65,0.10)', badgeText: '#386641', btn: 'rgba(56,102,65,0.08)', btnHover: 'rgba(56,102,65,0.14)', btnText: '#264d2e' },
  { border: '#ea580c', badge: 'rgba(234,88,12,0.10)', badgeText: '#ea580c', btn: 'rgba(234,88,12,0.08)', btnHover: 'rgba(234,88,12,0.14)', btnText: '#9a3412' },
  { border: '#1a2e1c', badge: 'rgba(26,46,28,0.10)',  badgeText: '#1a2e1c', btn: 'rgba(26,46,28,0.07)',  btnHover: 'rgba(26,46,28,0.13)', btnText: '#0f1f10' },
];
---

<section class="pricing bg-white py-14" id="pricing">
  <div class="container-site">
    <div class="pricing-header mb-10 text-center">
      <div
        class="mx-auto mb-5 inline-flex items-center gap-2 rounded-full border border-hatch-accent-bg-strong bg-hatch-accent-bg px-4 py-1.5 pl-2.5 text-xs font-semibold tracking-[0.04em] text-hatch-accent"
      >
        <span
          class="pulse-dot h-1.5 w-1.5 flex-shrink-0 rounded-full bg-hatch-accent shadow-[0_0_8px_rgba(234,88,12,0.5)]"
        ></span>
        <span>{data.label}</span>
      </div>
      <h2
        class="mb-4 mt-2 font-display font-bold"
        style="font-size: clamp(26px, 3.6vw, 40px); line-height: 1.08; letter-spacing: -0.02em;"
        set:html={data.h2}
      />
      <p class="mx-auto max-w-[520px] text-base text-slate-600">{data.sub}</p>
    </div>

    <!-- 3 cards: S / M / L -->
    <div class="price-grid mx-auto grid max-w-[960px] gap-5 md:grid-cols-3 items-stretch">
      {
        data.plans.map((plan, i) => {
          const c = palette[i];
          return (
            <div
              class="price-card relative flex flex-col rounded-[22px] bg-white px-7 pb-8 pt-8 transition hover:-translate-y-[3px] hover:shadow-[0_20px_52px_rgba(0,0,0,0.09)]"
              style={`border: 2px solid ${c.border};`}
            >
              <!-- Size badge -->
              <div
                class="plan-size mb-4 inline-flex h-10 w-10 items-center justify-center rounded-[11px] text-[17px] font-extrabold"
                style={`background:${c.badge}; color:${c.badgeText};`}
              >
                {plan.size}
              </div>

              <!-- Segment label -->
              <div class="plan-segment mb-1 text-[14px] font-semibold text-slate-900">
                {plan.segment}
              </div>

              <!-- Employee desc -->
              <div class="plan-desc mb-7 text-[12px] text-slate-400">
                {plan.desc}
              </div>

              <!-- Price -->
              <div class="plan-price mb-1 flex items-baseline gap-0.5">
                <span class="text-[14px] font-medium text-slate-400">€</span>
                <span class="text-[52px] font-extrabold leading-none tracking-[-0.04em] text-slate-900">
                  {plan.priceMonthly}
                </span>
                <span class="ml-1 text-[13px] font-medium text-slate-400">/loc/mo</span>
              </div>

              <div class="flex-1"></div>

              <a
                href={demo}
                class="plan-btn mt-8 block w-full rounded-[11px] py-3 text-center text-sm font-semibold transition"
                style={`background:${c.btn}; color:${c.btnText}; border: 1.5px solid ${c.border}40;`}
                onmouseover={`this.style.background='${c.btnHover}'`}
                onmouseout={`this.style.background='${c.btn}'`}
                set:html={plan.btn}
              />
            </div>
          );
        })
      }
    </div>

    <p
      class="price-footnote mt-7 text-center text-[13px] text-slate-500"
      set:html={data.footnote}
    />
  </div>
</section>
