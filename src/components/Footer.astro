---
import { Image, Picture } from 'astro:assets';
import Button from './ui/Button.astro';
import { section } from '../content/section';
import { getEntry } from 'astro:content';
import {
  entryRoutes,
  routes,
  otherLocale,
  useTranslations,
  type Locale,
  type Paths,
} from '../i18n/ui';
import { socialLinks } from '../seo/jsonld';
import logo from '../assets/brand/hatch-os-night.png';
import immeuble from '../assets/footer/immeuble.jpg';

/**
 * Site-wide footer — v4 node DbMpt ("Footer D · L'immeuble voxel"): brand + links on the left,
 * the voxel building (one agent per floor) on the right. Stacked, building first, below 1280 px.
 */
/** A page's own footer scene: its image, and the list that goes with it in place of the building's floors. */
export interface ScenePied {
  image: ImageMetadata;
  alt: string;
  titre: string;
  liste: { repere: string; texte: string; href: string }[];
}

interface Props {
  locale: Locale;
  paths: Paths;
  scene?: ScenePied;
  /** The home page: no customer-cases link, and Security points at the page's own Security block. */
  accueil?: boolean;
  /**
   * A pared-down footer (Robin): no link columns, the brand and the scene centred; the legal links
   * stay reachable, small, on the fine-print line.
   */
  epure?: boolean;
}

const { locale, paths, scene, accueil = false, epure = false } = Astro.props;
const t = useTranslations(locale);
const data = await section('piedDePage', locale);
const home = routes.home[locale];
const reseaux = routes.reseaux[locale];
/** The building's residents: each floor links to its agent's page once published (César 12/10). */
const residents = await Promise.all(
  data.agents.residents.map(async (r) => {
    if (!('agent' in r)) return { etage: r.etage, metier: r.metier, nom: r.nom, href: r.lien };
    const e = await getEntry('agents', `${locale}/${r.agent}`);
    if (!e) throw new Error(`Missing src/content/agents/${locale}/${r.agent}.md`);
    const publiee = !!e.data.page && !e.data.page.brouillon;
    return {
      ...r,
      nom: e.data.name,
      href: publiee ? entryRoutes.agents(r.agent)[locale] : `${reseaux}#agents`,
    };
  }),
);
const other = otherLocale(locale);
const produit = accueil
  ? [{ href: '#securite', label: t('nav.security') }]
  : [
      { href: `${reseaux}#cas-clients`, label: t('nav.cases') },
      { href: routes.security[locale], label: t('nav.security') },
    ];
const legal = [
  { href: routes.terms[locale], label: data.legal.conditions },
  { href: routes.sales[locale], label: data.legal.vente },
  { href: routes.privacy[locale], label: data.legal.confidentialite },
  { href: routes.mentions[locale], label: data.legal.mentions },
];
const annee = new Date().getFullYear();
const titre = 'font-mono text-[11px] leading-[14px] tracking-[0.16em] text-muted uppercase';
const lien = 'lien-pied block w-fit text-[14.5px] leading-[normal] text-paper';
---

<footer data-rv-groupe class="bg-black text-paper">
  <div
    class:list={[
      'mx-auto flex max-w-[1920px] flex-col lg:flex-row',
      epure ? 'max-w-[1440px] lg:items-center lg:gap-10 lg:px-12' : 'xl:h-[900px]',
    ]}
  >
    <div
      data-rv
      class:list={[
        'order-1 flex justify-center lg:order-2 lg:shrink-0',
        epure ? 'lg:w-[46%] lg:py-14' : 'lg:w-[40%] xl:w-[min(720px,42%)]',
      ]}
    >
      <Picture
        pictureAttributes={{ class: 'block w-full max-w-[460px] lg:h-full lg:max-w-none' }}
        src={scene?.image ?? immeuble}
        alt={scene?.alt ?? data.immeubleAlt}
        widths={[480, 720, 1080, 1440]}
        sizes="(min-width: 1280px) 720px, (min-width: 1024px) 40vw, (min-width: 768px) 460px, 100vw"
        formats={['avif', 'webp']}
        class:list={[
          'block h-auto w-full',
          !epure && 'lg:h-full lg:object-contain lg:object-bottom xl:object-cover',
        ]}
      />
    </div>

    <div
      class:list={[
        'order-2 flex min-w-0 flex-1 flex-col gap-14 px-6 pt-4 pb-10 md:px-12 lg:order-1',
        epure
          ? 'lg:justify-center lg:gap-16 lg:py-14 lg:pr-0 lg:pl-0 xl:pl-12'
          : 'justify-between lg:gap-10 lg:pt-20 lg:pr-8 xl:pt-[88px] xl:pr-12 xl:pl-24',
      ]}
    >
      <div data-rv class="flex max-w-[420px] flex-col items-start gap-[18px]">
        <a href={home} aria-label={t('a11y.home')}>
          <Image src={logo} alt="" width={130} densities={[1, 2]} class="h-auto w-[130px]" />
        </a>
        <p class="text-[15px] leading-[23px] text-white/70">{data.signature}</p>
        <Button href={routes.demo[locale]} variant="cream">{data.cta}</Button>
      </div>

      {
        !epure && (
          <div
            data-rv
            class="grid grid-cols-2 gap-x-6 gap-y-10 md:flex md:flex-wrap md:gap-x-11 lg:flex-nowrap lg:gap-x-8 xl:gap-x-11"
          >
            <nav aria-labelledby="pied-produit" class="flex flex-col gap-3">
              <h2 id="pied-produit" class={titre}>
                {t('footer.product')}
              </h2>
              <ul class="flex flex-col gap-3">
                {produit.map((l) => (
                  <li>
                    <a href={l.href} class={lien}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <nav aria-labelledby="pied-agents" class="order-last col-span-2 md:order-none">
              <h2 id="pied-agents" class={titre}>
                {scene?.titre ?? data.agents.titre}
              </h2>
              <ul class="mt-3">
                {(scene
                  ? scene.liste.map((l) => ({
                      etage: l.repere,
                      metier: l.texte,
                      nom: '',
                      href: l.href,
                    }))
                  : residents
                ).map((r) => (
                  <li>
                    <a
                      href={r.href}
                      class="lien-pied flex w-fit items-center gap-3 py-1.5 leading-[normal]"
                    >
                      <span class="w-[58px] shrink-0 font-mono text-[11px] tracking-[0.8px] text-orange">
                        {r.etage}
                      </span>
                      <span class="text-[14.5px] whitespace-nowrap">
                        {r.nom ? `${r.metier} · ${r.nom}` : r.metier}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <div class="flex flex-col gap-8">
              <nav aria-labelledby="pied-hatch" class="flex flex-col gap-3">
                <h2 id="pied-hatch" class={titre}>
                  {t('footer.company')}
                </h2>
                <ul class="flex flex-col gap-3">
                  {socialLinks.map((l) => (
                    <li>
                      <a href={l.href} rel="noopener" class={lien}>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
              <nav aria-labelledby="pied-legal" class="flex flex-col gap-3">
                <h2 id="pied-legal" class={titre}>
                  {data.legal.titre}
                </h2>
                <ul class="flex flex-col gap-3">
                  {legal.map((l) => (
                    <li>
                      <a href={l.href} class={lien}>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </div>
        )
      }

      <div class="flex flex-col gap-[18px] border-t border-white/12 pt-[18px]">
        <div
          class:list={[
            'flex flex-col gap-2 font-mono text-[11px] leading-[14px] tracking-[0.14em] text-stone uppercase',
            !epure && 'sm:flex-row sm:justify-between',
          ]}
        >
          {/* The language switch sits with the page's fine print, not among the social links. */}
          <p class="flex flex-wrap gap-x-6 gap-y-2">
            <span>
              {annee}
              {data.copyright}
            </span>
            <a
              href={paths[other]}
              hreflang={other}
              lang={other}
              class="text-paper transition-colors duration-300 hover:text-orange"
            >
              {t('lang.switch')}
            </a>
          </p>
          <p>{data.mention}</p>
        </div>
        {
          epure && (
            <nav
              aria-label={data.legal.titre}
              class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px] leading-[14px] tracking-[0.14em] text-stone uppercase"
            >
              {legal.map((l) => (
                <a href={l.href} class="transition-colors duration-300 hover:text-orange">
                  {l.label}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .lien-pied {
    transition:
      color 0.3s,
      transform 0.3s var(--ease-hatch);
  }
  .lien-pied:hover {
    color: var(--color-orange);
    transform: translateX(3px);
  }
</style>
