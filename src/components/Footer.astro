---
import Logo from './ui/Logo.astro';
import { routes, otherLocale, useTranslations, type Locale, type Paths } from '../i18n/ui';

/** Minimal footer for the foundation; the voxel "immeuble" footer replaces it in lot 3. */
interface Props {
  locale: Locale;
  paths: Paths;
}

const { locale, paths } = Astro.props;
const t = useTranslations(locale);
const home = routes.home[locale];
const other = otherLocale(locale);
const product = [
  { href: `${home}#agents`, label: t('nav.agents') },
  { href: `${home}#cas-clients`, label: t('nav.cases') },
  { href: `${home}#tarifs`, label: t('nav.pricing') },
  { href: routes.security[locale], label: t('nav.security') },
];
const social = [
  { href: 'https://www.linkedin.com/company/gethatchos/', label: 'LinkedIn' },
  { href: 'https://www.instagram.com/get_hatch.os/', label: 'Instagram' },
];
---

<footer class="bg-night text-white">
  <div class="mx-auto grid max-w-site gap-12 px-6 py-16 md:grid-cols-[2fr_1fr_1fr] md:px-8">
    <div class="flex flex-col gap-4">
      <Logo tone="night" />
      <p class="text-caption text-white/75">{t('footer.tagline')}</p>
    </div>
    <div>
      <h2 class="font-mono text-kicker text-white/60 uppercase">{t('footer.product')}</h2>
      <ul class="mt-4 flex flex-col gap-2.5">
        {
          product.map((l) => (
            <li>
              <a href={l.href} class="text-caption hover:text-orange">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="font-mono text-kicker text-white/60 uppercase">{t('footer.company')}</h2>
      <ul class="mt-4 flex flex-col gap-2.5">
        {
          social.map((l) => (
            <li>
              <a href={l.href} rel="noopener" class="text-caption hover:text-orange">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={paths[other]}
            hreflang={other}
            lang={other}
            class="text-caption hover:text-orange"
          >
            {t('lang.switch')}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line-night">
    <p class="mx-auto max-w-site px-6 py-6 font-mono text-source text-white/60 uppercase md:px-8">
      © {new Date().getFullYear()} Hatch OS. {t('footer.rights')}
    </p>
  </div>
</footer>
