---
/**
 * `/_ds`, dev only (CLAUDE.md, « Guardrails »): every token and DS component on one page, to check
 * against Pencil at a glance. A file named `_ds.astro` would be ignored by Astro, hence this dynamic
 * route; it has no path outside `pnpm dev`, so it is never built nor in the sitemap.
 * The tokens are read from `@theme` in global.css, so the page follows it without upkeep.
 * Internal tool: its labels are not site copy and stay here (exception to « no copy in .astro »).
 */
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import EnTete from '../components/ui/EnTete.astro';
import Button from '../components/ui/Button.astro';
import Carte from '../components/ui/Carte.astro';
import Logo from '../components/ui/Logo.astro';
import Badge from '../components/ressources/Badge.astro';
import css from '../styles/global.css?raw';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { ds: '_ds' } }] : [];
}

const theme = css.slice(css.indexOf('@theme {'), css.indexOf('\n}', css.indexOf('@theme {')));
const vars = (prefix: string) =>
  [...theme.matchAll(new RegExp(`--(${prefix}[a-z0-9-]*):\\s*([^;]+);`, 'g'))]
    .map(([, nom, valeur]) => ({ nom, valeur: valeur.trim() }))
    .filter((v) => !v.nom.includes('--') && v.valeur !== 'initial');
const couleurs = vars('color-');
const tailles = vars('text-').filter((v) => !v.nom.match(/line-height|letter-spacing/));
const rayons = vars('radius-');
const ombres = vars('shadow-');
const conteneurs = vars('container-');

const TONS = ['cream', 'cream-2', 'surface', 'night', 'black', 'orange'] as const;
const paths = { fr: '/_ds', en: '/_ds' };
---

<Base
  locale="fr"
  paths={paths}
  title="Design system"
  description="Tokens et composants"
  noindex
  nav="legal"
>
  <Section>
    <EnTete
      niveau="h1"
      titre="Design system Hatch OS v4"
      intro="Tokens lus dans @theme, composants de src/components/ui. Dev seulement."
    />
  </Section>

  <Section ton="cream-2">
    <EnTete titre="Couleurs" />
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-6">
      {
        couleurs.map((c) => (
          <li class="flex flex-col gap-2">
            <span
              class="aspect-square rounded-card-sm shadow-1 ring-1 ring-line"
              style={`background: var(--${c.nom})`}
            />
            <code class="text-caption">{c.nom.replace('color-', '')}</code>
            <code class="text-source text-soft">{c.valeur}</code>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <EnTete titre="Typographie" />
    <ul class="mt-10 flex flex-col gap-6">
      {
        tailles.map((t) => (
          <li class="grid gap-2 border-t border-line pt-4 md:grid-cols-[12rem_1fr]">
            <code class="text-caption text-soft">
              {t.nom}
              <br />
              {t.valeur}
            </code>
            <span
              class:list={[
                t.nom === 'text-kicker' || t.nom === 'text-source'
                  ? 'font-mono uppercase'
                  : ['text-h1', 'text-section', 'text-card', 'text-stat'].includes(t.nom)
                    ? 'font-display font-semibold'
                    : 'font-sans',
              ]}
              style={`font-size: var(--${t.nom}); line-height: var(--${t.nom}--line-height, 1.3); letter-spacing: var(--${t.nom}--letter-spacing, normal)`}
            >
              Le ratio matière d'un restaurant
            </span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section ton="cream-2">
    <EnTete titre="Rayons, ombres, conteneurs" />
    <div class="mt-10 flex flex-wrap gap-6">
      {
        rayons.map((r) => (
          <div class="flex flex-col items-center gap-2">
            <span
              class="size-32 bg-surface shadow-2"
              style={`border-radius: var(--${r.nom}); corner-shape: squircle`}
            />
            <code class="text-caption">{r.nom}</code>
            <code class="text-source text-soft">{r.valeur}</code>
          </div>
        ))
      }
    </div>
    <div class="mt-12 flex flex-wrap gap-8">
      {
        ombres.map((o) => (
          <div class="flex flex-col items-center gap-3">
            <span
              class="size-28 rounded-card-sm bg-surface"
              style={`box-shadow: var(--${o.nom})`}
            />
            <code class="text-caption">{o.nom}</code>
          </div>
        ))
      }
    </div>
    <ul class="mt-12 flex flex-col gap-3">
      {
        conteneurs.map((c) => (
          <li class="flex flex-col gap-1">
            <span class="h-3 rounded-full bg-orange" style={`max-width: var(--${c.nom})`} />
            <code class="text-caption">
              {c.nom} · {c.valeur}
            </code>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <EnTete titre="Boutons" />
    <div class="mt-10 flex flex-wrap items-center gap-4">
      {
        (['orange', 'secondary', 'ink'] as const).flatMap((v) =>
          (['sm', 'lg'] as const).map((s) => (
            <Button href="#" variant={v} size={s}>
              {v} · {s}
            </Button>
          )),
        )
      }
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-4 rounded-card bg-night p-8">
      <Button href="#" variant="cream">cream · sm</Button>
      <Button href="#" variant="cream" size="lg">cream · lg</Button>
      <Logo tone="night" />
    </div>
  </Section>

  <Section ton="cream-2">
    <EnTete titre="Cartes et badges" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        (['surface', 'nuit', 'verre'] as const).map((v) => (
          <Carte variante={v} class="p-8">
            <p class="font-mono text-kicker uppercase">variante {v}</p>
            <p class="mt-3 font-display text-card font-semibold">Une carte</p>
          </Carte>
        ))
      }
      <Carte href="#" class="p-8">
        <p class="font-mono text-kicker uppercase">href</p>
        <p class="mt-3 font-display text-card font-semibold">Carte lien, survol</p>
      </Carte>
      <Carte taille="sm" class="p-6">
        <p class="font-display text-card font-semibold">taille sm</p>
      </Carte>
      <Carte taille="panneau" class="p-10">
        <p class="font-display text-card font-semibold">taille panneau</p>
      </Carte>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <Badge locale="fr" public="independant" />
      <Badge locale="fr" public="reseau" />
      <Badge locale="fr" public="tous" />
    </div>
  </Section>

  {
    TONS.map((ton) => (
      <Section ton={ton}>
        <EnTete
          kicker={`Section ton="${ton}"`}
          titre="Un titre de section"
          intro="Le chapeau prend la couleur --doux de la section."
        />
      </Section>
    ))
  }
</Base>
