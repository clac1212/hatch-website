---
/**
 * MAQUETTE — la page réseau complète (le site actuel, qui passera à /reseaux), avec la nouvelle
 * section Tarifs en formulaire à la place des trois offres chiffrées.
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import Clients from '../../components/sections/Clients.astro';
import Probleme from '../../components/sections/Probleme.astro';
import Demo from '../../components/sections/Demo.astro';
import Equipe from '../../components/sections/Equipe.astro';
import Cas from '../../components/sections/Cas.astro';
import MiseEnPlace from '../../components/sections/MiseEnPlace.astro';
import Securite from '../../components/sections/Securite.astro';
import TarifsFormulaire from '../../components/maquettes/TarifsFormulaire.astro';
import { routes } from '../../i18n/ui';
import siege from '../../assets/footer/siege.jpg';

const locale = 'fr';

/** Le pied de page propre au réseau : le siège en plan ouvert, un agent par espace. */
const pied = {
  image: siege,
  alt: "Le siège d'un réseau de franchise en voxels, vu de dessus sans toit : autour de la grande carte de France, chaque agent Hatch OS a son espace.",
  titre: 'Le siège',
  liste: [
    { repere: 'CARTE', texte: 'Pilotage · Lark', href: '#agents' },
    { repere: 'STANDARD', texte: 'Vie de réseau · Peep', href: '#agents' },
    { repere: 'CUISINE', texte: 'Établissement · Owl', href: '#agents' },
    { repere: 'ARCHIVES', texte: 'Documentation · Jay', href: '#agents' },
    { repere: 'AUDIT', texte: 'Qualité · Finch', href: '#agents' },
    { repere: 'SALLE', texte: 'Formation · Pecker', href: '#agents' },
    { repere: 'PLANS', texte: 'Développement · Sparrow', href: '#agents' },
  ],
};
---

<Base
  locale={locale}
  paths={routes.home}
  title="Maquette réseau | Hatch OS"
  description="Maquette de la page réseau de Hatch OS avec la nouvelle section tarifs en formulaire."
  pied={pied}
>
  <Hero locale={locale} />
  <Clients locale={locale} />
  <Probleme locale={locale} />
  <Demo locale={locale} />
  <Equipe locale={locale} />
  <Cas locale={locale} />
  <MiseEnPlace locale={locale} />
  <Securite locale={locale} />
  <TarifsFormulaire />
</Base>
