---
/**
 * MAQUETTE — landing Robin (espace indépendant) avec inscription à la liste d'attente de la bêta.
 * Contenu tiré de Notion (« Robin — le cofondateur des restaurants indépendants »).
 * Visuel uniquement : textes en dur, le formulaire n'envoie rien.
 */
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Iphone from '../../components/ui/Iphone.astro';
import { routes } from '../../i18n/ui';
import robin from '../../assets/robin/robin-face.png';
import oeuf from '../../assets/robin/robin-oeuf-comptoir.jpg';

const piliers = [
  {
    titre: 'Il connaît votre restaurant',
    texte:
      "Votre carte, votre équipe, vos fournisseurs, vos décisions, vos documents. Il retient tout et s'en sert pour vous répondre.",
    exemple: '« Quel fournisseur on avait pris pour le beurre en septembre ? »',
  },
  {
    titre: 'Il revient vers vous',
    texte:
      "Le point du lundi, le bilan du mois, une alerte quand une facture dérape. C'est lui qui écrit en premier.",
    exemple: '« Le beurre a pris 14 % chez Metro, je te montre ? »',
  },
  {
    titre: 'Il prépare le travail',
    texte:
      'Des fiches prêtes à afficher, des checklists, des mails, le dossier pour la banque. Vous relisez, il a fait le reste.',
    exemple: '« Fais-moi la fiche allergènes du plat du jour. »',
  },
];

const champs = [
  { id: 'prenom', label: 'Prénom', type: 'text', placeholder: 'Karim', auto: 'given-name' },
  { id: 'restaurant', label: 'Nom du restaurant', type: 'text', placeholder: 'Le Petit Comptoir', auto: 'organization' },
  { id: 'ville', label: 'Ville', type: 'text', placeholder: 'Lyon', auto: 'address-level2' },
  { id: 'whatsapp', label: 'Numéro WhatsApp', type: 'tel', placeholder: '06 12 34 56 78', auto: 'tel' },
  { id: 'email', label: 'Email', type: 'email', placeholder: 'karim@lepetitcomptoir.fr', auto: 'email' },
];
---

<Base
  locale="fr"
  paths={routes.home}
  nav="accueil"
  title="Maquette Robin | Hatch OS"
  description="Maquette de la page Robin, l'associé IA des restaurateurs indépendants sur WhatsApp, avec l'inscription à la liste d'attente de la bêta."
>
  <!-- 1 · Hero + liste d'attente -->
  <section class="points relative overflow-hidden bg-cream pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div class="mx-auto grid max-w-[1240px] items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="flex flex-col items-start gap-6">
        <span
          class="rounded-full bg-surface px-4 py-2 font-mono text-[12px] tracking-[0.16em] text-ink uppercase ring-1 ring-line"
        >
          Nouvel agent · Restaurants indépendants · Bêta
        </span>
        <h1
          class="font-display text-[44px] leading-[1.02] font-semibold tracking-[-0.025em] text-ink sm:text-[58px] lg:text-[76px]"
        >
          Robin, votre associé IA <span class="surligne">sur WhatsApp.</span>
        </h1>
        <p class="max-w-[540px] text-[16px] leading-7 text-soft lg:text-[18px] lg:leading-8">
          Vous faites tout, tout seul : la cuisine, l'équipe, les fournisseurs, les chiffres,
          l'administratif. Robin est le bras droit que vous n'avez pas, dans l'application que vous
          ouvrez déjà cent fois par jour.
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[14px] font-medium text-ink">
          <li class="flex items-center gap-2"><span class="puce"></span>1 ou 2 établissements</li>
          <li class="flex items-center gap-2"><span class="puce"></span>À l'écrit ou en vocal</li>
          <li class="flex items-center gap-2"><span class="puce"></span>Gratuit pendant la bêta</li>
        </ul>
      </div>

      <!-- Le formulaire de la liste d'attente, Robin perché dessus -->
      <div class="relative pt-16" id="liste">
        <Image
          src={robin}
          alt="Robin, un rouge-gorge en voxel."
          widths={[160, 320]}
          sizes="160px"
          class="perche absolute -top-2 right-8 z-2 w-[150px] drop-shadow-[0_12px_18px_rgb(42_16_3/0.18)]"
        />
        <form
          class="relative z-1 flex flex-col gap-4 rounded-[28px] bg-surface p-6 shadow-2 ring-1 ring-line sm:p-8 lg:rounded-[36px] lg:p-10"
          onsubmit="event.preventDefault()"
        >
          <div class="flex flex-col gap-2">
            <h2 class="font-display text-[28px] leading-tight font-semibold text-ink">Rejoignez la bêta</h2>
            <p class="text-[14px] leading-6 text-soft">
              On ouvre Robin à quelques restaurateurs à la fois. Laissez vos coordonnées, on vous
              écrit sur WhatsApp quand c'est votre tour.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {
              champs.map((c, i) => (
                <label class:list={['champ', i >= 3 && 'sm:col-span-2']} for={`r-${c.id}`}>
                  <span>{c.label}</span>
                  <input id={`r-${c.id}`} name={c.id} type={c.type} placeholder={c.placeholder} autocomplete={c.auto} />
                </label>
              ))
            }
          </div>
          <button
            type="submit"
            class="btn-vif mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink shadow-[0_10px_24px_rgb(248_122_1/0.4)]"
          >
            Rejoindre la liste d'attente <span aria-hidden="true">→</span>
          </button>
          <p class="text-center text-[12.5px] text-soft">Gratuit pendant la bêta. Aucun engagement.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- 2 · Les trois piliers -->
  <section class="bg-cream-2 py-16 lg:py-24">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
      <div class="mb-10 flex max-w-[720px] flex-col gap-4 lg:mb-14">
        <span class="font-mono text-[12px] tracking-[0.16em] text-orange-txt uppercase">Ce que fait Robin</span>
        <h2 class="font-display text-[34px] leading-[1.08] font-semibold tracking-[-0.02em] text-ink lg:text-[48px]">
          Pas un logiciel de plus. Un associé qui connaît la maison.
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3 lg:gap-5">
        {
          piliers.map((p, i) => (
            <article class="flex flex-col gap-4 rounded-[28px] bg-surface p-7 shadow-1 ring-1 ring-line lg:p-9">
              <span class="font-mono text-[13px] text-orange-txt">0{i + 1}</span>
              <h3 class="font-display text-[24px] leading-tight font-semibold text-ink">{p.titre}</h3>
              <p class="text-[15px] leading-6 text-soft">{p.texte}</p>
              <p class="mt-auto rounded-2xl bg-whatsapp px-4 py-3 text-[14px] leading-5 text-ink">{p.exemple}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3 · Dans WhatsApp, aujourd'hui -->
  <section class="bg-cream py-16 lg:py-24">
    <div class="mx-auto grid max-w-[1240px] items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col items-start gap-5">
        <span class="font-mono text-[12px] tracking-[0.16em] text-orange-txt uppercase">Le lundi, 8 h 30</span>
        <h2 class="font-display text-[34px] leading-[1.08] font-semibold tracking-[-0.02em] text-ink lg:text-[48px]">
          C'est lui qui écrit en premier.
        </h2>
        <p class="max-w-[480px] text-[16px] leading-7 text-soft">
          Chaque semaine, Robin fait le point : votre chiffre, ce qui a bougé dans vos factures, ce
          qu'il ne faut pas oublier. Vous répondez comme à un associé, il s'occupe du reste.
        </p>
        <p class="max-w-[480px] text-[16px] leading-7 text-soft">
          Pendant la bêta, Robin vit dans WhatsApp. Ensuite, il aura sa propre conversation, pensée
          pour lui, toujours à portée de main.
        </p>
      </div>

      <div class="mx-auto w-full max-w-[340px]">
        <Iphone>
          <div class="wa">
            <div class="wa-statut" aria-hidden="true"><span>8:31</span><span>●●● ▮</span></div>
            <header class="wa-barre">
              <span class="wa-retour" aria-hidden="true">‹</span>
              <Image src={robin} alt="" width={40} densities={[1, 2]} class="wa-av" />
              <span class="wa-contact"><b>Robin</b><span>en ligne</span></span>
            </header>
            <div class="wa-fil">
              <p class="wa-jour">Lundi</p>
              <div class="wa-msg robin">
                Bonjour Karim 👋 Le point de la semaine :
                <br />• 18 420 € de CA, +6 % sur la semaine d'avant
                <br />• le beurre a pris 14 % chez Metro
                <br />• le contrat de Lina se termine vendredi
                <br /><br />Je te prépare le planning ?
              </div>
              <div class="wa-msg patron">Oui. Et fais-moi la fiche allergènes du plat du jour</div>
              <div class="wa-msg robin wa-doc">
                <span class="wa-fichier"><b>Allergènes · Plat du jour.pdf</b><span>1 page · prête à afficher</span></span>
                C'est fait. Le planning arrive dans 5 minutes.
              </div>
            </div>
          </div>
        </Iphone>
      </div>
    </div>
  </section>

  <!-- 4 · Le bandeau orange, comme l'affiche -->
  <section class="bandeau bg-orange py-16 lg:py-20">
    <div class="mx-auto grid max-w-[1240px] items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="flex flex-col items-start gap-6">
        <h2 class="font-display text-[34px] leading-[1.06] font-semibold tracking-[-0.02em] text-ink lg:text-[52px]">
          On cherche nos premiers restaurateurs pour le tester et l'améliorer avec nous.
        </h2>
        <a
          href="#liste"
          class="btn-vif inline-flex items-center gap-2 rounded-full bg-ink px-6 py-4 font-mono text-[14px] tracking-[0.12em] text-cream uppercase"
        >
          Rejoindre la bêta <span aria-hidden="true">→</span>
        </a>
      </div>
      <Picture
        src={oeuf}
        alt="Robin sort de son œuf sur le comptoir d'un bistrot."
        widths={[500, 900]}
        sizes="(min-width: 1024px) 480px, 100vw"
        formats={['avif', 'webp']}
        class="w-full rotate-[2deg] rounded-[24px] shadow-3 ring-8 ring-white"
      />
    </div>
  </section>
</Base>

<style>
  /* Grille de points, comme le fond des visuels Robin. */
  .points {
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 12%, transparent) 1px, transparent 1.4px);
    background-size: 22px 22px;
  }
  .surligne {
    background: linear-gradient(transparent 60%, var(--color-peach) 60% 92%, transparent 92%);
  }
  .puce {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-orange);
  }
  .champ {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .champ input {
    height: 48px;
    padding: 0 16px;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-surface-2);
    font: 400 15px var(--font-sans);
    color: var(--color-ink);
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .champ input::placeholder {
    color: var(--color-muted);
  }
  .champ input:focus {
    border-color: var(--color-orange-txt);
    box-shadow: 0 0 0 4px var(--color-orange-tint);
  }
  .perche {
    animation: perche 5s ease-in-out infinite;
  }
  @keyframes perche {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-6px) rotate(2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .perche {
      animation: none;
    }
  }
  /* Motif « PILOTE GRATUIT » en filigrane, comme l'affiche orange. */
  .bandeau {
    background-image: repeating-linear-gradient(
      -12deg,
      transparent 0 34px,
      color-mix(in srgb, var(--color-white) 10%, transparent) 34px 36px
    );
  }

  /* WhatsApp dans l'iPhone, mêmes proportions que les maquettes de la démo. */
  .wa {
    --pt: calc(100cqw / 370);
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-whatsapp-wall);
    font: 400 calc(15 * var(--pt)) / 1.35 var(--font-sans);
    color: var(--color-ink);
  }
  .wa-statut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: calc(54 * var(--pt));
    padding: calc(4 * var(--pt)) calc(34 * var(--pt)) 0 calc(48 * var(--pt));
    background: var(--color-surface);
    font: 600 calc(16 * var(--pt)) / 1 var(--font-sans);
  }
  .wa-barre {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--pt));
    padding: calc(6 * var(--pt)) calc(16 * var(--pt)) calc(9 * var(--pt)) calc(10 * var(--pt));
    background: var(--color-surface);
    box-shadow: 0 1px 0 var(--color-line);
  }
  .wa-retour {
    font-size: calc(30 * var(--pt));
    line-height: 1;
  }
  .wa-barre :global(.wa-av) {
    width: calc(38 * var(--pt));
    height: calc(38 * var(--pt));
    object-fit: contain;
    border-radius: 999px;
    background: var(--color-cream);
  }
  .wa-contact {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .wa-contact b {
    font-size: calc(17 * var(--pt));
  }
  .wa-contact span {
    font-size: calc(13 * var(--pt));
    color: var(--color-soft);
  }
  .wa-fil {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: calc(8 * var(--pt));
    padding: calc(10 * var(--pt)) calc(10 * var(--pt)) calc(16 * var(--pt));
  }
  .wa-jour {
    align-self: center;
    margin-bottom: auto;
    padding: calc(5 * var(--pt)) calc(12 * var(--pt));
    border-radius: calc(9 * var(--pt));
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    font: 500 calc(12 * var(--pt)) / 1.2 var(--font-sans);
    color: var(--color-soft);
  }
  .wa-msg {
    max-width: 84%;
    padding: calc(8 * var(--pt)) calc(11 * var(--pt));
    border-radius: calc(10 * var(--pt));
    box-shadow: 0 1px 0.5px color-mix(in srgb, var(--color-black) 13%, transparent);
  }
  .wa-msg.robin {
    align-self: flex-start;
    background: var(--color-surface);
    border-top-left-radius: 0;
  }
  .wa-msg.patron {
    align-self: flex-end;
    background: var(--color-whatsapp);
    border-top-right-radius: 0;
  }
  .wa-fichier {
    display: flex;
    flex-direction: column;
    margin-bottom: calc(6 * var(--pt));
    padding: calc(10 * var(--pt)) calc(12 * var(--pt));
    border-radius: calc(8 * var(--pt));
    background: var(--color-gray-50);
    border-left: calc(4 * var(--pt)) solid var(--color-statut-rouge);
  }
  .wa-fichier span {
    font-size: calc(12 * var(--pt));
    color: var(--color-soft);
  }
</style>
