---
/**
 * MAQUETTE — landing Robin (espace indépendant) avec inscription à la liste d'attente de la bêta.
 * Inspiration : muse.ai (sobriété, fond nuit, une grande phrase) et la page « dots » de ChatGPT :
 * le personnage qui flotte au-dessus du titre, la pilule de navigation collante, les rangées
 * alternées texte / carte de couleur avec une conversation dedans, « une semaine avec Robin » en
 * frise, le téléphone WhatsApp, trois cartes de confiance.
 * Contenu tiré de Notion (« Robin — le cofondateur des restaurants indépendants ») et de la
 * maquette précédente. Visuel uniquement : textes en dur, le formulaire n'envoie rien.
 */
import { Image } from 'astro:assets';
import rungis from '../../assets/footer/rungis.jpg';
import Base from '../../layouts/Base.astro';
import Iphone from '../../components/ui/Iphone.astro';
import RobinSituations from '../../components/maquettes/RobinSituations.astro';
import { routes } from '../../i18n/ui';
import robin from '../../assets/portraits/robin.jpg';
import soir from '../../assets/robin/soir.jpg';
import portrait from '../../assets/portraits/robin.jpg';
import poseLun from '../../assets/robin/semaine/lun.jpg';
import poseMar from '../../assets/robin/semaine/mar.jpg';
import poseMer from '../../assets/robin/semaine/mer.jpg';
import poseJeu from '../../assets/robin/semaine/jeu.jpg';
import poseVen from '../../assets/robin/semaine/ven.jpg';
import poseDim from '../../assets/robin/semaine/dim.jpg';

/** Robin, une tenue par jour de la frise (même ordre que `semaine`). */
const poses = [poseLun, poseMar, poseMer, poseJeu, poseVen, poseDim];

/** Une semaine avec Robin : la frise, un moment par jour (mêmes sources que les piliers). */
const semaine = [
  {
    jour: 'Lun',
    heure: '8 h 30',
    titre: 'Le point de la semaine',
    texte: 'Ventes, achats, coût du personnel : votre semaine en un coup d’œil, établissement par établissement.',
    bulle: 'Bonjour Karim, ta semaine est prête : ventes, achats et coût du personnel. Le samedi midi a été ton meilleur service.',
  },
  {
    jour: 'Mar',
    heure: '10 h',
    titre: 'Les livraisons',
    texte: 'Il rapproche ce que vous avez commandé, ce qui est arrivé et ce qui est facturé. Il vous montre les écarts, preuves à l’appui.',
    bulle: 'J’ai rapproché commandes, bons de livraison et factures. Une ligne cloche chez Metro, je te montre ?',
  },
  {
    jour: 'Mer',
    heure: '15 h',
    titre: "L'équipe",
    texte: "Il répond à vos salariés sans rien promettre à votre place, et vous fait un récap de ce qui demande votre avis.",
    bulle: 'Thomas voudrait poser samedi. Je lui ai dit que tu revenais vers lui, sans rien promettre.',
  },
  {
    jour: 'Jeu',
    heure: '11 h',
    titre: 'Le coût des plats',
    texte: "Quand un prix d'achat bouge, il recalcule le coût de vos plats et vous prévient si une marge passe sous votre seuil.",
    bulle: 'Avec la hausse du bœuf, ton tartare passe sous ta marge cible. Je te propose deux pistes ?',
  },
  {
    jour: 'Ven',
    heure: '18 h',
    titre: 'Avant le service',
    texte: "Il vous rappelle ce qui compte pour le week-end, sans que vous ayez à le lui demander.",
    bulle: 'Samedi soir est presque complet. Lina est confirmée en extra, son contrat est signé.',
  },
  {
    jour: 'Dim',
    heure: '21 h',
    titre: 'Une question pour lundi',
    texte: 'Il part de vos décisions, pas de tableaux : faut-il rester ouvert l’après-midi, ajouter un service, revoir une carte ?',
    bulle: 'Tu me demandais si on reste ouvert de 14 h à 18 h : en semaine, le créneau ne couvre pas les salaires. On en parle demain ?',
  },
];

/** Confiance : trois cartes sobres, comme celles des dots. */
const confiance = [
  {
    titre: 'Vos données restent les vôtres',
    texte: 'Hébergées en Europe, jamais utilisées pour entraîner une IA. Vous choisissez ce que Robin voit.',
  },
  {
    titre: 'Il propose, vous décidez',
    texte: "Robin prépare, vous validez. Il ne promet rien à votre place, et rien ne part chez un fournisseur ou un salarié sans votre accord.",
  },
  {
    titre: 'Dans une appli que vous connaissez',
    texte: "Pas de logiciel à installer pendant la bêta : Robin vous écrit sur WhatsApp, à l'écrit ou en vocal.",
  },
];

const champs = [
  { id: 'prenom', label: 'Prénom', type: 'text', placeholder: 'Karim', auto: 'given-name' },
  { id: 'nom', label: 'Nom', type: 'text', placeholder: 'Benali', auto: 'family-name' },
  { id: 'restaurant', label: 'Nom du restaurant', type: 'text', placeholder: 'Le Petit Comptoir', auto: 'organization' },
  { id: 'site', label: 'Site web', type: 'url', placeholder: 'lepetitcomptoir.fr', auto: 'url' },
  { id: 'whatsapp', label: 'Numéro WhatsApp', type: 'tel', placeholder: '06 12 34 56 78', auto: 'tel' },
  { id: 'email', label: 'Email', type: 'email', placeholder: 'karim@lepetitcomptoir.fr', auto: 'email' },
];

/** Le pied de page propre à Robin : le marché de Rungis et ce que Robin suit, pavillon par pavillon. */
const pied = {
  image: rungis,
  alt: "Un pavillon du marché de Rungis en voxels, vu en coupe au petit matin : marée, fruits, viande, crèmerie et un bureau à l'étage. Robin, perché sur les cagettes du chariot, fait les courses avec le patron.",
  titre: 'Robin au marché',
  liste: [
    { repere: 'MARÉE', texte: 'Il compare les prix · Commandes', href: '#fait' },
    { repere: 'FRUITS', texte: 'Il ajuste les quantités · Stock', href: '#fait' },
    { repere: 'VIANDE', texte: 'Il vérifie les pesées · Factures', href: '#fait' },
    { repere: 'CRÈMERIE', texte: 'Il suit les avoirs · Fournisseurs', href: '#fait' },
    { repere: 'BUREAU', texte: 'Il prépare les contrats · Équipe', href: '#semaine' },
  ],
};

/** La scène du soir : les messages de Robin qui arrivent l'un après l'autre, en bulles, sur la vidéo. */
const soiree = [
  {
    txt: "Le service est fini ! 🎉 Je te fais le point de la soirée. Tu trouveras le détail dans le tableau de bord qu'on a construit ensemble.",
    lien: 'Tableau de bord',
  },
  {
    txt: "Le tartare de bœuf est parti très vite ce soir 🔥. J'ai croisé les ventes avec ton stock et ajusté la commande Metro de demain : plus de bœuf 🥩, moins de saumon 🐟.",
  },
  {
    txt: "Lina t'a répondu par mail pour l'extra de demain : elle confirme sa présence 👍. Je prépare son contrat d'extra et sa fiche de paie en avance.",
  },
];

/** Le fil du lundi, dans le téléphone WhatsApp. */
const lundi = [
  {
    qui: 'robin',
    txt: 'Bonjour Karim, voici le point de la semaine. J’ai rapproché les livraisons et les factures : il manque 2 kg de bœuf chez Metro, la demande d’avoir est prête.',
  },
  { qui: 'patron', txt: 'Envoie-la. Et fais le contrat de Lina pour samedi' },
  {
    qui: 'robin',
    txt: "C'est fait, à partir de ton modèle. Relis-le avant que je l'envoie.",
    doc: "Contrat d'extra · Lina.pdf",
    meta: 'Ton modèle · prêt à signer',
  },
];
---

<Base
  espace
  locale="fr"
  paths={{ fr: '/maquettes/robin', en: '/en/maquettes/robin' }}
  nav="accueil"
  navTone="night"
  pied={pied}
  title="Maquette Robin | Hatch OS"
  description="Maquette de la page Robin, l'associé IA des restaurateurs indépendants sur WhatsApp, avec l'inscription à la liste d'attente de la bêta."
>
  <div class="nuit bg-night text-cream">
    <!-- 1 · Hero : Robin flotte au-dessus du titre (dots), une grande phrase centrée (muse.ai) -->
    <section id="robin" class="flex flex-col items-center px-4 pt-36 pb-14 text-center sm:px-6 lg:pt-44 lg:pb-20">
      <!-- Robin arrive en volant dans son cercle, fait coucou, note, vérifie un ticket, lève le pouce,
           puis repart (boucle de 15 s, avec un bouton pause : WCAG 2.2.2). -->
      <div class="mb-8 flex flex-col items-center gap-2" data-vol>
        <div class="size-[132px] overflow-hidden rounded-full bg-cream-2 lg:size-[156px]">
          <video
            class="size-full object-cover"
            src="/maquettes/anim/robin-vol.mp4"
            poster={portrait.src}
            muted
            loop
            playsinline
            preload="auto"
            aria-label="Robin, un rouge-gorge en voxel, arrive en volant, fait coucou, prend des notes, vérifie un ticket, lève le pouce et repart."
          ></video>
        </div>
        <button type="button" class="vol-pause" data-vol-pause aria-pressed="false">
          <span class="sr-only" data-vol-label>Mettre l'animation de Robin en pause</span>
          <svg viewBox="0 0 24 24" class="ico-pause size-3.5" fill="currentColor" aria-hidden="true">
            <path d="M7 5h4v14H7zm6 0h4v14h-4z"></path>
          </svg>
          <svg viewBox="0 0 24 24" class="ico-lecture size-3.5" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </button>
      </div>
      <h1
        class="font-display text-[40px] leading-[1.04] font-medium tracking-[-0.02em] sm:text-[54px] lg:text-[64px]"
      >
        Robin, votre associé IA.
      </h1>
      <p class="mt-5 max-w-[520px] text-[16px] leading-7 text-cream/75 lg:text-[18px] lg:leading-8">
        Vous faites tout, tout seul. Robin est le bras droit que vous n'avez pas : il connaît la
        maison, revient vers vous et prépare le travail.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#beta" class="btn-vif rounded-full bg-cream px-6 py-3 text-[0.9rem] font-bold text-ink">
          Rejoindre la liste d'attente
        </a>
      </div>

      <!-- La scène sous le hero, comme la vidéo des dots : le bistrot à la fermeture, Robin parle au
           patron (vidéo en boucle), et ses messages sortent de son bec, en bulles de BD, l'un après l'autre. -->
      <div class="soiree mt-14 w-full max-w-[860px] lg:mt-16" data-soiree>
        <div class="soiree-cadre">
          <video
            class="soiree-video"
            src="/maquettes/anim/robin-soir.mp4"
            poster={soir.src}
            muted
            loop
            playsinline
            preload="auto"
            aria-label="Le soir, à la fermeture d'un petit bistrot en voxels : Robin, perché sur le comptoir, fait le point avec le patron, qui regarde son téléphone."
          ></video>
          <ol class="bulles-soir" aria-label="Les messages de Robin ce soir">
            {
              soiree.map((m, i) => (
                <li class="bs" style={`--i:${i}`}>
                  <span class="bs-bulle">
                    {m.txt}
                    {m.lien && (
                      <span class="bs-lien">
                        {m.lien} <span aria-hidden="true">→</span>
                      </span>
                    )}
                  </span>
                </li>
              ))
            }
          </ol>
          <button type="button" class="soiree-pause" data-pause aria-pressed="false">
            <span class="sr-only" data-pause-label>Mettre l'animation en pause</span>
            <svg viewBox="0 0 24 24" class="ico-pause size-4" fill="currentColor" aria-hidden="true">
              <path d="M7 5h4v14H7zm6 0h4v14h-4z"></path>
            </svg>
            <svg viewBox="0 0 24 24" class="ico-lecture size-4" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- 2 · La pilule de navigation collante (dots) -->
    <nav class="pilule-zone" aria-label="Sur cette page">
      <div class="pilule">
        <a href="#robin" class="pilule-nom">
          <span class="pastille" aria-hidden="true"></span>
          Robin <span class="pilule-statut">en ligne</span>
        </a>
        <a href="#fait">Ce qu'il fait</a>
        <a href="#semaine">Une semaine</a>
        <a href="#canaux">Où le trouver</a>
        <a href="#beta" class="pilule-cta">Rejoindre la liste d'attente</a>
      </div>
    </nav>

    <!-- 3 · Ce que fait Robin : rangées alternées, une conversation dans une carte teintée -->
    <section id="fait" class="mx-auto flex max-w-[1180px] flex-col gap-12 px-4 py-20 sm:px-6 lg:gap-16 lg:py-28">
      <div class="flex max-w-[640px] flex-col gap-4">
        <span class="font-mono text-kicker text-cream/60 uppercase">Ce que fait Robin</span>
        <h2 class="font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          Pas un logiciel de plus. Un associé qui connaît la maison.
        </h2>
      </div>
      <RobinSituations />
    </section>

    <!-- 4 · Une semaine avec Robin : la frise des jours (la « journée » des dots) -->
    <section id="semaine" class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28" data-semaine>
      <div class="mx-auto flex max-w-[980px] flex-col items-center text-center">
        <span class="font-mono text-kicker text-cream/60 uppercase">Une semaine avec Robin</span>
        <h2 class="mt-4 max-w-[18ch] font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          Du lundi matin au dimanche soir.
        </h2>

        <!-- Robin et sa bulle, qui changent avec le jour -->
        <div class="scene mt-12">
          <!-- Robin change de tenue avec le jour : café le lundi, cagette le mardi, calendrier le
               mercredi, toque le jeudi, cloche le vendredi, bonnet de nuit le dimanche. -->
          <div class="flotte jour-av">
            {
              poses.map((src, i) => (
                <Image
                  src={src}
                  alt=""
                  widths={[120, 240]}
                  sizes="120px"
                  class:list={['pose', i === 0 && 'on']}
                  data-j={i}
                />
              ))
            }
          </div>
          <div class="bulles">
            {
              semaine.map((j, i) => (
                <p class:list={['bulle', i === 0 && 'on']} data-j={i}>
                  {j.bulle}
                </p>
              ))
            }
          </div>
        </div>

        <!-- La frise -->
        <div class="frise mt-10 w-full" role="tablist" aria-label="Jours de la semaine">
          {
            semaine.map((j, i) => (
              <button
                type="button"
                role="tab"
                class="jour"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="semaine-detail"
                data-j={i}
              >
                <span class="jour-point" aria-hidden="true" />
                <span class="jour-nom">{j.jour}</span>
                <span class="jour-heure">{j.heure}</span>
              </button>
            ))
          }
        </div>

        <div id="semaine-detail" class="details mt-10" aria-live="polite">
          {
            semaine.map((j, i) => (
              <div class:list={['detail', i === 0 && 'on']} data-j={i}>
                <h3 class="font-display text-[26px] leading-tight font-medium lg:text-[32px]">{j.titre}</h3>
                <p class="mx-auto mt-3 max-w-[520px] text-[16px] leading-7 text-cream/75">{j.texte}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5 · Où le trouver : le téléphone WhatsApp (pas encore d application) -->
    <section id="canaux" class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28" data-canaux>
      <div class="mx-auto flex max-w-[980px] flex-col items-center text-center">
        <span class="font-mono text-kicker text-cream/60 uppercase">Où le trouver</span>
        <h2 class="mt-4 font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          Là où vous êtes déjà.
        </h2>
        <p class="mt-4 max-w-[520px] text-[16px] leading-7 text-cream/75">
          Pendant la bêta, Robin vit dans WhatsApp. Ensuite, il aura sa propre application, pensée
          pour lui, toujours à portée de main.
        </p>

        <div class="telephone mt-10 w-full max-w-[320px]">
          <Iphone>
            <!-- WhatsApp -->
            <div class="ecran wa on" data-c="0">
              <div class="wa-statut" aria-hidden="true"><span>8:31</span><span>●●● ▮</span></div>
              <header class="wa-barre">
                <span class="wa-retour" aria-hidden="true">‹</span>
                <Image src={robin} alt="" width={40} densities={[1, 2]} class="wa-av" />
                <span class="wa-contact"><b>Robin</b><span>en ligne</span></span>
              </header>
              <div class="wa-fil">
                <p class="wa-jour">Lundi</p>
                {
                  lundi.map((m) => (
                    <div class:list={['wa-msg', m.qui, m.doc && 'wa-doc']}>
                      {m.doc && (
                        <span class="wa-fichier">
                          <b>{m.doc}</b>
                          <span>{m.meta}</span>
                        </span>
                      )}
                      {m.txt}
                    </div>
                  ))
                }
              </div>
            </div>
          </Iphone>
        </div>
      </div>
    </section>

    <!-- 6 · Confiance : sur le fond noir, trois cartes au contour bleu du plumage de Robin. -->
    <section class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28">
      <div class="mx-auto flex max-w-[1180px] flex-col items-center">
        <h2 class="max-w-[20ch] text-center font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          À vos côtés, sous votre contrôle.
        </h2>
        <div class="mt-12 grid w-full gap-4 md:grid-cols-3">
          {
            confiance.map((c, i) => (
              <article class="flex flex-col items-start gap-3 rounded-[24px] bg-night-2 p-7 ring-1 ring-robin/60 lg:p-8">
                <span class="font-mono text-[12px] tracking-[0.08em] text-cream/60">0{i + 1}</span>
                <h3 class="font-display text-[22px] leading-tight font-medium">{c.titre}</h3>
                <p class="text-[15px] leading-6 text-cream/75">{c.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7 · La bêta : la liste d'attente -->
    <section id="beta" class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28">
      <div class="mx-auto grid max-w-[1100px] items-center gap-12 lg:grid-cols-[1fr_0.95fr] lg:gap-16">
        <div class="flex flex-col items-start gap-5">
          <span class="font-mono text-kicker text-cream/60 uppercase">Bêta</span>
          <h2 class="font-display text-[34px] leading-[1.06] font-medium tracking-[-0.02em] lg:text-[48px]">
            Vous souhaitez utiliser Robin ? Inscrivez-vous sur la liste d'attente.
          </h2>
          <p class="max-w-[440px] text-[16px] leading-7 text-cream/75">
            Les premiers inscrits seront avantagés. On ouvre Robin à quelques restaurateurs à la fois,
            on vous écrit sur WhatsApp quand c'est votre tour.
          </p>
        </div>
        <form
          class="flex flex-col gap-4 rounded-[28px] bg-cream p-6 text-ink sm:p-8 lg:rounded-[36px] lg:p-10"
          onsubmit="event.preventDefault()"
        >
          <div class="grid gap-3 sm:grid-cols-2">
            {
              champs.map((c, i) => (
                <label class="champ" for={`r-${c.id}`}>
                  <span>{c.label}</span>
                  <input id={`r-${c.id}`} name={c.id} type={c.type} placeholder={c.placeholder} autocomplete={c.auto} />
                </label>
              ))
            }
          </div>
          <button
            type="submit"
            class="btn-vif mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink"
          >
            Rejoindre la liste d'attente <span aria-hidden="true">→</span>
          </button>
          <p class="text-center text-[12.5px] text-soft">Gratuit pendant la bêta. Aucun engagement.</p>
        </form>
      </div>
    </section>
  </div>

  <script is:inline data-keep>
    // Robin en vol dans le hero : la boucle démarre seule (sauf mouvement réduit : le portrait reste
    // fixe), le petit bouton la met en pause.
    (function () {
      var root = document.querySelector('[data-vol]');
      if (!root) return;
      var video = root.querySelector('video');
      var bouton = root.querySelector('[data-vol-pause]');
      var label = root.querySelector('[data-vol-label]');
      function regler(pause) {
        root.classList.toggle('pause', pause);
        bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
        label.textContent = pause ? "Relancer l'animation de Robin" : "Mettre l'animation de Robin en pause";
        if (pause) video.pause();
        else video.play().catch(function () {});
      }
      bouton.addEventListener('click', function () {
        regler(!root.classList.contains('pause'));
      });
      regler(matchMedia('(prefers-reduced-motion: reduce)').matches);
    })();
    // La scène du soir : la vidéo démarre seule (sauf mouvement réduit), le bouton met en pause la
    // vidéo et l'arrivée des messages (WCAG 2.2.2 : tout ce qui tourne en boucle se met en pause).
    (function () {
      var root = document.querySelector('[data-soiree]');
      if (!root) return;
      var video = root.querySelector('video');
      var bouton = root.querySelector('[data-pause]');
      var label = root.querySelector('[data-pause-label]');
      var reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function regler(pause) {
        root.classList.toggle('pause', pause);
        bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
        label.textContent = pause ? "Relancer l'animation" : "Mettre l'animation en pause";
        if (pause) video.pause();
        else video.play().catch(function () {});
      }
      bouton.addEventListener('click', function () {
        regler(!root.classList.contains('pause'));
      });
      regler(reduit);
    })();
    // Une semaine avec Robin : un clic sur un jour change la bulle et le détail. Les canaux : un clic
    // sur un onglet change l'écran du téléphone. Sans JS : le lundi et WhatsApp restent affichés.
    (function () {
      function onglets(root, attr) {
        if (!root) return;
        var tabs = [].slice.call(root.querySelectorAll('[role="tab"]'));
        var panneaux = [].slice.call(root.querySelectorAll('[' + attr + ']:not([role="tab"])'));
        tabs.forEach(function (t) {
          t.addEventListener('click', function () {
            var v = t.getAttribute(attr);
            tabs.forEach(function (u) {
              u.setAttribute('aria-selected', u === t ? 'true' : 'false');
            });
            panneaux.forEach(function (p) {
              var on = p.getAttribute(attr) === v;
              p.classList.toggle('on', on);
              p.setAttribute('aria-hidden', on ? 'false' : 'true');
            });
          });
        });
      }
      onglets(document.querySelector('[data-semaine]'), 'data-j');
    })();
  </script>
</Base>

<style>
