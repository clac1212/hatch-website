---
/**
 * MAQUETTE — nouvelle page d'accueil : un bandeau qui dit ce que fait Hatch OS (phrase à mot
 * changeant), puis deux portes côte à côte : restaurant indépendant (Robin) et réseau (le site actuel).
 * Visuel uniquement : textes en dur, rien n'est branché.
 */
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { routes } from '../../i18n/ui';
import oeuf from '../../assets/robin/robin-oeuf-comptoir.jpg';
import reseau from '../../assets/tarifs/restaurant.jpg';
import peep from '../../assets/portraits/peep.jpg';
import pecker from '../../assets/hero/agents/pecker.webp';
import finch from '../../assets/hero/agents/finch.webp';
import jay from '../../assets/hero/agents/jay.webp';
import sparrow from '../../assets/hero/agents/sparrow.png';
import owl from '../../assets/hero/agents/owl.webp';
import lark from '../../assets/hero/agents/lark.webp';
import robin from '../../assets/robin/robin-face.png';

// Chaque fin de phrase est le travail d'un agent : son avatar change avec le texte.
const mots = [
  { texte: 'répondent à vos équipes', agent: 'Peep', img: peep, portrait: true },
  { texte: 'forment vos recrues', agent: 'Pecker', img: pecker },
  { texte: 'auditent vos restaurants', agent: 'Finch', img: finch },
  { texte: 'tiennent vos procédures à jour', agent: 'Jay', img: jay },
  { texte: 'préparent vos ouvertures', agent: 'Sparrow', img: sparrow },
  { texte: 'répondent en cuisine', agent: 'Owl', img: owl },
  { texte: 'font le point chaque lundi', agent: 'Lark', img: lark },
  { texte: 'calculent vos marges', agent: 'Robin', img: robin },
];
---

<Base
  locale="fr"
  paths={routes.home}
  nav="accueil"
  title="Maquette accueil | Hatch OS"
  description="Maquette de la nouvelle page d'accueil de Hatch OS : un bandeau qui explique ce que font les agents, puis deux espaces, indépendants et réseaux."
>
  <main class="mx-auto flex max-w-[1360px] flex-col gap-4 px-4 pt-24 pb-16 sm:px-6 lg:gap-5 lg:pt-28">
    <!-- 1 · Le bandeau : ce que fait Hatch OS -->
    <!-- Juste le texte, façon muse.ai : pas de cadre, pas d'image, une grande phrase centrée. -->
    <section
      class="flex flex-col items-center gap-6 px-2 pt-14 pb-12 text-center lg:pt-24 lg:pb-20"
      aria-labelledby="accueil-titre"
    >
      <!-- Le titre « rébus » de muse.ai : ligne 1 avec l'avatar dans un cercle, ligne 2 la fin de
           phrase qui change mot par mot. L'avatar change avec elle : c'est l'agent qui fait ce travail. -->
      <h1
        id="accueil-titre"
        class="rebus w-full font-display text-[34px] leading-[1.1] font-medium tracking-[-0.01em] text-ink sm:text-[46px] lg:text-[clamp(46px,4.3vw,62px)]"
        data-rebus
      >
        <span class="sr-only">Des collaborateurs IA qui {mots[0].texte}</span>
        <span class="ligne" aria-hidden="true">
          Des collaborateurs IA<span class="avatars" data-avatars>
            {
              mots.map((m, i) => (
                <span class:list={['av', i === 0 && 'on']} title={m.agent}>
                  <Image src={m.img} alt="" width={160} class:list={['av-img', m.portrait && 'portrait']} />
                </span>
              ))
            }
          </span>qui
        </span>
        <span class="ligne phrases" aria-hidden="true">
          {
            mots.map((m, i) => (
              <span class:list={['ph', i === 0 && 'on']}>
                {m.texte.split(' ').map((w, j) => (
                  <>
                    <span class="w" style={`--i:${j}`}>
                      {w}
                    </span>{' '}
                  </>
                ))}
              </span>
            ))
          }
        </span>
      </h1>
      <p class="max-w-[560px] text-[16px] leading-7 text-soft lg:text-[18px] lg:leading-8">
        Pour le patron d'un restaurant indépendant comme pour la tête d'un réseau de franchise.
        Choisissez votre espace.
      </p>
    </section>

    <!-- 2 · Les deux portes -->
    <div class="grid gap-4 md:grid-cols-2 lg:gap-5">
      <!-- Indépendant → Robin -->
      <a
        href="/maquettes/robin"
        class="group flex flex-col overflow-hidden rounded-[28px] bg-surface shadow-1 ring-1 ring-line transition hover:-translate-y-1 hover:shadow-2 lg:rounded-[36px]"
      >
        <div class="relative aspect-[16/10] overflow-hidden">
          <Picture
            src={oeuf}
            alt="Robin, un rouge-gorge en voxel, sort de son œuf sur le comptoir d'un bistrot."
            widths={[600, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={['avif', 'webp']}
            class="size-full object-cover transition duration-700 group-hover:scale-[1.03]"
          />
          <span
            class="absolute top-4 left-4 rounded-full bg-ink px-3 py-1.5 font-mono text-[11px] tracking-[0.16em] text-cream uppercase"
          >
            Bêta ouverte
          </span>
        </div>
        <div class="flex flex-1 flex-col gap-3 px-6 pt-6 pb-7 lg:px-9 lg:pt-8 lg:pb-9">
          <span class="font-mono text-[12px] tracking-[0.16em] text-orange-txt uppercase">
            Restaurant indépendant
          </span>
          <h2 class="font-display text-[28px] leading-[1.1] font-semibold text-ink lg:text-[36px]">
            Robin, votre associé IA sur WhatsApp
          </h2>
          <p class="text-[15px] leading-6 text-soft">
            Vous tenez un ou deux restaurants et vous faites tout vous-même. Robin connaît votre
            maison, revient vers vous chaque semaine et vous prépare ce dont vous avez besoin.
          </p>
          <span class="mt-auto pt-3">
            <span
              class="btn-vif inline-flex items-center gap-2 rounded-full bg-orange px-5 py-3 text-[0.875rem] font-bold text-ink shadow-[0_6px_16px_rgb(248_122_1/0.35)]"
            >
              Découvrir Robin <span aria-hidden="true">→</span>
            </span>
          </span>
        </div>
      </a>

      <!-- Réseau → le site actuel -->
      <a
        href="/"
        class="group flex flex-col overflow-hidden rounded-[28px] bg-night shadow-1 transition hover:-translate-y-1 hover:shadow-2 lg:rounded-[36px]"
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-scene">
          <Picture
            src={reseau}
            alt="Un restaurant en coupe, en voxel, où les agents Hatch OS travaillent à chaque étage."
            widths={[600, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={['avif', 'webp']}
            class="size-full object-cover transition duration-700 group-hover:scale-[1.03]"
          />
        </div>
        <div class="flex flex-1 flex-col gap-3 px-6 pt-6 pb-7 lg:px-9 lg:pt-8 lg:pb-9">
          <span class="font-mono text-[12px] tracking-[0.16em] text-peach uppercase">
            Réseau, franchise, succursales
          </span>
          <h2 class="font-display text-[28px] leading-[1.1] font-semibold text-cream lg:text-[36px]">
            Les agents Hatch OS pour piloter votre réseau
          </h2>
          <p class="text-[15px] leading-6 text-cream/75">
            Animation, documentation, audits, formation, ouvertures : une équipe d'agents qui
            travaille pour le siège et répond à chaque établissement.
          </p>
          <span class="mt-auto pt-3">
            <span
              class="btn-vif inline-flex items-center gap-2 rounded-full bg-cream px-5 py-3 text-[0.875rem] font-bold text-ink"
            >
              Découvrir les agents <span aria-hidden="true">→</span>
            </span>
          </span>
        </div>
      </a>
    </div>
    <script is:inline data-keep>
      // Titre « rébus » façon muse.ai. Toutes les 2,8 s : les mots de la fin de phrase sortent vers le
      // haut l'un après l'autre, ceux de la suivante entrent par le bas ; l'agent du cercle change avec
      // elle (il arrive en sautillant). Mouvement réduit : la première phrase reste, sans animation.
      (function () {
        var root = document.querySelector('[data-rebus]');
        if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var ph = [].slice.call(root.querySelectorAll('.ph'));
        var av = [].slice.call(root.querySelectorAll('.av'));
        var sr = root.querySelector('.sr-only');
        var i = 0;
        setInterval(function () {
          var a = ph[i], b = av[i];
          a.classList.remove('on'); a.classList.add('out');
          b.classList.remove('on'); b.classList.add('out');
          i = (i + 1) % ph.length;
          ph[i].classList.remove('out'); ph[i].classList.add('on');
          av[i].classList.remove('out'); av[i].classList.add('on');
          if (sr) sr.textContent = 'Des collaborateurs IA qui ' + ph[i].textContent.replace(/\s+/g, ' ').trim();
          setTimeout(function () { a.classList.remove('out'); b.classList.remove('out'); }, 900);
        }, 2800);
      })();
    </script>
  </main>
</Base>



<style>
  .rebus .ligne {
    display: block;
  }

  /* L'avatar, comme celui de Muse : un cercle un peu plus haut que les capitales, liseré fin,
     posé dans la ligne. Tous les agents empilés dans la même case, un seul visible. */
  .avatars {
    position: relative;
    display: inline-grid;
    width: 1.07em;
    height: 1.07em;
    margin: 0 0.19em;
    vertical-align: middle;
    translate: 0 -0.05em;
    border-radius: 999px;
    background: var(--color-cream-2);
    box-shadow: inset 0 0 0 0.5px color-mix(in srgb, var(--color-ink) 8%, transparent);
    overflow: hidden;
    cursor: default;
  }
  .av {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    translate: 0 60%;
    scale: 0.7;
    transition:
      opacity 0.3s ease,
      translate 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .av.on {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .av.out {
    opacity: 0;
    translate: 0 -40%;
    scale: 0.85;
    transition-timing-function: ease-in;
    transition-duration: 0.3s;
  }
  .av :global(.av-img) {
    width: 80%;
    height: auto;
    margin-bottom: 6%;
    transform-origin: 50% 100%;
  }
  /* il respire tant qu'il est affiché, il se dandine au survol (le « working » de Muse) */
  /* Portrait façon Muse (fond crème, agent de face qui remplit le cercle) : pleine case. */
  .av :global(.av-img.portrait) {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }
  .av.on :global(.av-img) {
    animation: respire 2.2s 0.6s ease-in-out infinite;
  }
  .avatars:hover .av.on :global(.av-img) {
    animation: dandine 0.7s ease-in-out infinite;
  }
  @keyframes respire {
    0%,
    100% {
      transform: scale(1, 1);
    }
    50% {
      transform: scale(1.04, 0.96);
    }
  }
  @keyframes dandine {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-8deg) translateY(-3%);
    }
    75% {
      transform: rotate(8deg) translateY(-3%);
    }
  }

  /* La fin de phrase : toutes empilées dans la même case (sa hauteur est celle de la plus longue),
     mot par mot. Sortie vers le haut, entrée par le bas, décalée de 45 ms par mot. */
  /* La fin de phrase qui change : gras, italique (le vrai italique de Fraunces) et orange de la
     marque, en version texte (#a34f00) pour rester lisible sur le crème. */
  .rebus .phrases {
    display: grid;
    justify-items: center;
    font-weight: 700;
    font-style: italic;
    color: var(--color-orange-txt);
  }
  .ph {
    grid-area: 1 / 1;
    place-self: start center;
    max-width: 100%;
  }
  .w {
    display: inline-block;
    opacity: 0;
    translate: 0 0.3em;
    transition:
      opacity 0.35s ease,
      translate 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 45ms);
  }
  .ph.on .w {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(180ms + var(--i) * 45ms);
  }
  .ph.out .w {
    opacity: 0;
    translate: 0 -0.3em;
    transition-timing-function: ease-in;
  }

  @media (prefers-reduced-motion: reduce) {
    .av,
    .w {
      transition: none;
    }
    .av.on :global(.av-img),
    .avatars:hover .av.on :global(.av-img) {
      animation: none;
    }
  }
</style>
