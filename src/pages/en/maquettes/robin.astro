---
/**
 * MOCKUP (EN) — Robin landing page (independent owners) with sign-up for the beta waitlist.
 * Inspiration: muse.ai (restraint, night background, one big sentence) and ChatGPT's "dots" page:
 * the character floating above the title, the sticky nav pill, alternating rows of text / coloured
 * card with a conversation inside, "a week with Robin" as a timeline, the WhatsApp phone, three
 * trust cards.
 * Content from Notion ("Robin — the co-founder of independent restaurants") and the previous
 * mockup. Visual only: hardcoded copy, the form sends nothing.
 */
import { Image } from 'astro:assets';
import rungis from '../../../assets/footer/rungis.jpg';
import Base from '../../../layouts/Base.astro';
import Iphone from '../../../components/ui/Iphone.astro';
import RobinSituations from '../../../components/maquettes/en/RobinSituations.astro';
import { routes } from '../../../i18n/ui';
import robin from '../../../assets/portraits/robin.jpg';
import soir from '../../../assets/robin/soir.jpg';
import portrait from '../../../assets/portraits/robin.jpg';
import poseLun from '../../../assets/robin/semaine/lun.jpg';
import poseMar from '../../../assets/robin/semaine/mar.jpg';
import poseMer from '../../../assets/robin/semaine/mer.jpg';
import poseJeu from '../../../assets/robin/semaine/jeu.jpg';
import poseVen from '../../../assets/robin/semaine/ven.jpg';
import poseDim from '../../../assets/robin/semaine/dim.jpg';

/** Robin, one outfit per day of the timeline (same order as `semaine`). */
const poses = [poseLun, poseMar, poseMer, poseJeu, poseVen, poseDim];

/** A week with Robin: the timeline, one moment per day (same sources as the pillars). */
const semaine = [
  {
    jour: 'Mon',
    heure: '8:30 am',
    titre: 'The weekly recap',
    texte: 'Sales, purchases, staff costs: your week at a glance, site by site.',
    bulle: 'Morning Karim, your week is ready: sales, purchases and staff costs. Saturday lunch was your best service.',
  },
  {
    jour: 'Tue',
    heure: '10 am',
    titre: 'Deliveries',
    texte: 'He matches what you ordered, what arrived and what was invoiced. He shows you the gaps, with the proof.',
    bulle: 'I matched orders, delivery notes and invoices. One line at Metro looks off, want me to show you?',
  },
  {
    jour: 'Wed',
    heure: '3 pm',
    titre: 'The team',
    texte: 'He answers your staff without promising anything on your behalf, and sums up what needs your call.',
    bulle: 'Thomas would like Saturday off. I told him you’d get back to him, no promises.',
  },
  {
    jour: 'Thu',
    heure: '11 am',
    titre: 'Dish costs',
    texte: 'When a purchase price moves, he recalculates the cost of your dishes and warns you if a margin drops below your threshold.',
    bulle: 'With beef prices up, your tartare drops below your target margin. Want two options?',
  },
  {
    jour: 'Fri',
    heure: '6 pm',
    titre: 'Before service',
    texte: 'He reminds you what matters for the weekend, without you having to ask.',
    bulle: 'Saturday night is almost full. Lina is confirmed as extra staff, her contract is signed.',
  },
  {
    jour: 'Sun',
    heure: '9 pm',
    titre: 'A question for Monday',
    texte: 'He starts from your decisions, not from spreadsheets: should you stay open in the afternoon, add a service, rework a menu?',
    bulle: 'You asked whether we should stay open from 2 to 6 pm: on weekdays, that slot doesn’t cover the wages. Shall we talk tomorrow?',
  },
];

/** Trust: three plain cards, like the dots ones. */
const confiance = [
  {
    titre: 'Your data stays yours',
    texte: 'Hosted in Europe, never used to train an AI. You choose what Robin sees.',
  },
  {
    titre: 'He suggests, you decide',
    texte: 'Robin prepares, you approve. He never promises anything on your behalf, and nothing goes out to a supplier or an employee without your OK.',
  },
  {
    titre: 'In an app you already know',
    texte: 'No software to install during the beta: Robin messages you on WhatsApp, in text or voice notes.',
  },
];

const champs = [
  { id: 'prenom', label: 'First name', type: 'text', placeholder: 'Karim', auto: 'given-name' },
  { id: 'nom', label: 'Last name', type: 'text', placeholder: 'Benali', auto: 'family-name' },
  { id: 'restaurant', label: 'Restaurant name', type: 'text', placeholder: 'Le Petit Comptoir', auto: 'organization' },
  { id: 'site', label: 'Website', type: 'url', placeholder: 'lepetitcomptoir.fr', auto: 'url' },
  { id: 'whatsapp', label: 'WhatsApp number', type: 'tel', placeholder: '+33 6 12 34 56 78', auto: 'tel' },
  { id: 'email', label: 'Email', type: 'email', placeholder: 'karim@lepetitcomptoir.fr', auto: 'email' },
];

/** Robin's own footer: the Rungis market and what Robin keeps track of, hall by hall. */
const pied = {
  image: rungis,
  alt: 'A hall of the Rungis market in voxels, seen in cross-section at dawn: fish, fruit, meat, dairy and an office upstairs. Robin, perched on the crates of the trolley, does the shopping with the owner.',
  titre: 'Robin at the market',
  liste: [
    { repere: 'FISH', texte: 'He compares prices · Orders', href: '#fait' },
    { repere: 'FRUIT', texte: 'He adjusts quantities · Stock', href: '#fait' },
    { repere: 'MEAT', texte: 'He checks the weights · Invoices', href: '#fait' },
    { repere: 'DAIRY', texte: 'He tracks credit notes · Suppliers', href: '#fait' },
    { repere: 'OFFICE', texte: 'He prepares contracts · Team', href: '#semaine' },
  ],
};

/** The evening scene: Robin's messages arriving one after another, as bubbles over the video. */
const soiree = [
  {
    txt: 'Service is over! 🎉 Here’s your recap of the evening. You’ll find the details in the dashboard we built together.',
    lien: 'Dashboard',
  },
  {
    txt: 'The beef tartare sold out fast tonight 🔥. I cross-checked sales with your stock and adjusted tomorrow’s Metro order: more beef 🥩, less salmon 🐟.',
  },
  {
    txt: 'Lina replied by email about tomorrow’s extra shift: she’s confirmed 👍. I’m preparing her extra contract and her payslip in advance.',
  },
];

/** Monday's thread, in the WhatsApp phone. */
const lundi = [
  {
    qui: 'robin',
    txt: 'Morning Karim, here’s your weekly recap. I matched deliveries and invoices: Metro is 2 kg of beef short, the credit note request is ready.',
  },
  { qui: 'patron', txt: 'Send it. And do Lina’s contract for Saturday' },
  {
    qui: 'robin',
    txt: 'Done, from your template. Check it before I send it.',
    doc: 'Extra contract · Lina.pdf',
    meta: 'Your template · ready to sign',
  },
];
---

<Base
  espace
  locale="en"
  paths={{ fr: '/maquettes/robin', en: '/en/maquettes/robin' }}
  nav="accueil"
  navTone="night"
  pied={pied}
  title="Robin mockup | Hatch OS"
  description="Mockup of the Robin page, the AI partner for independent restaurant owners on WhatsApp, with sign-up for the beta waitlist."
>
  <div class="nuit bg-night text-cream">
    <!-- 1 · Hero: Robin floats above the title (dots), one big centred sentence (muse.ai) -->
    <section id="robin" class="flex flex-col items-center px-4 pt-36 pb-14 text-center sm:px-6 lg:pt-44 lg:pb-20">
      <!-- Robin flies into his circle, waves, takes notes, checks a receipt, gives a thumbs up,
           then flies off (15 s loop, with a pause button: WCAG 2.2.2). -->
      <div class="mb-8 flex flex-col items-center gap-2" data-vol>
        <div class="size-[132px] overflow-hidden rounded-full bg-cream-2 lg:size-[156px]">
          <video
            class="size-full object-cover"
            src="/maquettes/anim/robin-vol.mp4"
            poster={portrait.src}
            muted
            loop
            playsinline
            preload="auto"
            aria-label="Robin, a voxel robin, flies in, waves, takes notes, checks a receipt, gives a thumbs up and flies off."
          ></video>
        </div>
        <button type="button" class="vol-pause" data-vol-pause aria-pressed="false">
          <span class="sr-only" data-vol-label>Pause Robin's animation</span>
          <svg viewBox="0 0 24 24" class="ico-pause size-3.5" fill="currentColor" aria-hidden="true">
            <path d="M7 5h4v14H7zm6 0h4v14h-4z"></path>
          </svg>
          <svg viewBox="0 0 24 24" class="ico-lecture size-3.5" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </button>
      </div>
      <h1
        class="font-display text-[40px] leading-[1.04] font-medium tracking-[-0.02em] sm:text-[54px] lg:text-[64px]"
      >
        Robin, your AI partner.
      </h1>
      <p class="mt-5 max-w-[520px] text-[16px] leading-7 text-cream/75 lg:text-[18px] lg:leading-8">
        You do everything, on your own. Robin is the right hand you don't have: he knows your
        restaurant, follows up with you and gets the work ready.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#beta" class="btn-vif rounded-full bg-cream px-6 py-3 text-[0.9rem] font-bold text-ink">
          Join the waitlist
        </a>
      </div>

      <!-- The scene below the hero, like the dots video: the bistro at closing time, Robin talks to
           the owner (looping video), and his messages pop out of his beak, as comic bubbles, one after another. -->
      <div class="soiree mt-14 w-full max-w-[860px] lg:mt-16" data-soiree>
        <div class="soiree-cadre">
          <video
            class="soiree-video"
            src="/maquettes/anim/robin-soir.mp4"
            poster={soir.src}
            muted
            loop
            playsinline
            preload="auto"
            aria-label="Evening, closing time at a small voxel bistro: Robin, perched on the counter, goes over the day with the owner, who is looking at his phone."
          ></video>
          <ol class="bulles-soir" aria-label="Robin's messages tonight">
            {
              soiree.map((m, i) => (
                <li class="bs" style={`--i:${i}`}>
                  <span class="bs-bulle">
                    {m.txt}
                    {m.lien && (
                      <span class="bs-lien">
                        {m.lien} <span aria-hidden="true">→</span>
                      </span>
                    )}
                  </span>
                </li>
              ))
            }
          </ol>
          <button type="button" class="soiree-pause" data-pause aria-pressed="false">
            <span class="sr-only" data-pause-label>Pause the animation</span>
            <svg viewBox="0 0 24 24" class="ico-pause size-4" fill="currentColor" aria-hidden="true">
              <path d="M7 5h4v14H7zm6 0h4v14h-4z"></path>
            </svg>
            <svg viewBox="0 0 24 24" class="ico-lecture size-4" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- 2 · The sticky nav pill (dots) -->
    <nav class="pilule-zone" aria-label="On this page">
      <div class="pilule">
        <a href="#robin" class="pilule-nom">
          <span class="pastille" aria-hidden="true"></span>
          Robin <span class="pilule-statut">online</span>
        </a>
        <a href="#fait">What he does</a>
        <a href="#semaine">A week</a>
        <a href="#canaux">Where to find him</a>
        <a href="#beta" class="pilule-cta">Join the waitlist</a>
      </div>
    </nav>

    <!-- 3 · What Robin does: alternating rows, a conversation in a tinted card -->
    <section id="fait" class="mx-auto flex max-w-[1180px] flex-col gap-12 px-4 py-20 sm:px-6 lg:gap-16 lg:py-28">
      <div class="flex max-w-[640px] flex-col gap-4">
        <span class="font-mono text-kicker text-cream/60 uppercase">What Robin does</span>
        <h2 class="font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          Not one more piece of software. A partner who knows your restaurant.
        </h2>
      </div>
      <RobinSituations />
    </section>

    <!-- 4 · A week with Robin: the day timeline (the dots "day") -->
    <section id="semaine" class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28" data-semaine>
      <div class="mx-auto flex max-w-[980px] flex-col items-center text-center">
        <span class="font-mono text-kicker text-cream/60 uppercase">A week with Robin</span>
        <h2 class="mt-4 max-w-[18ch] font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          From Monday morning to Sunday night.
        </h2>

        <!-- Robin and his bubble, which change with the day -->
        <div class="scene mt-12">
          <!-- Robin changes outfit with the day: coffee on Monday, crate on Tuesday, calendar on
               Wednesday, chef's hat on Thursday, bell on Friday, nightcap on Sunday. -->
          <div class="flotte jour-av">
            {
              poses.map((src, i) => (
                <Image
                  src={src}
                  alt=""
                  widths={[120, 240]}
                  sizes="120px"
                  class:list={['pose', i === 0 && 'on']}
                  data-j={i}
                />
              ))
            }
          </div>
          <div class="bulles">
            {
              semaine.map((j, i) => (
                <p class:list={['bulle', i === 0 && 'on']} data-j={i}>
                  {j.bulle}
                </p>
              ))
            }
          </div>
        </div>

        <!-- The timeline -->
        <div class="frise mt-10 w-full" role="tablist" aria-label="Days of the week">
          {
            semaine.map((j, i) => (
              <button
                type="button"
                role="tab"
                class="jour"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="semaine-detail"
                data-j={i}
              >
                <span class="jour-point" aria-hidden="true" />
                <span class="jour-nom">{j.jour}</span>
                <span class="jour-heure">{j.heure}</span>
              </button>
            ))
          }
        </div>

        <div id="semaine-detail" class="details mt-10" aria-live="polite">
          {
            semaine.map((j, i) => (
              <div class:list={['detail', i === 0 && 'on']} data-j={i}>
                <h3 class="font-display text-[26px] leading-tight font-medium lg:text-[32px]">{j.titre}</h3>
                <p class="mx-auto mt-3 max-w-[520px] text-[16px] leading-7 text-cream/75">{j.texte}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5 · Where to find him: the WhatsApp phone (no app yet) -->
    <section id="canaux" class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28" data-canaux>
      <div class="mx-auto flex max-w-[980px] flex-col items-center text-center">
        <span class="font-mono text-kicker text-cream/60 uppercase">Where to find him</span>
        <h2 class="mt-4 font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          Right where you already are.
        </h2>
        <p class="mt-4 max-w-[520px] text-[16px] leading-7 text-cream/75">
          During the beta, Robin lives in WhatsApp. Later, he'll have his own app, built for him,
          always within reach.
        </p>

        <div class="telephone mt-10 w-full max-w-[320px]">
          <Iphone>
            <!-- WhatsApp -->
            <div class="ecran wa on" data-c="0">
              <div class="wa-statut" aria-hidden="true"><span>8:31</span><span>●●● ▮</span></div>
              <header class="wa-barre">
                <span class="wa-retour" aria-hidden="true">‹</span>
                <Image src={robin} alt="" width={40} densities={[1, 2]} class="wa-av" />
                <span class="wa-contact"><b>Robin</b><span>online</span></span>
              </header>
              <div class="wa-fil">
                <p class="wa-jour">Monday</p>
                {
                  lundi.map((m) => (
                    <div class:list={['wa-msg', m.qui, m.doc && 'wa-doc']}>
                      {m.doc && (
                        <span class="wa-fichier">
                          <b>{m.doc}</b>
                          <span>{m.meta}</span>
                        </span>
                      )}
                      {m.txt}
                    </div>
                  ))
                }
              </div>
            </div>
          </Iphone>
        </div>
      </div>
    </section>

    <!-- 6 · Trust: on the dark background, three cards outlined in the blue of Robin's feathers. -->
    <section class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28">
      <div class="mx-auto flex max-w-[1180px] flex-col items-center">
        <h2 class="max-w-[20ch] text-center font-display text-[34px] leading-[1.08] font-medium tracking-[-0.02em] lg:text-[48px]">
          By your side, under your control.
        </h2>
        <div class="mt-12 grid w-full gap-4 md:grid-cols-3">
          {
            confiance.map((c, i) => (
              <article class="flex flex-col items-start gap-3 rounded-[24px] bg-night-2 p-7 ring-1 ring-robin/60 lg:p-8">
                <span class="font-mono text-[12px] tracking-[0.08em] text-cream/60">0{i + 1}</span>
                <h3 class="font-display text-[22px] leading-tight font-medium">{c.titre}</h3>
                <p class="text-[15px] leading-6 text-cream/75">{c.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7 · The beta: the waitlist -->
    <section id="beta" class="border-t border-line-night px-4 py-20 sm:px-6 lg:py-28">
      <div class="mx-auto grid max-w-[1100px] items-center gap-12 lg:grid-cols-[1fr_0.95fr] lg:gap-16">
        <div class="flex flex-col items-start gap-5">
          <span class="font-mono text-kicker text-cream/60 uppercase">Beta</span>
          <h2 class="font-display text-[34px] leading-[1.06] font-medium tracking-[-0.02em] lg:text-[48px]">
            Want to use Robin? Join the waitlist.
          </h2>
          <p class="max-w-[440px] text-[16px] leading-7 text-cream/75">
            Early sign-ups get priority. We're opening Robin to a few restaurant owners at a time,
            and we'll message you on WhatsApp when it's your turn.
          </p>
        </div>
        <form
          class="flex flex-col gap-4 rounded-[28px] bg-cream p-6 text-ink sm:p-8 lg:rounded-[36px] lg:p-10"
          onsubmit="event.preventDefault()"
        >
          <div class="grid gap-3 sm:grid-cols-2">
            {
              champs.map((c, i) => (
                <label class="champ" for={`r-${c.id}`}>
                  <span>{c.label}</span>
                  <input id={`r-${c.id}`} name={c.id} type={c.type} placeholder={c.placeholder} autocomplete={c.auto} />
                </label>
              ))
            }
          </div>
          <button
            type="submit"
            class="btn-vif mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-orange px-6 py-4 text-base font-bold text-ink"
          >
            Join the waitlist <span aria-hidden="true">→</span>
          </button>
          <p class="text-center text-[12.5px] text-soft">Free during the beta. No commitment.</p>
        </form>
      </div>
    </section>
  </div>

  <script is:inline data-keep>
    // Robin flying in the hero: the loop starts on its own (except with reduced motion: the portrait
    // stays still), the small button pauses it.
    (function () {
      var root = document.querySelector('[data-vol]');
      if (!root) return;
      var video = root.querySelector('video');
      var bouton = root.querySelector('[data-vol-pause]');
      var label = root.querySelector('[data-vol-label]');
      function regler(pause) {
        root.classList.toggle('pause', pause);
        bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
        label.textContent = pause ? "Play Robin's animation" : "Pause Robin's animation";
        if (pause) video.pause();
        else video.play().catch(function () {});
      }
      bouton.addEventListener('click', function () {
        regler(!root.classList.contains('pause'));
      });
      regler(matchMedia('(prefers-reduced-motion: reduce)').matches);
    })();
    // The evening scene: the video starts on its own (except with reduced motion), the button pauses
    // the video and the incoming messages (WCAG 2.2.2: anything that loops can be paused).
    (function () {
      var root = document.querySelector('[data-soiree]');
      if (!root) return;
      var video = root.querySelector('video');
      var bouton = root.querySelector('[data-pause]');
      var label = root.querySelector('[data-pause-label]');
      var reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function regler(pause) {
        root.classList.toggle('pause', pause);
        bouton.setAttribute('aria-pressed', pause ? 'true' : 'false');
        label.textContent = pause ? 'Play the animation' : 'Pause the animation';
        if (pause) video.pause();
        else video.play().catch(function () {});
      }
      bouton.addEventListener('click', function () {
        regler(!root.classList.contains('pause'));
      });
      regler(reduit);
    })();
    // A week with Robin: clicking a day changes the bubble and the detail. Channels: clicking a tab
    // changes the phone screen. Without JS: Monday and WhatsApp stay visible.
    (function () {
      function onglets(root, attr) {
        if (!root) return;
        var tabs = [].slice.call(root.querySelectorAll('[role="tab"]'));
        var panneaux = [].slice.call(root.querySelectorAll('[' + attr + ']:not([role="tab"])'));
        tabs.forEach(function (t) {
          t.addEventListener('click', function () {
            var v = t.getAttribute(attr);
            tabs.forEach(function (u) {
              u.setAttribute('aria-selected', u === t ? 'true' : 'false');
            });
            panneaux.forEach(function (p) {
              var on = p.getAttribute(attr) === v;
              p.classList.toggle('on', on);
              p.setAttribute('aria-hidden', on ? 'false' : 'true');
            });
          });
        });
      }
      onglets(document.querySelector('[data-semaine]'), 'data-j');
    })();
  </script>
</Base>

<style>
  /* Robin floats gently, like the dot above the title. */
  /* The pause button for flying Robin: discreet, under the circle. */
  .vol-pause {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    color: color-mix(in srgb, var(--color-cream) 75%, transparent);
    box-shadow: 0 0 0 1px var(--color-line-night);
    cursor: pointer;
  }
  .vol-pause:hover,
  .vol-pause:focus-visible {
    color: var(--color-cream);
  }
  .vol-pause:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }
  .vol-pause .ico-lecture,
  [data-vol].pause .vol-pause .ico-pause {
    display: none;
  }
  [data-vol].pause .vol-pause .ico-lecture {
    display: block;
  }
  .flotte {
    filter: drop-shadow(0 18px 24px color-mix(in srgb, var(--color-black) 45%, transparent));
    animation: flotte 5s ease-in-out infinite;
  }
  @keyframes flotte {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }


  /* The evening scene: the video large, Robin's messages arriving top left (over the windows, so they hide no one). */
  .soiree-cadre {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 28px;
    background: var(--color-night-2);
    box-shadow: 0 0 0 1px var(--color-line-night);
  }
  @media (min-width: 64rem) {
    .soiree-cadre {
      border-radius: 36px;
    }
  }
  .soiree-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The bubbles come from Robin on the counter: opening to the left, the tail pointing down just to his left.
     One at a time, in the same cell, each in turn (9 s, time to read), then the evening restarts.
     Robin sits at ~55% of the video's width and ~42% of its height. */
  .bulles-soir {
    position: absolute;
