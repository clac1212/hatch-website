---
import TrustLayout from '../../components/TrustLayout.astro';
---

<TrustLayout
  locale="en"
  title="AI Compliance (EU AI Act) — Hatch"
  description="The European Union adopted the AI Act in 2024. Here is what it means in practice for you as a Hatch OS customer."
>
  <!-- HERO -->
  <section style="background:#051309;padding:96px 32px 80px;">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(56,102,65,0.18);border:1px solid rgba(56,102,65,0.35);border-radius:100px;padding:5px 14px 5px 10px;margin-bottom:24px;">
        <span style="width:6px;height:6px;border-radius:50%;background:#5aad6e;flex-shrink:0;box-shadow:0 0 8px rgba(90,173,110,0.7);"></span>
        <span style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5aad6e;font-family:'Inter',sans-serif;">AI Compliance</span>
      </div>
      <h1 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(32px,5vw,56px);font-weight:700;line-height:1.06;letter-spacing:-0.03em;color:#fff;margin:0 0 20px;">
        Hatch OS &amp; the EU AI Act.
      </h1>
      <p style="font-size:clamp(16px,2vw,19px);color:rgba(255,255,255,0.7);line-height:1.65;margin:0 0 40px;">
        The European Union adopted the AI Regulation (AI Act) in 2024. Here is what it means in practice for you as a Hatch OS customer.
      </p>
      <a href="/en/trust" style="display:inline-flex;align-items:center;gap:6px;color:rgba(255,255,255,0.5);font-size:14px;font-weight:500;text-decoration:none;font-family:'Inter',sans-serif;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        View Trust &amp; Security
      </a>
    </div>
  </section>

  <!-- 01 – RISK CLASSIFICATION -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">01</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 16px;line-height:1.1;">Hatch OS risk classification</h2>
      <p style="font-family:'Inter',sans-serif;font-size:15px;color:#4b6358;margin:0 0 28px;line-height:1.65;">Under the AI Act, AI systems are classified into four risk levels:</p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:32px;">
        <div style="border:1.5px solid #fca5a5;background:#fef2f2;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#dc2626;margin-bottom:6px;font-family:'Inter',sans-serif;">Unacceptable risk</div>
          <div style="font-size:12px;color:#991b1b;font-family:'Inter',sans-serif;line-height:1.5;">Prohibited (mass surveillance, social scoring…)</div>
        </div>
        <div style="border:1.5px solid #fdba74;background:#fff7ed;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#c2410c;margin-bottom:6px;font-family:'Inter',sans-serif;">High risk</div>
          <div style="font-size:12px;color:#9a3412;font-family:'Inter',sans-serif;line-height:1.5;">Strict requirements (health, employment, justice…)</div>
        </div>
        <div style="border:2px solid #386641;background:#f0f9f1;border-radius:12px;padding:16px;text-align:center;position:relative;">
          <div style="position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#386641;color:#fff4a4;font-size:10px;font-weight:700;letter-spacing:0.07em;padding:3px 10px;border-radius:100px;white-space:nowrap;font-family:'Inter',sans-serif;">Hatch OS</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#386641;margin-bottom:6px;font-family:'Inter',sans-serif;">Limited risk</div>
          <div style="font-size:12px;color:#166534;font-family:'Inter',sans-serif;line-height:1.5;">Transparency obligations</div>
        </div>
        <div style="border:1.5px solid #e5e7eb;background:#f8fafc;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;margin-bottom:6px;font-family:'Inter',sans-serif;">Minimal risk</div>
          <div style="font-size:12px;color:#6b7280;font-family:'Inter',sans-serif;line-height:1.5;">Spam filters, AI video games…</div>
        </div>
      </div>
      <div style="background:#f6fbf7;border:1.5px solid rgba(56,102,65,0.2);border-radius:14px;padding:24px 28px;">
        <p style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;margin:0 0 8px;font-weight:600;">Hatch OS is a limited-risk system.</p>
        <p style="font-family:'Inter',sans-serif;font-size:14px;color:#4b6358;margin:0;line-height:1.7;">We operate in the category of productivity and content management AI assistants. Our systems do not make autonomous decisions on sensitive matters (employment access, credit, justice…).</p>
      </div>
    </div>
  </section>

  <!-- 02 – OBLIGATIONS -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">02</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Our obligations and how we meet them</h2>
      <div style="overflow-x:auto;border-radius:12px;border:1px solid #e5e7eb;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
        <table style="width:100%;border-collapse:collapse;font-family:'Inter',sans-serif;font-size:14px;">
          <thead>
            <tr>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;white-space:nowrap;">AI Act Obligation</th>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Our approach</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Transparency</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">Users are always informed that they are interacting with an AI agent (Peep's welcome message).</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Human oversight</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">All important decisions remain in the hands of your teams. Hatch OS suggests, it does not decide.</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Accuracy &amp; robustness</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">Responses are based on YOUR documents (RAG). Hatch does not fabricate data. When uncertain, the agent says so.</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Data protection</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">See <a href="/en/trust" style="color:#386641;text-decoration:underline;">/en/trust</a> — native GDPR compliance, DPO appointed, EU data hosting.</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;font-weight:600;white-space:nowrap;vertical-align:top;">Technical documentation</td>
              <td style="padding:14px 18px;color:#374151;line-height:1.65;">Available on request for your IT and legal teams.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 03 – ROLES -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">03</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Who does what?</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div style="border:1.5px solid rgba(56,102,65,0.2);background:#f6fbf7;border-radius:16px;padding:28px 24px;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#386641;margin-bottom:12px;font-family:'Inter',sans-serif;">Hatch OS (AI provider)</div>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;">
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Develops and maintains models and infrastructure
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Ensures transparency of systems
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Provides technical documentation
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Updates systems as regulations evolve
            </li>
          </ul>
        </div>
        <div style="border:1.5px solid rgba(234,88,12,0.15);background:#fff8f5;border-radius:16px;padding:28px 24px;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#ea580c;margin-bottom:12px;font-family:'Inter',sans-serif;">Your network (deployer)</div>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;">
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Defines the agent's use cases
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Populates the knowledge base (your documents)
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Oversees agent responses
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Appoints an internal AI lead if required
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 – TIMELINE -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">04</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Application timeline</h2>
      <div style="display:flex;flex-direction:column;gap:0;position:relative;">
        <div style="position:absolute;left:23px;top:24px;bottom:24px;width:2px;background:linear-gradient(180deg,#386641,rgba(56,102,65,0.1));"></div>
        <div style="display:flex;align-items:flex-start;gap:20px;padding:0 0 28px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#386641;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#386641;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">August 2024</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;font-weight:500;">Regulation adopted</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:20px;padding:0 0 28px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#386641;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#386641;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">February 2025</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;font-weight:500;">Prohibited practices articles enter into force</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:20px;padding:0 0 28px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#fff4a4;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <span style="font-family:'Fraunces',serif;font-size:16px;font-weight:700;color:#1a2e1c;">!</span>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#ea580c;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">August 2026</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;font-weight:600;">Rules apply to limited-risk systems <span style="color:#386641;">(including Hatch OS)</span></div>
            <div style="font-family:'Inter',sans-serif;font-size:13px;color:#6b7280;margin-top:4px;">We are anticipating these requirements now.</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:20px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#e5e7eb;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">August 2027</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#6b7280;font-weight:500;">Full application</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 – LEGAL TEAM -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <div style="background:linear-gradient(135deg,#0a1f0b 0%,#112515 100%);border-radius:20px;padding:40px 44px;border:1px solid rgba(255,255,255,0.07);">
        <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#5aad6e;margin:0 0 10px;font-family:'Inter',sans-serif;">05 — For your legal team</p>
        <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(20px,2.5vw,30px);font-weight:700;color:#fff;letter-spacing:-0.02em;margin:0 0 8px;line-height:1.2;">For your legal team</h2>
        <p style="font-family:'Inter',sans-serif;font-size:15px;color:rgba(255,255,255,0.65);margin:0 0 24px;line-height:1.65;">Need to document AI tool usage across your network?</p>
        <ul style="list-style:none;margin:0 0 32px;padding:0;display:flex;flex-direction:column;gap:12px;">
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            We provide an AI classification sheet on request
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            We participate in your assessment processes (vendor questionnaires, internal audits)
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            We sign required DPAs (Data Processing Agreements)
          </li>
        </ul>
