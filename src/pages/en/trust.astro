---
import TrustLayout from '../../components/TrustLayout.astro';
---

<TrustLayout
  locale="en"
  title="Trust & Security — Hatch"
  description="Hatch OS is built for demanding networks: native GDPR compliance, data hosted in the European Union, no resale, no advertising."
>
  <!-- HERO -->
  <section style="background:#051309;padding:96px 32px 80px;">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(56,102,65,0.18);border:1px solid rgba(56,102,65,0.35);border-radius:100px;padding:5px 14px 5px 10px;margin-bottom:24px;">
        <span style="width:6px;height:6px;border-radius:50%;background:#5aad6e;flex-shrink:0;box-shadow:0 0 8px rgba(90,173,110,0.7);"></span>
        <span style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5aad6e;font-family:'Inter',sans-serif;">Trust &amp; Security</span>
      </div>
      <h1 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(32px,5vw,56px);font-weight:700;line-height:1.06;letter-spacing:-0.03em;color:#fff;margin:0 0 20px;">
        Your network deserves a trustworthy partner.
      </h1>
      <p style="font-size:clamp(16px,2vw,19px);color:rgba(255,255,255,0.7);line-height:1.65;margin:0 0 40px;">
        Hatch OS is built for demanding networks: native GDPR compliance, data hosted in the European Union, no resale, no advertising.
      </p>
      <a href="/en/ai-compliance" style="display:inline-flex;align-items:center;color:rgba(255,255,255,0.65);font-size:14px;font-weight:500;text-decoration:none;font-family:'Inter',sans-serif;">View AI compliance →</a>
    </div>
  </section>

  <!-- 01 – WHAT WE NEVER DO -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">01</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 40px;line-height:1.1;">What we never do</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">
        <div style="border:1.5px solid rgba(56,102,65,0.2);background:#f6fbf7;border-radius:16px;padding:28px 24px;">
          <div style="width:40px;height:40px;border-radius:10px;background:#386641;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3 style="font-family:'Inter',sans-serif;font-size:15px;font-weight:700;color:#0f1f10;margin:0 0 8px;">Your data is never sold.</h3>
          <p style="font-family:'Inter',sans-serif;font-size:14px;color:#4b6358;line-height:1.65;margin:0;">We do not monetise your data in any form. Your trust is not a product.</p>
        </div>
        <div style="border:1.5px solid rgba(56,102,65,0.2);background:#f6fbf7;border-radius:16px;padding:28px 24px;">
          <div style="width:40px;height:40px;border-radius:10px;background:#386641;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 style="font-family:'Inter',sans-serif;font-size:15px;font-weight:700;color:#0f1f10;margin:0 0 8px;">Your data never trains third-party models.</h3>
          <p style="font-family:'Inter',sans-serif;font-size:14px;color:#4b6358;line-height:1.65;margin:0;">What you index in Hatch stays in your agent. No leakage to shared or public AI models.</p>
        </div>
        <div style="border:1.5px solid rgba(56,102,65,0.2);background:#f6fbf7;border-radius:16px;padding:28px 24px;">
          <div style="width:40px;height:40px;border-radius:10px;background:#386641;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          </div>
          <h3 style="font-family:'Inter',sans-serif;font-size:15px;font-weight:700;color:#0f1f10;margin:0 0 8px;">No advertising cookies.</h3>
          <p style="font-family:'Inter',sans-serif;font-size:14px;color:#4b6358;line-height:1.65;margin:0;">No third-party tracking, no remarketing, no ad networks. Only cookies strictly necessary for the service.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 – INFRASTRUCTURE -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">02</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 8px;line-height:1.1;">Infrastructure built for Europe</h2>
      <p style="font-family:'Inter',sans-serif;font-size:15px;color:#4b6358;margin:0 0 32px;">Your data is hosted in the European Union by default. Exceptions are documented and governed by contract.</p>
      <div style="overflow-x:auto;border-radius:12px;border:1px solid #e5e7eb;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
        <table style="width:100%;border-collapse:collapse;font-family:'Inter',sans-serif;font-size:14px;">
          <thead>
            <tr>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Component</th>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Provider</th>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Location</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;font-weight:500;">Database</td>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;">Supabase (PostgreSQL)</td>
              <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;"><span style="display:inline-flex;align-items:center;gap:5px;background:#dcfce7;color:#166534;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">🇪🇺 Europe (eu-west-1)</span></td>
            </tr>
            <tr>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;font-weight:500;">Hosting &amp; CDN</td>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;">Vercel</td>
              <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;"><span style="display:inline-flex;align-items:center;gap:5px;background:#dcfce7;color:#166534;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">🇪🇺 Europe</span></td>
            </tr>
            <tr>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;font-weight:500;">AI models</td>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;">Google Gemini / Anthropic Claude</td>
              <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;"><span style="display:inline-flex;align-items:center;gap:5px;background:#fef3c7;color:#92400e;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">🇺🇸 United States *</span></td>
            </tr>
            <tr>
              <td style="padding:13px 18px;color:#374151;font-weight:500;">Messaging</td>
              <td style="padding:13px 18px;color:#374151;">WhatsApp Business API (Meta)</td>
              <td style="padding:13px 18px;"><span style="display:inline-flex;align-items:center;gap:5px;background:#fef3c7;color:#92400e;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">EU / United States *</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-family:'Inter',sans-serif;font-size:12px;color:#6b7280;margin:12px 0 0;">* Transfers governed by Standard Contractual Clauses (SCCs) in compliance with GDPR.</p>
    </div>
  </section>

  <!-- 03 – CERTIFICATIONS -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">03</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Certifications &amp; audits</h2>
      <div style="overflow-x:auto;border-radius:12px;border:1px solid #e5e7eb;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
        <table style="width:100%;border-collapse:collapse;font-family:'Inter',sans-serif;font-size:14px;">
          <thead>
            <tr>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Certification</th>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Status</th>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;font-weight:600;">GDPR</td>
              <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;"><span style="display:inline-flex;align-items:center;gap:5px;background:#dcfce7;color:#166534;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">✓ Compliant</span></td>
              <td style="padding:13px 18px;color:#4b6358;border-bottom:1px solid #f1f5f9;">DPO appointed, processing register maintained</td>
            </tr>
            <tr>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;font-weight:600;">SOC 2 Type II</td>
              <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;"><span style="display:inline-flex;align-items:center;gap:5px;background:#fef3c7;color:#92400e;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">⏳ In progress</span></td>
              <td style="padding:13px 18px;color:#4b6358;border-bottom:1px solid #f1f5f9;">Audit launched mid-2026</td>
            </tr>
            <tr>
              <td style="padding:13px 18px;color:#374151;border-bottom:1px solid #f1f5f9;font-weight:600;">ISO 27001</td>
              <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;"><span style="display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;color:#6b7280;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">— Not applicable yet</span></td>
              <td style="padding:13px 18px;color:#4b6358;border-bottom:1px solid #f1f5f9;">Planned from 50 active locations</td>
            </tr>
            <tr>
              <td style="padding:13px 18px;color:#374151;font-weight:600;">EU hosting</td>
              <td style="padding:13px 18px;"><span style="display:inline-flex;align-items:center;gap:5px;background:#dcfce7;color:#166534;font-size:12px;font-weight:600;padding:3px 10px;border-radius:100px;">✓ Compliant</span></td>
              <td style="padding:13px 18px;color:#4b6358;">Supabase eu-west-1, Vercel Europe region</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 04 – YOUR DATA -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">
      <div>
        <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">04</p>
        <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 16px;line-height:1.1;">Your data belongs to you</h2>
        <p style="font-family:'Inter',sans-serif;font-size:15px;color:#4b6358;line-height:1.7;margin:0;">Hatch OS acts as a <strong style="color:#0f1f10;">data processor</strong> under GDPR. You remain the data controller. This means:</p>
      </div>
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px;padding-top:48px;">
        <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.6;">
          <span style="width:20px;height:20px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
            <svg width="10" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3.5 3.5L11 1" stroke="#fff4a4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span><strong style="color:#0f1f10;">Access:</strong> export your data at any time, at no charge and without delay.</span>
        </li>
        <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.6;">
          <span style="width:20px;height:20px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
            <svg width="10" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3.5 3.5L11 1" stroke="#fff4a4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span><strong style="color:#0f1f10;">Deletion:</strong> request account deletion and all data is erased within 30 days.</span>
        </li>
        <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.6;">
          <span style="width:20px;height:20px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
            <svg width="10" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3.5 3.5L11 1" stroke="#fff4a4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span><strong style="color:#0f1f10;">Portability:</strong> JSON or CSV export on request.</span>
        </li>
        <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.6;">
          <span style="width:20px;height:20px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
            <svg width="10" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5l3.5 3.5L11 1" stroke="#fff4a4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>No post-contract retention beyond legal obligations (10 years for billing).</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 05 – IT TEAMS -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <div style="background:linear-gradient(135deg,#0a1f0b 0%,#112515 100%);border-radius:20px;padding:40px 44px;border:1px solid rgba(255,255,255,0.07);">
        <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#5aad6e;margin:0 0 10px;font-family:'Inter',sans-serif;">05 — For IT teams</p>
        <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(20px,2.5vw,30px);font-weight:700;color:#fff;letter-spacing:-0.02em;margin:0 0 8px;line-height:1.2;">A note for IT &amp; security teams</h2>
        <p style="font-family:'Inter',sans-serif;font-size:15px;color:rgba(255,255,255,0.65);margin:0 0 24px;line-height:1.65;">Need to validate an AI tool before deploying it across your network?</p>
        <ul style="list-style:none;margin:0 0 32px;padding:0;display:flex;flex-direction:column;gap:12px;">
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><strong style="color:#fff;">Authentication:</strong> SSO SAML 2.0 (integration in progress)</span>
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><strong style="color:#fff;">Encryption:</strong> TLS 1.3 in transit, AES-256 at rest</span>
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><strong style="color:#fff;">Logging:</strong> all data access is audited and retained for 12 months</span>
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><strong style="color:#fff;">Data isolation:</strong> each network has its own isolated space (PostgreSQL row-level security)</span>
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><strong style="color:#fff;">Documented REST API:</strong> compatible with your monitoring tools (SIEM, DLP)</span>
          </li>
        </ul>
        <a href="mailto:cesar@gethatch.io" style="display:inline-flex;align-items:center;gap:8px;background:#fff4a4;color:#1a2e1c;font-size:14px;font-weight:600;padding:11px 22px;border-radius:9px;text-decoration:none;font-family:'Inter',sans-serif;">
          Contact the technical team
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:720px;margin:0 auto;">
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,34px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 36px;text-align:center;line-height:1.1;">Frequently asked questions</h2>
      <div style="display:flex;flex-direction:column;gap:2px;">
        <details class="faq-item" style="border:1px solid #e5e7eb;border-radius:12px;background:#fff;overflow:hidden;">
          <summary style="padding:18px 20px;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;color:#0f1f10;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;">
            Where is my data hosted?
