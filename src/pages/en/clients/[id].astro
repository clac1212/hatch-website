---
import { getCollection } from 'astro:content';
import CasePage from '../../../views/CasePage.astro';
import type { CaseId } from '../../../content/schemas/cas';

/** One page per customer case of src/content/cases/en. */
export async function getStaticPaths() {
  const cases = await getCollection('cases', (e) => e.id.startsWith('en/'));
  return cases.map((e) => ({ params: { id: e.id.slice('en/'.length) } }));
}

const id = Astro.params.id as CaseId;
---

<CasePage locale="en" id={id} />
