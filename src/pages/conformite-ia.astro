---
import TrustLayout from '../components/TrustLayout.astro';
---

<TrustLayout
  locale="fr"
  title="Conformité IA (AI Act) — Hatch"
  description="L'Union européenne a adopté le Règlement IA (AI Act) en 2024. Voici ce que cela signifie concrètement pour vous, en tant que client Hatch OS."
>
  <!-- HERO -->
  <section style="background:#051309;padding:96px 32px 80px;">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(56,102,65,0.18);border:1px solid rgba(56,102,65,0.35);border-radius:100px;padding:5px 14px 5px 10px;margin-bottom:24px;">
        <span style="width:6px;height:6px;border-radius:50%;background:#5aad6e;flex-shrink:0;box-shadow:0 0 8px rgba(90,173,110,0.7);"></span>
        <span style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5aad6e;font-family:'Inter',sans-serif;">Conformité IA</span>
      </div>
      <h1 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(32px,5vw,56px);font-weight:700;line-height:1.06;letter-spacing:-0.03em;color:#fff;margin:0 0 20px;">
        Hatch OS &amp; l'AI Act européen.
      </h1>
      <p style="font-size:clamp(16px,2vw,19px);color:rgba(255,255,255,0.7);line-height:1.65;margin:0 0 40px;">
        L'Union européenne a adopté le Règlement IA (AI Act) en 2024. Voici ce que cela signifie concrètement pour vous, en tant que client Hatch OS.
      </p>
      <a href="/confiance" style="display:inline-flex;align-items:center;gap:6px;color:rgba(255,255,255,0.5);font-size:14px;font-weight:500;text-decoration:none;font-family:'Inter',sans-serif;transition:color 0.15s;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Voir Confiance &amp; sécurité
      </a>
    </div>
  </section>

  <!-- 01 – CLASSIFICATION -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">01</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 16px;line-height:1.1;">Classification du risque de Hatch OS</h2>
      <p style="font-family:'Inter',sans-serif;font-size:15px;color:#4b6358;margin:0 0 28px;line-height:1.65;">Selon l'AI Act, les systèmes d'IA sont classés en quatre niveaux de risque :</p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:32px;">
        <div style="border:1.5px solid #fca5a5;background:#fef2f2;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#dc2626;margin-bottom:6px;font-family:'Inter',sans-serif;">Risque inacceptable</div>
          <div style="font-size:12px;color:#991b1b;font-family:'Inter',sans-serif;line-height:1.5;">Interdit (surveillance de masse, score social…)</div>
        </div>
        <div style="border:1.5px solid #fdba74;background:#fff7ed;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#c2410c;margin-bottom:6px;font-family:'Inter',sans-serif;">Risque élevé</div>
          <div style="font-size:12px;color:#9a3412;font-family:'Inter',sans-serif;line-height:1.5;">Exigences strictes (santé, emploi, justice…)</div>
        </div>
        <div style="border:2px solid #386641;background:#f0f9f1;border-radius:12px;padding:16px;text-align:center;position:relative;">
          <div style="position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#386641;color:#fff4a4;font-size:10px;font-weight:700;letter-spacing:0.07em;padding:3px 10px;border-radius:100px;white-space:nowrap;font-family:'Inter',sans-serif;">Hatch OS</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#386641;margin-bottom:6px;font-family:'Inter',sans-serif;">Risque limité</div>
          <div style="font-size:12px;color:#166534;font-family:'Inter',sans-serif;line-height:1.5;">Obligations de transparence</div>
        </div>
        <div style="border:1.5px solid #e5e7eb;background:#f8fafc;border-radius:12px;padding:16px;text-align:center;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;margin-bottom:6px;font-family:'Inter',sans-serif;">Risque minimal</div>
          <div style="font-size:12px;color:#6b7280;font-family:'Inter',sans-serif;line-height:1.5;">Spam filters, jeux vidéo IA…</div>
        </div>
      </div>
      <div style="background:#f6fbf7;border:1.5px solid rgba(56,102,65,0.2);border-radius:14px;padding:24px 28px;">
        <p style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;margin:0 0 8px;font-weight:600;">Hatch OS est un système de risque limité.</p>
        <p style="font-family:'Inter',sans-serif;font-size:14px;color:#4b6358;margin:0;line-height:1.7;">Nous opérons dans la catégorie des assistants IA orientés productivité et gestion de contenu. Nos systèmes ne prennent pas de décisions autonomes sur des sujets sensibles (accès à l'emploi, crédit, justice…).</p>
      </div>
    </div>
  </section>

  <!-- 02 – OBLIGATIONS -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">02</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Nos obligations et comment nous les respectons</h2>
      <div style="overflow-x:auto;border-radius:12px;border:1px solid #e5e7eb;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
        <table style="width:100%;border-collapse:collapse;font-family:'Inter',sans-serif;font-size:14px;">
          <thead>
            <tr>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;white-space:nowrap;">Obligation AI Act</th>
              <th style="background:#f1f5f9;text-align:left;padding:12px 18px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;border-bottom:1px solid #e5e7eb;">Notre approche</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Transparence</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">Les utilisateurs sont toujours informés qu'ils interagissent avec un agent IA (message de bienvenue Peep).</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Supervision humaine</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">Toute décision importante reste entre les mains de vos équipes. Hatch OS suggère, il ne décide pas.</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Exactitude &amp; robustesse</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">Les réponses sont basées sur VOS documents (RAG). Hatch n'invente pas de données. En cas d'incertitude, l'agent le signale.</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;border-bottom:1px solid #f1f5f9;font-weight:600;white-space:nowrap;vertical-align:top;">Protection des données</td>
              <td style="padding:14px 18px;color:#374151;border-bottom:1px solid #f1f5f9;line-height:1.65;">Voir <a href="/confiance" style="color:#386641;text-decoration:underline;">/confiance</a> — RGPD natif, DPO désigné, données EU.</td>
            </tr>
            <tr>
              <td style="padding:14px 18px;color:#0f1f10;font-weight:600;white-space:nowrap;vertical-align:top;">Documentation technique</td>
              <td style="padding:14px 18px;color:#374151;line-height:1.65;">Disponible sur demande pour vos équipes DSI et juristes.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 03 – RÔLES -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">03</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Qui fait quoi ?</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div style="border:1.5px solid rgba(56,102,65,0.2);background:#f6fbf7;border-radius:16px;padding:28px 24px;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#386641;margin-bottom:12px;font-family:'Inter',sans-serif;">Hatch OS (fournisseur IA)</div>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;">
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Développe et maintient les modèles et l'infrastructure
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Garantit la transparence des systèmes
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Fournit la documentation technique
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#386641;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff4a4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Met à jour les systèmes en cas d'évolution réglementaire
            </li>
          </ul>
        </div>
        <div style="border:1.5px solid rgba(234,88,12,0.15);background:#fff8f5;border-radius:16px;padding:28px 24px;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#ea580c;margin-bottom:12px;font-family:'Inter',sans-serif;">Votre réseau (déployeur)</div>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;">
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Définit les cas d'usage de l'agent
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Alimente la base de connaissances (vos documents)
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Supervise les réponses de l'agent
            </li>
            <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Inter',sans-serif;font-size:14px;color:#374151;line-height:1.55;">
              <span style="width:16px;height:16px;border-radius:50%;background:#ea580c;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              Désigne un référent IA interne si nécessaire
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 – CALENDRIER -->
  <section style="background:#f8fafc;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#ea580c;margin:0 0 10px;font-family:'Inter',sans-serif;">04</p>
      <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(22px,3vw,36px);font-weight:700;color:#0f1f10;letter-spacing:-0.02em;margin:0 0 32px;line-height:1.1;">Calendrier d'application</h2>
      <div style="display:flex;flex-direction:column;gap:0;position:relative;">
        <div style="position:absolute;left:23px;top:24px;bottom:24px;width:2px;background:linear-gradient(180deg,#386641,rgba(56,102,65,0.1));"></div>
        <div style="display:flex;align-items:flex-start;gap:20px;padding:0 0 28px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#386641;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#386641;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">Août 2024</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;font-weight:500;">Adoption du règlement</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:20px;padding:0 0 28px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#386641;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff4a4" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#386641;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">Février 2025</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;font-weight:500;">Entrée en vigueur des articles sur les pratiques interdites</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:20px;padding:0 0 28px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#fff4a4;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <span style="font-family:'Fraunces',serif;font-size:16px;font-weight:700;color:#1a2e1c;">!</span>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#ea580c;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">Août 2026</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#0f1f10;font-weight:600;">Application aux systèmes de risque limité <span style="color:#386641;">(dont Hatch OS)</span></div>
            <div style="font-family:'Inter',sans-serif;font-size:13px;color:#6b7280;margin-top:4px;">Nous anticipons ces exigences dès maintenant.</div>
          </div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:20px;">
          <div style="width:48px;height:48px;border-radius:50%;background:#e5e7eb;border:3px solid #f8fafc;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <div>
            <div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px;">Août 2027</div>
            <div style="font-family:'Inter',sans-serif;font-size:15px;color:#6b7280;font-weight:500;">Application complète</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 – ENCART JURIDIQUE -->
  <section style="background:#fff;padding:72px 32px;">
    <div style="max-width:1000px;margin:0 auto;">
      <div style="background:linear-gradient(135deg,#0a1f0b 0%,#112515 100%);border-radius:20px;padding:40px 44px;border:1px solid rgba(255,255,255,0.07);">
        <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#5aad6e;margin:0 0 10px;font-family:'Inter',sans-serif;">05 — Pour votre équipe juridique</p>
        <h2 style="font-family:'Fraunces',Georgia,serif;font-size:clamp(20px,2.5vw,30px);font-weight:700;color:#fff;letter-spacing:-0.02em;margin:0 0 8px;line-height:1.2;">Pour votre équipe juridique</h2>
        <p style="font-family:'Inter',sans-serif;font-size:15px;color:rgba(255,255,255,0.65);margin:0 0 24px;line-height:1.65;">Vous devez documenter l'utilisation d'outils IA dans votre réseau ?</p>
        <ul style="list-style:none;margin:0 0 32px;padding:0;display:flex;flex-direction:column;gap:12px;">
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Nous fournissons une fiche de classification IA sur demande
          </li>
          <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Inter',sans-serif;font-size:14px;color:rgba(255,255,255,0.75);line-height:1.6;">
            <span style="width:18px;height:18px;border-radius:50%;background:rgba(90,173,110,0.25);border:1px solid rgba(90,173,110,0.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
              <svg width="8" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l2.8 2.8L9 1" stroke="#5aad6e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Nous participons à vos processus d'évaluation (questionnaires fournisseurs, audits internes)
          </li>
