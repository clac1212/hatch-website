{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/privacy", "destination": "/confidentialite", "permanent": true },
    { "source": "/terms", "destination": "/conditions", "permanent": true },
    { "source": "/security", "destination": "/securite", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/relais/static/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/:path"
    },
    { "source": "/relais/:path(.*)", "destination": "https://eu.i.posthog.com/:path" }
  ]
}
